#!/usr/bin/env bash
# gates/disk-low — pause launching when free disk drops below the floor.
#
# THE GATE CONTRACT
#   stdout   a one-line reason, when pausing
#   exit 0   feed OK
#   exit 10  pause launching (running agents are never touched)
#   other    treated as a broken gate: the pump warns and feeds anyway
#
# A thin delegate to the disk watchdog's own --gate mode, which owns the
# threshold. Keeping one source for that number is the point: the watchdog also
# drives the live pool cap from disk pressure, and the two must not disagree
# about what "low" means.
#
# Configuration:
#   TASKPUMP_DISK_GATE       0 disables the gate (default 1)
#   TASKPUMP_DISK_WATCHDOG   path to the watchdog (default: the installed one)
#   TASKPUMP_DISK_PAUSE_GB   the floor itself, read by the watchdog (default 10)
#
# Fails open when the watchdog is missing or not executable.
# HELP-END
set -uo pipefail

_tp_self_root="$(CDPATH= cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/config.sh
. "$_tp_self_root/lib/config.sh"
tp_load_config
# shellcheck source=../lib/pump-lib.sh
. "$TP_LIB_DIR/pump-lib.sh"

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { apl_help "$0"; exit 0; }

export TASKPUMP_DISK_WATCHDOG="${TASKPUMP_DISK_WATCHDOG:-$TP_LIBEXEC_DIR/tp-disk-watchdog}"

reason="$(apl_disk_low)" || rc=$?
rc="${rc:-0}"
if [[ "$rc" -eq 10 ]]; then
  printf '%s\n' "$reason"
  exit 10
fi
exit 0
