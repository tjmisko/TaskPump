#!/usr/bin/env bash
# gates/claude-token-fresh — pause launching when the HOST's OAuth access token
# is about to expire.
#
# THE GATE CONTRACT
#   stdout   a one-line reason, when pausing
#   exit 0   feed OK
#   exit 10  pause launching (running agents are never touched)
#   other    treated as a broken gate: the pump warns and feeds anyway
#
# Why this exists: launched containers are given the host's ACCESS token with
# the refresh token stripped out, so they cannot rotate it. That is deliberate —
# the refresh token rotates on use and the host's copy is mounted read-only, so
# a container-side refresh would log the host out. The consequence is that the
# host owns rotation, and a container launched against an already-expired token
# just 401s and burns a relaunch cycle. So: pause launching while the token is
# within a margin of expiry, and resume once a host-side session writes a fresh
# one back.
#
# Configuration:
#   TASKPUMP_TOKEN_GATE       0 disables the gate (default 1)
#   TASKPUMP_TOKEN_MARGIN_S   seconds of headroom before expiry (default 600)
#   TASKPUMP_CREDENTIALS      credentials file (default ~/.claude/.credentials.json)
#   TASKPUMP_NOW_S            clock override, for tests
#
# Fails open everywhere: a missing file, absent jq, or an unreadable expiry all
# feed. A meter we cannot read must never wedge the pump.
#
# It fails open LOUDLY, though. This gate ships in the default chain, so it runs
# on hosts driving a non-Claude agent where the credentials file will never
# exist. Those runs get one line on stderr — `skipped: no claude credentials at
# <path>` — and exit 0. A silent feed would be indistinguishable from a gate that
# looked and approved, which is the opposite fact about how protected the run is.
# The skip line goes to stderr because stdout is reserved for the pause reason.
# HELP-END
set -uo pipefail

_tp_self_root="$(CDPATH='' cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/config.sh
. "$_tp_self_root/lib/config.sh"
tp_load_config
# shellcheck source=../lib/pump-lib.sh
. "$TP_LIB_DIR/pump-lib.sh"

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { apl_help "$0"; exit 0; }

CRED="${TASKPUMP_CREDENTIALS:-$HOME/.claude/.credentials.json}"

# This gate ships in the DEFAULT chain, so it runs on hosts driving some other
# agent, against a file that will never exist. Say so, once, on stderr, and feed.
#
# Out loud, because a silent feed is indistinguishable from a gate that looked
# and approved — and the two are opposite facts about how protected the run is.
# On stderr, because stdout is where this gate says why it PAUSED (the contract
# at the top of this file), and a skip is not a pause.
skip="$(apl_host_credentials_problem "$CRED")"
if [[ -n "$skip" ]]; then
  printf 'claude-token-fresh: skipped: %s\n' "$skip" >&2
  exit 0
fi

# Credentials that are readable but carry no OAuth expiry are the same kind of
# absent input: nothing to measure, so nothing to pause on.
if ! jq -e '.claudeAiOauth.expiresAt | numbers' "$CRED" >/dev/null 2>&1; then
  printf 'claude-token-fresh: skipped: no OAuth expiry in %s\n' "$CRED" >&2
  exit 0
fi

reason="$(apl_host_token_stale "$CRED")" || rc=$?
rc="${rc:-0}"
if [[ "$rc" -eq 10 ]]; then
  printf '%s\n' "$reason"
  exit 10
fi
exit 0
