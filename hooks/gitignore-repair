#!/usr/bin/env bash
# hooks/gitignore-repair — undo a tool's habit of re-ignoring the worktrees dir.
#
# THE PRE-TICK HOOK CONTRACT
#   $1        the repo root
#   stdout    anything worth telling the operator; the pump logs it, and
#             notifies when the text CHANGES (so a persistent condition does not
#             fire a desktop notification every tick)
#   exit 0    fine
#   non-zero  the pump warns and carries on with the tick
#
# What this repairs: worktrees silently gitignored, from either direction. The
# `gh worktree` extension appends a bare `.worktrees/` line to .gitignore on
# every `worktree create`; sitting after the intentional `!.worktrees/`
# negations, it re-ignores every worktree — hiding their files from ripgrep and
# an agent's file search, and leaving the primary checkout permanently dirty,
# which makes the contamination guard fire on every tick (a live run stalled on
# exactly that, 2026-06-24). And an operator-global core.excludesFile ignoring
# **/.worktrees/** everywhere does the same from below (the dogfood canary
# launched nothing, 2026-08-13) — healed by negations appended once to the
# repo's own info/exclude, which outranks the global file and is untracked.
#
# Idempotent: a no-op unless something is wrong. Says nothing when there is
# nothing to repair, so it does not add a line to every tick's log.
#
# Configuration:
#   TASKPUMP_WORKTREES_IGNORE_LINE   the line to strip, and the dir the
#                                    visibility probe checks (default `.worktrees/`)
# HELP-END
set -uo pipefail

_tp_self_root="$(CDPATH='' cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/config.sh
. "$_tp_self_root/lib/config.sh"
tp_load_config
# shellcheck source=../lib/pump-lib.sh
. "$TP_LIB_DIR/pump-lib.sh"

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { apl_help "$0"; exit 0; }

repo_root="${1:-${TP_REPO_ROOT:-$PWD}}"
probe_base="${TASKPUMP_WORKTREES_IGNORE_LINE:-.worktrees/}"
probe="$repo_root/${probe_base%/}/.tp-visibility-probe"
if ! apl_ensure_worktrees_visible "$repo_root" "$probe"; then
  echo "worktrees dir is still gitignored after repair: $(git -C "$repo_root" check-ignore -v "$probe" 2>/dev/null | head -1)"
fi
exit 0
