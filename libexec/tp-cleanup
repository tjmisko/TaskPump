#!/bin/bash
# tp-cleanup -- one-button rescue for a parallel run.
#
# Background: a parallel run can leave the box in an awkward state — agents hung
# on build locks after an ENOSPC, runaway dev-server zombies, tens of GB of
# container build cache, several GB of build output per worktree. This packages
# the recovery so it is one command and not a 20-step muscle-memory ritual.
#
# Usage:
#   tp cleanup --status        # what would be cleaned (read-only)
#   tp cleanup --stuck         # stop hung containers, release their tasks
#   tp cleanup --targets       # clean worktree build dirs (skips live agents)
#   tp cleanup --targets --include-primary  # ...and the primary checkout's
#   tp cleanup --docker        # builder prune + system prune
#   tp cleanup --all           # all three, in that order
#   tp cleanup --all --dry-run # preview the full --all sweep
#
# Stuck-detection heuristic: a running agent container whose agent log's mtime
# is older than TASKPUMP_STUCK_THRESHOLD_MIN (default 15) is considered stuck.
# The script then:
#   1. WIP-commits its worktree (so in-flight edits survive the kill).
#   2. Stops the container (graceful SIGTERM + grace period, then SIGKILL).
#   3. Releases the task claim so the next run can re-pick it.
#
# Configuration (taskpump.conf or the environment; legacy names still work):
#   TASKPUMP_STUCK_THRESHOLD_MIN  log-stale cutoff, minutes (default 15)
#   TASKPUMP_STOP_GRACE_SEC       stop grace period, seconds (default 30)
#   TASKPUMP_MANIFEST             manifest mapping containers to tasks
#   TASKPUMP_WORKTREES_DIR        base dir holding the agent worktrees
#   TASKPUMP_AGENT_LOG_NAME       the agent log inside each worktree
#   TASKPUMP_RECLAIM_PRIMARY      1 = same as --include-primary
#   TASKPUMP_EXTRA_BUSY_DIRS      newline-separated workspace roots --targets
#                                 must also skip (the disk guard passes
#                                 compiler-busy workspaces here; a listed
#                                 primary root skips the primary even under
#                                 --include-primary)
# HELP-END
set -uo pipefail

# ── TaskPump config core ──────────────────────────────────────────────────────
_tp_self_root="$(CDPATH= cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/config.sh
. "$_tp_self_root/lib/config.sh"
tp_load_config
# shellcheck source=../lib/pump-lib.sh
. "$TP_LIB_DIR/pump-lib.sh"

# REPO_ROOT is normally the parent of this script's dir; overridable so the
# target-reclaim sweep can be unit-tested against a fixture tree.
_default_repo_root="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
REPO_ROOT="${TASKPUMP_CLEANUP_REPO_ROOT:-$_default_repo_root}"
# Shared with the pump: cleanup used to hardcode `.worktrees` while the pump had
# it behind a knob, so a relocated worktrees base broke the rescue path only.
WORKTREES_DIR="${TASKPUMP_WORKTREES_DIR:-$REPO_ROOT/.worktrees}"
MANIFEST="${TASKPUMP_MANIFEST:-${MANIFEST:-$REPO_ROOT/ops/task-loop/parallel-manifest.tsv}}"
STUCK_THRESHOLD_MIN="${TASKPUMP_STUCK_THRESHOLD_MIN:-${STUCK_THRESHOLD_MIN:-15}}"
DOCKER_GRACE_SEC="${TASKPUMP_STOP_GRACE_SEC:-${DOCKER_GRACE_SEC:-30}}"
AGENT_LOG_NAME="${TASKPUMP_AGENT_LOG_NAME:-.taskpump-agent.log}"

DRY_RUN=0
MODE=""
# --include-primary / RECLAIM_PRIMARY=1: also reclaim the PRIMARY checkout's
# target/ (Arachne itself), not just worktrees. Off by default so a human's
# in-progress build in the primary checkout is never wiped without asking; the
# disk watchdog turns it on under PANIC to buy maximum space.
INCLUDE_PRIMARY="${TASKPUMP_RECLAIM_PRIMARY:-${RECLAIM_PRIMARY:-0}}"

usage() { apl_help "$0"; }

for a in "$@"; do
    case "$a" in
        --status)   MODE="status";  DRY_RUN=1 ;;
        --stuck)    [[ -z "$MODE" ]] && MODE="stuck"    || { echo "ERROR: only one mode allowed"; exit 2; } ;;
        --targets)  [[ -z "$MODE" ]] && MODE="targets"  || { echo "ERROR: only one mode allowed"; exit 2; } ;;
        --docker)   [[ -z "$MODE" ]] && MODE="docker"   || { echo "ERROR: only one mode allowed"; exit 2; } ;;
        --all)      [[ -z "$MODE" ]] && MODE="all"      || { echo "ERROR: only one mode allowed"; exit 2; } ;;
        --include-primary) INCLUDE_PRIMARY=1 ;;
        --dry-run)  DRY_RUN=1 ;;
        -h|--help)  usage; exit 0 ;;
        *)          echo "ERROR: unknown arg '$a'" >&2; usage; exit 2 ;;
    esac
done

[[ -z "$MODE" ]] && { usage; exit 2; }

log() { echo "[$(date '+%H:%M:%S')] $*"; }
act() {
    if [[ "$DRY_RUN" -eq 1 ]]; then echo "  (dry-run) $*"
    else echo "  $ $*"; eval "$@"
    fi
}

# ── manifest_task_for <container-name> -- echo the epic task id for a
#    running container, or empty if no match. Compares each manifest branch
#    transliterated to a slug ('/' → '-') against <prefix><slug>.
manifest_task_for() {
    local cname="$1"
    [[ -f "$MANIFEST" ]] || return 1
    local prefix; prefix="$(apl_agent_prefix)"
    while IFS=$'\t' read -r name branch _brief task _rest; do
        [[ "$name" =~ ^# ]] && continue
        [[ -z "$name"   ]] && continue
        local slug="${branch//\//-}"
        if [[ "$prefix$slug" == "$cname" ]]; then
            echo "$task"; return 0
        fi
    done < "$MANIFEST"
    return 1
}

# ── worktree_for_container <container-name> -- echo the worktree path.
#    KNOWN LIMITATION (deferred): the slug→branch mapping is lossy. It converts
#    the FIRST '-' back into '/', which round-trips `feat/foo-bar` but not
#    `feature-x/y`. Correct for the one-slash branch convention the pump
#    generates; a branch with a '-' before its '/' would resolve to the wrong
#    worktree. Fixing it needs the branch carried alongside the name rather than
#    re-derived from it.
worktree_for_container() {
    local cname="$1"
    local slug="${cname#"$(apl_agent_prefix)"}"
    local branch="${slug/-//}"
    echo "$WORKTREES_DIR/$branch"
}

# ── list_agent_containers -- emit names of running agent containers.
list_agent_containers() { apl_live_agent_names; }

# ── log_age_min <path> -- echo the age of <path> in minutes, or "?" if missing.
log_age_min() {
    local f="$1"
    [[ -f "$f" ]] || { echo "?"; return; }
    local now mt
    now=$(date +%s)
    mt=$(stat -c '%Y' "$f" 2>/dev/null || stat -f '%m' "$f" 2>/dev/null || echo 0)
    echo $(( (now - mt) / 60 ))
}

# ── do_stuck -- find log-stale containers, snapshot their worktrees, stop
#    them, release their epic task claims.
do_stuck() {
    log "stuck-agent sweep (threshold=${STUCK_THRESHOLD_MIN}min, dry-run=$DRY_RUN)"
    local found=0
    local cname
    while IFS= read -r cname; do
        [[ -z "$cname" ]] && continue
        local wt; wt="$(worktree_for_container "$cname")"
        local logf="$wt/$AGENT_LOG_NAME"
        local age; age="$(log_age_min "$logf")"
        if [[ "$age" == "?" ]]; then
            log "  $cname: no log file at $logf (skip)"
            continue
        fi
        if (( age < STUCK_THRESHOLD_MIN )); then
            log "  $cname: log fresh (${age}min < ${STUCK_THRESHOLD_MIN}) — leave alone"
            continue
        fi
        found=$((found + 1))
        log "  $cname: STUCK (log idle ${age}min)"
        # 1) snapshot worktree progress
        if [[ -d "$wt/.git" || -f "$wt/.git" ]]; then
            act "git -C '$wt' add -A"
            act "git -C '$wt' -c user.name=tp-cleanup -c user.email=cleanup@taskpump.local commit -m 'wip: tp-cleanup pre-stop snapshot' --allow-empty"
        fi
        # 2) stop the container
        act "$(apl_docker) stop --time=$DOCKER_GRACE_SEC '$cname'"
        # 3) release the task claim, if known
        local task; task="$(manifest_task_for "$cname" || true)"
        if [[ -n "$task" ]]; then
            act "'$TP_LIBEXEC_DIR/tp-task' release '$task' --reason 'tp-cleanup: stuck (log idle ${age}min)'"
        else
            log "  $cname: no manifest task mapping; skipping the task release"
        fi
    done < <(list_agent_containers)
    if (( found == 0 )); then
        log "no stuck agents found."
    else
        log "stuck-agent sweep: $found container(s) handled."
    fi
}

# ── busy_worktrees -- emit the .worktrees paths that currently host a live
#    arachne-agent-* container (one per line). Used to skip a worktree whose
#    agent is mid-build, so reclaiming target/ never yanks the rug from a
#    running session. Empty when docker is absent or no agents run.
busy_worktrees() {
    local cname
    while IFS= read -r cname; do
        [[ -z "$cname" ]] && continue
        worktree_for_container "$cname"
    done < <(list_agent_containers)
}

# ── reclaim_target <dir> <label> -- free a Rust build dir's target/. Prefers
#    `cargo clean` (respects the workspace layout / CARGO_TARGET_DIR); falls
#    back to rm -rf when cargo or the manifest is absent. Honours --dry-run via
#    act(). Returns 1 (no-op) when there is no target/ to reclaim.
reclaim_target() {
    local dir="$1" label="$2"
    [[ -d "$dir/target" ]] || return 1
    local size; size="$(du -sh "$dir/target" 2>/dev/null | cut -f1)"
    log "  $label: $dir/target ($size)"
    if command -v cargo >/dev/null 2>&1 && [[ -f "$dir/Cargo.toml" ]]; then
        act "cargo clean --manifest-path '$dir/Cargo.toml'"
    else
        act "rm -rf '$dir/target'"
    fi
    return 0
}

# ── do_targets -- cargo clean target/ in every worktree (cheap to rebuild,
#    typically 2-6 GB each), SKIPPING any worktree that currently hosts a live
#    agent container so an in-flight build is never broken. With
#    --include-primary it also reclaims the primary checkout's own target/.
do_targets() {
    log "reclaiming cargo target/ dirs (dry-run=$DRY_RUN, include-primary=$INCLUDE_PRIMARY)"
    local busy; busy="$(busy_worktrees)"
    local found=0 skipped=0
    local wt
    # DEFERRED (documented, not fixed): this glob is two levels deep while the
    # pump addresses a worktree as <base>/<branch-with-a-slash>. The two agree
    # only because the generated branches happen to contain exactly one slash;
    # a flat branch name would be invisible here.
    for wt in "$WORKTREES_DIR"/*/*; do
        [[ -d "$wt/target" ]] || continue
        if printf '%s\n' "$busy" | grep -Fxq "$wt"; then
            log "  skip: $wt/target — live agent container"
            skipped=$((skipped + 1))
            continue
        fi
        if [[ -n "${EXTRA_BUSY_DIRS:-}" ]] && printf '%s\n' "$EXTRA_BUSY_DIRS" | grep -Fxq "$wt"; then
            log "  skip: $wt/target — busy (EXTRA_BUSY_DIRS)"
            skipped=$((skipped + 1))
            continue
        fi
        reclaim_target "$wt" "worktree" && found=$((found + 1))
    done
    if (( found == 0 && skipped == 0 )); then
        log "no worktree target dirs to reclaim."
    else
        log "reclaimed $found worktree target dir(s); skipped $skipped live."
    fi
    # The primary checkout's own target/ — only when explicitly requested, since
    # a human may be building there. The watchdog passes --include-primary under
    # PANIC to buy the most space.
    if [[ -d "$REPO_ROOT/target" ]]; then
        if [[ -n "${EXTRA_BUSY_DIRS:-}" ]] && printf '%s\n' "$EXTRA_BUSY_DIRS" | grep -Fxq "$REPO_ROOT"; then
            log "  skip: $REPO_ROOT/target — busy (EXTRA_BUSY_DIRS)"
        elif [[ "$INCLUDE_PRIMARY" -eq 1 ]]; then
            reclaim_target "$REPO_ROOT" "primary"
        else
            local size; size="$(du -sh "$REPO_ROOT/target" 2>/dev/null | cut -f1)"
            log "primary checkout target: $REPO_ROOT/target ($size) — left alone (pass --include-primary to reclaim)"
        fi
    fi
}

# ── do_docker -- prune build cache + dangling containers/images. The
#    agent image itself is reused, not pruned.
do_docker() {
    log "docker prune (build cache + system) (dry-run=$DRY_RUN)"
    local docker_bin; docker_bin="$(apl_docker)"
    if ! command -v "$docker_bin" >/dev/null 2>&1; then
        log "$docker_bin not on PATH; skipping."
        return
    fi
    act "$docker_bin builder prune -af"
    act "$docker_bin system prune -f"
    log "docker prune complete."
}

# ── status -- read-only summary.
do_status() {
    log "tp-cleanup --status (read-only)"
    echo
    echo "## Agent containers"
    "$(apl_docker)" ps --format 'table {{.Names}}\t{{.Status}}\t{{.Size}}' 2>/dev/null \
        | grep -E "^NAMES|^$(apl_agent_prefix)" || echo "(none running)"
    echo
    echo "## Log-stale heuristic (threshold=${STUCK_THRESHOLD_MIN}min)"
    local cname
    while IFS= read -r cname; do
        [[ -z "$cname" ]] && continue
        local wt; wt="$(worktree_for_container "$cname")"
        local logf="$wt/$AGENT_LOG_NAME"
        local age; age="$(log_age_min "$logf")"
        printf "  %-40s  log_age=%s min\n" "$cname" "$age"
    done < <(list_agent_containers)
    echo
    echo "## Worktree target/ sizes"
    du -sh "$WORKTREES_DIR"/*/*/target 2>/dev/null | sort -h | tail -20 || echo "(none)"
    echo
    echo "## Docker storage"
    "$(apl_docker)" system df 2>/dev/null || echo "(container runtime not available)"
}

case "$MODE" in
    status)   do_status ;;
    stuck)    do_stuck ;;
    targets)  do_targets ;;
    docker)   do_docker ;;
    all)      do_stuck; echo; do_targets; echo; do_docker ;;
esac
