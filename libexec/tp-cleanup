#!/bin/bash
# tp-cleanup -- one-button rescue for a parallel run.
#
# Background: a parallel run can leave the box in an awkward state — agents hung
# on build locks after an ENOSPC, runaway dev-server zombies, tens of GB of
# container build cache, several GB of build output per worktree. This packages
# the recovery so it is one command and not a 20-step muscle-memory ritual.
#
# Usage:
#   tp cleanup --status        # what would be cleaned (read-only)
#   tp cleanup --stuck         # stop hung containers, release their tasks
#   tp cleanup --targets       # clean worktree build dirs (skips live agents)
#   tp cleanup --targets --include-primary  # ...and the primary checkout's
#   tp cleanup --docker        # builder prune + system prune
#   tp cleanup --all           # all three, in that order
#   tp cleanup --all --dry-run # preview the full --all sweep
#
# Stuck-detection heuristic: a running agent container whose agent log's mtime
# is older than TASKPUMP_STUCK_THRESHOLD_MIN (default 15) is considered stuck.
# The script then:
#   1. WIP-commits its worktree (so in-flight edits survive the kill).
#   2. Stops the container (graceful SIGTERM + grace period, then SIGKILL).
#   3. Releases the task claim so the next run can re-pick it.
#
# Configuration (taskpump.conf or the environment; legacy names still work):
#   TASKPUMP_RECLAIM_CMD          the command the --targets sweep RUNS in each
#                                 idle workspace, with that workspace as the
#                                 working directory — the same key, with the
#                                 same meaning, that the pump's per-tick reclaim
#                                 executes. Unset, the sweep touches nothing and
#                                 says so.
#   TASKPUMP_RECLAIM_DIR          the build-output directory that says a
#                                 workspace is worth reclaiming, and the one
#                                 --status measures (default `target`; set it to
#                                 `build`, `node_modules`, `dist`, ... for your
#                                 toolchain). Empty means no precondition: the
#                                 reclaim command runs in every idle workspace —
#                                 the primary checkout included, on every
#                                 --include-primary (which the disk watchdog's
#                                 PANIC sweep always passes). Name the primary in
#                                 TASKPUMP_EXTRA_BUSY_DIRS to hold it back.
#   TASKPUMP_STUCK_THRESHOLD_MIN  log-stale cutoff, minutes (default 15)
#   TASKPUMP_STOP_GRACE_SEC       stop grace period, seconds (default 30)
#   TASKPUMP_MANIFEST             OPT-IN v1 parallel-run manifest (no default;
#                                 the ledger's live claim is the canonical
#                                 container→task mapping, and a configured
#                                 manifest that does not exist is an error)
#   TASKPUMP_WORKTREES_DIR        base dir holding the agent worktrees
#   TASKPUMP_AGENT_LOG_NAME       the agent log inside each worktree
#   TASKPUMP_RECLAIM_PRIMARY      1 = same as --include-primary
#   TASKPUMP_EXTRA_BUSY_DIRS      newline-separated workspace roots --targets
#                                 must also skip, so a workspace that is
#                                 mid-compile keeps its build output (a listed
#                                 primary root skips the primary even under
#                                 --include-primary). The bare EXTRA_BUSY_DIRS
#                                 spelling is the legacy one and still works;
#                                 the two lists are UNIONED, never ranked — the
#                                 disk guard passes the bare name on its command
#                                 line while a conf carries the prefixed one, and
#                                 dropping either list deletes the build output
#                                 it was set to protect. The skip line names the
#                                 spelling (or both) that protected the entry.
#
# Exit status: 0 = swept, 2 = usage error (no mode, unknown arg, two modes, a
# configured-but-missing TASKPUMP_MANIFEST), 3 = a configured reclaim command
# failed in at least one workspace, so the sweep may have freed nothing.
# HELP-END
set -uo pipefail

# ── TaskPump config core ──────────────────────────────────────────────────────
_tp_self_root="$(CDPATH='' cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/config.sh
. "$_tp_self_root/lib/config.sh"
tp_load_config
# shellcheck source=../lib/pump-lib.sh
. "$TP_LIB_DIR/pump-lib.sh"

# REPO_ROOT is normally the parent of this script's dir; overridable so the
# target-reclaim sweep can be unit-tested against a fixture tree.
_default_repo_root="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)"
REPO_ROOT="${TASKPUMP_CLEANUP_REPO_ROOT:-$_default_repo_root}"
# Shared with the pump: cleanup used to hardcode `.worktrees` while the pump had
# it behind a knob, so a relocated worktrees base broke the rescue path only.
WORKTREES_DIR="${TASKPUMP_WORKTREES_DIR:-$REPO_ROOT/.worktrees}"
# Which task a container is on comes from the LEDGER's live claim
# (claim_task_for below). TASKPUMP_MANIFEST is an opt-in fallback for a consumer
# that still launches from a v1 parallel-run manifest — a TSV of
# name<TAB>branch<TAB>brief<TAB>task rows. It has NO default path: TaskPump does
# not generate the file, and the old Arachne-shaped default pointed every other
# consumer at a path that cannot exist (issue #7). The bare MANIFEST spelling is
# the pre-extraction name and is still honoured.
MANIFEST_KEY="MANIFEST"
[[ -n "${TASKPUMP_MANIFEST:-}" ]] && MANIFEST_KEY="TASKPUMP_MANIFEST"
MANIFEST="${TASKPUMP_MANIFEST:-${MANIFEST:-}}"
# The repo-relative spelling, same precedence as the monitor (issue #7 review:
# a spelling one tool honours and the other silently ignores is the
# explicit-config-silently-ignored shape this change exists to eliminate).
if [[ -z "$MANIFEST" && -n "${TASKPUMP_MANIFEST_SUBPATH:-}" ]]; then
    MANIFEST_KEY="TASKPUMP_MANIFEST_SUBPATH"
    MANIFEST="$REPO_ROOT/${TASKPUMP_MANIFEST_SUBPATH}"
fi
STUCK_THRESHOLD_MIN="${TASKPUMP_STUCK_THRESHOLD_MIN:-${STUCK_THRESHOLD_MIN:-15}}"
DOCKER_GRACE_SEC="${TASKPUMP_STOP_GRACE_SEC:-${DOCKER_GRACE_SEC:-30}}"
AGENT_LOG_NAME="${TASKPUMP_AGENT_LOG_NAME:-.taskpump-agent.log}"

DRY_RUN=0
MODE=""
# --include-primary / RECLAIM_PRIMARY=1: also reclaim the PRIMARY checkout's
# build output, not just the worktrees'. Off by default so a human's
# in-progress build in the primary checkout is never wiped without asking; the
# disk watchdog turns it on under PANIC to buy maximum space.
INCLUDE_PRIMARY="${TASKPUMP_RECLAIM_PRIMARY:-${RECLAIM_PRIMARY:-0}}"
# The build-output sweep runs only when the consumer has said how build output
# is reclaimed (TASKPUMP_RECLAIM_CMD, the same key the pump's per-tick pass
# reads), and it runs exactly that command — a rescue tool guessing at another
# toolchain's build dirs is worse than one that says it is unconfigured (G1.7;
# examples/arachne.conf pins 'cargo clean').
RECLAIM_CMD="${TASKPUMP_RECLAIM_CMD:-}"
# Which directory means "this workspace is holding build output". Rust's
# `target` is the default because it is what this sweep has always looked for;
# it is a PROBE, not the thing that gets deleted, so a project whose `target/`
# means something else still only ever has RECLAIM_CMD run against it. Empty
# turns the precondition off (B9).
RECLAIM_DIR="${TASKPUMP_RECLAIM_DIR-${RECLAIM_DIR-target}}"
# Workspaces to leave alone even though no agent container is on them — a human
# mid-compile, or the disk guard's own busy list.
#
# UNION, not precedence. The prefixed name used to be inert, so the documented
# spelling protected nothing and the sweep deleted exactly the build output it
# was set to save (B5) — and a `:-` chain re-creates that harm through whichever
# spelling loses: the live disk-guard chain passes the bare EXTRA_BUSY_DIRS on
# its command line while a conf (or lib/config.sh's ARACHNE_→TASKPUMP_ bridge)
# supplies the prefixed one, so ranking them silently unprotects a workspace
# somebody explicitly named. Both lists are consulted; the skip line names the
# spelling that matched, so "which one did it read" is never a guess.
BUSY_EXTRA_CANONICAL="${TASKPUMP_EXTRA_BUSY_DIRS:-}"
BUSY_EXTRA_LEGACY="${EXTRA_BUSY_DIRS:-}"

usage() { apl_help "$0"; }

for a in "$@"; do
    case "$a" in
        --status)   MODE="status";  DRY_RUN=1 ;;
        --stuck)    [[ -z "$MODE" ]] && MODE="stuck"    || { echo "ERROR: only one mode allowed"; exit 2; } ;;
        --targets)  [[ -z "$MODE" ]] && MODE="targets"  || { echo "ERROR: only one mode allowed"; exit 2; } ;;
        --docker)   [[ -z "$MODE" ]] && MODE="docker"   || { echo "ERROR: only one mode allowed"; exit 2; } ;;
        --all)      [[ -z "$MODE" ]] && MODE="all"      || { echo "ERROR: only one mode allowed"; exit 2; } ;;
        --include-primary) INCLUDE_PRIMARY=1 ;;
        --dry-run)  DRY_RUN=1 ;;
        -h|--help)  usage; exit 0 ;;
        *)          echo "ERROR: unknown arg '$a'" >&2; usage; exit 2 ;;
    esac
done

[[ -z "$MODE" ]] && { usage; exit 2; }

# An explicitly configured manifest that does not exist is an ERROR, on the same
# rule TASKPUMP_CONFIG follows: an explicit request for a specific file must not
# silently fall back. Unconfigured is normal and reads nothing.
if [[ -n "$MANIFEST" && ! -f "$MANIFEST" ]]; then
    echo "ERROR: $MANIFEST_KEY names '$MANIFEST', which does not exist." >&2
    echo "       Restore the file, or unset $MANIFEST_KEY — stuck-agent rescues map containers to tasks from the ledger's live claims without it." >&2
    exit 2
fi

log() { echo "[$(date '+%H:%M:%S')] $*"; }

# act <argv...> -- run one command, or print what it would have been under
# --dry-run. An ARGV VECTOR, never a command string.
#
# This used to end in `eval "$*"`, on the premise that "every caller passes ONE
# pre-quoted command string". The premise is what failed: the callers built
# those strings by interpolating values — a worktree directory name from a glob,
# a task id read out of the ledger — inside single quotes, and a value carrying
# a single quote of its own closes the quoting and the rest of it runs as the
# operator, on the host, from a watchdog nobody is watching (PI-C1 / PI-D4).
# There is no quoting discipline that survives that; there is only not parsing
# data as shell. Words in, words out.
act() {
    if [[ "$DRY_RUN" -eq 1 ]]; then printf '  (dry-run) %s\n' "$(act_render "$@")"
    else printf '  $ %s\n' "$(act_render "$@")"; "$@"
    fi
}

# act_render <argv...> -- the command as a copy-pasteable shell line. %q, so a
# value that would need quoting shows its quoting instead of losing it.
act_render() {
    local out; out="$(printf '%q ' "$@")"
    printf '%s' "${out% }"
}

# ── checked_task_id <id> <source> <remedy> -- 0 when this id may be handed to
#    another tool, 1 (with a WARNING naming the source, the reason and <remedy>)
#    when it may not.
#    Ids ENTER this tool from the filesystem: a ledger task file's frontmatter,
#    a manifest row. Both are writable by anything that can write the repo — an
#    agent with a bind-mounted checkout, a merged pull request — and neither
#    goes through `tp task create`, which is where the id shape used to be
#    enforced. So it is enforced here too, at the boundary where the string
#    arrives, and an unsafe id is refused with a diagnostic instead of being
#    passed on (PI-C1 / PI-C4).
#
#    <remedy> is the caller's, because the file to fix is the caller's: sending
#    an operator to a task file's frontmatter for a bad row in a TSV manifest
#    names the wrong file and `tp task fsck` will not find it either.
#
#    SAFETY refuses; GRAMMAR only warns. An id outside TASKPUMP_ID_PATTERN is
#    still one safe argv word, and refusing to free a wedged agent over the
#    project's naming convention would strand the claim — `tp task fsck --fix`
#    filters on the same pattern, so it will not repair those files either.
checked_task_id() {
    local id="$1" source="$2" remedy="$3" reason
    if ! reason="$(apl_id_reject_reason "$id")"; then
        echo "WARN: ignoring the $source: $reason" >&2
        echo "      $remedy" >&2
        return 1
    fi
    if ! reason="$(apl_id_offgrammar_reason "$id")"; then
        echo "WARN: the $source: $reason" >&2
        echo "      Proceeding anyway — the id is safe to hand on as one argument, and a wedged agent is worse than an off-grammar id. $remedy" >&2
    fi
    return 0
}

# ── ledger_claims -- "branch<TAB>task<TAB>turns<TAB>goal" rows, one per branch
#    holding a live in_progress claim. Delegated to the renderer's --claims mode
#    for the same reason the monitor delegates: it shares the ledger's
#    frontmatter parser and newest-heartbeat election, so the rescue path cannot
#    disagree with the dashboards about which claim is live.
ledger_claims() {
    local dag_bin="${TASKPUMP_DAG_BIN:-$TP_LIBEXEC_DIR/tp-dag-render}" out rc=0
    if [[ ! -x "$dag_bin" ]]; then
        echo "WARN: ledger renderer not executable: $dag_bin — cannot read live claims, falling back to the manifest" >&2
        return 0
    fi
    # Neutralize pump-state phase narrowing: the renderer scopes --claims to
    # the pump state's phase range, but a stuck agent is typically exactly the
    # one the range has moved past. -f /dev/null is false, so PHASES stays
    # empty and every phase is scanned.
    out="$(TASKPUMP_PUMP_STATE_FILE=/dev/null "$dag_bin" --claims)" || rc=$?
    if (( rc != 0 )); then
        echo "WARN: ledger claim renderer failed (rc=$rc) — falling back to the manifest; a 'no live ledger claim' below means unchecked, not absent" >&2
        return 0
    fi
    [[ -n "$out" ]] && printf '%s\n' "$out"
    return 0
}

# ── claim_task_for <container-name> -- echo the task whose live ledger claim
#    is held by the branch this container name encodes (<prefix><branch slug>,
#    '/' → '-'). This is the CANONICAL mapping: it works for every consumer with
#    a ledger, needs no manifest, and tracks the agent as it moves through a
#    phase instead of freezing the launch-time assignment.
#
#    Three outcomes, three exit codes, because two of them are different facts
#    about the world and the caller reports them differently: 0 = mapped, 1 = no
#    claim for this container, 2 = a claim WAS found and its id was REFUSED.
#    Collapsing 2 into 1 is what made the sweep print "no live ledger claim …
#    maps this container to a task" over a claim it had just named on stderr.
claim_task_for() {
    local cname="$1"
    local prefix; prefix="$(apl_agent_prefix)"
    local branch task _rest
    while IFS=$'\t' read -r branch task _rest; do
        [[ -z "$branch" || -z "$task" ]] && continue
        if [[ "$prefix${branch//\//-}" == "$cname" ]]; then
            checked_task_id "$task" "live ledger claim held by branch '$branch'" \
                "Fix the task file's frontmatter (\`tp task fsck\` names it) and release the claim by hand." \
                || return 2
            echo "$task"; return 0
        fi
    done < <(ledger_claims)
    return 1
}

# ── manifest_task_for <container-name> -- echo the epic task id for a
#    running container. Opt-in fallback (see MANIFEST above): a manifest row is a
#    launch-time constant, so it is consulted only when the ledger has no live
#    claim for the branch. Compares each manifest branch transliterated to a slug
#    ('/' → '-') against <prefix><slug>. Same three exit codes as claim_task_for:
#    0 = mapped, 1 = no row, 2 = a row was found and its id was refused.
manifest_task_for() {
    local cname="$1"
    [[ -f "$MANIFEST" ]] || return 1
    local prefix; prefix="$(apl_agent_prefix)"
    while IFS=$'\t' read -r name branch _brief task _rest; do
        [[ "$name" =~ ^# ]] && continue
        [[ -z "$name"   ]] && continue
        local slug="${branch//\//-}"
        if [[ "$prefix$slug" == "$cname" ]]; then
            checked_task_id "$task" "manifest row for branch '$branch'" \
                "Fix that row in $MANIFEST and release the claim by hand." \
                || return 2
            echo "$task"; return 0
        fi
    done < "$MANIFEST"
    return 1
}

# ── worktree_for_container <container-name> -- echo the worktree path.
#    KNOWN LIMITATION (deferred): the slug→branch mapping is lossy. It converts
#    the FIRST '-' back into '/', which round-trips `feat/foo-bar` but not
#    `feature-x/y`. Correct for the one-slash branch convention the pump
#    generates; a branch with a '-' before its '/' would resolve to the wrong
#    worktree. Fixing it needs the branch carried alongside the name rather than
#    re-derived from it.
worktree_for_container() {
    local cname="$1"
    local slug="${cname#"$(apl_agent_prefix)"}"
    local branch="${slug/-//}"
    echo "$WORKTREES_DIR/$branch"
}

# ── list_agent_containers -- emit names of running agent containers.
list_agent_containers() { apl_live_agent_names; }

# ── log_age_min <path> -- echo the age of <path> in minutes, or "?" if missing.
log_age_min() {
    local f="$1"
    [[ -f "$f" ]] || { echo "?"; return; }
    local now mt
    now=$(date +%s)
    mt=$(stat -c '%Y' "$f" 2>/dev/null || stat -f '%m' "$f" 2>/dev/null || echo 0)
    echo $(( (now - mt) / 60 ))
}

# ── do_stuck -- find log-stale containers, snapshot their worktrees, stop
#    them, release their epic task claims.
do_stuck() {
    log "stuck-agent sweep (threshold=${STUCK_THRESHOLD_MIN}min, dry-run=$DRY_RUN)"
    local found=0
    local cname
    while IFS= read -r cname; do
        [[ -z "$cname" ]] && continue
        local wt; wt="$(worktree_for_container "$cname")"
        local logf="$wt/$AGENT_LOG_NAME"
        local age; age="$(log_age_min "$logf")"
        if [[ "$age" == "?" ]]; then
            log "  $cname: no log file at $logf (skip)"
            continue
        fi
        if (( age < STUCK_THRESHOLD_MIN )); then
            log "  $cname: log fresh (${age}min < ${STUCK_THRESHOLD_MIN}) — leave alone"
            continue
        fi
        found=$((found + 1))
        log "  $cname: STUCK (log idle ${age}min)"
        # 1) snapshot worktree progress
        if [[ -d "$wt/.git" || -f "$wt/.git" ]]; then
            act git -C "$wt" add -A
            act git -C "$wt" -c user.name=tp-cleanup -c user.email=cleanup@taskpump.local \
                commit -m 'wip: tp-cleanup pre-stop snapshot' --allow-empty
        fi
        # 2) stop the container
        act "$(apl_docker)" stop "--time=$DOCKER_GRACE_SEC" "$cname"
        # 3) release the task claim, if known. The ledger's live claim is the
        #    canonical mapping; the opt-in manifest is only a fallback, because
        #    its row is a launch-time constant that goes stale the moment the
        #    agent moves on to another task.
        #
        #    A REFUSED id is not a missing one, and gets its own line. A refused
        #    live claim also stops the search: a launch-time manifest row must
        #    not paper over the claim the ledger actually holds.
        local task="" refused="" rc=0
        task="$(claim_task_for "$cname")" || rc=$?
        if (( rc == 2 )); then
            refused="live ledger claim"
        elif [[ -z "$task" ]]; then
            rc=0
            task="$(manifest_task_for "$cname")" || rc=$?
            (( rc == 2 )) && refused="manifest row"
        fi
        if [[ -n "$task" ]]; then
            act "$TP_LIBEXEC_DIR/tp-task" release "$task" \
                --reason "tp-cleanup: stuck (log idle ${age}min)"
        elif [[ -n "$refused" ]]; then
            log "  $cname: the $refused for this container names an id this tool refuses to pass on (the WARN above says what is wrong); its task claim is NOT released — fix the id, then 'tp task release <id>'"
        else
            log "  $cname: no live ledger claim (and no manifest row) maps this container to a task; skipping the task release — check 'tp task list' and release it by hand"
        fi
    done < <(list_agent_containers)
    if (( found == 0 )); then
        log "no stuck agents found."
    else
        log "stuck-agent sweep: $found container(s) handled."
    fi
}

# ── busy_worktrees -- emit the .worktrees paths that currently host a live
#    prefix-named agent container (one per line). Used to skip a worktree whose
#    agent is mid-build, so reclaiming build output never yanks the rug from a
#    running session. Empty when docker is absent or no agents run.
busy_worktrees() {
    local cname
    while IFS= read -r cname; do
        [[ -z "$cname" ]] && continue
        worktree_for_container "$cname"
    done < <(list_agent_containers)
}

# ── busy_extra_key <dir> -- echo the extra-busy-list spelling(s) that name
#    <dir>, or return 1 when neither does. Both lists are searched: they are a
#    union (see BUSY_EXTRA_CANONICAL above), and when both name the same entry
#    the line says so rather than picking a winner.
busy_extra_key() {
    local dir="$1" keys=""
    [[ -n "$dir" ]] || return 1
    if [[ -n "$BUSY_EXTRA_CANONICAL" ]] && printf '%s\n' "$BUSY_EXTRA_CANONICAL" | grep -Fxq "$dir"; then
        keys="TASKPUMP_EXTRA_BUSY_DIRS"
    fi
    if [[ -n "$BUSY_EXTRA_LEGACY" ]] && printf '%s\n' "$BUSY_EXTRA_LEGACY" | grep -Fxq "$dir"; then
        [[ -n "$keys" ]] && keys="$keys + EXTRA_BUSY_DIRS" || keys="EXTRA_BUSY_DIRS"
    fi
    [[ -n "$keys" ]] || return 1
    printf '%s' "$keys"
}

# ── reclaim_workspace <dir> <label> -- run the consumer's reclaim command with
#    <dir> as the working directory.
#
#    Three outcomes: 0 = reclaimed, 1 = nothing to do here (RECLAIM_DIR is
#    configured and <dir> has no such directory), 2 = the command RAN and
#    FAILED. The third used to be folded into the first — a WARNING was logged
#    and 0 returned anyway — so the summary line counted the failure as a
#    reclaim and contradicted the warning immediately above it, and the
#    unattended PANIC sweep exited 0 having freed nothing. The old hardcoded
#    `rm -rf` essentially never failed; an arbitrary consumer command
#    (`npm run clean` with no package.json, an uninstalled toolchain) does.
#
#    This used to run `cargo clean` or `rm -rf <dir>/target` and never look at
#    TASKPUMP_RECLAIM_CMD's value at all — the key was a switch that armed a
#    hardcoded Rust sweep. So a consumer who set it to their project's actual
#    reclaim command got `rm -rf target/` instead, and a consumer whose build
#    output is anywhere else got a sweep that reported success having freed
#    nothing (B9). One key, one meaning, in both consumers: the pump's per-tick
#    pass already executed this value verbatim, and now so does the rescue.
#
#    The `eval` here is the only one left in this tool, and it is deliberate:
#    RECLAIM_CMD is a shell command line the OPERATOR wrote, in the same trust
#    domain as the shell running this script (lib/config.sh sources the whole
#    conf under `set -a` before this line is reached). Nothing read from the
#    ledger or from a directory name is ever evaluated — see act().
reclaim_workspace() {
    local dir="$1" label="$2"
    if [[ -n "$RECLAIM_DIR" ]]; then
        [[ -d "$dir/$RECLAIM_DIR" ]] || return 1
        local size; size="$(du -sh "$dir/$RECLAIM_DIR" 2>/dev/null | cut -f1)"
        log "  $label: $dir/$RECLAIM_DIR ($size)"
    else
        log "  $label: $dir"
    fi
    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf '  (dry-run) cd %q && %s\n' "$dir" "$RECLAIM_CMD"
        return 0
    fi
    printf '  $ cd %q && %s\n' "$dir" "$RECLAIM_CMD"
    if ( cd "$dir" && eval "$RECLAIM_CMD" ); then
        return 0
    fi
    log "  WARNING: TASKPUMP_RECLAIM_CMD failed in $dir — nothing was reclaimed there"
    return 2
}

# ── do_targets -- reclaim build output in every worktree (cheap to rebuild,
#    typically 2-6 GB each), SKIPPING any worktree that currently hosts a live
#    agent container so an in-flight build is never broken. With
#    --include-primary it also reclaims the primary checkout's own build output.
#    Runs only when a reclaim command is configured; see RECLAIM_CMD above.
#
#    Returns 3 when the reclaim command failed anywhere, so the caller that runs
#    this unattended — the disk watchdog's PANIC sweep — can tell "reclaimed"
#    from "tried and bought nothing".
do_targets() {
    if [[ -z "$RECLAIM_CMD" ]]; then
        log "build reclaim skipped: TASKPUMP_RECLAIM_CMD unconfigured — nothing touched (set it to your project's reclaim command, e.g. 'cargo clean')"
        return 0
    fi
    local probe="probe=$RECLAIM_DIR/"
    [[ -z "$RECLAIM_DIR" ]] && probe="probe=none"
    log "reclaiming build output ($probe, dry-run=$DRY_RUN, include-primary=$INCLUDE_PRIMARY)"
    local busy; busy="$(busy_worktrees)"
    local found=0 skipped=0 failed=0 rc=0
    local wt rel unsafe busy_key
    # DEFERRED (documented, not fixed): this glob is two levels deep while the
    # pump addresses a worktree as <base>/<branch-with-a-slash>. The two agree
    # only because the generated branches happen to contain exactly one slash;
    # a flat branch name would be invisible here.
    for wt in "$WORKTREES_DIR"/*/*; do
        [[ -d "$wt" ]] || continue
        # A directory name is attacker-chosen input: anyone who can create a
        # directory under the worktrees base — a tracked path in a hostile
        # repository, an agent with a bind-mounted checkout — picks these bytes.
        # act() no longer parses them as shell, but a name this stack cannot
        # carry has nothing to do here either, and a silent skip would be worse
        # than none (PI-D4).
        rel="${wt#"$WORKTREES_DIR"/}"
        if ! unsafe="$(apl_unsafe_name_reason 'worktree directory' "$rel" '/')"; then
            log "  skip: $wt — $unsafe"
            skipped=$((skipped + 1))
            continue
        fi
        if [[ -n "$RECLAIM_DIR" && ! -d "$wt/$RECLAIM_DIR" ]]; then
            continue
        fi
        if printf '%s\n' "$busy" | grep -Fxq "$wt"; then
            log "  skip: $wt — live agent container"
            skipped=$((skipped + 1))
            continue
        fi
        if busy_key="$(busy_extra_key "$wt")"; then
            log "  skip: $wt — busy ($busy_key)"
            skipped=$((skipped + 1))
            continue
        fi
        rc=0; reclaim_workspace "$wt" "worktree" || rc=$?
        case "$rc" in
            0) found=$((found + 1)) ;;
            2) failed=$((failed + 1)) ;;
        esac
    done
    if (( found == 0 && skipped == 0 && failed == 0 )); then
        # "Nothing to reclaim" is a finding, not a success: it is what a
        # consumer whose build output is not called `target/` sees on every
        # panic sweep while the disk fills (B9). Say what was looked for.
        if [[ -n "$RECLAIM_DIR" ]]; then
            log "nothing to reclaim: no workspace under $WORKTREES_DIR/*/* has a $RECLAIM_DIR/ (set TASKPUMP_RECLAIM_DIR to the directory your build writes, or empty to run TASKPUMP_RECLAIM_CMD in every idle workspace)"
        else
            log "nothing to reclaim: no workspace found under $WORKTREES_DIR/*/*"
        fi
    else
        # The failure count is part of the sentence, not a footnote: a summary
        # that reports a reclaim the WARNING two lines up says did not happen is
        # the shape of defect this whole change exists to remove.
        local tally="reclaimed $found worktree workspace(s); skipped $skipped."
        (( failed > 0 )) && tally="reclaimed $found worktree workspace(s); skipped $skipped; FAILED $failed (TASKPUMP_RECLAIM_CMD returned non-zero there; that space was not freed)."
        log "$tally"
    fi
    # The primary checkout's own build output — only when explicitly requested,
    # since a human may be building there. The watchdog passes --include-primary
    # under PANIC to buy the most space.
    if [[ -z "$RECLAIM_DIR" || -d "$REPO_ROOT/$RECLAIM_DIR" ]]; then
        if busy_key="$(busy_extra_key "$REPO_ROOT")"; then
            log "  skip: $REPO_ROOT — busy ($busy_key)"
        elif [[ "$INCLUDE_PRIMARY" -eq 1 ]]; then
            # With no probe configured there is no precondition left on this
            # arm: an empty TASKPUMP_RECLAIM_DIR means the command runs in the
            # primary checkout every time --include-primary is passed, and the
            # unattended PANIC sweep always passes it. Say so where it happens.
            [[ -z "$RECLAIM_DIR" ]] && \
                log "  (TASKPUMP_RECLAIM_DIR is empty, so there is no precondition on this arm: the command runs in the primary checkout unconditionally — list it in TASKPUMP_EXTRA_BUSY_DIRS to hold it back)"
            rc=0; reclaim_workspace "$REPO_ROOT" "primary" || rc=$?
            (( rc == 2 )) && failed=$((failed + 1))
        elif [[ -n "$RECLAIM_DIR" ]]; then
            local size; size="$(du -sh "$REPO_ROOT/$RECLAIM_DIR" 2>/dev/null | cut -f1)"
            log "primary checkout: $REPO_ROOT/$RECLAIM_DIR ($size) — left alone (pass --include-primary to reclaim)"
        else
            log "primary checkout: $REPO_ROOT — left alone (pass --include-primary to reclaim)"
        fi
    fi
    if (( failed > 0 )); then
        log "build reclaim FAILED in $failed workspace(s): TASKPUMP_RECLAIM_CMD returned non-zero — exit 3, and assume no space was bought"
        return 3
    fi
    return 0
}

# ── do_docker -- prune build cache + dangling containers/images. The
#    agent image itself is reused, not pruned.
do_docker() {
    log "docker prune (build cache + system) (dry-run=$DRY_RUN)"
    local docker_bin; docker_bin="$(apl_docker)"
    if ! command -v "$docker_bin" >/dev/null 2>&1; then
        log "$docker_bin not on PATH; skipping."
        return
    fi
    act "$docker_bin" builder prune -af
    act "$docker_bin" system prune -f
    log "docker prune complete."
}

# ── status -- read-only summary.
do_status() {
    log "tp-cleanup --status (read-only)"
    echo
    echo "## Agent containers"
    "$(apl_docker)" ps --format 'table {{.Names}}\t{{.Status}}\t{{.Size}}' 2>/dev/null \
        | grep -E "^NAMES|^$(apl_agent_prefix)" || echo "(none running)"
    echo
    echo "## Log-stale heuristic (threshold=${STUCK_THRESHOLD_MIN}min)"
    local cname
    while IFS= read -r cname; do
        [[ -z "$cname" ]] && continue
        local wt; wt="$(worktree_for_container "$cname")"
        local logf="$wt/$AGENT_LOG_NAME"
        local age; age="$(log_age_min "$logf")"
        printf "  %-40s  log_age=%s min\n" "$cname" "$age"
    done < <(list_agent_containers)
    echo
    if [[ -n "$RECLAIM_DIR" ]]; then
        echo "## Worktree $RECLAIM_DIR/ sizes"
        du -sh "$WORKTREES_DIR"/*/*/"$RECLAIM_DIR" 2>/dev/null | sort -h | tail -20 || echo "(none)"
    else
        echo "## Worktree sizes (TASKPUMP_RECLAIM_DIR is empty: whole workspaces)"
        du -sh "$WORKTREES_DIR"/*/* 2>/dev/null | sort -h | tail -20 || echo "(none)"
    fi
    echo
    echo "## Docker storage"
    "$(apl_docker)" system df 2>/dev/null || echo "(container runtime not available)"
}

# A failed reclaim has to survive to the exit status, --all included: the whole
# point of counting it is that the unattended caller can see it, and `do_stuck;
# do_targets; do_docker` would otherwise report the LAST command's status and
# lose it.
SWEEP_RC=0
case "$MODE" in
    status)   do_status ;;
    stuck)    do_stuck ;;
    targets)  do_targets || SWEEP_RC=$? ;;
    docker)   do_docker ;;
    all)      do_stuck; echo; { do_targets || SWEEP_RC=$?; }; echo; do_docker ;;
esac
exit "$SWEEP_RC"
