#!/bin/bash
# tp dag-render -- render the task DAG for a phase range as a layered ASCII
# graph, for the tp-monitor GRAPH tab.
#
# Nodes are boxes, one row of boxes per dependency layer, edges routed through
# horizontal rail bands between layers. Reads task frontmatter directly (the
# whole graph in one gawk pass) rather than shelling out to a YAML parser per
# task, so it is cheap enough to sit behind the monitor's normal cache TTL.
#
# Layout passes (v2 -- see docs/design/monitor-dag-v2.md):
#   layer()     longest-path layering over `blockers:`
#   dummies()   one trunk of dummy nodes per target with far blockers, so a
#               multi-layer edge is actually drawn instead of silently dropped
#   order()     median sweeps with a real crossing count, best permutation kept,
#               then adjacent-swap transposition
#   xassign()   priority-method x coordinates -- dummies outrank real nodes so
#               long edges stay straight columns; unrelated neighbours in a
#               layer get a wider gutter than siblings
#   channels()  greedy interval routing -- parents whose edge spans do not
#               overlap horizontally share one rail row, so a wide fan-out band
#               stays a few rows tall instead of one row per parent
#
# Requires GNU awk (gawk) and bash 4+. The layout uses and()/or() bit operations
# on the edge mask, which are gawk extensions: under mawk or BWK awk every edge
# junction would render wrong rather than failing loudly, so the interpreter is
# checked up front. See TASKPUMP_AWK below to point at a differently-named gawk.
#
# Usage:
#   tp dag-render                       # phases from the pump state file
#   tp dag-render --phases F79
#   tp dag-render --phases F55..F63
#   tp dag-render --running F79.4       # mark these as live (▶)
#   tp dag-render --cursor F79.5        # heavy border on one node
#   tp dag-render --index-file /tmp/i   # TSV node table for the monitor
#   tp dag-render --cols 200            # clip output to a viewport
#   tp dag-render --no-color            # for tests
#   tp dag-render --claims              # no picture: one row per branch holding
#       an in_progress claim, naming the single task an agent is actually on
#       (branch/task/turns/goal, tab separated). Shares this file's parser and
#       election with the canvas, so the monitor's two tabs cannot disagree
#       about which claim is live.
#
# Config (canonical TASKPUMP_* names; the legacy ARACHNE_* spelling of each is
# still honoured, and taskpump.conf sets either):
#   TASKPUMP_DAG_REPO_ROOT     repo the ledger is resolved against
#                              (default: $PWD's git worktree, else the install)
#   TASKPUMP_TASKS_DIR         the ledger itself (default: <root>/<subdir>)
#   TASKPUMP_TASKS_SUBDIR      ledger path within the repo
#                              (default: tasks)
#   TASKPUMP_TASK_EXT          task-file extension (default: .md)
#   TASKPUMP_PUMP_STATE_FILE   pump state, for the implicit phase range
#   TASKPUMP_PUMP_STATE_NAME   its filename (default: .taskpump-pump.state)
#   TASKPUMP_PHASE_SIGIL       letter a phase token starts with (default: T)
#   TASKPUMP_PHASE_SEPARATOR   what ends the phase within an id (default: .)
#   TASKPUMP_DAG_LAYOUT        the layout program (default: lib/dag-layout.awk)
#   TASKPUMP_AWK               the gawk binary (default: gawk)
set -euo pipefail

if (( ${BASH_VERSINFO[0]:-0} < 4 )); then
    echo "ERROR: tp-dag-render needs bash 4+ (found ${BASH_VERSION:-unknown})" >&2
    exit 1
fi

# ── TaskPump config core ──────────────────────────────────────────────────────
_tp_self_root="$(CDPATH='' cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/config.sh
. "$_tp_self_root/lib/config.sh"
tp_load_config

# The repo whose ledger this renders is a property of the CALLER's directory,
# not of which copy of the script is on PATH -- the same rule config.sh applies
# to config discovery, and the 2026-08-01 wrong-ledger lesson made structural.
# Outside a repo there is nothing to infer, so the install root stands in.
_tp_repo_default() {
    local top
    top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    [[ -n "$top" && -d "$top" ]] && { printf '%s' "$top"; return 0; }
    printf '%s' "$TP_ROOT"
}
REPO_ROOT="${TASKPUMP_DAG_REPO_ROOT:-$(_tp_repo_default)}"
TASKS_SUBDIR="${TASKPUMP_LEDGER_PROBE:-${TASKPUMP_TASKS_SUBDIR:-tasks}}"
TASKS_DIR="${TASKPUMP_TASKS_DIR:-$REPO_ROOT/$TASKS_SUBDIR}"
TASK_EXT="${TASKPUMP_TASK_EXT:-.md}"
PUMP_STATE_NAME="${TASKPUMP_PUMP_STATE_NAME:-.taskpump-pump.state}"
PUMP_STATE="${TASKPUMP_PUMP_STATE_FILE:-$REPO_ROOT/$PUMP_STATE_NAME}"
PHASE_SIGIL="${TASKPUMP_PHASE_SIGIL:-T}"
PHASE_SEP="${TASKPUMP_PHASE_SEPARATOR:-.}"
LAYOUT_AWK="${TASKPUMP_DAG_LAYOUT:-$TP_LIB_DIR/dag-layout.awk}"
AWK_BIN="${TASKPUMP_AWK:-gawk}"

PHASES=""; RUNNING=""; LIVEBRANCHES=""; COLOR=1; COMPACT=-1; PANX=0
CURSOR=""; INDEXFILE=""; COLS=0; MODE=""

print_help() { awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --phases)    PHASES="${2:-}"; shift ;;
        --phases=*)  PHASES="${1#--phases=}" ;;
        --running)   RUNNING="${2:-}"; shift ;;
        --running=*) RUNNING="${1#--running=}" ;;
        --live-branches)   LIVEBRANCHES="${2:-}"; shift ;;
        --live-branches=*) LIVEBRANCHES="${1#--live-branches=}" ;;
        --pan)       PANX="${2:-0}"; shift ;;
        --pan=*)     PANX="${1#--pan=}" ;;
        --cols)      COLS="${2:-0}"; shift ;;
        --cols=*)    COLS="${1#--cols=}" ;;
        --cursor)    CURSOR="${2:-}"; shift ;;
        --cursor=*)  CURSOR="${1#--cursor=}" ;;
        --index-file)   INDEXFILE="${2:-}"; shift ;;
        --index-file=*) INDEXFILE="${1#--index-file=}" ;;
        --claims)    MODE=claims ;;
        --no-color)  COLOR=0 ;;
        --compact)   COMPACT=1 ;;
        --full-ids)  COMPACT=0 ;;
        -h|--help)   print_help; exit 0 ;;
        *)           echo "ERROR: unknown arg '$1'" >&2; exit 1 ;;
    esac
    shift
done

# Phase range: explicit flag > the live pump's range > every phase present.
if [[ -z "$PHASES" && -f "$PUMP_STATE" ]]; then
    PHASES="$(jq -r '.phases // ""' "$PUMP_STATE" 2>/dev/null || echo '')"
fi

[[ -d "$TASKS_DIR" ]] || { echo "(no tasks dir: $TASKS_DIR)"; exit 0; }

shopt -s nullglob
files=("$TASKS_DIR"/*"$TASK_EXT")
(( ${#files[@]} )) || { echo "(no tasks found)"; exit 0; }

# The layout's edge-junction glyphs come from and()/or() on a direction bitmask.
# mawk and BWK awk do not have them, and would mis-render every join rather than
# stopping -- so say which dependency is missing, by name, before drawing.
command -v "$AWK_BIN" >/dev/null 2>&1 \
    || { echo "ERROR: $AWK_BIN not found — tp dag-render needs GNU awk (gawk); set TASKPUMP_AWK to override" >&2; exit 1; }
"$AWK_BIN" 'BEGIN { exit (and(3, 1) == 1) ? 0 : 1 }' </dev/null >/dev/null 2>&1 \
    || { echo "ERROR: $AWK_BIN is not GNU awk (gawk) — the DAG layout needs its and()/or() bit operations" >&2; exit 1; }

"$AWK_BIN" -v phases="$PHASES" -v running="$RUNNING" -v livebranches="$LIVEBRANCHES" \
     -v color="$COLOR" -v compact="$COMPACT" -v panx="$PANX" \
     -v cursor="$CURSOR" -v indexfile="$INDEXFILE" -v cols="$COLS" -v mode="$MODE" \
     -v sigil="$PHASE_SIGIL" -v phasesep="$PHASE_SEP" \
     -f "$LAYOUT_AWK" "${files[@]}"
