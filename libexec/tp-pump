#!/usr/bin/env bash
# tp-pump — usage-governed, DAG-aware, keep-acquiring task-loop supervisor.
#
# A singular HOST-level loop (so there is no cross-agent claim race) that points
# a sandboxed-agent substrate at a RANGE of phases and drains it for days:
#
#   * Queue = the live eligible frontier, recomputed every tick from `blockers:`
#     via `tp task ready --phases A..B`. Newly-unblocked tasks enter
#     automatically — this is "keep acquiring".
#   * Dispatch grain = phase: each phase with eligible work gets a worktree that
#     drains its own sub-tree serially via the in-context `tp task next --phase`
#     loop; phases fan out in parallel.
#   * Liveness from the container runtime, never task status: a parked epic
#     (in_progress, dead container) auto-resumes; a live one is never
#     double-launched.
#   * Feed gate: pause LAUNCHING new work — running agents are never killed —
#     when any gate in TASKPUMP_GATES says so. The default chain is network
#     health, host token freshness, the plan's usage ceiling, and free disk.
#     Feeding resumes by itself when the gate clears.
#   * Disk discipline: a completed phase's worktree build dir is reclaimed each
#     tick once its container has exited, so a multi-day drain's disk footprint
#     stays bounded (TASKPUMP_DISK_RECLAIM=0 disables).
#   * Drains: exits only when no open task remains in range AND no live agent
#     container remains, then pushes the ledger and emits a summary.
#
# Usage:
#   tp pump --phases F55..F63 --jobs 4 --usage-ceiling 95 --grain phase
#   tp pump --phases F55..F63 --dry-run     # print the plan, launch nothing
#   tp pump --phases F64 --list             # one planning pass, then exit
#   tp pump --phases F64 --once             # one REAL tick (scrub+gate+launch), exit
#
# Monitor handoff:
#   With --detach, the supervisor goes to systemd and this terminal is then
#   handed to the monitor — quitting it (q) leaves the pump running.
#   --no-monitor (or TASKPUMP_PUMP_MONITOR=0) keeps your shell; a non-tty skips
#   it automatically.
# HELP-END
#
# Stalled-claim auto-resume (on by default):
#   A phase whose only blocker is its OWN orphaned claim — dead container, work
#   already committed, so the reclaim path refuses to reopen it — is relaunched
#   to CONTINUE that task, with a resume note pointing the agent at it. Bounded
#   by --resume-max no-progress attempts (a new commit resets the count); when
#   spent, the task is marked needs-review and the pump notifies. When nothing
#   is live, launchable, or resumable, the pump exits 3 instead of idling.
#   --resume-max N          attempts before escalating to a human (default 3)
#   --no-resume-stalled     disable; revert to parking orphans for review
#
# Configuration lives in taskpump.conf (see taskpump.conf.example for the full
# key surface) or the environment; the configuration block below names every key
# this tool reads, with the default each one falls back to. The legacy ARACHNE_*
# spellings still arrive here through lib/config.sh.
set -euo pipefail

# ── TaskPump config core ──────────────────────────────────────────────────────
_tp_self_root="$(CDPATH= cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/config.sh
. "$_tp_self_root/lib/config.sh"
tp_load_config

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=../lib/pump-lib.sh
source "$TP_LIB_DIR/pump-lib.sh"

# ── Configuration ─────────────────────────────────────────────────────────────
# Every value here has a default that reproduces what the pump did before any of
# it was configurable, so a project with no taskpump.conf sees no change. Where a
# key exists in both a shared and a pump-scoped spelling, the pump-scoped one
# wins: TASKPUMP_TASKS_DIR is what every tool reads, TASKPUMP_PUMP_TASKS_DIR
# points this supervisor somewhere else. The legacy ARACHNE_* names still arrive
# here through the config core.

# The agent's home and config on the host. Mounted read-only into a launched
# container, and the credentials file the token gate reads.
CLAUDE_DIR="${TASKPUMP_AGENT_HOME:-$HOME/.claude}"
CLAUDE_JSON="${TASKPUMP_AGENT_CONFIG:-$HOME/.claude.json}"

# The ledger: a git checkout the pump pulls at the top of every tick and pushes
# when the range drains, holding the task files.
OPS_DIR="${TASKPUMP_PUMP_OPS_DIR:-${TASKPUMP_LEDGER_REPO:-$REPO_ROOT/ops}}"
# Tasks dir — overridable independently of OPS_DIR so phase_dependencies / brief
# rendering can be unit-tested against a flat fixture dir.
TASKS_DIR="${TASKPUMP_PUMP_TASKS_DIR:-${TASKPUMP_TASKS_DIR:-$OPS_DIR/task-loop/tasks}}"
# The file that tells us a submodule ledger has actually been checked out. Any
# path inside the ledger that only exists once `submodule update` has run.
SUBMODULE_PROBE="${TASKPUMP_SUBMODULE_PROBE:-ops/planning/STATUS.md}"

# Sibling tools.
TASK_BIN="${TASKPUMP_TASK:-$TP_LIBEXEC_DIR/tp-task}"
USAGE_BIN="${TASKPUMP_USAGE:-$TP_GATES_DIR/claude-usage}"
DISK_WATCHDOG_BIN="${TASKPUMP_DISK_WATCHDOG:-$TP_LIBEXEC_DIR/tp-disk-watchdog}"
MONITOR_BIN="${TASKPUMP_MONITOR_BIN:-$TP_LIBEXEC_DIR/tp-monitor}"

# The agent runner. The pump decides WHAT to launch and WHERE; the runner owns
# HOW — the sandbox, the mounts, the credentials. See runners/claude-docker.
RUNNER="${TASKPUMP_RUNNER:-$TP_ROOT/runners/claude-docker/runner.sh}"
DOCKER="${TASKPUMP_DOCKER:-${DOCKER:-docker}}"
# No default image on purpose (G1.5): a wrong-but-plausible default launches the
# wrong agent silently, so a real run fails loudly below when this is empty.
# --dry-run and NO_LAUNCH ticks never launch and keep working imageless.
IMAGE="${TASKPUMP_IMAGE:-}"
# The default names the shipped claude-docker runner's own entrypoint at the
# path the image contract bakes it (docs/RUNNERS.md §4.0). Arachne's image
# layout (/entrypoint-parallel.sh) survives as the examples/arachne.conf pin.
ENTRYPOINT="${TASKPUMP_ENTRYPOINT:-/entrypoint.sh}"
# Building the agent image once before the drain. Unset ⇒ the default docker
# build of the repo root; set to the empty string ⇒ skip it entirely, which is
# what a runner that pulls a prebuilt image wants. (Building really belongs to
# the runner; moving it there is a second round of the launch seam.)
if [[ -n "${TASKPUMP_IMAGE_BUILD+set}" ]]; then
  IMAGE_BUILD_CMD="$TASKPUMP_IMAGE_BUILD"
else
  IMAGE_BUILD_CMD="\"$DOCKER\" build -t \"$IMAGE\" \"$REPO_ROOT\""
fi

# Worktrees base — overridable so the reclaim sweep / launcher can be unit-tested
# against a fixture tree (single source for both launch_phase and reclaim).
WORKTREES_DIR="${TASKPUMP_PUMP_WORKTREES_DIR:-${TASKPUMP_WORKTREES_DIR:-$REPO_ROOT/.worktrees}}"

# What the templates say about this project. The defaults reproduce Arachne's
# wording exactly, so a rendered brief or resume note is unchanged for it.
#   TASKPUMP_TASK_CLI     how an agent invokes the ledger CLI from its worktree
#   TASKPUMP_VERIFY_CMDS  newline-separated commands a task must leave green;
#                         rendered mid-sentence as `a` and `b`
#   TASKPUMP_PROJECT_BRIEF  one paragraph pointing an agent at the project's own
#                         contributor documentation
TASK_CLI="${TASKPUMP_TASK_CLI:-scripts/arachne-task}"
TASK_CLI_NAME="$(basename "$TASK_CLI")"
# Built outside the expansions: an apostrophe inside a ${x:-word} default is a
# real quote to bash, and would swallow the rest of the file.
_tp_default_verify=$'cargo fmt --all\ncargo clippy --workspace -- -D warnings'
_tp_default_project_brief="Read the contributor documentation for this repository (CLAUDE.md, CONTRIBUTING.md, or equivalent) before writing code, then read the design note that phase {{PHASE}} is built against."
VERIFY_CMDS="${TASKPUMP_VERIFY_CMDS:-$_tp_default_verify}"
PROJECT_BRIEF="${TASKPUMP_PROJECT_BRIEF:-$_tp_default_project_brief}"

# Where the run's dotfiles live. One knob moves them all out of the repo root;
# each filename is still individually overridable.
STATE_DIR="${TASKPUMP_STATE_DIR:-$REPO_ROOT}"
AGENT_LOG_NAME="${TASKPUMP_AGENT_LOG_NAME:-.taskpump-agent.log}"
BRIEF_OUT_NAME="${TASKPUMP_BRIEF_OUT_NAME:-.taskpump-phase-brief.md}"
RESUME_NOTE_NAME="${TASKPUMP_RESUME_NOTE_NAME:-.taskpump-resume.md}"
# Written inside the container rather than here, but named here so one place
# owns every filename the run drops into a worktree.
GOAL_NOTE_NAME="${TASKPUMP_GOAL_NOTE_NAME:-.taskpump-goal.md}"
# Fingerprint of the last pre-tick hook output, so a persistent condition is
# notified once rather than every tick. Survives a supervisor restart.
HOOK_MARK_FILE="${TASKPUMP_HOOK_MARK_FILE:-${TASKPUMP_FSGUARD_MARK_FILE:-$STATE_DIR/.taskpump-fsguard.notified}}"
DISK_WATCHDOG_LOG="${TASKPUMP_DISK_WATCHDOG_LOG:-$STATE_DIR/.taskpump-disk-watchdog.log}"

# Defaults (flags override).
PHASES=""
# The supervisor's own default cap. Callers that set nothing at all fall back to
# pump-lib's TASKPUMP_JOBS_FALLBACK instead; see the note there.
JOBS="${TASKPUMP_JOBS:-${JOBS:-4}}"
CEILING="${TASKPUMP_USAGE_CEILING:-95}"
GRAIN="phase"
TICK="${TASKPUMP_TICK:-${POOL_TICK:-30}}"
STAGGER="${TASKPUMP_STAGGER:-${POOL_STAGGER:-3}}"
HEALTH_WINDOW="${TASKPUMP_HEALTH_WINDOW:-${HEALTH_WINDOW:-120}}"
HEALTH_GATE=1
USAGE_GATE=1
DISK_GATE=1
BRANCH_PREFIX="${TASKPUMP_PUMP_BRANCH_PREFIX:-${TASKPUMP_BRANCH_PREFIX:-feat/}}"
BASE_REF="${TASKPUMP_PUMP_BASE:-${TASKPUMP_BASE:-main}}"
BASE_GIVEN=0      # set when --base is passed explicitly (gates the trunk override)
# ── Autonomous integration trunk (A3 / F65.6) ────────────────────────────────
# Opt-in behind --integration-trunk (default OFF): when on, the run cuts every
# phase worktree from a continuously-integrated auto/trunk branch instead of a
# stale base, merges each quiescent phase into it behind a build gate, and
# graduates the whole drain as one auto/trunk → main PR. Flag off ⇒ byte-for-byte
# the prior pump.
INTEGRATION=0
INTEGRATION_TRUNK="${TASKPUMP_PUMP_TRUNK:-${TASKPUMP_TRUNK:-auto/trunk}}"
INTEGRATION_BASE="${TASKPUMP_PUMP_INTEGRATION_BASE:-${TASKPUMP_INTEGRATION:-main}}"
# Build gate run on each merge into the trunk (empty ⇒ default cargo check +
# smoke). Overridable for tests (TASKPUMP_BUILD_GATE='false' forces red).
BUILD_GATE_CMD="${TASKPUMP_PUMP_BUILD_CMD:-${TASKPUMP_BUILD_GATE:-}}"
TRUNK_LOCK_FILE="${TASKPUMP_PUMP_TRUNK_LOCK_FILE:-$STATE_DIR/.auto-trunk.lock}"
QUARANTINE_FILE="${TASKPUMP_PUMP_QUARANTINE_FILE:-$STATE_DIR/.auto-trunk-quarantine}"
# Reclaim of a finished phase's build artifacts. Empty ⇒ the default cargo
# clean / rm -rf of <worktree>/target; a configured command is run with the
# worktree as $1 and its cwd.
RECLAIM_CMD="${TASKPUMP_RECLAIM_CMD:-}"
MAX_TURNS="${TASKPUMP_MAX_TURNS:-${MAX_TURNS:-600}}"
AGENT_MODEL="${TASKPUMP_AGENT_MODEL:-${AGENT_MODEL:-opus}}"
# ── Stalled-claim auto-resume (2026-08-05) ───────────────────────────────────
# A phase starved solely by its own orphaned-but-committed claim is relaunched
# to *continue* that task, bounded by RESUME_MAX no-progress attempts. Default
# ON: the behaviour it replaces is a permanent, silent idle loop.
RESUME_STALLED=1
RESUME_MAX="${TASKPUMP_PUMP_RESUME_MAX:-${TASKPUMP_RESUME_MAX:-3}}"
# Consecutive fully-deadlocked ticks before the pump gives up and pages a human.
# >1 so a container dying mid-tick cannot trip it.
STALL_EXIT_TICKS="${TASKPUMP_PUMP_STALL_EXIT_TICKS:-${TASKPUMP_STALL_EXIT_TICKS:-3}}"
STALL_TICKS=0
RESUME_TASK_ID=""
LAST_PARKED_FP=""
CAP_FILE="${TASKPUMP_POOL_CAP_FILE:-$STATE_DIR/.taskpump-pool-cap}"
RESET_FILE="${TASKPUMP_USAGE_RESET_FILE:-$STATE_DIR/.taskpump-usage-reset}"
MODE="run"        # run | dry | list | once | render | resume-note | help
DETACH=0
# After --detach hands the supervisor to systemd, the launching terminal is free
# — and watching the monitor is what you almost always want next, so take it
# over by default. TASKPUMP_PUMP_MONITOR=0 or --no-monitor opts out; a non-tty
# (cron, CI, a nested pump re-exec) opts out automatically.
MONITOR="${TASKPUMP_PUMP_MONITOR:-1}"
STATE_FILE="${TASKPUMP_PUMP_STATE_FILE:-$STATE_DIR/${TASKPUMP_PUMP_STATE_NAME:-.taskpump-pump.state}}"
PUMP_LOG="${TASKPUMP_PUMP_LOG:-$STATE_DIR/.taskpump-pump.log}"
PUMP_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Name this supervisor answers to as itself: the diagnostic prefix, the plan
# header, the notify-send title, and the transient systemd unit. Pump-scoped
# sibling of tp-task's TASKPUMP_PROG_NAME — the two tools identify themselves
# differently, so they cannot share one key. The reference consumer pins the
# historical `arachne-pump` in examples/arachne.conf.
PROG_NAME="${TASKPUMP_PUMP_PROG_NAME:-tp-pump}"

warn() { printf '%s: %s\n' "$PROG_NAME" "$*" >&2; }
die()  { warn "$*"; exit 1; }
log()  { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }
# Quiet per-tick skip traces (e.g. "already integrated") — off unless
# TASKPUMP_PUMP_DEBUG=1, so reconcile doesn't spam the log every TICK seconds.
dbg_log() { [[ "${TASKPUMP_PUMP_DEBUG:-0}" -eq 1 ]] && log "$*"; return 0; }

# Keep the verbatim argv so --detach can re-exec the same command minus --detach.
ORIG_ARGS=("$@")

# ── Arg parsing ────────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --phases|--phase) PHASES="$2"; shift 2;;
    --phases=*) PHASES="${1#--phases=}"; shift;;
    --phase=*)  PHASES="${1#--phase=}"; shift;;
    --jobs|-j)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--jobs needs a non-negative integer"
      JOBS="$2"; shift 2;;
    --usage-ceiling)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--usage-ceiling needs an integer"
      CEILING="$2"; shift 2;;
    --usage-ceiling=*) CEILING="${1#--usage-ceiling=}"; shift;;
    --grain) GRAIN="$2"; shift 2;;
    --grain=*) GRAIN="${1#--grain=}"; shift;;
    --tick)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--tick needs an integer (seconds)"
      TICK="$2"; shift 2;;
    --branch-prefix) BRANCH_PREFIX="$2"; shift 2;;
    --base) BASE_REF="$2"; BASE_GIVEN=1; shift 2;;
    --integration-trunk) INTEGRATION=1; shift;;
    --integration-base) INTEGRATION_BASE="$2"; shift 2;;
    --integration-base=*) INTEGRATION_BASE="${1#--integration-base=}"; shift;;
    --resume-max)
      [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || die "--resume-max needs a positive integer"
      RESUME_MAX="$2"; shift 2;;
    --resume-max=*) RESUME_MAX="${1#--resume-max=}"; shift;;
    --no-resume-stalled) RESUME_STALLED=0; shift;;
    --no-health-gate) HEALTH_GATE=0; shift;;
    --no-usage-gate)  USAGE_GATE=0; shift;;
    --no-disk-gate)   DISK_GATE=0; shift;;
    --dry-run) MODE="dry"; shift;;
    --list)    MODE="list"; shift;;
    --once)    MODE="once"; shift;;
    --render-brief) MODE="render"; PHASES="$2"; shift 2;;   # print rendered brief, exit
    --render-brief=*) MODE="render"; PHASES="${1#--render-brief=}"; shift;;
    --render-resume-note) MODE="resume-note"; PHASES="$2"; shift 2;;   # print resume preamble, exit
    --render-resume-note=*) MODE="resume-note"; PHASES="${1#--render-resume-note=}"; shift;;
    --detach)  DETACH=1; shift;;          # F64.5 wires the actual detach mechanism
    --no-monitor) MONITOR=0; shift;;      # don't hand the terminal to arachne-monitor
    -h|--help) MODE="help"; shift;;
    --*) die "unknown flag $1 (try --help)";;
    *) die "unexpected argument: $1";;
  esac
done

usage() { apl_help "$0"; }
[[ "$MODE" == "help" ]] && { usage; exit 0; }

[[ -n "$PHASES" ]] || die "--phases is required (e.g. --phases F55..F63)"
case "$GRAIN" in
  phase) ;;
  task|chain) die "grain '$GRAIN' is not implemented yet; only --grain phase is supported (SPEC_GAP: D4 task/chain grains deferred)";;
  *) die "unknown grain '$GRAIN' (phase|task|chain)";;
esac

# When integration is on and the operator did not pin a base, cut worktrees from
# the continuously-integrated trunk rather than the (stale) base branch. An
# explicit --base always wins (e.g. a canary cutting from a throwaway base).
if [[ "$INTEGRATION" -eq 1 && "$BASE_GIVEN" -eq 0 ]]; then
  BASE_REF="$INTEGRATION_TRUNK"
fi

# ── Phase-range expansion (mirrors arachne-task's expand_phases for display) ───
# Numeric ranges + comma lists; non-numeric tokens pass through uppercased.
# Honors TASKPUMP_PHASE_SIGIL exactly as arachne-task does: with sigil G,
# "G55", "g55" and "55" all canonicalize to "G55".
: "${TASKPUMP_PHASE_SIGIL:=T}"

# Drop a leading sigil from a phase token, case-insensitively (tp-task's
# strip_phase_sigil, mirrored here because tp-task is an executable, not a lib).
pump_strip_phase_sigil() {
  local value=$1 sigil=$TASKPUMP_PHASE_SIGIL
  if [[ -n "$sigil" && "${value,,}" == "${sigil,,}"* ]]; then
    value=${value:${#sigil}}
  fi
  printf '%s' "$value"
}

pump_expand_phases() {
  local spec=$1 comp a b lo hi i n sigil=$TASKPUMP_PHASE_SIGIL
  local IFS=','
  for comp in $spec; do
    comp="${comp//[[:space:]]/}"; [[ -z "$comp" ]] && continue
    if [[ "$comp" == *..* ]]; then
      a="${comp%%..*}"; b="${comp##*..}"
      a=$(pump_strip_phase_sigil "$a"); b=$(pump_strip_phase_sigil "$b")
      [[ "$a" =~ ^[0-9]+$ && "$b" =~ ^[0-9]+$ ]] \
        || die "bad phase range '$comp' (expected ${sigil}N..${sigil}M)"
      if (( a <= b )); then lo=$a; hi=$b; else lo=$b; hi=$a; fi
      for (( i=lo; i<=hi; i++ )); do printf '%s%s\n' "$sigil" "$i"; done
    else
      comp="${comp%%.*}"; n=$(pump_strip_phase_sigil "$comp")
      if [[ "$n" =~ ^[0-9]+$ ]]; then printf '%s%s\n' "$sigil" "$n"; else printf '%s\n' "${comp^^}"; fi
    fi
  done
}

# Validate the spec once, up front, in the MAIN shell. Every consumer below
# reads this function through a process substitution, where `die` kills only
# the subshell — a malformed range would be reported and then ignored, leaving
# the pump to plan (and idle green) against an empty phase list.
pump_expand_phases "$PHASES" >/dev/null

# The tasks dir as an agent inside the worktree would name it. Absolute when the
# ledger sits outside the code repo, which is also how an agent would reach it.
tasks_dir_rel() {
  case "$TASKS_DIR" in
    "$REPO_ROOT"/*) printf '%s' "${TASKS_DIR#"$REPO_ROOT"/}" ;;
    *)              printf '%s' "$TASKS_DIR" ;;
  esac
}

phase_branch()    { printf '%s%s' "$BRANCH_PREFIX" "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"; }
branch_slug()     { printf '%s' "${1//\//-}"; }
phase_container() { printf '%s%s' "$(apl_agent_prefix)" "$(branch_slug "$(phase_branch "$1")")"; }
# Host worktree the integration trunk is checked out into (A3): auto/trunk →
# <worktrees>/auto-trunk, sharing the configurable worktrees base with phases.
trunk_worktree()  { printf '%s/%s' "$WORKTREES_DIR" "$(branch_slug "$INTEGRATION_TRUNK")"; }
# pump_in_list <needle> <space-separated-haystack> — membership test for the
# dry-run integration stubs (STUB_INTEGRATE_*).
pump_in_list() {
  local needle="$1" item
  for item in ${2:-}; do [[ "$item" == "$needle" ]] && return 0; done
  return 1
}

# Distinct phases present in the live eligible frontier (have ≥1 launchable task).
frontier_phases() {
  "$TASK_BIN" ready --phases "$PHASES" --json 2>/dev/null \
    | jq -r '.[].phase' 2>/dev/null | sort -u
}

# Open-task count across the range (the drain test). 0 ⇒ no open work remains.
open_count() {
  "$TASK_BIN" ready --phases "$PHASES" --count 2>/dev/null || echo 0
}

# Open-task count within a single phase (regardless of blocker state).
phase_open_count() {
  "$TASK_BIN" ready --phase "$1" --count 2>/dev/null || echo 0
}

# Is a phase's worktree branch currently owned by a LIVE container? (D3)
phase_live() {
  local want; want="$(phase_container "$1")"
  local name
  while IFS= read -r name; do
    [[ "$name" == "$want" ]] && return 0
  done < <(apl_live_agent_names)
  return 1
}

# Lowest eligible task id in a phase (the epic/safety-net task for the container).
phase_lead_task() {
  "$TASK_BIN" ready --phase "$1" --json 2>/dev/null | jq -r '.[0].id // empty' 2>/dev/null
}

# ── Liveness-based reclaim (D3 applied to the eligibility path) ─────────────────
# A task left `in_progress` by a DEAD container (no live `arachne-agent` for its
# claimed branch) silently starves the frontier: `ready` excludes claimed tasks,
# so the phase's lead task — and everything blocked behind it — becomes ineligible
# and the pump can neither launch nor drain. (Root cause of the 2026-06-23 F43..F63
# stall: agents 401'd on an expired token and died; the entrypoint's safety-net
# `claim --turns 9999` meant scrub's turn-budget tripwire never reclaimed them.)
#
# D3 says liveness comes from `docker ps`, never task status. The launch path
# already honors this; this closes the gap on the *reclaim* path. Each tick, for
# every in_progress task claimed by a branch THIS pump owns (claimed_by ==
# phase_branch of the task's phase) whose container is dead:
#   * 0 commits ahead of base → `release` to `open` (clean, safe re-attempt).
#   * commits ahead          → leave parked, warn (a human/PR decision; the pump
#                              never auto-loops over committed work).
# The branch/worktree is never touched, so a released task resumes its prior work.
reclaim_orphaned_claims() {
  local -A live=()
  local s; while IFS= read -r s; do [[ -n "$s" ]] && live["$s"]=1; done < <(apl_live_agent_slugs)
  local reclaimed=0 parked=0 id status branch _rest parked_ids=""
  while read -r id status branch _rest; do
    [[ "$id" == "ID" || "$status" != "in_progress" ]] && continue
    [[ -z "$branch" || "$branch" == "-" ]] && continue
    # Only touch claims on a branch this pump's naming scheme owns; skip human
    # branches and any other claimant.
    local phase="${id%%.*}"
    [[ "$branch" == "$(phase_branch "$phase")" ]] || continue
    # Live container for this branch ⇒ a legitimate, in-flight claim. Leave it.
    [[ -n "${live["$(branch_slug "$branch")"]:-}" ]] && continue
    # Orphaned claim. Preserve committed work; only auto-reopen clean orphans.
    local ahead; ahead="$(git -C "$REPO_ROOT" rev-list --count "$BASE_REF..$branch" 2>/dev/null || echo 0)"
    if [[ "$ahead" -gt 0 ]]; then
      parked_ids+="$id:$ahead "
      parked=$((parked + 1))
      continue
    fi
    if "$TASK_BIN" release "$id" \
        --reason "Auto-reclaimed by pump: container for $branch is dead and the branch has 0 commits (D3 liveness reclaim)." \
        >/dev/null 2>&1; then
      log "reclaimed orphaned claim $id ($branch — container dead, 0 commits) → open"
      reclaimed=$((reclaimed + 1))
    fi
  done < <("$TASK_BIN" list --status in_progress 2>/dev/null)
  [[ "$reclaimed" -gt 0 ]] && log "liveness reclaim: $reclaimed task(s) released to open"
  # Report parked orphans only when the SET changes. This used to warn twice per
  # tick unconditionally: one 2026-08-05 F79 stall produced 563 identical pairs
  # over 7h, which buries every other line in the journal and trains the operator
  # to ignore the log. The resume path below now clears most of these anyway;
  # what survives (resume disabled or budget spent) is genuinely worth one line.
  if [[ "$parked_ids" != "$LAST_PARKED_FP" ]]; then
    if [[ "$parked" -gt 0 ]]; then
      warn "liveness reclaim: $parked orphaned claim(s) with committed work parked for review: ${parked_ids% }"
      [[ "$RESUME_STALLED" -eq 1 ]] \
        || warn "  (auto-resume disabled via --no-resume-stalled; these will not be picked up)"
    fi
    LAST_PARKED_FP="$parked_ids"
  fi
  return 0
}

# ── Stalled-claim detection (2026-08-05) ───────────────────────────────────────
# The gap reclaim_orphaned_claims deliberately leaves open. It refuses to reopen
# an orphan with committed work — right instinct, since blindly reopening would
# make a fresh agent redo landed work — but it then has no exit: `ready` only
# surfaces `status: open`, so the claim is invisible to the frontier, everything
# blocked behind it is ineligible, `compute_plan` files the phase under WAITING,
# and `is_drained` never fires because open_count > 0. The pump idles forever.
#
# So instead of reopening (fresh start, loses context) we *resume*: keep the
# claim and relaunch a container on the same branch and worktree, with a note
# telling the agent to continue that specific task. The prior work is right there
# in git; nothing is redone.
#
# Ownership rules are inherited from reclaim_orphaned_claims: only branches this
# pump's naming scheme owns, never a human's. `in_progress` carries its claimant
# in claimed_by; `scrub` NULLs claimed_by when it parks a task, so needs-review /
# stuck ownership is inferred from the phase branch — the same inference the
# reclaim path already makes. Both are included because a stalled claim reaches
# needs-review on its own: with last_heartbeat_ts null, scrub falls back to
# claimed_at and trips the 24h staleness tripwire.
declare -A STALL_TASK STALL_STATUS ESCALATED
detect_stalled_orphans() {
  STALL_TASK=(); STALL_STATUS=()
  [[ "$RESUME_STALLED" -eq 1 ]] || return 0
  local -A live=()
  local s; while IFS= read -r s; do [[ -n "$s" ]] && live["$s"]=1; done < <(apl_live_agent_slugs)
  local id status branch _rest phase pbranch ahead
  while read -r id status branch _rest; do
    [[ "$id" == "ID" ]] && continue
    case "$status" in in_progress|needs-review|stuck) : ;; *) continue;; esac
    phase="${id%%.*}"
    pbranch="$(phase_branch "$phase")"
    # Already handed to a human this run. Without this the phase would re-enter
    # PLAN_RESUME every tick, re-run resume-attempt (which returns `escalate`
    # forever once the budget is spent), and re-notify every 30s. Dropping it
    # here is also what lets the deadlock detector below accumulate and exit.
    [[ -n "${ESCALATED[$phase]:-}" ]] && continue
    # First (lowest) match per phase wins; one container drains one phase.
    [[ -n "${STALL_TASK[$phase]:-}" ]] && continue
    [[ "$status" == "in_progress" && "$branch" != "$pbranch" ]] && continue
    [[ -n "${live["$(branch_slug "$pbranch")"]:-}" ]] && continue
    git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$pbranch" >/dev/null 2>&1 || continue
    ahead="$(git -C "$REPO_ROOT" rev-list --count "$BASE_REF..$pbranch" 2>/dev/null || echo 0)"
    [[ "$ahead" -gt 0 ]] || continue
    STALL_TASK["$phase"]="$id"
    STALL_STATUS["$phase"]="$status"
  done < <("$TASK_BIN" list 2>/dev/null)
  return 0
}

# ── Feed gate ──────────────────────────────────────────────────────────────────
# A gate answers one question before the pump launches anything: is it a good
# idea to start MORE work right now? It never stops work already running.
#
# The chain is an ordered list of command lines, one per line. Each is run with
# stdout and stderr captured together (the tools that predate this contract
# write their reason to stderr) and judged by exit status:
#
#   0    feed OK
#   10   pause launching; its output is the reason the operator sees
#   else a broken gate — warn and FEED ANYWAY
#
# That last rule is deliberate: a gate that cannot reach its meter must never
# silently halt a multi-day drain. Every gate shipped here fails open too.
#
# The default chain is exactly what was hardcoded before — network health, host
# token freshness, the usage ceiling, free disk — with the three --no-*-gate
# flags dropping their entry. A configured TASKPUMP_GATES replaces the whole
# chain and is used verbatim; the flags still export their disable switches, so
# a gate that honors them keeps working either way.
default_gates() {
  [[ "$HEALTH_GATE" -eq 1 ]] && printf '%s\n' "$TP_GATES_DIR/net-health"
  printf '%s\n' "$TP_GATES_DIR/claude-token-fresh"
  [[ "$USAGE_GATE" -eq 1 ]] && printf '%s\n' "$USAGE_BIN --gate"
  [[ "$DISK_GATE"  -eq 1 ]] && printf '%s\n' "$TP_GATES_DIR/disk-low"
  return 0
}

# Everything a gate might need, since a gate is a separate process.
export_gate_env() {
  export TASKPUMP_HEALTH_GATE="$HEALTH_GATE"
  export TASKPUMP_USAGE_GATE="$USAGE_GATE"
  export TASKPUMP_DISK_GATE="$DISK_GATE"
  export TASKPUMP_HEALTH_WINDOW="$HEALTH_WINDOW"
  export TASKPUMP_USAGE_CEILING="$CEILING"
  export TASKPUMP_USAGE_RESET_FILE="$RESET_FILE"
  export TASKPUMP_CREDENTIALS="$CLAUDE_DIR/.credentials.json"
  export TASKPUMP_DISK_WATCHDOG="$DISK_WATCHDOG_BIN"
  # The legacy spellings the un-migrated tools still read.
  export HEALTH_GATE HEALTH_WINDOW
  export ARACHNE_USAGE_RESET_FILE="$RESET_FILE"
}

# Strip a leading "<toolname>: " so a tool that prefixes all its diagnostics
# does not have to special-case the gate path. Only a bare token counts, so a
# reason that merely contains a colon is left alone.
strip_gate_prefix() {
  local r="$1"
  [[ "$r" =~ ^[A-Za-z0-9._-]+:\ (.*)$ ]] && r="${BASH_REMATCH[1]}"
  printf '%s' "$r"
}

GATE_REASON=""
feed_gate() {
  GATE_REASON=""
  export_gate_env
  local gates spec rc reason
  gates="${TASKPUMP_GATES:-$(default_gates)}"
  while IFS= read -r spec; do
    [[ -z "${spec//[[:space:]]/}" ]] && continue
    # A gate entry is a command line; splitting on whitespace is the point.
    # shellcheck disable=SC2086
    set -- $spec
    if [[ ! -x "$1" ]]; then
      warn "gate not executable, skipping: $1"
      continue
    fi
    rc=0
    reason="$("$@" 2>&1)" || rc=$?
    case "$rc" in
      0) ;;
      10) GATE_REASON="$(strip_gate_prefix "$reason")"; return 10 ;;
      *) warn "gate '$1' failed (rc=$rc); feeding anyway${reason:+ — $reason}" ;;
    esac
  done <<<"$gates"
  return 0
}

# ── Dependency-aware briefs (A3 v1 / F65.6) ────────────────────────────────────
# dep_pr_number <branch> — the open draft-PR number for a dependency branch, or
# empty. Fail-open: empty when gh is absent / disabled (TASKPUMP_PUMP_NO_GH=1, for
# hermetic tests) / errors.
dep_pr_number() {
  local branch="$1"
  [[ "${TASKPUMP_PUMP_NO_GH:-0}" -eq 1 ]] && return 0
  command -v gh >/dev/null 2>&1 || return 0
  gh pr list --head "$branch" --base "$INTEGRATION_BASE" --json number -q '.[0].number // empty' 2>/dev/null || true
}

# phase_cross_blockers <FN> — the unique set of OTHER phases this phase's tasks
# are blocked on (in-phase blockers are the pump's own serial concern), one phase
# token per line. The single source of truth for both the dependency brief (v1)
# and the integration launch gate (v2).
phase_cross_blockers() {
  local phase="$1"
  local -A seen=()
  local f blk bphase
  # DEFERRED (documented, not fixed): this reads task frontmatter directly with
  # yq, bypassing the "the CLI is the ledger's only reader and writer"
  # invariant, and re-hardcodes both the task-file naming convention and the
  # `.md` extension. Routing it through the CLI needs a subcommand that reports
  # blockers for a whole phase in one call; doing it per-file through the CLI
  # would add a process spawn per task per tick.
  shopt -s nullglob
  for f in "$TASKS_DIR/$phase."*.md; do
    while IFS= read -r blk; do
      [[ -z "$blk" ]] && continue
      bphase="${blk%%.*}"
      [[ "$bphase" == "$phase" ]] && continue       # in-phase dep — pump-internal
      [[ -n "${seen[$bphase]:-}" ]] && continue
      seen[$bphase]=1
      printf '%s\n' "$bphase"
    done < <(yq --front-matter=extract '.blockers[]?' "$f" 2>/dev/null || true)
  done
  shopt -u nullglob
}

# phase_deps_integrated <FN> — true (0) when EVERY cross-phase blocker's branch is
# already an ancestor of the integration trunk (its code is physically present on
# the base downstream is cut from). The v2 launch gate: a frontier phase whose
# blocker is `done` in the ledger but whose CODE is not yet on auto/trunk stays
# WAITING. Vacuously true with no cross-phase blockers. Test seam: when
# STUB_INTEGRATED is set, only its space-separated phases count as integrated.
phase_deps_integrated() {
  local phase="$1" dp dbranch
  while IFS= read -r dp; do
    [[ -z "$dp" ]] && continue
    dbranch="$(phase_branch "$dp")"
    if [[ -n "${STUB_INTEGRATED+x}" ]]; then
      pump_in_list "$dp" "$STUB_INTEGRATED" || return 1
    else
      apl_phase_integrated "$REPO_ROOT" "$dbranch" "$INTEGRATION_TRUNK" || return 1
    fi
  done < <(phase_cross_blockers "$phase")
  return 0
}

# phase_dependencies <FN> — emit a markdown "Depends on / builds upon" block
# naming this phase's CROSS-PHASE blockers, each resolved to branch / integration
# state / draft PR, so the launched agent learns its lineage instead of
# re-deriving upstream work. No cross-phase blockers ⇒ a single explanatory line.
# Pure-ish: the branch name is string-derived (always present); sha/PR are
# best-effort enrichment.
phase_dependencies() {
  local phase="$1"
  local deps=() dp
  while IFS= read -r dp; do [[ -n "$dp" ]] && deps+=("$dp"); done < <(phase_cross_blockers "$phase")

  if (( ${#deps[@]} == 0 )); then
    printf 'No cross-phase dependencies.\n'
    return 0
  fi

  printf 'This phase builds upon work from other phases. Their code is integrated\n'
  printf 'into the `%s` branch you are based on — do not re-derive it:\n\n' "$INTEGRATION_TRUNK"
  local dp dbranch dstate dpr
  for dp in "${deps[@]}"; do
    dbranch="$(phase_branch "$dp")"
    if apl_phase_integrated "$REPO_ROOT" "$dbranch" "$INTEGRATION_TRUNK"; then
      dstate="integrated @ $(git -C "$REPO_ROOT" rev-parse --short "$dbranch" 2>/dev/null || echo '?')"
    elif git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$dbranch" >/dev/null 2>&1; then
      dstate="not yet integrated"
    else
      dstate="not yet started"
    fi
    dpr="$(dep_pr_number "$dbranch")"
    if [[ -n "$dpr" ]]; then dpr="PR #$dpr"; else dpr="no PR yet"; fi
    printf -- '- **%s** (`%s`) — %s, %s\n' "$dp" "$dbranch" "$dstate" "$dpr"
  done
}

# ── Brief-template resolution ─────────────────────────────────────────────────
# Three places to look, in order: what the operator configured, the consumer's
# own template inside its ledger (Arachne's path — so an existing project keeps
# rendering exactly what it did), and finally the generic one shipped with
# TaskPump. Previously a missing consumer template was a hard die, which made a
# fresh project unable to run at all until it wrote one.
resolve_brief_template() {
  local explicit="${TASKPUMP_PHASE_BRIEF_TEMPLATE:-${TASKPUMP_BRIEF_TEMPLATE:-}}"
  [[ -n "$explicit" ]] && { printf '%s' "$explicit"; return 0; }
  local consumer="$OPS_DIR/task-loop/briefs/_phase-drain-template.md"
  [[ -f "$consumer" ]] && { printf '%s' "$consumer"; return 0; }
  printf '%s' "$TP_ROOT/templates/phase-drain-brief.md"
}
BRIEF_TEMPLATE="$(resolve_brief_template)"

# The resume note resolves the same three ways, for the same reason: a consumer
# whose agents depend on particular wording keeps it in its own ledger, while
# the shipped default stays tool-agnostic. Symmetry matters here — the two
# templates are read by the same agent in the same session.
resolve_resume_template() {
  local explicit="${TASKPUMP_RESUME_TEMPLATE:-}"
  [[ -n "$explicit" ]] && { printf '%s' "$explicit"; return 0; }
  local consumer="$OPS_DIR/task-loop/briefs/_resume-note-template.md"
  [[ -f "$consumer" ]] && { printf '%s' "$consumer"; return 0; }
  printf '%s' "$TP_ROOT/templates/resume-note.md"
}
RESUME_TEMPLATE="$(resolve_resume_template)"

# Only reachable when the resolved template is genuinely absent — an explicit
# TASKPUMP_BRIEF_TEMPLATE pointing nowhere, or a broken install.
missing_brief_template_msg() {
  printf 'phase-drain brief template not found: %s\n' "$BRIEF_TEMPLATE"
  printf '  looked at: $TASKPUMP_BRIEF_TEMPLATE, then %s/task-loop/briefs/_phase-drain-template.md,\n' "$OPS_DIR"
  printf '  then the one shipped at %s/templates/phase-drain-brief.md\n' "$TP_ROOT"
}

# ── Brief rendering (D6 / F64.4; deps A3 v1) ───────────────────────────────────
# render_brief_stream <phase> — render the parameterized phase-drain template to
# stdout: substitute {{PHASE}} (plain sed — no envsubst, no clash with the
# `$PHASE` / `$(…)` shell examples the brief contains; phase tokens FNN are
# sed-safe) and expand the {{DEPENDS_ON}} placeholder line with the dependency
# block (awk by literal `index()` — avoids multi-line inline sed and the awk
# brace-interval pitfall).
render_brief_stream() {
  local phase="$1"
  local depfile; depfile="$(mktemp)"
  phase_dependencies "$phase" >| "$depfile"
  local -A TPL_VARS TPL_BLOCKS
  TPL_VARS=(
    [PHASE]="$phase"
    [BASE]="$BASE_REF"
    [TASK_CLI]="$TASK_CLI"
    [TASK_CLI_NAME]="$TASK_CLI_NAME"
    [TASK_DIR]="$(tasks_dir_rel)"
    [VERIFY_CMDS]="$(apl_join_commands "$VERIFY_CMDS")"
    [BUILD_GATE]="$(apl_join_commands "$VERIFY_CMDS")"
    [PROJECT_BRIEF]="${PROJECT_BRIEF//\{\{PHASE\}\}/$phase}"
  )
  TPL_BLOCKS=( [DEPENDS_ON]="$depfile" )
  apl_render_template "$BRIEF_TEMPLATE"
  rm -f "$depfile" 2>/dev/null || true
}

# render_brief <phase> — write the rendered brief to a transient per-phase file
# and echo its path (the launcher passes the path to the container).
render_brief() {
  local phase="$1"
  [[ -f "$BRIEF_TEMPLATE" ]] || die "$(missing_brief_template_msg)"
  local out="$WORKTREES_DIR/$(phase_branch "$phase")/$BRIEF_OUT_NAME"
  mkdir -p "$(dirname "$out")" 2>/dev/null || true
  render_brief_stream "$phase" >| "$out"
  printf '%s' "$out"
}

# ── Launch one phase's worktree + container ────────────────────────────────────
# Write the resume preamble the container prepends ahead of the kickoff brief.
# The in-container entrypoint already resolves the resume-note path and cats it
# between the goal preamble and the brief — that plumbing was built for
# run-parallel.sh's interrupted-session path and the pump simply never used it,
# so nothing in the container needs to change.
#
# The one thing run-parallel.sh's version cannot say is what a *dead* agent
# already landed: it only reports uncommitted state. A resumed task's whole
# context is its commits, so those lead here.
#
# The prose lives in templates/resume-note.md (TASKPUMP_RESUME_TEMPLATE). It was
# ~55 lines of heredoc naming one project's CLI path, task-file layout, and
# verification commands; this function now only gathers the git state the
# template splices in.
render_resume_note_stream() {
  local wt="$1" branch="$2" id="$3"
  local phase="${id%%.*}"
  local commits status_short diff_stat
  commits="$(mktemp)"; status_short="$(mktemp)"; diff_stat="$(mktemp)"
  git -C "$wt" log --oneline "$BASE_REF..$branch" 2>/dev/null | head -40 >| "$commits" || true
  git -C "$wt" status --short 2>/dev/null | head -40 >| "$status_short" || true
  git -C "$wt" diff --stat 2>/dev/null | tail -20 >| "$diff_stat" || true

  local -A TPL_VARS TPL_BLOCKS
  TPL_VARS=(
    [TASK_ID]="$id"
    [PHASE]="$phase"
    [BRANCH]="$branch"
    [TASK_FILE]="$(tasks_dir_rel)/$id.md"
    [TASK_CLI]="$TASK_CLI"
    [TASK_CLI_NAME]="$TASK_CLI_NAME"
    [VERIFY_CMDS]="$(apl_join_commands "$VERIFY_CMDS")"
    # The shipped templates call this {{BUILD_GATE}}. Both names resolve to the
    # same value so either template file renders, but note that the pump's
    # TASKPUMP_BUILD_GATE is a DIFFERENT thing — the merge queue's gate, not the
    # per-task verification commands.
    [BUILD_GATE]="$(apl_join_commands "$VERIFY_CMDS")"
  )
  TPL_BLOCKS=(
    [COMMITS]="$commits"
    [STATUS_SHORT]="$status_short"
    [DIFF_STAT]="$diff_stat"
  )
  apl_render_template "$RESUME_TEMPLATE"
  rm -f "$commits" "$status_short" "$diff_stat" 2>/dev/null || true
}

# write_resume_note <wt> <branch> <id> — render to the worktree and echo the path
# (the launcher passes the path on to the runner).
write_resume_note() {
  local wt="$1" branch="$2" id="$3"
  local out="$wt/$RESUME_NOTE_NAME"
  render_resume_note_stream "$wt" "$branch" "$id" >| "$out"
  printf '%s' "$out"
}

# Give up on a stalled task and hand it to a human. Uses `needs-review` (the
# sanctioned quarantine status, same as quarantine_phase) rather than `block`,
# which means "external dependency". `reopen` now accepts needs-review, so this
# is a door the operator can walk back through.
escalate_stalled() {
  local phase="$1" id="$2" verdict="$3"
  ESCALATED["$phase"]=1
  "$TASK_BIN" needs-review "$id" \
    --reason "Pump auto-resume exhausted: $RESUME_MAX resume attempts made no new commits on $(phase_branch "$phase"). Needs a human to finish, split, or block it." \
    >/dev/null 2>&1 \
    || warn "escalate $id: needs-review failed"
  pump_notify "$phase STALLED on $id — $verdict, no progress across $RESUME_MAX auto-resumes. Marked needs-review; finish, split, or block it by hand."
}

# Relaunch a starved phase to continue its orphaned task.
resume_phase() {
  local phase="$1"
  local id="${STALL_TASK[$phase]:-}"
  [[ -n "$id" ]] || return 1
  local branch; branch="$(phase_branch "$phase")"
  local head; head="$(git -C "$REPO_ROOT" rev-parse "$branch" 2>/dev/null || true)"
  [[ -n "$head" ]] || { warn "resume $phase: cannot resolve head of $branch"; return 1; }

  # Bookkeep the attempt HERE rather than inside launch_phase: a phase that is
  # detected but not launched — pool cap reached, feed gate shut — must not burn
  # an attempt it never got to use.
  local verdict rc=0
  verdict="$("$TASK_BIN" resume-attempt "$id" --head "$head" --max "$RESUME_MAX" 2>/dev/null)" || rc=$?
  if (( rc == 10 )); then
    escalate_stalled "$phase" "$id" "$verdict"
    return 1
  fi
  (( rc == 0 )) || { warn "resume $phase: resume-attempt $id failed (rc=$rc)"; return 1; }

  # A scrub-parked task has to come back to `open` before the container's
  # safety-net claim can take it (claim accepts open, or in_progress on the same
  # branch — never needs-review/stuck).
  local status="${STALL_STATUS[$phase]:-}"
  if [[ "$status" == "needs-review" || "$status" == "stuck" ]]; then
    "$TASK_BIN" reopen "$id" \
      --reason "Pump auto-resume ($verdict): committed work on $branch, container dead; relaunching to continue." \
      >/dev/null 2>&1 || { warn "resume $phase: reopen $id failed"; return 1; }
  fi

  log "resuming $phase task $id ($verdict, was $status, head $(printf '%s' "$head" | cut -c1-12))"
  RESUME_TASK_ID="$id"
  local lrc=0
  launch_phase "$phase" || lrc=$?
  RESUME_TASK_ID=""
  return "$lrc"
}

launch_phase() {
  local phase="$1"
  # Test/maintenance hook: tick through the gate + plan + state logic without
  # materialising worktrees or containers.
  if [[ "${TASKPUMP_PUMP_NO_LAUNCH:-0}" -eq 1 ]]; then
    if [[ -n "$RESUME_TASK_ID" ]]; then
      log "would launch $phase -> $(phase_branch "$phase") (NO_LAUNCH, resume $RESUME_TASK_ID)"
    else
      log "would launch $phase -> $(phase_branch "$phase") (NO_LAUNCH)"
    fi
    return 0
  fi
  local branch; branch="$(phase_branch "$phase")"
  local wt="$WORKTREES_DIR/$branch"
  local cname; cname="$(phase_container "$phase")"
  # A resumed phase names its own task. phase_lead_task reads the *eligible*
  # frontier, which by definition excludes the claimed task that stalled us, so
  # it would hand back an empty id — and the entrypoint skips its safety-net
  # claim + heartbeat entirely when ARACHNE_TASK_ID is empty. That empty-lead
  # path is exactly how a naive relaunch reproduces the original stall, and it
  # also leaves last_heartbeat_ts unset so scrub re-parks the task within 24h.
  local lead
  if [[ -n "$RESUME_TASK_ID" ]]; then
    lead="$RESUME_TASK_ID"
  else
    lead="$(phase_lead_task "$phase")"
  fi

  # Materialise the worktree (idempotent). Create the branch from BASE_REF if new.
  if [[ ! -d "$wt" ]]; then
    if git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$branch" >/dev/null 2>&1; then
      git -C "$REPO_ROOT" worktree add "$wt" "$branch" >/dev/null
    else
      git -C "$REPO_ROOT" worktree add "$wt" -b "$branch" "$BASE_REF" >/dev/null
    fi
  fi
  [[ -f "$wt/$SUBMODULE_PROBE" ]] || git -C "$wt" submodule update --init --recursive 2>&1 | tail -1 || true
  apl_repair_worktree_gitignore "$REPO_ROOT"
  if (cd "$REPO_ROOT" && git check-ignore -q "$wt" 2>/dev/null); then
    warn "worktree still gitignored: $wt — fix .gitignore; skipping $phase"; return 1
  fi

  # v2: refresh a reused/stale worktree with newly-integrated upstream deps. A
  # worktree cut from auto/trunk BEFORE a dependency integrated will not contain
  # it; merging the current trunk in makes a relaunch inherit upstream (a first
  # launch from BASE_REF=trunk is already up to date → no-op). Conflict → abort,
  # skip the launch, and quarantine (same gate as reconcile_trunk). Integration
  # off ⇒ untouched.
  if [[ "$INTEGRATION" -eq 1 ]] && git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$INTEGRATION_TRUNK" >/dev/null 2>&1; then
    if ! git -C "$wt" merge --no-ff --no-edit "$INTEGRATION_TRUNK" >/dev/null 2>&1; then
      git -C "$wt" merge --abort >/dev/null 2>&1 || true
      warn "worktree $wt conflicts with $INTEGRATION_TRUNK; skipping launch of $phase"
      quarantine_phase "$phase" "$(git -C "$wt" rev-parse HEAD 2>/dev/null)" "worktree merge conflict"
      return 1
    fi
  fi

  local brief; brief="$(render_brief "$phase")"
  # Resume preamble, prepended by the entrypoint ahead of the brief. A normal
  # launch actively clears a stale note so a later fresh drain of this worktree
  # cannot inherit a previous resume's instructions.
  local resume_note=""
  if [[ -n "$RESUME_TASK_ID" ]]; then
    resume_note="$(write_resume_note "$wt" "$branch" "$RESUME_TASK_ID")"
  else
    rm -f "$wt/$RESUME_NOTE_NAME" 2>/dev/null || true
  fi

  # ── Hand off to the runner ──────────────────────────────────────────────────
  # The pump decides WHAT to run and WHERE; the runner owns HOW — the sandbox,
  # the mounts, the credential handling, the image. Everything it needs arrives
  # in the environment, in two spellings: the canonical TP_* names, and the
  # legacy ones the in-container entrypoint reads today. The container-side
  # reader prefers canonical and falls back to legacy, so either half can be
  # migrated on its own.
  #
  # Stopping a container and checking liveness are still the pump's, by
  # container name through the runtime directly. Folding those into the runner
  # contract is v2: liveness is read on every tick from every phase, and routing
  # it through a process spawn per phase per tick is a cost worth measuring
  # first.
  local cid rc=0
  cid=$(
    TP_WORKSPACE="$wt"                 WORKSPACE_PATH="$wt" \
    TP_BRANCH="$branch" \
    TP_CONTAINER_NAME="$cname" \
    TP_IMAGE="$IMAGE" \
    TP_ENTRYPOINT="$ENTRYPOINT" \
    TP_TASK_ID="$lead"                 ARACHNE_TASK_ID="$lead" \
    TP_PHASE="$phase"                  ARACHNE_PHASE="$phase" \
    TP_MODEL="$AGENT_MODEL"            AGENT_MODEL="$AGENT_MODEL" \
    TP_MAX_TURNS="$MAX_TURNS"          MAX_TURNS="$MAX_TURNS" \
    TP_REPO_ROOT="$REPO_ROOT"          REPO_ROOT="$REPO_ROOT" \
    TP_BRIEF="$brief"                  ARACHNE_BRIEF="$brief" \
    TP_RESUME_NOTE="$resume_note"      ARACHNE_RESUME_NOTE="$resume_note" \
    TP_LEDGER_REPO="$OPS_DIR" \
    TP_CLAUDE_DIR="$CLAUDE_DIR"        CLAUDE_DIR="$CLAUDE_DIR" \
    TP_CLAUDE_JSON="$CLAUDE_JSON"      CLAUDE_JSON="$CLAUDE_JSON" \
    TP_AGENT_LOG_NAME="$AGENT_LOG_NAME" \
    TP_GOAL_NOTE_NAME="$GOAL_NOTE_NAME" \
    TP_TASKS_DIR="$TASKS_DIR" \
    TP_MEMORY_MAX="${AGENT_MEMORY_MAX:-3g}"   AGENT_MEMORY_MAX="${AGENT_MEMORY_MAX:-3g}" \
    TP_MEMORY_SWAP="${AGENT_MEMORY_SWAP:-5g}" AGENT_MEMORY_SWAP="${AGENT_MEMORY_SWAP:-5g}" \
    TP_DOCKER="$DOCKER"                DOCKER="$DOCKER" \
    GITHUB_TOKEN="${GITHUB_TOKEN:-}" \
    "$RUNNER" launch
  ) || rc=$?
  if (( rc != 0 )); then
    warn "runner failed to launch $phase (rc=$rc): $RUNNER"
    return 1
  fi
  log "launched $phase -> $cname ($(printf '%s' "$cid" | cut -c1-12))  lead=$lead${RESUME_TASK_ID:+ (RESUME)}  log: $wt/$AGENT_LOG_NAME"
  return 0
}

# ── Autonomous integration trunk (A3 / F65.6) ──────────────────────────────────
# ensure_trunk — startup, real-run only: create auto/trunk from INTEGRATION_BASE
# if absent and materialise its dedicated host worktree (idempotent). The host —
# not a container — owns the trunk worktree (decision 1): the merge/build runs on
# the host's fresh auth, never inside a dying container.
ensure_trunk() {
  [[ "$INTEGRATION" -eq 1 ]] || return 0
  if ! git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$INTEGRATION_TRUNK" >/dev/null 2>&1; then
    git -C "$REPO_ROOT" branch "$INTEGRATION_TRUNK" "$INTEGRATION_BASE" \
      || die "cannot create $INTEGRATION_TRUNK from $INTEGRATION_BASE"
    log "created integration trunk $INTEGRATION_TRUNK from $INTEGRATION_BASE"
  fi
  local twt; twt="$(trunk_worktree)"
  if [[ ! -d "$twt" ]]; then
    git -C "$REPO_ROOT" worktree add "$twt" "$INTEGRATION_TRUNK" >/dev/null \
      || die "cannot add trunk worktree $twt"
    log "integration trunk worktree at $twt"
  fi
  [[ -f "$twt/$SUBMODULE_PROBE" ]] || git -C "$twt" submodule update --init --recursive 2>&1 | tail -1 || true
  apl_repair_worktree_gitignore "$REPO_ROOT"
}

# run_build_gate <worktree> — the gate every merge into the trunk must pass. A
# configured BUILD_GATE_CMD (tests / advanced) wholly replaces the default
# (cargo check --workspace, then smoke_test.sh if present). Returns the gate's
# exit status; 0 == green.
run_build_gate() {
  local wt="$1"
  if [[ -n "$BUILD_GATE_CMD" ]]; then
    ( cd "$wt" && WORKSPACE_PATH="$wt" eval "$BUILD_GATE_CMD" ) >/dev/null 2>&1
    return $?
  fi
  ( cd "$wt" && cargo check --workspace ) >/dev/null 2>&1 || return 1
  if [[ -x "$wt/smoke_test.sh" ]]; then
    ( cd "$wt" && WORKSPACE_PATH="$wt" ./smoke_test.sh ) >/dev/null 2>&1 || return 1
  fi
  return 0
}

# run_build_gate_dry — the dry-run build gate: run ONLY an explicitly-configured
# BUILD_GATE_CMD (so a test's `false` forces red) and never the real cargo. No
# command configured ⇒ assume green.
run_build_gate_dry() {
  [[ -n "$BUILD_GATE_CMD" ]] || return 0
  ( eval "$BUILD_GATE_CMD" ) >/dev/null 2>&1
}

# quarantine_phase <phase> <pre-sha> <reason> — a conflicting or build-red merge
# does NOT advance the trunk; the phase is flagged needs-review (real run) and a
# host quarantine marker is appended so a human can reconcile feat/fN later. The
# un-integrated branch simply stops propagating. Honors the dry-run seam.
quarantine_phase() {
  local phase="$1" sha="$2" reason="$3"
  local lead; lead="$(phase_lead_task "$phase")"
  [[ -z "$lead" ]] && lead="$phase.0"
  if [[ "${TASKPUMP_PUMP_INTEGRATE_DRYRUN:-0}" -eq 1 ]]; then
    log "would quarantine $phase: $reason"
    log "would needs-review $lead: $reason"
  else
    log "quarantine $phase: $reason — not advancing $INTEGRATION_TRUNK; $lead → needs-review"
    "$TASK_BIN" needs-review "$lead" --reason "auto/trunk integration $reason ($phase)" >/dev/null 2>&1 \
      || warn "needs-review $lead failed"
    pump_notify "auto/trunk: quarantined $phase ($reason); $lead flagged needs-review"
  fi
  printf '%s %s %s\n' "$phase" "${sha:-?}" "$reason" >> "$QUARANTINE_FILE" 2>/dev/null || true
}

# integrate_one_phase <phase> — merge a single quiescent phase branch into the
# trunk under the merge lock + build gate. Returns 0 always (fail-open).
integrate_one_phase() {
  local phase="$1" branch; branch="$(phase_branch "$phase")"
  # Never merge a tree an agent is mid-edit on (decision 3, quiescence proxy).
  if phase_live "$phase"; then
    dbg_log "skip integrate $phase: live container (not quiescent)"
    return 0
  fi
  if [[ "${TASKPUMP_PUMP_INTEGRATE_DRYRUN:-0}" -eq 1 ]]; then
    integrate_one_phase_dryrun "$phase" "$branch"
  else
    integrate_one_phase_real "$phase" "$branch"
  fi
  return 0
}

# Dry-run integration: no git/cargo. STUB_INTEGRATE_NOBRANCH / _ANCESTOR /
# _CONFLICT (space-separated phase lists) drive branch-exists / already-integrated
# / merge-conflict; BUILD_GATE_CMD drives the gate. Logs would-integrate /
# would-quarantine lines for the harness to assert.
integrate_one_phase_dryrun() {
  local phase="$1"
  if pump_in_list "$phase" "${STUB_INTEGRATE_NOBRANCH:-}"; then
    dbg_log "skip integrate $phase: branch absent (stub)"; return 0
  fi
  if pump_in_list "$phase" "${STUB_INTEGRATE_ANCESTOR:-}"; then
    dbg_log "skip integrate $phase: already an ancestor of $INTEGRATION_TRUNK (stub)"; return 0
  fi
  if pump_in_list "$phase" "${STUB_INTEGRATE_CONFLICT:-}"; then
    quarantine_phase "$phase" "stub" "conflict"; return 0
  fi
  if ! run_build_gate_dry; then
    quarantine_phase "$phase" "stub" "build red"; return 0
  fi
  log "would integrate $phase"
}

# Real integration: under the trunk flock, merge feat/fN --no-ff into the trunk
# worktree; conflict → abort + quarantine; build-red → reset --hard + quarantine;
# green → keep, log, optionally push.
integrate_one_phase_real() {
  local phase="$1" branch="$2"
  git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$branch" >/dev/null 2>&1 \
    || { dbg_log "skip integrate $phase: no branch $branch"; return 0; }
  if apl_phase_integrated "$REPO_ROOT" "$branch" "$INTEGRATION_TRUNK"; then
    dbg_log "skip integrate $phase: $branch already an ancestor of $INTEGRATION_TRUNK"; return 0
  fi
  local twt; twt="$(trunk_worktree)"
  [[ -d "$twt" ]] || { warn "trunk worktree missing ($twt); skipping $phase"; return 0; }
  (
    apl_acquire_trunk_lock "$TRUNK_LOCK_FILE" || { warn "trunk lock busy; deferring $phase to next tick"; exit 0; }
    local pre; pre="$(git -C "$twt" rev-parse HEAD 2>/dev/null)"
    if ! git -C "$twt" merge --no-ff --no-edit "$branch" >/dev/null 2>&1; then
      git -C "$twt" merge --abort >/dev/null 2>&1 || true
      quarantine_phase "$phase" "$pre" "conflict"
      exit 0
    fi
    if ! run_build_gate "$twt"; then
      git -C "$twt" reset --hard "$pre" >/dev/null 2>&1 || true
      quarantine_phase "$phase" "$pre" "build red"
      exit 0
    fi
    local post; post="$(git -C "$twt" rev-parse HEAD 2>/dev/null)"
    log "integrated $phase @ $(printf '%s' "$post" | cut -c1-12)"
    [[ "${TASKPUMP_PUMP_TRUNK_PUSH:-0}" -eq 1 ]] && git -C "$twt" push >/dev/null 2>&1 || true
    exit 0
  ) || true
}

# reconcile_trunk — the host integration step (decision 1): walk every phase in
# range and integrate each quiescent, not-yet-integrated branch. Wired into
# do_tick AFTER scrub and BEFORE feed_gate so finished work keeps propagating
# even while LAUNCHING is usage-paused (integration is local compute, no tokens).
# Guarded on INTEGRATION=1; returns 0 always (fail-open — a wedged merge delays
# integration, never the tick).
reconcile_trunk() {
  [[ "$INTEGRATION" -eq 1 ]] || return 0
  local p
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    integrate_one_phase "$p" || true
  done < <(pump_expand_phases "$PHASES")
  return 0
}

# graduate_trunk — drain tail (real run only): open exactly one trunk →
# integration-base PR (idempotent: refresh if it exists). The base receives no
# direct commits — the separate trunk buffer keeps integration continuous while
# review stays batched. Every gh call here targets $INTEGRATION_BASE; all three
# used to hardcode `main` while --integration-base pretended to be configurable,
# so pointing a run at a release branch silently opened PRs against main.
graduate_trunk() {
  [[ "$INTEGRATION" -eq 1 ]] || return 0
  command -v gh >/dev/null 2>&1 || { warn "gh absent; cannot graduate $INTEGRATION_TRUNK → $INTEGRATION_BASE"; return 0; }
  local twt; twt="$(trunk_worktree)"
  local existing
  existing="$(gh pr list --head "$INTEGRATION_TRUNK" --base "$INTEGRATION_BASE" --json number -q '.[0].number // empty' 2>/dev/null || true)"
  if [[ -n "$existing" ]]; then
    log "graduation PR #$existing already open for $INTEGRATION_TRUNK; left as-is"
    return 0
  fi
  [[ -d "$twt" ]] && git -C "$twt" push -u origin "$INTEGRATION_TRUNK" >/dev/null 2>&1 \
    || warn "push $INTEGRATION_TRUNK failed (continuing to PR)"
  local quarantined=""
  [[ -f "$QUARANTINE_FILE" ]] && quarantined="$(cat "$QUARANTINE_FILE" 2>/dev/null || true)"
  local body
  body="$(printf 'Autonomous integration of phases %s via %s.\n' "$PHASES" "$INTEGRATION_TRUNK")"
  if [[ -n "$quarantined" ]]; then
    body="$(printf '%s\nQuarantined (needs human reconciliation):\n%s\n' "$body" "$quarantined")"
  fi
  if gh pr create --base "$INTEGRATION_BASE" --head "$INTEGRATION_TRUNK" \
      --title "auto: integrate $PHASES" --body "$body" >/dev/null 2>&1; then
    log "opened graduation PR $INTEGRATION_TRUNK → $INTEGRATION_BASE"
  else
    warn "gh pr create for $INTEGRATION_TRUNK → $INTEGRATION_BASE failed"
  fi
}

# ── Planning pass: classify every phase in range ───────────────────────────────
# Sets arrays LAUNCH/RUNNING/WAITING/DONEP. Returns the plan via globals.
declare -a PLAN_LAUNCH PLAN_RUNNING PLAN_WAITING PLAN_DONE PLAN_RESUME
declare -A PLAN_WAIT_REASON
compute_plan() {
  PLAN_LAUNCH=(); PLAN_RUNNING=(); PLAN_WAITING=(); PLAN_DONE=(); PLAN_RESUME=(); PLAN_WAIT_REASON=()
  detect_stalled_orphans
  local -A in_frontier=()
  local p
  while IFS= read -r p; do [[ -n "$p" ]] && in_frontier["$p"]=1; done < <(frontier_phases)
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    local oc; oc="$(phase_open_count "$p")"
    if [[ -n "${in_frontier[$p]:-}" ]]; then
      if phase_live "$p"; then
        PLAN_RUNNING+=("$p")
      elif [[ "$INTEGRATION" -eq 1 ]] && ! phase_deps_integrated "$p"; then
        # v2: ledger says ready, but a cross-phase dep's CODE is not yet on the
        # trunk this phase would be cut from. Hold until the merge lands so the
        # worktree physically contains its dependencies (RC-3 closure).
        PLAN_WAITING+=("$p")
        PLAN_WAIT_REASON["$p"]="deps done but not yet integrated into $INTEGRATION_TRUNK"
      else
        PLAN_LAUNCH+=("$p")
      fi
    elif [[ -n "${STALL_TASK[$p]:-}" ]] && ! phase_live "$p"; then
      # Not in the frontier, no live container, but an orphaned claim with
      # committed work sits on this phase's branch — that claim IS the reason
      # nothing here is eligible. Tested ahead of `oc` deliberately: when the
      # orphan is the phase's only remaining work oc == 0, and the phase would
      # otherwise land in PLAN_DONE and let is_drained declare the range
      # finished over committed, unfinished work.
      PLAN_RESUME+=("$p")
    elif [[ "$oc" -gt 0 ]]; then
      # Has open tasks but none eligible — gated on incomplete cross-phase deps,
      # unless a live container is already draining it.
      if phase_live "$p"; then
        PLAN_RUNNING+=("$p")
      else
        PLAN_WAITING+=("$p")
        PLAN_WAIT_REASON["$p"]="$oc open, none eligible — cross-phase blockers pending"
      fi
    else
      PLAN_DONE+=("$p")
    fi
  done < <(pump_expand_phases "$PHASES")
}

print_plan() {
  compute_plan
  local gate_line; if feed_gate; then gate_line="GATE: feed-ok"; else gate_line="GATE: PAUSED — $GATE_REASON"; fi
  echo "$PROG_NAME plan — phases $PHASES, grain $GRAIN, cap $(JOBS=$JOBS apl_read_cap), ceiling $CEILING%"
  echo "$gate_line"
  local p
  for p in "${PLAN_LAUNCH[@]:-}";  do [[ -n "$p" ]] && printf '  LAUNCH   %-6s -> %s\n' "$p" "$(phase_branch "$p")"; done
  for p in "${PLAN_RUNNING[@]:-}"; do [[ -n "$p" ]] && printf '  RUNNING  %-6s -> %s (live container)\n' "$p" "$(phase_branch "$p")"; done
  for p in "${PLAN_RESUME[@]:-}";  do [[ -n "$p" ]] && printf '  RESUME   %-6s -> %s (stalled on %s, %s; container dead, work committed)\n' \
      "$p" "$(phase_branch "$p")" "${STALL_TASK[$p]}" "${STALL_STATUS[$p]}"; done
  for p in "${PLAN_WAITING[@]:-}"; do [[ -n "$p" ]] && printf '  WAITING  %-6s (%s)\n' "$p" "${PLAN_WAIT_REASON[$p]:-cross-phase blockers pending}"; done
  for p in "${PLAN_DONE[@]:-}";    do [[ -n "$p" ]] && printf '  DONE     %-6s (no open tasks)\n' "$p"; done
  echo "frontier: ${#PLAN_LAUNCH[@]} launchable, ${#PLAN_RUNNING[@]} running, ${#PLAN_RESUME[@]} resumable, ${#PLAN_WAITING[@]} waiting | open tasks in range: $(open_count)"
}

# ── Reclaim build artifacts of completed phases (A4 / F65.3) ───────────────────
# After compute_plan, every phase with no open tasks is in PLAN_DONE — its agent
# container has exited (a resumable phase still has an open task and is never
# PLAN_DONE), so its worktree target/ is dead weight. Reclaim it to keep a
# multi-day drain's disk footprint bounded. Guards: never touch a phase with a
# live container (phase_live), and only remove build artifacts — source files and
# every commit are untouched. Runs every tick regardless of the feed gate, so a
# disk-pressure pause can self-heal as completed phases free their target/ dirs.
# Disabled with ARACHNE_DISK_RECLAIM=0.
reclaim_done_targets() {
  [[ "${TASKPUMP_DISK_RECLAIM:-1}" -eq 1 ]] || return 0
  local p wt sz
  for p in "${PLAN_DONE[@]:-}"; do
    [[ -z "$p" ]] && continue
    wt="$WORKTREES_DIR/$(phase_branch "$p")"
    [[ -d "$wt/target" ]] || continue
    phase_live "$p" && continue
    sz="$(du -sh "$wt/target" 2>/dev/null | cut -f1)"
    if [[ -n "$RECLAIM_CMD" ]]; then
      if ( cd "$wt" && eval "$RECLAIM_CMD" ) >/dev/null 2>&1; then
        log "reclaimed $p target/ (${sz:-?}) via TASKPUMP_RECLAIM_CMD"
      else
        warn "TASKPUMP_RECLAIM_CMD failed for $p ($wt)"
      fi
    elif command -v cargo >/dev/null 2>&1; then
      if cargo clean --manifest-path "$wt/Cargo.toml" >/dev/null 2>&1; then
        log "reclaimed $p target/ (${sz:-?}) via cargo clean"
      else
        warn "cargo clean failed for $p ($wt); run '\''tp cleanup --targets'\'' to reclaim"
      fi
    elif rm -rf "$wt/target"; then
      log "reclaimed $p target/ (${sz:-?}) via rm -rf (no cargo)"
    fi
  done
}

# ── Pre-tick hooks ─────────────────────────────────────────────────────────────
# Housekeeping the supervisor runs before it plans anything. Pulling the ledger
# and scrubbing stale claims stay built in — the pump cannot function without
# them — but the two that encode assumptions about one project's working
# arrangement are files under hooks/ and can be replaced or dropped.
#
# Each hook is run with the repo root as $1. Its stdout is logged and, when the
# text CHANGES since the last tick, sent to the notifier — a persistent
# condition must not fire a desktop notification every TICK seconds. The
# fingerprint lives in a marker file, so the dedup survives a supervisor
# restart. A non-zero exit is a warning, never a reason to skip the tick.
default_pre_tick_hooks() {
  printf '%s\n' "$TP_ROOT/hooks/gitignore-repair"
  printf '%s\n' "$TP_ROOT/hooks/fs-guard"
}

run_pre_tick_hooks() {
  local hooks spec rc out all=""
  hooks="${TASKPUMP_PRE_TICK_HOOKS:-$(default_pre_tick_hooks)}"
  while IFS= read -r spec; do
    [[ -z "${spec//[[:space:]]/}" ]] && continue
    # A hook entry is a command line; splitting on whitespace is the point.
    # shellcheck disable=SC2086
    set -- $spec
    if [[ ! -x "$1" ]]; then
      warn "pre-tick hook not executable, skipping: $1"
      continue
    fi
    rc=0
    out="$(TP_REPO_ROOT="$REPO_ROOT" "$@" "$REPO_ROOT" 2>&1)" || rc=$?
    (( rc != 0 )) && warn "pre-tick hook '$1' failed (rc=$rc)${out:+ — $out}"
    [[ -n "$out" ]] && { log "$out"; all+="$out"$'\n'; }
  done <<<"$hooks"

  all="${all%$'\n'}"
  if [[ -n "$all" ]]; then
    # Compare against the trimmed form the marker holds; $(cat) strips trailing
    # newlines, so an untrimmed comparison never matches and re-notifies forever.
    if [[ "$all" != "$(cat "$HOOK_MARK_FILE" 2>/dev/null)" ]]; then
      pump_notify "$all"
      printf '%s' "$all" >"$HOOK_MARK_FILE" 2>/dev/null || true
    fi
  else
    rm -f "$HOOK_MARK_FILE" 2>/dev/null || true   # quiet again → re-arm
  fi
  return 0
}

# ── One tick: scrub, plan, reclaim, gate, top up the pool to cap ───────────────
do_tick() {
  git -C "$OPS_DIR" pull --ff-only >/dev/null 2>&1 || warn "ops pull --ff-only failed (continuing)"
  # Capture rather than discard: a scrub that finds invisible task files (exit
  # 3) has the one detail worth acting on — the paths. Dropping them left the
  # operator a generic "scrub failed" every tick for days with nothing to go on,
  # and conflated a corrupt ledger with scrub itself crashing.
  local scrub_out scrub_line scrub_rc=0
  scrub_out=$("$TASK_BIN" scrub 2>&1) || scrub_rc=$?
  if (( scrub_rc == 3 )); then
    while IFS= read -r scrub_line; do
      [[ -n "$scrub_line" ]] && warn "ledger integrity: $scrub_line"
    done < <(grep -E 'UNPARSEABLE|NO-ID' <<<"$scrub_out" || true)
  elif (( scrub_rc != 0 )); then
    warn "scrub failed (continuing)"
  fi
  reclaim_orphaned_claims   # D3: free tasks parked by dead containers before planning
  run_pre_tick_hooks

  # Integrate finished phases into auto/trunk (A3). Runs after scrub and BEFORE
  # feed_gate: integration is local compute (no API tokens), so finished work
  # keeps propagating even while LAUNCHING is usage-paused. No-op when the
  # integration trunk is off (INTEGRATION=0).
  reconcile_trunk

  # Plan + reclaim run before the gate: classification is read-only and reclaim
  # frees disk for DONE phases even while feeding is paused (e.g. on the disk gate).
  compute_plan
  reclaim_done_targets

  if ! feed_gate; then
    log "PAUSED feeding — $GATE_REASON (running agents untouched)"
    write_state paused "$GATE_REASON"
    return 0
  fi

  local cap have launched=0 p
  cap="$(JOBS=$JOBS apl_read_cap)"
  have="$(apl_count_live_agents)"
  for p in "${PLAN_LAUNCH[@]:-}"; do
    [[ -z "$p" ]] && continue
    (( have >= cap )) && break
    if launch_phase "$p"; then
      have=$((have + 1)); launched=$((launched + 1)); sleep "$STAGGER"
    fi
  done
  # Starved phases go last: genuinely-eligible work is always preferred over
  # resuming a partially-done task. Same cap, same stagger, and — because this
  # sits below the feed gate's early return — the same usage/token/WiFi/disk
  # pause, so a resume never fires while the pump is throttled.
  for p in "${PLAN_RESUME[@]:-}"; do
    [[ -z "$p" ]] && continue
    (( have >= cap )) && break
    if resume_phase "$p"; then
      have=$((have + 1)); launched=$((launched + 1)); sleep "$STAGGER"
    fi
  done
  [[ "$launched" -gt 0 ]] && log "tick: launched $launched (live=$have/$cap)"

  # Deadlock detector. Nothing running, nothing launchable, nothing resumable ⇒
  # no later tick can change state by itself, so idling is pointless — this is
  # the 7-hour/563-tick silence the F79 stall produced. Counted over consecutive
  # ticks so a container dying mid-tick cannot trip it; gate-paused ticks return
  # before this point and never count.
  if (( have == 0 )) && [[ -z "${PLAN_LAUNCH[*]:-}" && -z "${PLAN_RESUME[*]:-}" ]]; then
    STALL_TICKS=$((STALL_TICKS + 1))
  else
    STALL_TICKS=0
  fi
  write_state running ""
  return 0
}

# No live agents, nothing launchable, nothing resumable, and open work left:
# hand the range to a human instead of spinning. Exits non-zero so the systemd
# unit reports `failed` rather than sitting green while making no progress.
stall_exit() {
  local attention
  attention=$("$TASK_BIN" list 2>/dev/null \
    | awk '$2=="blocked"||$2=="stuck"||$2=="needs-review"{n++} END{print n+0}')
  write_state stalled "no live agents, nothing launchable, nothing resumable"
  git -C "$OPS_DIR" push >/dev/null 2>&1 || warn "ops push on stall exit failed"
  pump_notify "$PHASES STALLED after $STALL_TICKS idle ticks — $(open_count) open task(s) remain but none can launch, and no orphaned claim is resumable. $attention task(s) need human review (blocked/stuck/needs-review)."
  exit 3
}

# ── Drain check ────────────────────────────────────────────────────────────────
is_drained() {
  [[ "$(open_count)" -eq 0 && "$(apl_count_live_agents)" -eq 0 ]]
}

# ── Restart-safe state (E2) ────────────────────────────────────────────────────
# Persist enough that a restarted supervisor (or the monitor) can re-derive what
# is in flight. Restart safety itself falls out of D3: liveness comes from
# `docker ps` and the queue is recomputed each tick, so a fresh supervisor never
# disturbs running containers and never double-launches — the state file just
# makes the run observable (paused_reason) and lets a restart confirm it is
# resuming the same range.
write_state() {  # $1=status(running|paused|drained) $2=paused_reason
  local status="${1:-running}" reason="${2:-}"
  jq -n \
    --arg phases "$PHASES" --argjson jobs "$JOBS" --argjson ceiling "$CEILING" \
    --arg grain "$GRAIN" --arg started "$PUMP_STARTED_AT" \
    --arg last_tick "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson live "$(apl_count_live_agents)" --argjson open "$(open_count)" \
    --arg status "$status" --arg reason "$reason" \
    '{phases:$phases, jobs:$jobs, ceiling:$ceiling, grain:$grain,
      started_at:$started, last_tick:$last_tick, live_agents:$live,
      open_tasks:$open, status:$status, paused_reason:$reason}' \
    >| "$STATE_FILE" 2>/dev/null || true
}

# ── Notify (E5) ────────────────────────────────────────────────────────────────
# Pluggable: ARACHNE_NOTIFY_CMD reads the message on stdin; defaults to
# `notify-send` (desktop) when present, else a no-op (just the log line).
pump_notify() {
  local msg="$1"
  log "$msg"
  if [[ -n "${TASKPUMP_NOTIFY_CMD:-}" ]]; then
    printf '%s\n' "$msg" | ${TASKPUMP_NOTIFY_CMD} >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "$PROG_NAME" "$msg" >/dev/null 2>&1 || true
  fi
}

# ── Detach (E3) ────────────────────────────────────────────────────────────────
# Re-exec the SAME command minus --detach, fully detached so a multi-day run
# survives terminal close / SSH drop. Prefers a transient systemd --user unit
# (clean `journalctl --user -u taskpump-pump`, Restart not set for transient —
# use systemd/taskpump-pump.service for restart-on-failure); falls back to
# setsid+nohup. The persistent unit template is systemd/taskpump-pump.service.
detach_and_exit() {
  local -a fwd=()
  local a
  for a in "${ORIG_ARGS[@]}"; do [[ "$a" == "--detach" ]] || fwd+=("$a"); done
  local unit="$PROG_NAME-$(printf '%s' "$PHASES" | tr -c 'A-Za-z0-9' '-')"
  if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
    systemd-run --user --collect --unit="$unit" \
      --description="$PROG_NAME usage-governed pump ($PHASES)" \
      --setenv=GITHUB_TOKEN="${GITHUB_TOKEN:-}" \
      "$0" "${fwd[@]}"
    log "detached as systemd --user unit '$unit'."
    log "  status: systemctl --user status $unit   logs: journalctl --user -u $unit -f"
    log "  stop:   systemctl --user stop $unit"
  else
    setsid nohup "$0" "${fwd[@]}" >>"$PUMP_LOG" 2>&1 </dev/null &
    local pid=$!
    disown "$pid" 2>/dev/null || true
    log "detached via setsid+nohup (pid=$pid, log=$PUMP_LOG)."
    log "  stop: kill $pid   (or: pkill -f '$PROG_NAME.*$PHASES')"
  fi
  exec_monitor
  exit 0
}

# Hand the launching terminal to the monitor. Only ever called after the
# supervisor is detached, so quitting the monitor (q) leaves the pump running —
# it is a viewer, not the run. Skipped when not interactive so cron/CI and the
# detached re-exec itself never block on a UI.
exec_monitor() {
  [[ "$MONITOR" -eq 1 ]] || return 0
  [[ -t 0 && -t 1 ]] || { log "not a tty — skipping the monitor (run: $MONITOR_BIN --watch)"; return 0; }
  [[ -x "$MONITOR_BIN" ]] || { log "no monitor at $MONITOR_BIN — skipping"; return 0; }
  # The supervisor writes .taskpump-pump.state on its first tick; give it a beat
  # so the monitor's opening frame shows the run instead of "no pump".
  sleep 2
  log "opening the monitor (q to close it; the pump keeps running)"
  exec "$MONITOR_BIN" --watch
}

# ── Modes ──────────────────────────────────────────────────────────────────────
case "$MODE" in
  render)
    # Print the phase-drain brief rendered for $PHASES to stdout (debug / test).
    # Goes through render_brief_stream so {{DEPENDS_ON}} is expanded too (v1).
    [[ -f "$BRIEF_TEMPLATE" ]] || die "$(missing_brief_template_msg)"
    render_brief_stream "$PHASES"
    exit 0
    ;;
  resume-note)
    # Print the resume preamble a stalled phase WOULD get, to stdout (debug /
    # test). Same split as render_brief: the stream form is the testable one.
    detect_stalled_orphans
    id="${STALL_TASK[$PHASES]:-}"
    [[ -n "$id" ]] || die "no stalled orphan detected for phase $PHASES (nothing to resume)"
    render_resume_note_stream "$WORKTREES_DIR/$(phase_branch "$PHASES")" "$(phase_branch "$PHASES")" "$id"
    exit 0
    ;;
  dry)
    echo "[dry-run] no image build, no launches, no ops mutation"
    print_plan
    exit 0
    ;;
  list)
    print_plan
    exit 0
    ;;
esac

# Real run (run / once): detach first if asked, then check prerequisites.
[[ "$DETACH" -eq 1 && "$MODE" == "run" ]] && detach_and_exit

# Restart detection (E2): a leftover state file for the SAME range means we are
# resuming; D3 makes that safe (re-derive from task files + docker ps).
if [[ -f "$STATE_FILE" ]]; then
  prev_phases="$(jq -r '.phases // empty' "$STATE_FILE" 2>/dev/null || true)"
  if [[ "$prev_phases" == "$PHASES" ]]; then
    log "resuming pump for $PHASES (re-deriving from task files + docker ps; running agents untouched)."
  elif [[ -n "$prev_phases" ]]; then
    warn "a pump state file exists for a different range ($prev_phases); overwriting with $PHASES."
  fi
fi

[[ -d "$CLAUDE_DIR" ]] || die "no ~/.claude; run 'claude' to authenticate first"
if [[ -z "${GITHUB_TOKEN:-}" ]] && command -v gh >/dev/null 2>&1; then
  GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"; export GITHUB_TOKEN
fi
[[ -f "$BRIEF_TEMPLATE" ]] || die "$(missing_brief_template_msg)"

# Seed the live cap file for discoverability / retuning.
[[ -f "$CAP_FILE" ]] || echo "$JOBS" >| "$CAP_FILE" 2>/dev/null || true

# Skip the (~9 GB) image build when we will not launch containers — keeps the
# NO_LAUNCH tick (tests / live read-only validation) side-effect-free.
if [[ "${TASKPUMP_PUMP_NO_LAUNCH:-0}" -ne 1 ]]; then
  # Before the build and before any runner call: launching needs an image, and
  # there is deliberately no default — a wrong silent image is strictly worse
  # than a loud missing one.
  [[ -n "$IMAGE" ]] || die "no container image configured: set TASKPUMP_IMAGE (--dry-run works without one)"
  [[ -x "$RUNNER" ]] || die "no agent runner at $RUNNER (set TASKPUMP_RUNNER)"
  if [[ -n "$IMAGE_BUILD_CMD" ]]; then
    log "Building the $IMAGE image ..."
    ( cd "$REPO_ROOT" && eval "$IMAGE_BUILD_CMD" ) >/dev/null || die "image build failed"
  fi
fi

# Materialise auto/trunk + its worktree once, before the loop (A3). Real run
# only — skipped under NO_LAUNCH (tests / read-only validation) and a no-op when
# --integration-trunk is off.
if [[ "${TASKPUMP_PUMP_NO_LAUNCH:-0}" -ne 1 ]]; then
  ensure_trunk
fi

# Belt-and-suspenders disk discipline (A4): auto-start the disk watchdog like
# run-parallel.sh does, so disk pressure also drops the live pool cap (cap-file
# path) on top of the feed gate. --auto-exit retires it once no agents remain.
# Skipped for --once / NO_LAUNCH ticks and when the disk gate is disabled.
if [[ "$MODE" == "run" && "$DISK_GATE" -eq 1 && "${TASKPUMP_PUMP_NO_LAUNCH:-0}" -ne 1 ]]; then
  nohup "$DISK_WATCHDOG_BIN" --auto-exit \
    >>"$DISK_WATCHDOG_LOG" 2>&1 </dev/null &
  disown "$!" 2>/dev/null || true
  log "disk watchdog started (cap-file path; log: $DISK_WATCHDOG_LOG)"
fi

log "Pump: phases=$PHASES grain=$GRAIN cap=$JOBS (live via $CAP_FILE) ceiling=${CEILING}% tick=${TICK}s"
log "Singular supervisor; Ctrl-C stops feeding but leaves running agents. Monitor: $MONITOR_BIN --watch"

if [[ "$MODE" == "once" ]]; then
  do_tick
  log "single tick complete (--once)"
  exit 0
fi

# Multi-day drain loop.
while true; do
  do_tick
  if is_drained; then
    log "range $PHASES drained: no open tasks and no live agents remain."
    break
  fi
  if (( STALL_TICKS >= STALL_EXIT_TICKS )); then
    stall_exit
  fi
  sleep "$TICK"
done

# Graduate the integration trunk as one auto/trunk → main PR (A3, no-op when
# --integration-trunk is off), then push canonical ops/.
graduate_trunk
git -C "$OPS_DIR" push >/dev/null 2>&1 || warn "final ops push failed"
write_state drained ""
# Tally non-done terminal states that need a human (blocked / stuck / needs-review).
attention=$("$TASK_BIN" list 2>/dev/null \
  | awk '$2=="blocked"||$2=="stuck"||$2=="needs-review"{n++} END{print n+0}')
pump_notify "$PHASES drained: 0 open should remain ($(open_count) open), $attention task(s) need human review (blocked/stuck/needs-review)."
exit 0
