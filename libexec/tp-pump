#!/usr/bin/env bash
# tp-pump — usage-governed, DAG-aware, keep-acquiring task-loop supervisor.
#
# A singular HOST-level loop (so there is no cross-agent claim race) that points
# a sandboxed-agent substrate at a RANGE of phases and drains it for days:
#
#   * Queue = the live eligible frontier, recomputed every tick from `blockers:`
#     via `tp task ready --phases A..B`. Newly-unblocked tasks enter
#     automatically — this is "keep acquiring".
#   * Dispatch grain = phase by default: each phase with eligible work gets a
#     worktree that drains its own sub-tree serially via the in-context
#     `tp task next --phase` loop; phases fan out in parallel. --grain task
#     dispatches each eligible TASK instead — one worktree, branch and agent per
#     task — for long independent siblings or a single-phase range. Two tasks run
#     concurrently only when their declared `files:` are disjoint; an undeclared
#     footprint is exclusive, so it runs alone.
#   * Liveness from the container runtime, never task status: a parked epic
#     (in_progress, dead container) auto-resumes; a live one is never
#     double-launched.
#   * Feed gate: pause LAUNCHING new work — running agents are never killed —
#     when any gate in TASKPUMP_GATES says so. The default chain is host token
#     freshness, the plan's usage ceiling, and free disk; the shipped net-health
#     gate joins it (first) when TASKPUMP_HEALTH_GATE=1. Feeding resumes by
#     itself when the gate clears.
#   * Disk discipline: a completed phase's worktree build dir is reclaimed each
#     tick once its container has exited, so a multi-day drain's disk footprint
#     stays bounded — when TASKPUMP_RECLAIM_CMD names how; unconfigured, the
#     pass is a no-op (TASKPUMP_DISK_RECLAIM=0 disables it entirely).
#   * Drains: exits only when no open task remains in range AND no live agent
#     container remains, then pushes the ledger and emits a summary.
#
# Usage:
#   tp pump --phases F55..F63 --jobs 4 --usage-ceiling 95 --grain phase
#   tp pump --phases F55 --grain task --jobs 3   # one agent per eligible task
#   tp pump --phases F55..F63 --dry-run     # print the plan, launch nothing
#   tp pump --phases F64 --list             # one planning pass, then exit
#   tp pump --phases F64 --once             # one REAL tick (scrub+gate+launch), exit
#
# Monitor handoff:
#   With --detach, the supervisor goes to systemd and this terminal is then
#   handed to the monitor — quitting it (q) leaves the pump running.
#   --no-monitor (or TASKPUMP_PUMP_MONITOR=0) keeps your shell; a non-tty skips
#   it automatically.
# HELP-END
#
# Stalled-claim auto-resume (on by default):
#   A phase whose only blocker is its OWN orphaned claim — dead container, work
#   already committed, so the reclaim path refuses to reopen it — is relaunched
#   to CONTINUE that task, with a resume note pointing the agent at it. Bounded
#   by --resume-max no-progress attempts (a new commit resets the count); when
#   spent, the task is marked needs-review and the pump notifies. When nothing
#   is live, launchable, or resumable, the pump exits 3 instead of idling.
#   --resume-max N          attempts before escalating to a human (default 3)
#   --no-resume-stalled     disable; revert to parking orphans for review
#
# Configuration lives in taskpump.conf (see taskpump.conf.example for the full
# key surface) or the environment; the configuration block below names every key
# this tool reads, with the default each one falls back to. The legacy ARACHNE_*
# spellings still arrive here through lib/config.sh.
set -euo pipefail

# ── TaskPump config core ──────────────────────────────────────────────────────
_tp_self_root="$(CDPATH='' cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/config.sh
. "$_tp_self_root/lib/config.sh"
tp_load_config

# ── The two roots (issue #32) ─────────────────────────────────────────────────
# TaskPump's INSTALL and the consumer's WORKSPACE are different directories in
# every vendored layout and the same directory only in dogfooding. The install
# root — lib/, libexec/, gates/, runners/, templates/, hooks/ — is
# script-relative: TP_ROOT and friends, set above by lib/config.sh. The
# workspace — the repository this pump DRIVES: the image-build context, the
# phase branches and agent worktrees, every `git -C` below, the state-dir
# default — is a property of the CALLER, resolved exactly as tp-task resolves
# the ledger. REPO_ROOT used to be script-relative too, which pointed every one
# of those surfaces at the vendored taskpump/ checkout for a submodule/subtree
# consumer: branches cut in the wrong object store, agent worktrees inside the
# vendored copy, right-looking git answers against the wrong repository.
# TASKPUMP_WORKSPACE_ROOT pins it explicitly (env > conf; a conf-relative value
# anchors to the conf's workspace); unset, the config anchor decides — which
# for the dogfood layout is the same directory the script-relative derivation
# always produced.
tp_resolve_workspace
if [[ -n "${TASKPUMP_WORKSPACE_ROOT:-}" ]]; then
  if ! REPO_ROOT="$(CDPATH='' cd -- "$TASKPUMP_WORKSPACE_ROOT" 2>/dev/null && pwd)"; then
    printf '%s: TASKPUMP_WORKSPACE_ROOT names a missing directory: %s\n' \
      "${TASKPUMP_PUMP_PROG_NAME:-tp-pump}" "$TASKPUMP_WORKSPACE_ROOT" >&2
    exit 1
  fi
else
  REPO_ROOT="$TP_WS_ROOT"
fi
# The fallback rung is not an answer for a SUPERVISOR: when neither a
# discovered conf nor the cwd probe anchored the workspace, TP_WS_ROOT is the
# install root — and a real run would build, branch, and cut worktrees inside
# the vendored TaskPump itself, then report the range DONE against the
# dogfood ledger at rc=0. tp-task refuses this rung for mutating verbs; the
# pump is the most mutating tool in the box. The vendored layout (install
# root at or inside the caller's worktree) keeps the fallback, exactly as
# tp-task allows it.
# An explicitly named ledger (env, or a conf value the loader anchored) is
# the caller saying where the work lives — the same first-rung exemption
# tp_require_resolved_ledger grants.
if [[ -z "${TASKPUMP_WORKSPACE_ROOT:-}" && -z "${TASKPUMP_PUMP_TASKS_DIR:-}" \
      && -z "${TASKPUMP_TASKS_DIR:-}" && "$TP_WS_VIA" == "install-root" ]]; then
  _pump_ws_vendored=0
  if [[ -n "$TP_WS_CWD_ROOT" ]]; then
    [[ "$TP_ROOT" == "$TP_WS_CWD_ROOT" || "$TP_ROOT" == "$TP_WS_CWD_ROOT"/* ]] && _pump_ws_vendored=1
  fi
  if (( ! _pump_ws_vendored )); then
    printf '%s: refusing to run against the TaskPump installation itself.\n  No taskpump.conf above $PWD, $PWD is not inside a consumer repository, and no pin was given — so resolution fell back to the install root:\n    %s\n  A drain planned there would target the install, not your project.\n  fix: run from your project root, or set TASKPUMP_WORKSPACE_ROOT=/path/to/project\n' \
      "${TASKPUMP_PUMP_PROG_NAME:-tp-pump}" "$TP_WS_ROOT" >&2
    exit 1
  fi
  unset _pump_ws_vendored
fi
# shellcheck source=../lib/pump-lib.sh
source "$TP_LIB_DIR/pump-lib.sh"

# ── Configuration ─────────────────────────────────────────────────────────────
# Every value here has a default that reproduces what the pump did before any of
# it was configurable, so a project with no taskpump.conf sees no change. Where a
# key exists in both a shared and a pump-scoped spelling, the pump-scoped one
# wins: TASKPUMP_TASKS_DIR is what every tool reads, TASKPUMP_PUMP_TASKS_DIR
# points this supervisor somewhere else. The legacy ARACHNE_* names still arrive
# here through the config core.

# The agent's home and config on the host. Mounted read-only into a launched
# container, and the credentials file the token gate reads.
CLAUDE_DIR="${TASKPUMP_AGENT_HOME:-$HOME/.claude}"
CLAUDE_JSON="${TASKPUMP_AGENT_CONFIG:-$HOME/.claude.json}"

# The ledger: a git checkout the pump pulls at the top of every tick and pushes
# when the range drains, holding the task files.
OPS_DIR="${TASKPUMP_PUMP_OPS_DIR:-${TASKPUMP_LEDGER_REPO:-$REPO_ROOT/ops}}"
# Tasks dir — overridable independently of OPS_DIR so phase_dependencies / brief
# rendering can be unit-tested against a flat fixture dir. The default derives
# from the ledger probe against the WORKSPACE (REPO_ROOT above), exactly as
# tp-task and tp-monitor derive theirs (issue #2): the pump is the tool that
# tells a launched agent where the ledger is, so it must not keep a private
# opinion. It anchors to the workspace root rather than OPS_DIR on purpose —
# the ledger-repo and the ledger-directory are separate questions, and coupling
# them is what baked Arachne's ops/task-loop/ shape in. A consumer whose ledger
# lives under a separate ledger repo names it via TASKPUMP_LEDGER_PROBE.
TASKS_SUBDIR="${TASKPUMP_LEDGER_PROBE:-${TASKPUMP_TASKS_SUBDIR:-tasks}}"
TASKS_DIR="${TASKPUMP_PUMP_TASKS_DIR:-${TASKPUMP_TASKS_DIR:-$REPO_ROOT/$TASKS_SUBDIR}}"
# Under an explicit workspace pin, the ledger CLI this pump spawns still
# anchors to its own $PWD — a different workspace entirely when a mismatch is
# the reason the pin was set. The pump's answer and its children's answer must
# not diverge (that split is a silent wrong ledger), so hand the children the
# pinned derivation — unless the caller (env or conf) already named a ledger,
# which both sides honor identically.
if [[ -n "${TASKPUMP_WORKSPACE_ROOT:-}" && -z "${TASKPUMP_TASKS_DIR:-}" ]]; then
  export TASKPUMP_TASKS_DIR="$REPO_ROOT/$TASKS_SUBDIR"
fi
# The file that proves the ledger submodule is populated in a fresh worktree.
# NO default (issue #3): the old one, ops/planning/STATUS.md, was Arachne's —
# for anyone else it either never exists (init runs every time, wasteful but
# safe) or exists for the wrong reason and SKIPS the init that some other
# submodule still needs, silently. Unset, the pump always runs the (idempotent,
# cheap) submodule init; the probe is a pure optimization a consumer opts into.
SUBMODULE_PROBE="${TASKPUMP_SUBMODULE_PROBE:-}"

# Sibling tools.
TASK_BIN="${TASKPUMP_TASK:-$TP_LIBEXEC_DIR/tp-task}"
USAGE_BIN="${TASKPUMP_USAGE:-$TP_GATES_DIR/claude-usage}"
DISK_WATCHDOG_BIN="${TASKPUMP_DISK_WATCHDOG:-$TP_LIBEXEC_DIR/tp-disk-watchdog}"
MONITOR_BIN="${TASKPUMP_MONITOR_BIN:-$TP_LIBEXEC_DIR/tp-monitor}"

# The agent runner. The pump decides WHAT to launch and WHERE; the runner owns
# HOW — the sandbox, the mounts, the credentials. See runners/claude-docker.
RUNNER="${TASKPUMP_RUNNER:-$TP_ROOT/runners/claude-docker/runner.sh}"
DOCKER="${TASKPUMP_DOCKER:-${DOCKER:-docker}}"
# Liveness is the runner's to answer when it can (docs/RUNNERS.md §1.3). This
# opts THIS process in; the read-only observers that share pump-lib (the monitor,
# cleanup, both watchdogs) load the same config and deliberately do not, so they
# keep scraping container names until each is migrated on purpose.
# shellcheck disable=SC2034  # read by apl_live_agents (lib/pump-lib.sh)
APL_LIVENESS_RUNNER="$RUNNER"
# No default image on purpose (G1.5): a wrong-but-plausible default launches the
# wrong agent silently, so a real run fails loudly below when this is empty.
# --dry-run and NO_LAUNCH ticks never launch and keep working imageless.
IMAGE="${TASKPUMP_IMAGE:-}"
# The default names the shipped claude-docker runner's own entrypoint at the
# path the image contract bakes it (docs/RUNNERS.md §4.0). Arachne's image
# layout (/entrypoint-parallel.sh) survives as the examples/arachne.conf pin.
ENTRYPOINT="${TASKPUMP_ENTRYPOINT:-/entrypoint.sh}"
# Building the agent image once before the drain. Unset ⇒ the default docker
# build of the repo root; set to the empty string ⇒ skip it entirely, which is
# what a runner that pulls a prebuilt image wants. (Building really belongs to
# the runner; moving it there is a second round of the launch seam.)
if [[ -n "${TASKPUMP_IMAGE_BUILD+set}" ]]; then
  IMAGE_BUILD_CMD="$TASKPUMP_IMAGE_BUILD"
else
  IMAGE_BUILD_CMD="\"$DOCKER\" build -t \"$IMAGE\" \"$REPO_ROOT\""
fi

# Worktrees base — overridable so the reclaim sweep / launcher can be unit-tested
# against a fixture tree (single source for both launch_unit and reclaim).
WORKTREES_DIR="${TASKPUMP_PUMP_WORKTREES_DIR:-${TASKPUMP_WORKTREES_DIR:-$REPO_ROOT/.worktrees}}"

# What the templates say about this project. Arachne's wording survives through
# the examples/arachne.conf pins, not through what is baked here.
#   TASKPUMP_TASK_CLI     how an agent invokes the ledger CLI from its worktree.
#                         Default `tp task` — the README quickstart's own
#                         spelling for every ledger verb, so a rendered brief
#                         commands something an agent with tp on PATH can run
#                         (`tp task claim …`), matching the entrypoint's
#                         workspace-CLI default of `tp`.
#   TASKPUMP_VERIFY_CMDS  newline-separated commands a task must leave green;
#                         rendered mid-sentence as `a` and `b`. Default: empty —
#                         no shipped default can know a project's toolchain, so
#                         the templates' {{#VERIFY_CMDS}} sections drop out
#                         until a consumer names its own bar.
#   TASKPUMP_PROJECT_BRIEF  one paragraph pointing an agent at the project's own
#                         contributor documentation
TASK_CLI="${TASKPUMP_TASK_CLI:-tp task}"
TASK_CLI_NAME="$(basename "$TASK_CLI")"
_tp_default_project_brief="Read the contributor documentation for this repository (CLAUDE.md, CONTRIBUTING.md, or equivalent) before writing code, then read the design note that phase {{PHASE}} is built against."
VERIFY_CMDS="${TASKPUMP_VERIFY_CMDS:-}"
PROJECT_BRIEF="${TASKPUMP_PROJECT_BRIEF:-$_tp_default_project_brief}"

# Where the run's dotfiles live. One knob moves them all out of the repo root;
# each filename is still individually overridable.
STATE_DIR="${TASKPUMP_STATE_DIR:-$REPO_ROOT}"
AGENT_LOG_NAME="${TASKPUMP_AGENT_LOG_NAME:-.taskpump-agent.log}"
BRIEF_OUT_NAME="${TASKPUMP_BRIEF_OUT_NAME:-.taskpump-phase-brief.md}"
RESUME_NOTE_NAME="${TASKPUMP_RESUME_NOTE_NAME:-.taskpump-resume.md}"
# Written inside the container rather than here, but named here so one place
# owns every filename the run drops into a worktree.
GOAL_NOTE_NAME="${TASKPUMP_GOAL_NOTE_NAME:-.taskpump-goal.md}"
# Fingerprint of the last pre-tick hook output, so a persistent condition is
# notified once rather than every tick. Survives a supervisor restart.
HOOK_MARK_FILE="${TASKPUMP_HOOK_MARK_FILE:-${TASKPUMP_FSGUARD_MARK_FILE:-$STATE_DIR/.taskpump-fsguard.notified}}"
DISK_WATCHDOG_LOG="${TASKPUMP_DISK_WATCHDOG_LOG:-$STATE_DIR/.taskpump-disk-watchdog.log}"

# Defaults (flags override).
PHASES=""
# The supervisor's own default cap. Callers that set nothing at all fall back to
# pump-lib's TASKPUMP_JOBS_FALLBACK instead; see the note there.
JOBS="${TASKPUMP_JOBS:-${JOBS:-4}}"
CEILING="${TASKPUMP_USAGE_CEILING:-95}"
GRAIN="phase"
TICK="${TASKPUMP_TICK:-${POOL_TICK:-30}}"
STAGGER="${TASKPUMP_STAGGER:-${POOL_STAGGER:-3}}"
HEALTH_WINDOW="${TASKPUMP_HEALTH_WINDOW:-${HEALTH_WINDOW:-120}}"
# net-health is host-hardware policy (one machine's WiFi firmware signatures),
# so it ships OFF: TASKPUMP_HEALTH_GATE=1 opts it into the default chain, ahead
# of the generic three. The reference consumer pins 1 in examples/arachne.conf.
HEALTH_GATE="${TASKPUMP_HEALTH_GATE:-0}"
USAGE_GATE=1
DISK_GATE=1
BRANCH_PREFIX="${TASKPUMP_PUMP_BRANCH_PREFIX:-${TASKPUMP_BRANCH_PREFIX:-feat/}}"
BASE_REF="${TASKPUMP_PUMP_BASE:-${TASKPUMP_BASE:-main}}"
BASE_GIVEN=0      # set when --base is passed explicitly (gates the trunk override)
# ── Autonomous integration trunk (A3 / F65.6) ────────────────────────────────
# Opt-in behind --integration-trunk (default OFF): when on, the run cuts every
# phase worktree from a continuously-integrated auto/trunk branch instead of a
# stale base, merges each quiescent phase into it behind a build gate, and
# graduates the whole drain as one auto/trunk → main PR. Flag off ⇒ byte-for-byte
# the prior pump.
INTEGRATION=0
INTEGRATION_TRUNK="${TASKPUMP_PUMP_TRUNK:-${TASKPUMP_TRUNK:-auto/trunk}}"
INTEGRATION_BASE="${TASKPUMP_PUMP_INTEGRATION_BASE:-${TASKPUMP_INTEGRATION:-main}}"
# Build gate run on each merge into the trunk (empty ⇒ default cargo check +
# smoke). Overridable for tests (TASKPUMP_BUILD_GATE='false' forces red).
BUILD_GATE_CMD="${TASKPUMP_PUMP_BUILD_CMD:-${TASKPUMP_BUILD_GATE:-}}"
TRUNK_LOCK_FILE="${TASKPUMP_PUMP_TRUNK_LOCK_FILE:-$STATE_DIR/.auto-trunk.lock}"
QUARANTINE_FILE="${TASKPUMP_PUMP_QUARANTINE_FILE:-$STATE_DIR/.auto-trunk-quarantine}"
# Reclaim of a finished phase's build artifacts. A configured command is run
# with the worktree as its cwd; empty (the default) makes the per-tick reclaim
# pass a no-op — only a consumer knows how its build output is reclaimed, so
# there is no built-in fallback (G1.7 retired the cargo one).
RECLAIM_CMD="${TASKPUMP_RECLAIM_CMD:-}"
MAX_TURNS="${TASKPUMP_MAX_TURNS:-${MAX_TURNS:-600}}"
# The turn budget a --grain task container gets. The phase default is sized for
# a container that drains a whole sub-tree over hours; a session that claims one
# task, finishes it and exits does not need it, and a budget far larger than the
# work is a cost ceiling that never binds.
TASK_MAX_TURNS="${TASKPUMP_TASK_MAX_TURNS:-120}"
AGENT_MODEL="${TASKPUMP_AGENT_MODEL:-${AGENT_MODEL:-opus}}"
# ── Stalled-claim auto-resume (2026-08-05) ───────────────────────────────────
# A phase starved solely by its own orphaned-but-committed claim is relaunched
# to *continue* that task, bounded by RESUME_MAX no-progress attempts. Default
# ON: the behaviour it replaces is a permanent, silent idle loop.
RESUME_STALLED=1
RESUME_MAX="${TASKPUMP_PUMP_RESUME_MAX:-${TASKPUMP_RESUME_MAX:-3}}"
# Consecutive fully-deadlocked ticks before the pump gives up and pages a human.
# >1 so a container dying mid-tick cannot trip it.
STALL_EXIT_TICKS="${TASKPUMP_PUMP_STALL_EXIT_TICKS:-${TASKPUMP_STALL_EXIT_TICKS:-3}}"
STALL_TICKS=0
RESUME_TASK_ID=""
LAST_PARKED_FP=""
CAP_FILE="${TASKPUMP_POOL_CAP_FILE:-$STATE_DIR/.taskpump-pool-cap}"
RESET_FILE="${TASKPUMP_USAGE_RESET_FILE:-$STATE_DIR/.taskpump-usage-reset}"
MODE="run"        # run | dry | list | once | render | resume-note | help
DETACH=0
# After --detach hands the supervisor to systemd, the launching terminal is free
# — and watching the monitor is what you almost always want next, so take it
# over by default. TASKPUMP_PUMP_MONITOR=0 or --no-monitor opts out; a non-tty
# (cron, CI, a nested pump re-exec) opts out automatically.
MONITOR="${TASKPUMP_PUMP_MONITOR:-1}"
STATE_FILE="${TASKPUMP_PUMP_STATE_FILE:-$STATE_DIR/${TASKPUMP_PUMP_STATE_NAME:-.taskpump-pump.state}}"
PUMP_LOG="${TASKPUMP_PUMP_LOG:-$STATE_DIR/.taskpump-pump.log}"
PUMP_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Name this supervisor answers to as itself: the diagnostic prefix, the plan
# header, the notify-send title, and the transient systemd unit. Pump-scoped
# sibling of tp-task's TASKPUMP_PROG_NAME — the two tools identify themselves
# differently, so they cannot share one key. The reference consumer pins the
# historical `arachne-pump` in examples/arachne.conf.
PROG_NAME="${TASKPUMP_PUMP_PROG_NAME:-tp-pump}"

warn() { printf '%s: %s\n' "$PROG_NAME" "$*" >&2; }
die()  { warn "$*"; exit 1; }
log()  { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }
# Quiet per-tick skip traces (e.g. "already integrated") — off unless
# TASKPUMP_PUMP_DEBUG=1, so reconcile doesn't spam the log every TICK seconds.
dbg_log() { [[ "${TASKPUMP_PUMP_DEBUG:-0}" -eq 1 ]] && log "$*"; return 0; }

# Keep the verbatim argv so --detach can re-exec the same command minus --detach.
ORIG_ARGS=("$@")

# ── Arg parsing ────────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --phases|--phase) PHASES="$2"; shift 2;;
    --phases=*) PHASES="${1#--phases=}"; shift;;
    --phase=*)  PHASES="${1#--phase=}"; shift;;
    --jobs|-j)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--jobs needs a non-negative integer"
      JOBS="$2"; shift 2;;
    --usage-ceiling)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--usage-ceiling needs an integer"
      CEILING="$2"; shift 2;;
    --usage-ceiling=*) CEILING="${1#--usage-ceiling=}"; shift;;
    --grain) GRAIN="$2"; shift 2;;
    --grain=*) GRAIN="${1#--grain=}"; shift;;
    --tick)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--tick needs an integer (seconds)"
      TICK="$2"; shift 2;;
    --branch-prefix) BRANCH_PREFIX="$2"; shift 2;;
    --base) BASE_REF="$2"; BASE_GIVEN=1; shift 2;;
    --integration-trunk) INTEGRATION=1; shift;;
    --integration-base) INTEGRATION_BASE="$2"; shift 2;;
    --integration-base=*) INTEGRATION_BASE="${1#--integration-base=}"; shift;;
    --resume-max)
      [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || die "--resume-max needs a positive integer"
      RESUME_MAX="$2"; shift 2;;
    --resume-max=*) RESUME_MAX="${1#--resume-max=}"; shift;;
    --no-resume-stalled) RESUME_STALLED=0; shift;;
    --no-health-gate) HEALTH_GATE=0; shift;;
    --no-usage-gate)  USAGE_GATE=0; shift;;
    --no-disk-gate)   DISK_GATE=0; shift;;
    --dry-run) MODE="dry"; shift;;
    --list)    MODE="list"; shift;;
    --once)    MODE="once"; shift;;
    --render-brief) MODE="render"; PHASES="$2"; shift 2;;   # print rendered brief, exit
    --render-brief=*) MODE="render"; PHASES="${1#--render-brief=}"; shift;;
    --render-resume-note) MODE="resume-note"; PHASES="$2"; shift 2;;   # print resume preamble, exit
    --render-resume-note=*) MODE="resume-note"; PHASES="${1#--render-resume-note=}"; shift;;
    --detach)  DETACH=1; shift;;          # F64.5 wires the actual detach mechanism
    --no-monitor) MONITOR=0; shift;;      # don't hand the terminal to arachne-monitor
    -h|--help) MODE="help"; shift;;
    --*) die "unknown flag $1 (try --help)";;
    *) die "unexpected argument: $1";;
  esac
done

usage() { apl_help "$0"; }
[[ "$MODE" == "help" ]] && { usage; exit 0; }

[[ -n "$PHASES" ]] || die "--phases is required (e.g. --phases F55..F63)"

# A missing ledger must never read as a drained range: open_count and
# frontier_phases mask tp-task's refusal into "0 open tasks" with their
# 2>/dev/null fallbacks, which would render every phase DONE at rc=0 — the
# false-drain shape this tool's incident history is about. Refuse up front.
[[ -d "$TASKS_DIR" ]] || die "tasks directory does not exist: $TASKS_DIR
  A drained range and a missing ledger must not look alike, so this is an
  error instead. \`tp task resolve --all\` prints how resolution answered."
case "$GRAIN" in
  phase|task) ;;
  chain) die "grain '$GRAIN' is not implemented yet; only --grain phase and --grain task are supported (SPEC_GAP: D4 chain grain deferred)";;
  *) die "unknown grain '$GRAIN' (phase|task|chain)";;
esac

# When integration is on and the operator did not pin a base, cut worktrees from
# the continuously-integrated trunk rather than the (stale) base branch. An
# explicit --base always wins (e.g. a canary cutting from a throwaway base).
if [[ "$INTEGRATION" -eq 1 && "$BASE_GIVEN" -eq 0 ]]; then
  BASE_REF="$INTEGRATION_TRUNK"
fi

# ── Phase-range expansion (mirrors arachne-task's expand_phases for display) ───
# Numeric ranges + comma lists; non-numeric tokens pass through uppercased.
# Honors TASKPUMP_PHASE_SIGIL exactly as arachne-task does: with sigil G,
# "G55", "g55" and "55" all canonicalize to "G55".
: "${TASKPUMP_PHASE_SIGIL:=T}"

# Drop a leading sigil from a phase token, case-insensitively (tp-task's
# strip_phase_sigil, mirrored here because tp-task is an executable, not a lib).
pump_strip_phase_sigil() {
  local value=$1 sigil=$TASKPUMP_PHASE_SIGIL
  if [[ -n "$sigil" && "${value,,}" == "${sigil,,}"* ]]; then
    value=${value:${#sigil}}
  fi
  printf '%s' "$value"
}

pump_expand_phases() {
  local spec=$1 comp a b lo hi i n sigil=$TASKPUMP_PHASE_SIGIL
  local IFS=','
  for comp in $spec; do
    comp="${comp//[[:space:]]/}"; [[ -z "$comp" ]] && continue
    if [[ "$comp" == *..* ]]; then
      a="${comp%%..*}"; b="${comp##*..}"
      a=$(pump_strip_phase_sigil "$a"); b=$(pump_strip_phase_sigil "$b")
      [[ "$a" =~ ^[0-9]+$ && "$b" =~ ^[0-9]+$ ]] \
        || die "bad phase range '$comp' (expected ${sigil}N..${sigil}M)"
      if (( a <= b )); then lo=$a; hi=$b; else lo=$b; hi=$a; fi
      for (( i=lo; i<=hi; i++ )); do printf '%s%s\n' "$sigil" "$i"; done
    else
      comp="${comp%%.*}"; n=$(pump_strip_phase_sigil "$comp")
      if [[ "$n" =~ ^[0-9]+$ ]]; then printf '%s%s\n' "$sigil" "$n"; else printf '%s\n' "${comp^^}"; fi
    fi
  done
}

# Validate the spec once, up front, in the MAIN shell. Every consumer below
# reads this function through a process substitution, where `die` kills only
# the subshell — a malformed range would be reported and then ignored, leaving
# the pump to plan (and idle green) against an empty phase list.
pump_expand_phases "$PHASES" >/dev/null

# The tasks dir as an agent inside the worktree would name it. Absolute when the
# ledger sits outside the code repo, which is also how an agent would reach it.
tasks_dir_rel() {
  case "$TASKS_DIR" in
    "$REPO_ROOT"/*) printf '%s' "${TASKS_DIR#"$REPO_ROOT"/}" ;;
    *)              printf '%s' "$TASKS_DIR" ;;
  esac
}

phase_branch()    { printf '%s%s' "$BRANCH_PREFIX" "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"; }
branch_slug()     { printf '%s' "${1//\//-}"; }
phase_container() { printf '%s%s' "$(apl_agent_prefix)" "$(branch_slug "$(phase_branch "$1")")"; }

# ── The dispatch UNIT (issue #11) ─────────────────────────────────────────────
# A unit is what this run launches: a PHASE at --grain phase, a TASK at --grain
# task. Everything downstream — the plan arrays, the launcher, the resume path,
# the trunk reconciler — is written in units, so the two grains share one set of
# mechanisms rather than growing a second, quietly-divergent code path.
#
# The branch map is the SAME map at either grain: prefix + the lowercased token,
# so "G3" → feat/g3 and "G3.4" → feat/g3.4. That matters more than it looks. The
# agent name is the branch with "/" → "-" (docs/RUNNERS.md §2), and liveness is
# read back out of those names — so a unit token whose branch cannot round-trip
# is an agent the pump cannot see, which is how you get two agents on one branch.
# `.` is legal in both a git ref and a container name, so a task id rides through
# unchanged; validate_unit_names below refuses at tick zero anything that does
# not, INCLUDING two units whose branches slug to the same name.
unit_branch()    { phase_branch "$1"; }
unit_container() { phase_container "$1"; }
# The phase a unit belongs to: itself at phase grain, the id's phase at task
# grain. What the brief, the goal note, and the runner hand-off call TP_PHASE.
unit_phase()     { [[ "$GRAIN" == "task" ]] && printf '%s' "${1%%.*}" || printf '%s' "$1"; }
# The branch a claim on <task id> would carry if THIS pump owned it. The
# ownership test every absence-driven pass makes before it touches a claim.
task_owner_branch() {
  if [[ "$GRAIN" == "task" ]]; then unit_branch "$1"; else phase_branch "${1%%.*}"; fi
}
# Host worktree the integration trunk is checked out into (A3): auto/trunk →
# <worktrees>/auto-trunk, sharing the configurable worktrees base with phases.
trunk_worktree()  { printf '%s/%s' "$WORKTREES_DIR" "$(branch_slug "$INTEGRATION_TRUNK")"; }

# Validate the branch names this run will CONSTRUCT, once, up front — the same
# discipline as the range check above. Every phase in the range takes the same
# prefix, so a prefix whose branches cannot carry an agent name is a property of
# the CONFIGURATION, not of any one launch: it should fail the run at tick zero
# naming the key to fix, rather than fail per-launch — or worse, launch fine and
# go invisible to liveness later, which is the failure this closes.
# First phase without a pipe: `| head -1` raced the expander's printf into
# EPIPE noise ("printf: write error: Broken pipe") that polluted captured
# plans and flaked the golden suite on CI.
_pump_all_phases="$(pump_expand_phases "$PHASES")"
_pump_probe_branch="$(phase_branch "${_pump_all_phases%%$'\n'*}")"
if ! _pump_branch_problem="$(apl_branch_slug_reject_reason "$_pump_probe_branch")"; then
  die "$_pump_branch_problem
this run constructs that branch from TASKPUMP_BRANCH_PREFIX='$BRANCH_PREFIX'
(--branch-prefix). The agent name is the branch with \"/\" replaced by \"-\", and
that mapping has to be reversible — see docs/RUNNERS.md section 2."
fi
unset _pump_all_phases _pump_probe_branch _pump_branch_problem
# The task-grain half of the same check runs later (validate_unit_names), once
# the ledger readers below are defined: at task grain the units are task IDS, so
# what has to be reversible is a property of the ledger's contents, not of the
# prefix alone.
# pump_in_list <needle> <space-separated-haystack> — membership test for the
# dry-run integration stubs (STUB_INTEGRATE_*).
pump_in_list() {
  local needle="$1" item
  for item in ${2:-}; do [[ "$item" == "$needle" ]] && return 0; done
  return 1
}

# Distinct phases present in the live eligible frontier (have ≥1 launchable task).
frontier_phases() {
  "$TASK_BIN" ready --phases "$PHASES" --json 2>/dev/null \
    | jq -r '.[].phase' 2>/dev/null | sort -u
}

# Open-task count across the range (the drain test). 0 ⇒ no open work remains.
open_count() {
  "$TASK_BIN" ready --phases "$PHASES" --count 2>/dev/null || echo 0
}

# Open-task count within a single phase (regardless of blocker state).
phase_open_count() {
  "$TASK_BIN" ready --phase "$1" --count 2>/dev/null || echo 0
}

# Is a phase's worktree branch currently owned by a LIVE agent? (D3)
#
# Reads the pluggable enumeration: the runner's own `list` when it has one, the
# container-name scrape otherwise (docs/RUNNERS.md §1.3). A degraded answer is
# used as-is here — this is the launch path, where the cost of reading a live
# agent as dead is bounded and self-correcting, unlike the reclaim path below.
phase_live() {
  local want; want="$(phase_container "$1")"
  local name
  while IFS= read -r name; do
    [[ "$name" == "$want" ]] && return 0
  done < <(apl_live_agents)
  return 1
}
# The same question about a dispatch unit. Identical at phase grain; at task
# grain it asks about the task's own branch container, which is what makes
# "never double-launch" (mechanism 2) hold per task instead of per phase.
unit_live() { phase_live "$1"; }

# ── Liveness that is safe to act on ───────────────────────────────────────────
# Two passes below do something IRREVERSIBLE on the strength of an agent being
# absent: reclaim releases its claim, and stall detection hands its phase to the
# resume path. Both are correct against a true absence and catastrophic against a
# false one — a liveness source that has gone dark reports every agent dead at
# once, so a single bad answer reclaims or resumes the entire fleet.
#
# apl_live_agents is fail-open by design (it prints the fallback scrape rather
# than nothing), and says so with exit 75. This wrapper turns that status into
# the only safe response for an absence-driven pass: don't run it this tick.
# Skipping costs one tick of latency on a genuinely dead agent, which the next
# tick recovers; acting costs a fleet.
LIVENESS_DEGRADED_TICK=0
live_slugs() {   # prints live branch slugs; returns non-zero when not authoritative
  local out rc=0
  out="$(apl_live_agent_slugs)" || rc=$?
  [[ -n "$out" ]] && printf '%s\n' "$out"
  if (( rc != 0 )); then
    # One line per tick, not per caller: two passes ask the same question.
    if (( LIVENESS_DEGRADED_TICK == 0 )); then
      warn "runner liveness unavailable this tick; falling back to container-name enumeration and skipping absence-driven passes (reclaim, stall detection)"
      LIVENESS_DEGRADED_TICK=1
    fi
    return 1
  fi
  return 0
}

# Lowest eligible task id in a phase (the epic/safety-net task for the container).
phase_lead_task() {
  "$TASK_BIN" ready --phase "$1" --json 2>/dev/null | jq -r '.[0].id // empty' 2>/dev/null
}

# The task a unit's container is pointed at: the phase's lead task at phase
# grain, the unit itself at task grain (a task unit IS its own lead).
unit_lead_task() {
  if [[ "$GRAIN" == "task" ]]; then printf '%s' "$1"; return 0; fi
  phase_lead_task "$1"
}

# ── The task-grain ledger snapshot (issue #11) ────────────────────────────────
# At task grain the pump classifies every TASK in range, which needs per-task
# status, claimant, blockers and declared `files:` footprint — for tasks the
# eligible frontier deliberately excludes (a claimed one, a blocked one) as much
# as for the ones it includes. `list --json` is the one read that answers all of
# it; `ready --json` answers eligibility, because the eligibility predicate is
# the ledger's to own and must never be re-implemented here.
#
# Refreshed once per planning pass, in the MAIN shell — associative arrays set
# inside a `$( )` or a pipeline would not survive.
declare -A TSNAP_STATUS TSNAP_CLAIMED TSNAP_FILES TSNAP_BLOCKERS TSNAP_ELIGIBLE
declare -a TSNAP_IDS
TSNAP_LOADED=0
load_task_snapshot() {
  TSNAP_STATUS=(); TSNAP_CLAIMED=(); TSNAP_FILES=(); TSNAP_BLOCKERS=()
  TSNAP_ELIGIBLE=(); TSNAP_IDS=()
  local -A in_range=()
  local p
  while IFS= read -r p; do [[ -n "$p" ]] && in_range["$p"]=1; done < <(pump_expand_phases "$PHASES")

  # One record per line: id, status, claimant, the files list, the blockers
  # list — fields separated by ASCII RS, the files list packed with ASCII US.
  #
  # Neither separator is a tab, and that is not fussiness. Tab is IFS
  # WHITESPACE, so `read` collapses a run of them into one delimiter: a task
  # with no claimant emits two adjacent tabs, and every field after it shifts
  # left — the files of the NEXT task read as this one's claimant. A control
  # character that is not whitespace preserves empty fields, and neither can
  # appear in an id, a status, a branch name or a path.
  local id status claimed files blockers
  while IFS=$'\x1e' read -r id status claimed files blockers; do
    [[ -z "$id" ]] && continue
    [[ -n "${in_range[${id%%.*}]:-}" ]] || continue
    TSNAP_STATUS["$id"]="$status"
    TSNAP_CLAIMED["$id"]="$claimed"
    TSNAP_FILES["$id"]="$files"
    TSNAP_BLOCKERS["$id"]="$blockers"
    TSNAP_IDS+=("$id")
  done < <("$TASK_BIN" list --json 2>/dev/null \
           | jq -r '.[] | [.id, .status, (.claimed_by // ""),
                           (.files | join("\u001f")), (.blockers | join(" "))]
                 | join("\u001e")' 2>/dev/null)

  while IFS= read -r id; do
    [[ -n "$id" ]] && TSNAP_ELIGIBLE["$id"]=1
  done < <("$TASK_BIN" ready --phases "$PHASES" --json 2>/dev/null | jq -r '.[].id' 2>/dev/null)
  TSNAP_LOADED=1
}

# task_files <id> — the task's declared footprint, one path per line.
task_files() {
  local blob="${TSNAP_FILES[$1]:-}"
  [[ -n "$blob" ]] && printf '%s\n' "${blob//$'\x1f'/$'\n'}"
  return 0
}

# task_files_inline <id> — the same footprint as one backticked, comma-separated
# phrase for the brief. Empty when the task declares nothing, which is what the
# template's undeclared section keys off.
task_files_inline() {
  local out="" f
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    out+="${out:+, }\`$f\`"
  done < <(task_files "$1")
  printf '%s' "$out"
}

# ── Conflict scheduling at task grain (issue #11) ─────────────────────────────
# Phase grain buys mutual exclusion for free: one branch per phase means sibling
# tasks that rewrite the same file never collide, because one agent does them in
# sequence. Task grain gives that up, so the exclusion has to become an explicit,
# inspectable RULE instead of a side effect — otherwise the grain's whole benefit
# is paid straight back as merge conflicts nobody predicted.
#
# The rule: two tasks may run concurrently only when their declared `files:` sets
# are disjoint. Overlap is a hold, exactly like a pending blocker, and the plan
# names the task and the path so the operator can see the schedule before it runs.
#
# An EMPTY `files:` is exclusive, not permissive (operator decision, 2026-08-13).
# An empty footprint means "unknown", and treating unknown as "touches nothing"
# is precisely the silent-wrong-answer shape this project exists to refuse: it
# would schedule two agents onto the same files and report a clean plan. So an
# undeclared task runs alone, and the dry-run says so in as many words. That also
# makes `files:` load-bearing rather than decorative.
#
# unit_files_conflict <candidate> <holder> — the reason the candidate may not run
# beside the holder, or nothing at all when the two are disjoint.
unit_files_conflict() {
  local cand="$1" holder="$2"
  local fc fh
  fc="$(task_files "$cand")"
  fh="$(task_files "$holder")"
  if [[ -z "$fc" ]]; then
    printf 'files: empty — exclusive; %s holds the tree' "$holder"; return 0
  fi
  if [[ -z "$fh" ]]; then
    printf '%s declares no files: — exclusive; it holds the tree' "$holder"; return 0
  fi
  local overlap
  overlap="$(comm -12 <(printf '%s\n' "$fc" | sort -u) <(printf '%s\n' "$fh" | sort -u) 2>/dev/null | head -1)"
  [[ -n "$overlap" ]] && printf 'files overlap with %s: %s' "$holder" "$overlap"
  return 0
}

# The units already holding the tree in the tick being planned, in admission
# order. A module-scope array rather than a `local` one because both admission
# passes below consult it through hold_reason, and bash has no clean way to pass
# an array to a function. compute_plan_task resets it.
declare -a PLAN_HOLDERS=()

# hold_reason <candidate> — the first reason the candidate may not be dispatched
# beside what already holds the tree, or nothing when it is free to go. Every
# unit the pump will START this tick must pass this, RESUME included: a resumed
# container is as real as a launched one.
hold_reason() {
  local cand="$1" h reason
  for h in "${PLAN_HOLDERS[@]:-}"; do
    [[ -z "$h" ]] && continue
    reason="$(unit_files_conflict "$cand" "$h")"
    [[ -n "$reason" ]] && { printf '%s' "$reason"; return 0; }
  done
  return 0
}

# The units a task-grain run dispatches: every task whose phase is in range, in
# the range's own phase order, numerically within each phase (the ledger's
# ordering — LEDGER-CONTRACT §6.1 — so the plan reads like `next` would hand the
# work out).
#
# The per-id guards are `|| continue`, never `[[ … ]] && printf`, and that is
# load-bearing under `set -e`. A trailing AND-list is the LAST command of the
# for-loop body, so an id that does not match the phase makes the loop — and,
# through `pipefail`, the whole `| sort` pipeline — exit 1. This while loop's
# body would then be a failing command, `set -e` would kill the function
# mid-range, and because the caller reads it through a process substitution the
# non-zero exit is invisible: every phase after the first silently vanished from
# the plan. `--grain task --phases G1..G9` planned G1 and nothing else, then hit
# the deadlock detector with eight phases of open work still in range.
tasks_in_range() {
  (( TSNAP_LOADED )) || load_task_snapshot
  local p id
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    for id in "${TSNAP_IDS[@]:-}"; do
      [[ -n "$id" ]] || continue
      [[ "${id%%.*}" == "$p" ]] || continue
      printf '%s\n' "$id"
    done | sort -V
  done < <(pump_expand_phases "$PHASES")
}

# The units this run dispatches, at whatever grain it runs.
units_in_range() {
  [[ "$GRAIN" == "task" ]] && { tasks_in_range; return 0; }
  pump_expand_phases "$PHASES"
}

# ── Unit-name validation at tick zero (issue #11) ─────────────────────────────
# The prefix check above proves the CONFIGURATION can name a branch. At task
# grain the unit tokens come from the ledger, so two more things have to be true
# of the run's actual contents, and both have to be true BEFORE anything
# launches:
#
#   * every unit branch can carry an agent name (apl_branch_slug_reject_reason);
#   * no two units slug to the SAME agent name. That is the cardinal failure of
#     this grain: two tasks whose branches collide means one container name for
#     two units, so liveness answers "running" for a unit that is not, the pump
#     launches a second agent onto the first one's branch, and the two overwrite
#     each other's commits. Phase grain gets this for free (phases are distinct
#     tokens by construction); task grain has to check, and refuse.
validate_unit_names() {
  [[ "$GRAIN" == "task" ]] || return 0
  (( TSNAP_LOADED )) || load_task_snapshot
  local -A slug_owner=()
  local unit branch slug problem
  while IFS= read -r unit; do
    [[ -z "$unit" ]] && continue
    branch="$(unit_branch "$unit")"
    if ! problem="$(apl_branch_slug_reject_reason "$branch")"; then
      die "$problem
task $unit would be dispatched on that branch (TASKPUMP_BRANCH_PREFIX='$BRANCH_PREFIX'
plus the task id, at --grain task). The agent name is the branch with \"/\"
replaced by \"-\", and that mapping has to be reversible — see docs/RUNNERS.md
section 2."
    fi
    slug="$(branch_slug "$branch")"
    if [[ -n "${slug_owner[$slug]:-}" ]]; then
      die "tasks ${slug_owner[$slug]} and $unit both map to the agent name $(apl_agent_prefix)$slug.
At --grain task each task is its own branch and its own agent, and liveness is
read back out of agent names — so two tasks sharing a name means the pump cannot
tell their containers apart, and would launch a second agent onto a branch that
already has one. Rename one of the tasks, or run this range at --grain phase."
    fi
    slug_owner["$slug"]="$unit"
  done < <(units_in_range)
  return 0
}

# ── Liveness-based reclaim (D3 applied to the eligibility path) ─────────────────
# A task left `in_progress` by a DEAD container (no live `arachne-agent` for its
# claimed branch) silently starves the frontier: `ready` excludes claimed tasks,
# so the phase's lead task — and everything blocked behind it — becomes ineligible
# and the pump can neither launch nor drain. (Root cause of the 2026-06-23 F43..F63
# stall: agents 401'd on an expired token and died; the entrypoint's safety-net
# `claim --turns 9999` meant scrub's turn-budget tripwire never reclaimed them.)
#
# D3 says liveness comes from `docker ps`, never task status. The launch path
# already honors this; this closes the gap on the *reclaim* path. Each tick, for
# every in_progress task claimed by a branch THIS pump owns (claimed_by ==
# phase_branch of the task's phase) whose container is dead:
#   * 0 commits ahead of base → `release` to `open` (clean, safe re-attempt).
#   * commits ahead          → leave parked, warn (a human/PR decision; the pump
#                              never auto-loops over committed work).
# The branch/worktree is never touched, so a released task resumes its prior work.
reclaim_orphaned_claims() {
  local -A live=()
  local slugs
  # Absence-driven: a liveness source that cannot answer would read as every
  # agent having died, and this pass would release every claim in the range.
  slugs="$(live_slugs)" || return 0
  local s; while IFS= read -r s; do [[ -n "$s" ]] && live["$s"]=1; done <<<"$slugs"
  local reclaimed=0 parked=0 id status branch _rest parked_ids=""
  while read -r id status branch _rest; do
    [[ "$id" == "ID" || "$status" != "in_progress" ]] && continue
    [[ -z "$branch" || "$branch" == "-" ]] && continue
    # Only touch claims on a branch this pump's naming scheme owns; skip human
    # branches and any other claimant. At task grain the owning branch is the
    # TASK's own (feat/g3.4), so a task-grain claim is recognized as this pump's
    # and a phase-grain claim keeps working unchanged.
    [[ "$branch" == "$(task_owner_branch "$id")" ]] || continue
    # Live container for this branch ⇒ a legitimate, in-flight claim. Leave it.
    [[ -n "${live["$(branch_slug "$branch")"]:-}" ]] && continue
    # Orphaned claim. Preserve committed work; only auto-reopen clean orphans.
    local ahead; ahead="$(git -C "$REPO_ROOT" rev-list --count "$BASE_REF..$branch" 2>/dev/null || echo 0)"
    if [[ "$ahead" -gt 0 ]]; then
      parked_ids+="$id:$ahead "
      parked=$((parked + 1))
      continue
    fi
    if "$TASK_BIN" release "$id" \
        --reason "Auto-reclaimed by pump: container for $branch is dead and the branch has 0 commits (D3 liveness reclaim)." \
        >/dev/null 2>&1; then
      log "reclaimed orphaned claim $id ($branch — container dead, 0 commits) → open"
      reclaimed=$((reclaimed + 1))
    fi
  done < <("$TASK_BIN" list --status in_progress 2>/dev/null)
  [[ "$reclaimed" -gt 0 ]] && log "liveness reclaim: $reclaimed task(s) released to open"
  # Report parked orphans only when the SET changes. This used to warn twice per
  # tick unconditionally: one 2026-08-05 F79 stall produced 563 identical pairs
  # over 7h, which buries every other line in the journal and trains the operator
  # to ignore the log. The resume path below now clears most of these anyway;
  # what survives (resume disabled or budget spent) is genuinely worth one line.
  if [[ "$parked_ids" != "$LAST_PARKED_FP" ]]; then
    if [[ "$parked" -gt 0 ]]; then
      warn "liveness reclaim: $parked orphaned claim(s) with committed work parked for review: ${parked_ids% }"
      [[ "$RESUME_STALLED" -eq 1 ]] \
        || warn "  (auto-resume disabled via --no-resume-stalled; these will not be picked up)"
    fi
    LAST_PARKED_FP="$parked_ids"
  fi
  return 0
}

# ── Stalled-claim detection (2026-08-05) ───────────────────────────────────────
# The gap reclaim_orphaned_claims deliberately leaves open. It refuses to reopen
# an orphan with committed work — right instinct, since blindly reopening would
# make a fresh agent redo landed work — but it then has no exit: `ready` only
# surfaces `status: open`, so the claim is invisible to the frontier, everything
# blocked behind it is ineligible, `compute_plan` files the phase under WAITING,
# and `is_drained` never fires because open_count > 0. The pump idles forever.
#
# So instead of reopening (fresh start, loses context) we *resume*: keep the
# claim and relaunch a container on the same branch and worktree, with a note
# telling the agent to continue that specific task. The prior work is right there
# in git; nothing is redone.
#
# Ownership rules are inherited from reclaim_orphaned_claims: only branches this
# pump's naming scheme owns, never a human's. `in_progress` carries its claimant
# in claimed_by; `scrub` NULLs claimed_by when it parks a task, so needs-review /
# stuck ownership is inferred from the phase branch — the same inference the
# reclaim path already makes. Both are included because a stalled claim reaches
# needs-review on its own: with last_heartbeat_ts null, scrub falls back to
# claimed_at and trips the 24h staleness tripwire.
declare -A STALL_TASK STALL_STATUS ESCALATED
detect_stalled_orphans() {
  STALL_TASK=(); STALL_STATUS=()
  [[ "$RESUME_STALLED" -eq 1 ]] || return 0
  local -A live=()
  local slugs
  # Absence-driven, and the more expensive of the two to get wrong: a false
  # "everything died" would put every running phase on the resume path.
  slugs="$(live_slugs)" || return 0
  local s; while IFS= read -r s; do [[ -n "$s" ]] && live["$s"]=1; done <<<"$slugs"
  local id status branch _rest unit pbranch ahead
  while read -r id status branch _rest; do
    [[ "$id" == "ID" ]] && continue
    case "$status" in in_progress|needs-review|stuck) : ;; *) continue;; esac
    # The UNIT the stalled task belongs to: its phase at phase grain, itself at
    # task grain. Everything below is unchanged — the resume mechanism is the
    # same mechanism, asked about a smaller thing.
    if [[ "$GRAIN" == "task" ]]; then unit="$id"; else unit="${id%%.*}"; fi
    pbranch="$(unit_branch "$unit")"
    # Already handed to a human this run. Without this the unit would re-enter
    # PLAN_RESUME every tick, re-run resume-attempt (which returns `escalate`
    # forever once the budget is spent), and re-notify every 30s. Dropping it
    # here is also what lets the deadlock detector below accumulate and exit.
    [[ -n "${ESCALATED[$unit]:-}" ]] && continue
    # First (lowest) match per unit wins; one container drains one unit.
    [[ -n "${STALL_TASK[$unit]:-}" ]] && continue
    [[ "$status" == "in_progress" && "$branch" != "$pbranch" ]] && continue
    [[ -n "${live["$(branch_slug "$pbranch")"]:-}" ]] && continue
    git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$pbranch" >/dev/null 2>&1 || continue
    ahead="$(git -C "$REPO_ROOT" rev-list --count "$BASE_REF..$pbranch" 2>/dev/null || echo 0)"
    [[ "$ahead" -gt 0 ]] || continue
    STALL_TASK["$unit"]="$id"
    STALL_STATUS["$unit"]="$status"
  done < <("$TASK_BIN" list 2>/dev/null)
  return 0
}

# ── Feed gate ──────────────────────────────────────────────────────────────────
# A gate answers one question before the pump launches anything: is it a good
# idea to start MORE work right now? It never stops work already running.
#
# The chain is an ordered list of command lines, one per line. Each is run with
# stdout and stderr captured together (the tools that predate this contract
# write their reason to stderr) and judged by exit status:
#
#   0    feed OK
#   10   pause launching; its output is the reason the operator sees
#   else a broken gate — warn and FEED ANYWAY
#
# That last rule is deliberate: a gate that cannot reach its meter must never
# silently halt a multi-day drain. Every gate shipped here fails open too.
#
# The default chain is token freshness, the usage ceiling, and free disk — with
# the three --no-*-gate flags dropping their entry. The shipped net-health gate
# is host-hardware policy and OFF by default; TASKPUMP_HEALTH_GATE=1 opts it in
# at the head of the chain (a wedged host is the cheapest, most binding check).
# A configured TASKPUMP_GATES replaces the whole chain and is used verbatim; the
# flags still export their disable switches, so a gate that honors them keeps
# working either way — note that means a net-health entry in a custom chain also
# needs TASKPUMP_HEALTH_GATE=1 to actually probe.
default_gates() {
  [[ "$HEALTH_GATE" -eq 1 ]] && printf '%s\n' "$TP_GATES_DIR/net-health"
  printf '%s\n' "$TP_GATES_DIR/claude-token-fresh"
  [[ "$USAGE_GATE" -eq 1 ]] && printf '%s\n' "$USAGE_BIN --gate"
  [[ "$DISK_GATE"  -eq 1 ]] && printf '%s\n' "$TP_GATES_DIR/disk-low"
  return 0
}

# The active chain as one display line: each entry's executable basename in
# consultation order. Dry-run prints it, so an operator can confirm a gate is
# wired and ordered as intended without waiting for one to trip (GATES.md §4).
gate_chain_line() {
  local gates spec line=""
  gates="${TASKPUMP_GATES:-$(default_gates)}"
  while IFS= read -r spec; do
    [[ -z "${spec//[[:space:]]/}" ]] && continue
    # A gate entry is a command line; splitting on whitespace is the point.
    # shellcheck disable=SC2086
    set -- $spec
    line+="${line:+ -> }$(basename "$1")"
  done <<<"$gates"
  printf '%s' "${line:-(none)}"
}

# Everything a gate might need, since a gate is a separate process.
export_gate_env() {
  export TASKPUMP_HEALTH_GATE="$HEALTH_GATE"
  export TASKPUMP_USAGE_GATE="$USAGE_GATE"
  export TASKPUMP_DISK_GATE="$DISK_GATE"
  export TASKPUMP_HEALTH_WINDOW="$HEALTH_WINDOW"
  export TASKPUMP_USAGE_CEILING="$CEILING"
  export TASKPUMP_USAGE_RESET_FILE="$RESET_FILE"
  # Derived only when unset: TASKPUMP_CREDENTIALS is a documented key of both
  # claude gates (their file override, and the golden suite's hermeticity
  # seam), and a documented key the operator set must never be clobbered by a
  # derivation of itself.
  export TASKPUMP_CREDENTIALS="${TASKPUMP_CREDENTIALS:-$CLAUDE_DIR/.credentials.json}"
  export TASKPUMP_DISK_WATCHDOG="$DISK_WATCHDOG_BIN"
  # The legacy spellings the un-migrated tools still read.
  export HEALTH_GATE HEALTH_WINDOW
  export ARACHNE_USAGE_RESET_FILE="$RESET_FILE"
}

# Strip a leading "<toolname>: " so a tool that prefixes all its diagnostics
# does not have to special-case the gate path. Only a bare token counts, so a
# reason that merely contains a colon is left alone.
strip_gate_prefix() {
  local r="$1"
  [[ "$r" =~ ^[A-Za-z0-9._-]+:\ (.*)$ ]] && r="${BASH_REMATCH[1]}"
  printf '%s' "$r"
}

GATE_REASON=""
# Lines from gates that FED but had something to say (a skip, a fail-open). The
# pause reason has its own variable because it is a decision; these are notes.
GATE_NOTES=""
feed_gate() {
  GATE_REASON=""
  GATE_NOTES=""
  export_gate_env
  local gates spec rc reason
  gates="${TASKPUMP_GATES:-$(default_gates)}"
  while IFS= read -r spec; do
    [[ -z "${spec//[[:space:]]/}" ]] && continue
    # A gate entry is a command line; splitting on whitespace is the point.
    # shellcheck disable=SC2086
    set -- $spec
    if [[ ! -x "$1" ]]; then
      warn "gate not executable, skipping: $1"
      continue
    fi
    rc=0
    reason="$("$@" 2>&1)" || rc=$?
    case "$rc" in
      # A gate that feeds and explains itself — "skipped: no claude credentials
      # at …" from the two Claude gates on a host driving some other agent — is
      # collected for whoever is asking the chain to explain itself. Collected,
      # not logged: a persistent condition would otherwise print every tick for
      # days. print_plan is where it surfaces, which is the mode whose whole job
      # is showing the operator what the chain decided and why.
      0) [[ -n "$reason" ]] && GATE_NOTES+="${GATE_NOTES:+$'\n'}$(basename "$1"): $(strip_gate_prefix "$reason")" ;;
      10) GATE_REASON="$(strip_gate_prefix "$reason")"; return 10 ;;
      *) warn "gate '$1' failed (rc=$rc); feeding anyway${reason:+ — $reason}" ;;
    esac
  done <<<"$gates"
  return 0
}

# ── Dependency-aware briefs (A3 v1 / F65.6) ────────────────────────────────────
# dep_pr_number <branch> — the open draft-PR number for a dependency branch, or
# empty. Fail-open: empty when gh is absent / disabled (TASKPUMP_PUMP_NO_GH=1, for
# hermetic tests) / errors.
dep_pr_number() {
  local branch="$1"
  [[ "${TASKPUMP_PUMP_NO_GH:-0}" -eq 1 ]] && return 0
  command -v gh >/dev/null 2>&1 || return 0
  gh pr list --head "$branch" --base "$INTEGRATION_BASE" --json number -q '.[0].number // empty' 2>/dev/null || true
}

# phase_cross_blockers <FN> — the unique set of OTHER phases this phase's tasks
# are blocked on (in-phase blockers are the pump's own serial concern), one phase
# token per line. The single source of truth for both the dependency brief (v1)
# and the integration launch gate (v2).
phase_cross_blockers() {
  local phase="$1"
  local -A seen=()
  local f blk bphase
  # DEFERRED (documented, not fixed): this reads task frontmatter directly with
  # yq, bypassing the "the CLI is the ledger's only reader and writer"
  # invariant, and re-hardcodes both the task-file naming convention and the
  # `.md` extension. Routing it through the CLI needs a subcommand that reports
  # blockers for a whole phase in one call; doing it per-file through the CLI
  # would add a process spawn per task per tick.
  shopt -s nullglob
  for f in "$TASKS_DIR/$phase."*.md; do
    while IFS= read -r blk; do
      [[ -z "$blk" ]] && continue
      bphase="${blk%%.*}"
      [[ "$bphase" == "$phase" ]] && continue       # in-phase dep — pump-internal
      [[ -n "${seen[$bphase]:-}" ]] && continue
      seen[$bphase]=1
      printf '%s\n' "$bphase"
    done < <(yq --front-matter=extract '.blockers[]?' "$f" 2>/dev/null || true)
  done
  shopt -u nullglob
}

# phase_deps_integrated <FN> — true (0) when EVERY cross-phase blocker's branch is
# already an ancestor of the integration trunk (its code is physically present on
# the base downstream is cut from). The v2 launch gate: a frontier phase whose
# blocker is `done` in the ledger but whose CODE is not yet on auto/trunk stays
# WAITING. Vacuously true with no cross-phase blockers. Test seam: when
# STUB_INTEGRATED is set, only its space-separated phases count as integrated.
phase_deps_integrated() {
  local phase="$1" dp dbranch
  while IFS= read -r dp; do
    [[ -z "$dp" ]] && continue
    dbranch="$(phase_branch "$dp")"
    if [[ -n "${STUB_INTEGRATED+x}" ]]; then
      pump_in_list "$dp" "$STUB_INTEGRATED" || return 1
    else
      apl_phase_integrated "$REPO_ROOT" "$dbranch" "$INTEGRATION_TRUNK" || return 1
    fi
  done < <(phase_cross_blockers "$phase")
  return 0
}

# ── The same two questions, asked about a unit ────────────────────────────────
# unit_cross_blockers <unit> — the upstream units whose code this one is built
# on. At phase grain that is phase_cross_blockers (in-phase edges are the
# in-context loop's serial concern). At task grain EVERY blocker is a different
# unit — the free serialization inside a phase is exactly what this grain gives
# up — so all of them count, and each maps to its own branch.
unit_cross_blockers() {
  if [[ "$GRAIN" != "task" ]]; then phase_cross_blockers "$1"; return; fi
  (( TSNAP_LOADED )) || load_task_snapshot
  local b
  for b in ${TSNAP_BLOCKERS[$1]:-}; do
    [[ -n "$b" ]] && printf '%s\n' "$b"
  done
}

# unit_deps_integrated <unit> — is every upstream unit's CODE already on the
# trunk this one would be cut from? A blocker with NO branch in this repository
# is treated as integrated: at task grain the blocker set reaches back to work
# that landed long before this run (and never had a pump branch), and holding a
# unit forever behind a branch that will never exist is a stall, not a safeguard.
unit_deps_integrated() {
  # `return`, not `return 0`: this is a PREDICATE, and swallowing the delegate's
  # answer would report every phase's dependencies integrated.
  if [[ "$GRAIN" != "task" ]]; then phase_deps_integrated "$1"; return; fi
  local unit="$1" dp dbranch
  while IFS= read -r dp; do
    [[ -z "$dp" ]] && continue
    dbranch="$(unit_branch "$dp")"
    if [[ -n "${STUB_INTEGRATED+x}" ]]; then
      pump_in_list "$dp" "$STUB_INTEGRATED" || return 1
    else
      git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$dbranch" >/dev/null 2>&1 || continue
      apl_phase_integrated "$REPO_ROOT" "$dbranch" "$INTEGRATION_TRUNK" || return 1
    fi
  done < <(unit_cross_blockers "$unit")
  return 0
}

# phase_dependencies <FN> — emit a markdown "Depends on / builds upon" block
# naming this phase's CROSS-PHASE blockers, each resolved to branch / integration
# state / draft PR, so the launched agent learns its lineage instead of
# re-deriving upstream work. No cross-phase blockers ⇒ a single explanatory line.
# Pure-ish: the branch name is string-derived (always present); sha/PR are
# best-effort enrichment.
phase_dependencies() {
  local phase="$1"
  local deps=() dp
  while IFS= read -r dp; do [[ -n "$dp" ]] && deps+=("$dp"); done < <(unit_cross_blockers "$phase")

  if (( ${#deps[@]} == 0 )); then
    if [[ "$GRAIN" == "task" ]]; then
      printf 'No blockers — nothing upstream is pending for this task.\n'
    else
      printf 'No cross-phase dependencies.\n'
    fi
    return 0
  fi

  if [[ "$GRAIN" == "task" ]]; then
    printf 'This task builds upon work from other tasks. Their code is integrated\n'
    printf 'into the `%s` branch you are based on — do not re-derive it:\n\n' "$INTEGRATION_TRUNK"
  else
    printf 'This phase builds upon work from other phases. Their code is integrated\n'
    printf 'into the `%s` branch you are based on — do not re-derive it:\n\n' "$INTEGRATION_TRUNK"
  fi
  local dp dbranch dstate dpr
  for dp in "${deps[@]}"; do
    dbranch="$(unit_branch "$dp")"
    if apl_phase_integrated "$REPO_ROOT" "$dbranch" "$INTEGRATION_TRUNK"; then
      dstate="integrated @ $(git -C "$REPO_ROOT" rev-parse --short "$dbranch" 2>/dev/null || echo '?')"
    elif git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$dbranch" >/dev/null 2>&1; then
      dstate="not yet integrated"
    else
      dstate="not yet started"
    fi
    dpr="$(dep_pr_number "$dbranch")"
    if [[ -n "$dpr" ]]; then dpr="PR #$dpr"; else dpr="no PR yet"; fi
    printf -- '- **%s** (`%s`) — %s, %s\n' "$dp" "$dbranch" "$dstate" "$dpr"
  done
}

# ── Brief-template resolution ─────────────────────────────────────────────────
# Three places to look, in order: what the operator configured, the consumer's
# own template inside its ledger (Arachne's path — so an existing project keeps
# rendering exactly what it did), and finally the generic one shipped with
# TaskPump. Previously a missing consumer template was a hard die, which made a
# fresh project unable to run at all until it wrote one.
resolve_brief_template() {
  local explicit="${TASKPUMP_PHASE_BRIEF_TEMPLATE:-${TASKPUMP_BRIEF_TEMPLATE:-}}"
  [[ -n "$explicit" ]] && { printf '%s' "$explicit"; return 0; }
  local consumer="$OPS_DIR/task-loop/briefs/_phase-drain-template.md"
  [[ -f "$consumer" ]] && { printf '%s' "$consumer"; return 0; }
  printf '%s' "$TP_ROOT/templates/phase-drain-brief.md"
}

# The task-grain brief resolves the same three ways. It is a DIFFERENT template,
# not a re-parameterized phase brief, and the difference is load-bearing: the
# phase brief's whole working method is the in-context `next --phase` loop, and
# an agent running that at task grain would claim its siblings — the very tasks
# the pump has just dispatched to other containers. Two agents, one task. So the
# task brief claims exactly the one task it was launched for, finishes it, and
# exits; acquisition belongs to the pump at this grain.
resolve_task_brief_template() {
  local explicit="${TASKPUMP_TASK_BRIEF_TEMPLATE:-}"
  [[ -n "$explicit" ]] && { printf '%s' "$explicit"; return 0; }
  local consumer="$OPS_DIR/task-loop/briefs/_task-template.md"
  [[ -f "$consumer" ]] && { printf '%s' "$consumer"; return 0; }
  printf '%s' "$TP_ROOT/templates/task-brief.md"
}
if [[ "$GRAIN" == "task" ]]; then
  BRIEF_TEMPLATE="$(resolve_task_brief_template)"
else
  BRIEF_TEMPLATE="$(resolve_brief_template)"
fi

# The resume note resolves the same three ways, for the same reason: a consumer
# whose agents depend on particular wording keeps it in its own ledger, while
# the shipped default stays tool-agnostic. Symmetry matters here — the two
# templates are read by the same agent in the same session.
resolve_resume_template() {
  local explicit="${TASKPUMP_RESUME_TEMPLATE:-}"
  [[ -n "$explicit" ]] && { printf '%s' "$explicit"; return 0; }
  local consumer="$OPS_DIR/task-loop/briefs/_resume-note-template.md"
  [[ -f "$consumer" ]] && { printf '%s' "$consumer"; return 0; }
  printf '%s' "$TP_ROOT/templates/resume-note.md"
}
RESUME_TEMPLATE="$(resolve_resume_template)"

# Only reachable when the resolved template is genuinely absent — an explicit
# TASKPUMP_BRIEF_TEMPLATE pointing nowhere, or a broken install.
missing_brief_template_msg() {
  if [[ "$GRAIN" == "task" ]]; then
    printf 'task brief template not found: %s\n' "$BRIEF_TEMPLATE"
    printf '  looked at: $TASKPUMP_TASK_BRIEF_TEMPLATE, then %s/task-loop/briefs/_task-template.md,\n' "$OPS_DIR"
    printf '  then the one shipped at %s/templates/task-brief.md\n' "$TP_ROOT"
    return 0
  fi
  printf 'phase-drain brief template not found: %s\n' "$BRIEF_TEMPLATE"
  printf '  looked at: $TASKPUMP_BRIEF_TEMPLATE, then %s/task-loop/briefs/_phase-drain-template.md,\n' "$OPS_DIR"
  printf '  then the one shipped at %s/templates/phase-drain-brief.md\n' "$TP_ROOT"
}

# ── Brief rendering (D6 / F64.4; deps A3 v1) ───────────────────────────────────
# render_brief_stream <phase> — render the parameterized phase-drain template to
# stdout: substitute {{PHASE}} (plain sed — no envsubst, no clash with the
# `$PHASE` / `$(…)` shell examples the brief contains; phase tokens FNN are
# sed-safe) and expand the {{DEPENDS_ON}} placeholder line with the dependency
# block (awk by literal `index()` — avoids multi-line inline sed and the awk
# brace-interval pitfall).
render_brief_stream() {
  local unit="$1"
  local phase; phase="$(unit_phase "$unit")"
  # Empty at phase grain, where the container acquires its own tasks; the task
  # brief's every mention of "your task" resolves through this.
  local task_id=""
  [[ "$GRAIN" == "task" ]] && task_id="$unit"
  # The declared footprint, and its absence, as two mutually-exclusive template
  # conditions. The brief cannot say one thing about both: "the pump scheduled
  # you concurrently BECAUSE those sets are disjoint" is false for a task with
  # `files: []`, which was scheduled EXCLUSIVELY, precisely because it declared
  # nothing. Empty at phase grain, where neither section exists in the template.
  local task_files_line="" task_files_undeclared=""
  if [[ "$GRAIN" == "task" ]]; then
    (( TSNAP_LOADED )) || load_task_snapshot
    task_files_line="$(task_files_inline "$unit")"
    [[ -z "$task_files_line" ]] && task_files_undeclared="yes"
  fi
  local depfile; depfile="$(mktemp)"
  phase_dependencies "$unit" >| "$depfile"
  local -A TPL_VARS TPL_BLOCKS
  TPL_VARS=(
    [PHASE]="$phase"
    [TASK_ID]="$task_id"
    [TASK_FILES]="$task_files_line"
    [TASK_FILES_UNDECLARED]="$task_files_undeclared"
    [BASE]="$BASE_REF"
    [TASK_CLI]="$TASK_CLI"
    [TASK_CLI_NAME]="$TASK_CLI_NAME"
    [TASK_DIR]="$(tasks_dir_rel)"
    [VERIFY_CMDS]="$(apl_join_commands "$VERIFY_CMDS")"
    [BUILD_GATE]="$(apl_join_commands "$VERIFY_CMDS")"
    [PROJECT_BRIEF]="${PROJECT_BRIEF//\{\{PHASE\}\}/$phase}"
  )
  TPL_BLOCKS=( [DEPENDS_ON]="$depfile" )
  apl_render_template "$BRIEF_TEMPLATE"
  rm -f "$depfile" 2>/dev/null || true
}

# render_brief <unit> — write the rendered brief to a transient per-unit file
# and echo its path (the launcher passes the path to the container).
render_brief() {
  local unit="$1"
  [[ -f "$BRIEF_TEMPLATE" ]] || die "$(missing_brief_template_msg)"
  local out
  out="$WORKTREES_DIR/$(unit_branch "$unit")/$BRIEF_OUT_NAME"
  mkdir -p "$(dirname "$out")" 2>/dev/null || true
  render_brief_stream "$unit" >| "$out"
  printf '%s' "$out"
}

# ── Launch one phase's worktree + container ────────────────────────────────────
# Write the resume preamble the container prepends ahead of the kickoff brief.
# The in-container entrypoint already resolves the resume-note path and cats it
# between the goal preamble and the brief — that plumbing was built for
# run-parallel.sh's interrupted-session path and the pump simply never used it,
# so nothing in the container needs to change.
#
# The one thing run-parallel.sh's version cannot say is what a *dead* agent
# already landed: it only reports uncommitted state. A resumed task's whole
# context is its commits, so those lead here.
#
# The prose lives in templates/resume-note.md (TASKPUMP_RESUME_TEMPLATE). It was
# ~55 lines of heredoc naming one project's CLI path, task-file layout, and
# verification commands; this function now only gathers the git state the
# template splices in.
render_resume_note_stream() {
  local wt="$1" branch="$2" id="$3"
  local phase="${id%%.*}"
  local commits status_short diff_stat
  commits="$(mktemp)"; status_short="$(mktemp)"; diff_stat="$(mktemp)"
  git -C "$wt" log --oneline "$BASE_REF..$branch" 2>/dev/null | head -40 >| "$commits" || true
  git -C "$wt" status --short 2>/dev/null | head -40 >| "$status_short" || true
  git -C "$wt" diff --stat 2>/dev/null | tail -20 >| "$diff_stat" || true

  local -A TPL_VARS TPL_BLOCKS
  # shellcheck disable=SC2034  # read by apl_render_template (lib/pump-lib.sh)
  TPL_VARS=(
    [TASK_ID]="$id"
    [PHASE]="$phase"
    [BRANCH]="$branch"
    [TASK_FILE]="$(tasks_dir_rel)/$id.md"
    [TASK_CLI]="$TASK_CLI"
    [TASK_CLI_NAME]="$TASK_CLI_NAME"
    [VERIFY_CMDS]="$(apl_join_commands "$VERIFY_CMDS")"
    # The shipped templates call this {{BUILD_GATE}}. Both names resolve to the
    # same value so either template file renders, but note that the pump's
    # TASKPUMP_BUILD_GATE is a DIFFERENT thing — the merge queue's gate, not the
    # per-task verification commands.
    [BUILD_GATE]="$(apl_join_commands "$VERIFY_CMDS")"
  )
  # shellcheck disable=SC2034  # read by apl_render_template (lib/pump-lib.sh)
  TPL_BLOCKS=(
    [COMMITS]="$commits"
    [STATUS_SHORT]="$status_short"
    [DIFF_STAT]="$diff_stat"
  )
  apl_render_template "$RESUME_TEMPLATE"
  rm -f "$commits" "$status_short" "$diff_stat" 2>/dev/null || true
}

# write_resume_note <wt> <branch> <id> — render to the worktree and echo the path
# (the launcher passes the path on to the runner).
write_resume_note() {
  local wt="$1" branch="$2" id="$3"
  local out="$wt/$RESUME_NOTE_NAME"
  render_resume_note_stream "$wt" "$branch" "$id" >| "$out"
  printf '%s' "$out"
}

# Give up on a stalled task and hand it to a human. Uses `needs-review` (the
# sanctioned quarantine status, same as quarantine_unit) rather than `block`,
# which means "external dependency". `reopen` now accepts needs-review, so this
# is a door the operator can walk back through.
escalate_stalled() {
  local unit="$1" id="$2" verdict="$3"
  ESCALATED["$unit"]=1
  "$TASK_BIN" needs-review "$id" \
    --reason "Pump auto-resume exhausted: $RESUME_MAX resume attempts made no new commits on $(unit_branch "$unit"). Needs a human to finish, split, or block it." \
    >/dev/null 2>&1 \
    || warn "escalate $id: needs-review failed"
  pump_notify "$unit STALLED on $id — $verdict, no progress across $RESUME_MAX auto-resumes. Marked needs-review; finish, split, or block it by hand."
}

# Relaunch a starved unit to continue its orphaned task. Identical at either
# grain: the bound, the reopen, the note and the relaunch are one mechanism
# (docs/PUMP-MECHANISMS.md §4) asked about a phase or about a single task.
resume_unit() {
  local unit="$1"
  local id="${STALL_TASK[$unit]:-}"
  [[ -n "$id" ]] || return 1
  local branch; branch="$(unit_branch "$unit")"
  local head; head="$(git -C "$REPO_ROOT" rev-parse "$branch" 2>/dev/null || true)"
  [[ -n "$head" ]] || { warn "resume $unit: cannot resolve head of $branch"; return 1; }

  # Bookkeep the attempt HERE rather than inside launch_unit: a unit that is
  # detected but not launched — pool cap reached, feed gate shut — must not burn
  # an attempt it never got to use.
  local verdict rc=0
  verdict="$("$TASK_BIN" resume-attempt "$id" --head "$head" --max "$RESUME_MAX" 2>/dev/null)" || rc=$?
  if (( rc == 10 )); then
    escalate_stalled "$unit" "$id" "$verdict"
    return 1
  fi
  (( rc == 0 )) || { warn "resume $unit: resume-attempt $id failed (rc=$rc)"; return 1; }

  # A scrub-parked task has to come back to `open` before the container's
  # safety-net claim can take it (claim accepts open, or in_progress on the same
  # branch — never needs-review/stuck).
  local status="${STALL_STATUS[$unit]:-}"
  if [[ "$status" == "needs-review" || "$status" == "stuck" ]]; then
    "$TASK_BIN" reopen "$id" \
      --reason "Pump auto-resume ($verdict): committed work on $branch, container dead; relaunching to continue." \
      >/dev/null 2>&1 || { warn "resume $unit: reopen $id failed"; return 1; }
  fi

  log "resuming $unit task $id ($verdict, was $status, head $(printf '%s' "$head" | cut -c1-12))"
  RESUME_TASK_ID="$id"
  local lrc=0
  launch_unit "$unit" || lrc=$?
  RESUME_TASK_ID=""
  return "$lrc"
}

launch_unit() {
  local unit="$1"
  local phase; phase="$(unit_phase "$unit")"
  # Test/maintenance hook: tick through the gate + plan + state logic without
  # materialising worktrees or containers.
  if [[ "${TASKPUMP_PUMP_NO_LAUNCH:-0}" -eq 1 ]]; then
    if [[ -n "$RESUME_TASK_ID" ]]; then
      log "would launch $unit -> $(unit_branch "$unit") (NO_LAUNCH, resume $RESUME_TASK_ID)"
    else
      log "would launch $unit -> $(unit_branch "$unit") (NO_LAUNCH)"
    fi
    return 0
  fi
  local branch; branch="$(unit_branch "$unit")"
  local wt="$WORKTREES_DIR/$branch"
  local cname; cname="$(unit_container "$unit")"
  # A resumed unit names its own task. unit_lead_task reads the *eligible*
  # frontier, which by definition excludes the claimed task that stalled us, so
  # it would hand back an empty id — and the entrypoint skips its safety-net
  # claim + heartbeat entirely when ARACHNE_TASK_ID is empty. That empty-lead
  # path is exactly how a naive relaunch reproduces the original stall, and it
  # also leaves last_heartbeat_ts unset so scrub re-parks the task within 24h.
  local lead
  if [[ -n "$RESUME_TASK_ID" ]]; then
    lead="$RESUME_TASK_ID"
  else
    lead="$(unit_lead_task "$unit")"
  fi
  # A task-grain session is one task, not a multi-task phase drain, so it gets
  # its own (much smaller) turn budget: the phase default exists to let one
  # container work a whole sub-tree for hours.
  local turns="$MAX_TURNS"
  [[ "$GRAIN" == "task" ]] && turns="$TASK_MAX_TURNS"

  # Materialise the worktree (idempotent). Create the branch from BASE_REF if new.
  if [[ ! -d "$wt" ]]; then
    if git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$branch" >/dev/null 2>&1; then
      git -C "$REPO_ROOT" worktree add "$wt" "$branch" >/dev/null
    else
      git -C "$REPO_ROOT" worktree add "$wt" -b "$branch" "$BASE_REF" >/dev/null
    fi
  fi
  # No probe configured ⇒ always init (idempotent); a configured probe that
  # answers skips it. See the SUBMODULE_PROBE note in the config block.
  [[ -n "$SUBMODULE_PROBE" && -f "$wt/$SUBMODULE_PROBE" ]] || git -C "$wt" submodule update --init --recursive 2>&1 | tail -1 || true
  if ! apl_ensure_worktrees_visible "$REPO_ROOT" "$wt"; then
    # Name the deciding pattern and its file: "fix .gitignore" sent an operator
    # whose GLOBAL excludes caused this to the wrong file (G0.6).
    local ign_src
    # The `--` before the path is load-bearing: the no-mounts-in-the-pump guard
    # greps this file for the volume-flag-then-quoted-path spelling and cannot
    # tell git's verbose flag from a docker mount without it.
    ign_src="$(git -C "$REPO_ROOT" check-ignore -v -- "$wt" 2>/dev/null | head -1)"
    warn "worktree still gitignored: $wt (deciding pattern: ${ign_src:-unknown}) — skipping $unit"
    return 1
  fi

  # v2: refresh a reused/stale worktree with newly-integrated upstream deps. A
  # worktree cut from auto/trunk BEFORE a dependency integrated will not contain
  # it; merging the current trunk in makes a relaunch inherit upstream (a first
  # launch from BASE_REF=trunk is already up to date → no-op). Conflict → abort,
  # skip the launch, and quarantine (same gate as reconcile_trunk). Integration
  # off ⇒ untouched.
  if [[ "$INTEGRATION" -eq 1 ]] && git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$INTEGRATION_TRUNK" >/dev/null 2>&1; then
    if ! git -C "$wt" merge --no-ff --no-edit "$INTEGRATION_TRUNK" >/dev/null 2>&1; then
      git -C "$wt" merge --abort >/dev/null 2>&1 || true
      warn "worktree $wt conflicts with $INTEGRATION_TRUNK; skipping launch of $unit"
      quarantine_unit "$unit" "$(git -C "$wt" rev-parse HEAD 2>/dev/null)" "worktree merge conflict"
      return 1
    fi
  fi

  local brief; brief="$(render_brief "$unit")"
  # Resume preamble, prepended by the entrypoint ahead of the brief. A normal
  # launch actively clears a stale note so a later fresh drain of this worktree
  # cannot inherit a previous resume's instructions.
  local resume_note=""
  if [[ -n "$RESUME_TASK_ID" ]]; then
    resume_note="$(write_resume_note "$wt" "$branch" "$RESUME_TASK_ID")"
  else
    rm -f "$wt/$RESUME_NOTE_NAME" 2>/dev/null || true
  fi

  # ── Hand off to the runner ──────────────────────────────────────────────────
  # The pump decides WHAT to run and WHERE; the runner owns HOW — the sandbox,
  # the mounts, the credential handling, the image. Everything it needs arrives
  # in the environment, in two spellings: the canonical TP_* names, and the
  # legacy ones the in-container entrypoint reads today. The container-side
  # reader prefers canonical and falls back to legacy, so either half can be
  # migrated on its own.
  #
  # Stopping a container and checking liveness are still the pump's, by
  # container name through the runtime directly. Folding those into the runner
  # contract is v2: liveness is read on every tick from every phase, and routing
  # it through a process spawn per phase per tick is a cost worth measuring
  # first.
  local cid rc=0
  # env, not shell prefix assignments: half of these are LEGACY="$LEGACY"
  # forwards of the canonical value under the un-migrated name, which prefix
  # syntax makes look like self-assignment confusion (SC2097/SC2098). As env
  # arguments they read as what they are: the child's environment, spelled out.
  cid=$(
    env \
    TP_WORKSPACE="$wt"                 WORKSPACE_PATH="$wt" \
    TP_BRANCH="$branch" \
    TP_CONTAINER_NAME="$cname" \
    TP_IMAGE="$IMAGE" \
    TP_ENTRYPOINT="$ENTRYPOINT" \
    TP_TASK_ID="$lead"                 ARACHNE_TASK_ID="$lead" \
    TP_PHASE="$phase"                  ARACHNE_PHASE="$phase" \
    TP_MODEL="$AGENT_MODEL"            AGENT_MODEL="$AGENT_MODEL" \
    TP_MAX_TURNS="$turns"              MAX_TURNS="$turns" \
    TP_REPO_ROOT="$REPO_ROOT"          REPO_ROOT="$REPO_ROOT" \
    TP_BRIEF="$brief"                  ARACHNE_BRIEF="$brief" \
    TP_RESUME_NOTE="$resume_note"      ARACHNE_RESUME_NOTE="$resume_note" \
    TP_LEDGER_REPO="$OPS_DIR" \
    TP_CLAUDE_DIR="$CLAUDE_DIR"        CLAUDE_DIR="$CLAUDE_DIR" \
    TP_CLAUDE_JSON="$CLAUDE_JSON"      CLAUDE_JSON="$CLAUDE_JSON" \
    TP_AGENT_LOG_NAME="$AGENT_LOG_NAME" \
    TP_GOAL_NOTE_NAME="$GOAL_NOTE_NAME" \
    TP_TASKS_DIR="$TASKS_DIR" \
    TP_MEMORY_MAX="${AGENT_MEMORY_MAX:-3g}"   AGENT_MEMORY_MAX="${AGENT_MEMORY_MAX:-3g}" \
    TP_MEMORY_SWAP="${AGENT_MEMORY_SWAP:-5g}" AGENT_MEMORY_SWAP="${AGENT_MEMORY_SWAP:-5g}" \
    TP_DOCKER="$DOCKER"                DOCKER="$DOCKER" \
    GITHUB_TOKEN="${GITHUB_TOKEN:-}" \
    "$RUNNER" launch
  ) || rc=$?
  if (( rc != 0 )); then
    warn "runner failed to launch $unit (rc=$rc): $RUNNER"
    return 1
  fi
  log "launched $unit -> $cname ($(printf '%s' "$cid" | cut -c1-12))  lead=$lead${RESUME_TASK_ID:+ (RESUME)}  log: $wt/$AGENT_LOG_NAME"
  return 0
}

# ── Autonomous integration trunk (A3 / F65.6) ──────────────────────────────────
# ensure_trunk — startup, real-run only: create auto/trunk from INTEGRATION_BASE
# if absent and materialise its dedicated host worktree (idempotent). The host —
# not a container — owns the trunk worktree (decision 1): the merge/build runs on
# the host's fresh auth, never inside a dying container.
ensure_trunk() {
  [[ "$INTEGRATION" -eq 1 ]] || return 0
  if ! git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$INTEGRATION_TRUNK" >/dev/null 2>&1; then
    git -C "$REPO_ROOT" branch "$INTEGRATION_TRUNK" "$INTEGRATION_BASE" \
      || die "cannot create $INTEGRATION_TRUNK from $INTEGRATION_BASE"
    log "created integration trunk $INTEGRATION_TRUNK from $INTEGRATION_BASE"
  fi
  local twt; twt="$(trunk_worktree)"
  if [[ ! -d "$twt" ]]; then
    git -C "$REPO_ROOT" worktree add "$twt" "$INTEGRATION_TRUNK" >/dev/null \
      || die "cannot add trunk worktree $twt"
    log "integration trunk worktree at $twt"
  fi
  [[ -n "$SUBMODULE_PROBE" && -f "$twt/$SUBMODULE_PROBE" ]] || git -C "$twt" submodule update --init --recursive 2>&1 | tail -1 || true
  apl_ensure_worktrees_visible "$REPO_ROOT" "$twt" \
    || warn "trunk worktree is gitignored: $twt"
}

# run_build_gate <worktree> — the gate every merge into the trunk must pass. A
# configured BUILD_GATE_CMD (tests / advanced) wholly replaces the default
# (cargo check --workspace, then smoke_test.sh if present). Returns the gate's
# exit status; 0 == green.
run_build_gate() {
  local wt="$1"
  if [[ -n "$BUILD_GATE_CMD" ]]; then
    ( cd "$wt" && WORKSPACE_PATH="$wt" eval "$BUILD_GATE_CMD" ) >/dev/null 2>&1
    return $?
  fi
  ( cd "$wt" && cargo check --workspace ) >/dev/null 2>&1 || return 1
  if [[ -x "$wt/smoke_test.sh" ]]; then
    ( cd "$wt" && WORKSPACE_PATH="$wt" ./smoke_test.sh ) >/dev/null 2>&1 || return 1
  fi
  return 0
}

# run_build_gate_dry — the dry-run build gate: run ONLY an explicitly-configured
# BUILD_GATE_CMD (so a test's `false` forces red) and never the real cargo. No
# command configured ⇒ assume green.
run_build_gate_dry() {
  [[ -n "$BUILD_GATE_CMD" ]] || return 0
  ( eval "$BUILD_GATE_CMD" ) >/dev/null 2>&1
}

# ledger_status <id> — the ledger's current status for one task, or empty when
# it does not exist. Asked of the CLI rather than of TSNAP because the
# integration pass runs BEFORE compute_plan (and at phase grain the snapshot is
# never loaded at all), so the snapshot is either stale by a tick or absent.
ledger_status() {
  "$TASK_BIN" list --json 2>/dev/null \
    | jq -r --arg id "$1" 'map(select(.id == $id)) | .[0].status // ""' 2>/dev/null
}

# quarantine_unit <unit> <pre-sha> <reason> — a conflicting or build-red merge
# does NOT advance the trunk; the unit is flagged needs-review (real run) and a
# host quarantine marker is appended so a human can reconcile feat/fN later. The
# un-integrated branch simply stops propagating. Honors the dry-run seam.
#
# A broken MERGE is not broken WORK, and a task that is already `done` is never
# un-completed here. At task grain unit_lead_task returns the unit ITSELF, so a
# finished task whose branch conflicts with the trunk used to be flipped to
# needs-review — whereupon detect_stalled_orphans saw needs-review with commits
# ahead, resume_unit `reopen`ed it back to `open`, and the pump relaunched an
# agent onto finished work. That is a silent wrong answer twice over: the ledger
# claims the work is unfinished, and an agent is told to redo it. The quarantine
# marker, the log line and the operator page already say what is actually broken
# — the merge — so the status stays `done`. (adversarial review, 2026-08-14)
quarantine_unit() {
  local unit="$1" sha="$2" reason="$3"
  local lead; lead="$(unit_lead_task "$unit")"
  [[ -z "$lead" ]] && lead="$unit.0"
  local lead_status; lead_status="$(ledger_status "$lead")"
  local dry=0
  [[ "${TASKPUMP_PUMP_INTEGRATE_DRYRUN:-0}" -eq 1 ]] && dry=1
  if [[ "$lead_status" == "done" ]]; then
    if (( dry )); then
      log "would quarantine $unit: $reason"
      log "would leave $lead done: the merge is broken, not the work"
    else
      log "quarantine $unit: $reason — not advancing $INTEGRATION_TRUNK; $lead stays done (the merge is broken, not the work)"
      pump_notify "auto/trunk: quarantined $unit ($reason); $lead left done — reconcile the merge by hand"
    fi
  elif (( dry )); then
    log "would quarantine $unit: $reason"
    log "would needs-review $lead: $reason"
  else
    log "quarantine $unit: $reason — not advancing $INTEGRATION_TRUNK; $lead → needs-review"
    "$TASK_BIN" needs-review "$lead" --reason "auto/trunk integration $reason ($unit)" >/dev/null 2>&1 \
      || warn "needs-review $lead failed"
    pump_notify "auto/trunk: quarantined $unit ($reason); $lead flagged needs-review"
  fi
  printf '%s %s %s\n' "$unit" "${sha:-?}" "$reason" >> "$QUARANTINE_FILE" 2>/dev/null || true
}

# integrate_one_unit <unit> — merge a single quiescent unit branch into the
# trunk under the merge lock + build gate. At task grain that is one task branch
# per merge, which is the point of the trunk: it absorbs the N-branch merge cost
# the finer grain creates. Returns 0 always (fail-open).
integrate_one_unit() {
  local unit="$1" branch; branch="$(unit_branch "$unit")"
  # Never merge a tree an agent is mid-edit on (decision 3, quiescence proxy).
  if unit_live "$unit"; then
    dbg_log "skip integrate $unit: live container (not quiescent)"
    return 0
  fi
  if [[ "${TASKPUMP_PUMP_INTEGRATE_DRYRUN:-0}" -eq 1 ]]; then
    integrate_one_unit_dryrun "$unit" "$branch"
  else
    integrate_one_unit_real "$unit" "$branch"
  fi
  return 0
}

# Dry-run integration: no git/cargo. STUB_INTEGRATE_NOBRANCH / _ANCESTOR /
# _CONFLICT (space-separated phase lists) drive branch-exists / already-integrated
# / merge-conflict; BUILD_GATE_CMD drives the gate. Logs would-integrate /
# would-quarantine lines for the harness to assert.
integrate_one_unit_dryrun() {
  local unit="$1"
  if pump_in_list "$unit" "${STUB_INTEGRATE_NOBRANCH:-}"; then
    dbg_log "skip integrate $unit: branch absent (stub)"; return 0
  fi
  if pump_in_list "$unit" "${STUB_INTEGRATE_ANCESTOR:-}"; then
    dbg_log "skip integrate $unit: already an ancestor of $INTEGRATION_TRUNK (stub)"; return 0
  fi
  if pump_in_list "$unit" "${STUB_INTEGRATE_CONFLICT:-}"; then
    quarantine_unit "$unit" "stub" "conflict"; return 0
  fi
  if ! run_build_gate_dry; then
    quarantine_unit "$unit" "stub" "build red"; return 0
  fi
  log "would integrate $unit"
}

# Real integration: under the trunk flock, merge feat/fN --no-ff into the trunk
# worktree; conflict → abort + quarantine; build-red → reset --hard + quarantine;
# green → keep, log, optionally push.
integrate_one_unit_real() {
  local unit="$1" branch="$2"
  git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$branch" >/dev/null 2>&1 \
    || { dbg_log "skip integrate $unit: no branch $branch"; return 0; }
  if apl_phase_integrated "$REPO_ROOT" "$branch" "$INTEGRATION_TRUNK"; then
    dbg_log "skip integrate $unit: $branch already an ancestor of $INTEGRATION_TRUNK"; return 0
  fi
  local twt; twt="$(trunk_worktree)"
  [[ -d "$twt" ]] || { warn "trunk worktree missing ($twt); skipping $unit"; return 0; }
  (
    apl_acquire_trunk_lock "$TRUNK_LOCK_FILE" || { warn "trunk lock busy; deferring $unit to next tick"; exit 0; }
    local pre; pre="$(git -C "$twt" rev-parse HEAD 2>/dev/null)"
    if ! git -C "$twt" merge --no-ff --no-edit "$branch" >/dev/null 2>&1; then
      git -C "$twt" merge --abort >/dev/null 2>&1 || true
      quarantine_unit "$unit" "$pre" "conflict"
      exit 0
    fi
    if ! run_build_gate "$twt"; then
      git -C "$twt" reset --hard "$pre" >/dev/null 2>&1 || true
      quarantine_unit "$unit" "$pre" "build red"
      exit 0
    fi
    local post; post="$(git -C "$twt" rev-parse HEAD 2>/dev/null)"
    log "integrated $unit @ $(printf '%s' "$post" | cut -c1-12)"
    [[ "${TASKPUMP_PUMP_TRUNK_PUSH:-0}" -eq 1 ]] && git -C "$twt" push >/dev/null 2>&1 || true
    exit 0
  ) || true
}

# reconcile_trunk — the host integration step (decision 1): walk every phase in
# range and integrate each quiescent, not-yet-integrated branch. Wired into
# do_tick AFTER scrub and BEFORE feed_gate so finished work keeps propagating
# even while LAUNCHING is usage-paused (integration is local compute, no tokens).
# Guarded on INTEGRATION=1; returns 0 always (fail-open — a wedged merge delays
# integration, never the tick).
reconcile_trunk() {
  [[ "$INTEGRATION" -eq 1 ]] || return 0
  local p
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    integrate_one_unit "$p" || true
  done < <(units_in_range)
  return 0
}

# graduate_trunk — drain tail (real run only): open exactly one trunk →
# integration-base PR (idempotent: refresh if it exists). The base receives no
# direct commits — the separate trunk buffer keeps integration continuous while
# review stays batched. Every gh call here targets $INTEGRATION_BASE; all three
# used to hardcode `main` while --integration-base pretended to be configurable,
# so pointing a run at a release branch silently opened PRs against main.
graduate_trunk() {
  [[ "$INTEGRATION" -eq 1 ]] || return 0
  command -v gh >/dev/null 2>&1 || { warn "gh absent; cannot graduate $INTEGRATION_TRUNK → $INTEGRATION_BASE"; return 0; }
  local twt; twt="$(trunk_worktree)"
  local existing
  existing="$(gh pr list --head "$INTEGRATION_TRUNK" --base "$INTEGRATION_BASE" --json number -q '.[0].number // empty' 2>/dev/null || true)"
  if [[ -n "$existing" ]]; then
    log "graduation PR #$existing already open for $INTEGRATION_TRUNK; left as-is"
    return 0
  fi
  [[ -d "$twt" ]] && git -C "$twt" push -u origin "$INTEGRATION_TRUNK" >/dev/null 2>&1 \
    || warn "push $INTEGRATION_TRUNK failed (continuing to PR)"
  local quarantined=""
  [[ -f "$QUARANTINE_FILE" ]] && quarantined="$(cat "$QUARANTINE_FILE" 2>/dev/null || true)"
  local body
  body="$(printf 'Autonomous integration of phases %s via %s.\n' "$PHASES" "$INTEGRATION_TRUNK")"
  if [[ -n "$quarantined" ]]; then
    body="$(printf '%s\nQuarantined (needs human reconciliation):\n%s\n' "$body" "$quarantined")"
  fi
  if gh pr create --base "$INTEGRATION_BASE" --head "$INTEGRATION_TRUNK" \
      --title "auto: integrate $PHASES" --body "$body" >/dev/null 2>&1; then
    log "opened graduation PR $INTEGRATION_TRUNK → $INTEGRATION_BASE"
  else
    warn "gh pr create for $INTEGRATION_TRUNK → $INTEGRATION_BASE failed"
  fi
}

# ── Planning pass: classify every phase in range ───────────────────────────────
# Sets arrays LAUNCH/RUNNING/WAITING/DONEP. Returns the plan via globals.
declare -a PLAN_LAUNCH PLAN_RUNNING PLAN_WAITING PLAN_DONE PLAN_RESUME
declare -A PLAN_WAIT_REASON
compute_plan() {
  PLAN_LAUNCH=(); PLAN_RUNNING=(); PLAN_WAITING=(); PLAN_DONE=(); PLAN_RESUME=(); PLAN_WAIT_REASON=()
  if [[ "$GRAIN" == "task" ]]; then compute_plan_task; return 0; fi
  detect_stalled_orphans
  local -A in_frontier=()
  local p
  while IFS= read -r p; do [[ -n "$p" ]] && in_frontier["$p"]=1; done < <(frontier_phases)
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    local oc; oc="$(phase_open_count "$p")"
    if [[ -n "${in_frontier[$p]:-}" ]]; then
      if phase_live "$p"; then
        PLAN_RUNNING+=("$p")
      elif [[ "$INTEGRATION" -eq 1 ]] && ! unit_deps_integrated "$p"; then
        # v2: ledger says ready, but a cross-phase dep's CODE is not yet on the
        # trunk this phase would be cut from. Hold until the merge lands so the
        # worktree physically contains its dependencies (RC-3 closure).
        PLAN_WAITING+=("$p")
        PLAN_WAIT_REASON["$p"]="deps done but not yet integrated into $INTEGRATION_TRUNK"
      else
        PLAN_LAUNCH+=("$p")
      fi
    elif [[ -n "${STALL_TASK[$p]:-}" ]] && ! phase_live "$p"; then
      # Not in the frontier, no live container, but an orphaned claim with
      # committed work sits on this phase's branch — that claim IS the reason
      # nothing here is eligible. Tested ahead of `oc` deliberately: when the
      # orphan is the phase's only remaining work oc == 0, and the phase would
      # otherwise land in PLAN_DONE and let is_drained declare the range
      # finished over committed, unfinished work.
      PLAN_RESUME+=("$p")
    elif [[ "$oc" -gt 0 ]]; then
      # Has open tasks but none eligible — gated on incomplete cross-phase deps,
      # unless a live container is already draining it.
      if phase_live "$p"; then
        PLAN_RUNNING+=("$p")
      else
        PLAN_WAITING+=("$p")
        PLAN_WAIT_REASON["$p"]="$oc open, none eligible — cross-phase blockers pending"
      fi
    else
      PLAN_DONE+=("$p")
    fi
  done < <(pump_expand_phases "$PHASES")
}

# ── Planning pass at task grain (issue #11) ───────────────────────────────────
# Same five classifications, same order of precedence, asked about a TASK. What
# changes is only what a unit is; every mechanism keeps its shape:
#
#   RUNNING  a live container on this task's own branch — never double-launched.
#   RESUME   an orphaned claim with committed work on this task's own branch,
#            and no file conflict with anything already holding the tree.
#   LAUNCH   eligible per the ledger, deps physically integrated (when the trunk
#            is on), and no file conflict with anything already holding the tree.
#   WAITING  everything else that is not finished, WITH THE REASON — blockers
#            pending, a conflict and the path it is on, a foreign claim, or a
#            status that needs a human.
#   DONE     done.
#
# The RESUME-before-open ordering is the F79 stall's lesson at the finer grain: a
# task whose only remaining state is its own committed-but-claimed work must not
# be able to read as finished.
#
# Three passes, and the split is the disjoint-files rule's: everything the tick
# will START — RUNNING already has, RESUME and LAUNCH will — becomes a holder,
# and a holder has to bind candidates planned BEFORE it as well as after. So
# each dispatch class is admitted in its own full pass over the range rather
# than inline in one loop.
compute_plan_task() {
  load_task_snapshot
  detect_stalled_orphans
  # Liveness read ONCE per pass, then answered from a map. phase_live asks the
  # runtime per unit, which is fine for a handful of phases and is a process
  # spawn per TASK per tick here. Same answer, same fail-open semantics (the
  # launch path may use a degraded enumeration — mechanism 2's asymmetry), one
  # read.
  local -A live_name=()
  local nm
  while IFS= read -r nm; do [[ -n "$nm" ]] && live_name["$nm"]=1; done < <(apl_live_agents)

  # Units already holding the tree this tick, in admission order: the live ones
  # first (they are running whatever the plan says), then the resumed ones, then
  # each task admitted to LAUNCH. A candidate is checked against all of them.
  PLAN_HOLDERS=()
  local -A classified=()
  local unit status claimed reason b pending
  # Pass 1 — live containers. Done as its own pass so a running task's footprint
  # is held against every candidate, not just the ones planned after it.
  while IFS= read -r unit; do
    [[ -z "$unit" ]] && continue
    if [[ -n "${live_name[$(unit_container "$unit")]:-}" ]]; then
      PLAN_RUNNING+=("$unit")
      PLAN_HOLDERS+=("$unit")
      classified["$unit"]=1
    fi
  done < <(tasks_in_range)

  # Pass 2 — resumable orphans, for exactly the reason pass 1 is its own pass.
  # do_tick dispatches PLAN_RESUME in the SAME tick as PLAN_LAUNCH, so a resumed
  # unit starts a container and its footprint has to be held against every
  # candidate — including the ones that sort ahead of it. Classifying RESUME
  # inline in the admission loop below (and appending to the holder list there)
  # bound only the candidates planned after it: an eligible task with the
  # IDENTICAL files: of a stranded one planned as RESUME + LAUNCH with "0
  # waiting", and a real tick started both containers on one file — the plan
  # looking clean while scheduling the collision this rule exists to refuse.
  # (adversarial review, 2026-08-14)
  #
  # A resume is itself checked against what already holds the tree, and can only
  # be held by a LIVE container (nothing else has been admitted yet). That is
  # safe for the deadlock detector: a live holder means have > 0, so a held
  # resume can never be mistaken for an idle tick.
  while IFS= read -r unit; do
    [[ -z "$unit" ]] && continue
    [[ -n "${classified[$unit]:-}" ]] && continue
    [[ -n "${STALL_TASK[$unit]:-}" ]] || continue
    # Classified ahead of eligibility and ahead of `done`: the claim IS the
    # reason this task is not in the frontier, and classifying it any other way
    # is how committed, unfinished work reads as finished.
    classified["$unit"]=1
    reason="$(hold_reason "$unit")"
    if [[ -n "$reason" ]]; then
      PLAN_WAITING+=("$unit")
      PLAN_WAIT_REASON["$unit"]="stalled on ${STALL_TASK[$unit]} (${STALL_STATUS[$unit]:-?}) but held: $reason"
      continue
    fi
    PLAN_RESUME+=("$unit")
    PLAN_HOLDERS+=("$unit")
  done < <(tasks_in_range)

  while IFS= read -r unit; do
    [[ -z "$unit" ]] && continue
    # Already classified RUNNING, RESUME, or held above.
    [[ -n "${classified[$unit]:-}" ]] && continue
    status="${TSNAP_STATUS[$unit]:-}"
    claimed="${TSNAP_CLAIMED[$unit]:-}"

    if [[ -n "${TSNAP_ELIGIBLE[$unit]:-}" ]]; then
      if [[ "$INTEGRATION" -eq 1 ]] && ! unit_deps_integrated "$unit"; then
        PLAN_WAITING+=("$unit")
        PLAN_WAIT_REASON["$unit"]="blockers done but not yet integrated into $INTEGRATION_TRUNK"
        continue
      fi
      reason="$(hold_reason "$unit")"
      if [[ -n "$reason" ]]; then
        PLAN_WAITING+=("$unit")
        PLAN_WAIT_REASON["$unit"]="$reason"
        continue
      fi
      PLAN_LAUNCH+=("$unit")
      PLAN_HOLDERS+=("$unit")
      continue
    fi

    case "$status" in
      done)
        PLAN_DONE+=("$unit")
        ;;
      open)
        pending=""
        for b in ${TSNAP_BLOCKERS[$unit]:-}; do
          [[ -z "$b" ]] && continue
          [[ "${TSNAP_STATUS[$b]:-}" == "done" ]] && continue
          pending+="${pending:+, }$b"
        done
        PLAN_WAITING+=("$unit")
        PLAN_WAIT_REASON["$unit"]="blockers pending: ${pending:-unresolved}"
        ;;
      in_progress)
        # Claimed, no live container, and not resumable (no commits on its
        # branch, or the claim is somebody else's). reclaim_orphaned_claims owns
        # the first case; the second is a human's branch and not ours to touch.
        PLAN_WAITING+=("$unit")
        PLAN_WAIT_REASON["$unit"]="claimed by ${claimed:-?}, no live container"
        ;;
      *)
        PLAN_WAITING+=("$unit")
        PLAN_WAIT_REASON["$unit"]="status: ${status:-unknown} — needs a human"
        ;;
    esac
  done < <(tasks_in_range)
  return 0
}

print_plan() {
  compute_plan
  local gate_line; if feed_gate; then gate_line="GATE: feed-ok"; else gate_line="GATE: PAUSED — $GATE_REASON"; fi
  echo "$PROG_NAME plan — phases $PHASES, grain $GRAIN, cap $(JOBS=$JOBS apl_read_cap), ceiling $CEILING%"
  echo "$gate_line"
  # What a feeding gate had to say — a Claude gate skipping on a host with no
  # Claude credentials, say. Indented under the gate line because it explains
  # that line: "feed-ok" alone cannot tell an operator whether the chain checked
  # and approved or had nothing to check.
  local note
  while IFS= read -r note; do
    [[ -n "$note" ]] && printf '  %s\n' "$note"
  done <<<"$GATE_NOTES"
  # One plan grammar at both grains — the same five verbs, the same columns,
  # with unit tokens where phases stand. Only the column width and the DONE
  # gloss differ, because a task id is longer than a phase token and "no open
  # tasks" is not what DONE means about a single task.
  local p w=6 done_note="no open tasks"
  if [[ "$GRAIN" == "task" ]]; then w=9; done_note="complete"; fi
  for p in "${PLAN_LAUNCH[@]:-}";  do [[ -n "$p" ]] && printf "  LAUNCH   %-${w}s -> %s\n" "$p" "$(unit_branch "$p")"; done
  for p in "${PLAN_RUNNING[@]:-}"; do [[ -n "$p" ]] && printf "  RUNNING  %-${w}s -> %s (live container)\n" "$p" "$(unit_branch "$p")"; done
  for p in "${PLAN_RESUME[@]:-}";  do [[ -n "$p" ]] && printf "  RESUME   %-${w}s -> %s (stalled on %s, %s; container dead, work committed)\n" \
      "$p" "$(unit_branch "$p")" "${STALL_TASK[$p]}" "${STALL_STATUS[$p]}"; done
  for p in "${PLAN_WAITING[@]:-}"; do [[ -n "$p" ]] && printf "  WAITING  %-${w}s (%s)\n" "$p" "${PLAN_WAIT_REASON[$p]:-cross-phase blockers pending}"; done
  for p in "${PLAN_DONE[@]:-}";    do [[ -n "$p" ]] && printf "  DONE     %-${w}s (%s)\n" "$p" "$done_note"; done
  echo "frontier: ${#PLAN_LAUNCH[@]} launchable, ${#PLAN_RUNNING[@]} running, ${#PLAN_RESUME[@]} resumable, ${#PLAN_WAITING[@]} waiting | open tasks in range: $(open_count)"
}

# ── Reclaim build artifacts of completed phases (A4 / F65.3) ───────────────────
# After compute_plan, every phase with no open tasks is in PLAN_DONE — its agent
# container has exited (a resumable phase still has an open task and is never
# PLAN_DONE), so its worktree target/ is dead weight. Reclaim it to keep a
# multi-day drain's disk footprint bounded. Guards: never touch a phase with a
# live container (phase_live), and only remove build artifacts — source files and
# every commit are untouched. Runs every tick regardless of the feed gate, so a
# disk-pressure pause can self-heal as completed phases free their target/ dirs.
# Disabled with ARACHNE_DISK_RECLAIM=0.
#
# With no TASKPUMP_RECLAIM_CMD configured the pass is a no-op: only a consumer
# knows how its build output is reclaimed, so there is no built-in fallback
# (G1.7 retired the cargo clean / rm -rf one; examples/arachne.conf pins
# 'cargo clean'). Logged once per run, not per tick.
RECLAIM_UNCONFIGURED_LOGGED=0
reclaim_done_targets() {
  [[ "${TASKPUMP_DISK_RECLAIM:-1}" -eq 1 ]] || return 0
  if [[ -z "$RECLAIM_CMD" ]]; then
    if [[ "$RECLAIM_UNCONFIGURED_LOGGED" -eq 0 ]]; then
      log "reclaim pass: TASKPUMP_RECLAIM_CMD unconfigured — leaving finished workspaces' build output in place"
      RECLAIM_UNCONFIGURED_LOGGED=1
    fi
    return 0
  fi
  local p wt sz
  for p in "${PLAN_DONE[@]:-}"; do
    [[ -z "$p" ]] && continue
    wt="$WORKTREES_DIR/$(unit_branch "$p")"
    [[ -d "$wt/target" ]] || continue
    unit_live "$p" && continue
    sz="$(du -sh "$wt/target" 2>/dev/null | cut -f1)"
    if ( cd "$wt" && eval "$RECLAIM_CMD" ) >/dev/null 2>&1; then
      log "reclaimed $p target/ (${sz:-?}) via TASKPUMP_RECLAIM_CMD"
    else
      warn "TASKPUMP_RECLAIM_CMD failed for $p ($wt)"
    fi
  done
}

# ── Pre-tick hooks ─────────────────────────────────────────────────────────────
# Housekeeping the supervisor runs before it plans anything. Pulling the ledger
# and scrubbing stale claims stay built in — the pump cannot function without
# them — but the two that encode assumptions about one project's working
# arrangement are files under hooks/ and can be replaced or dropped.
#
# Each hook is run with the repo root as $1. Its stdout is logged and, when the
# text CHANGES since the last tick, sent to the notifier — a persistent
# condition must not fire a desktop notification every TICK seconds. The
# fingerprint lives in a marker file, so the dedup survives a supervisor
# restart. A non-zero exit is a warning, never a reason to skip the tick.
default_pre_tick_hooks() {
  printf '%s\n' "$TP_ROOT/hooks/gitignore-repair"
  printf '%s\n' "$TP_ROOT/hooks/fs-guard"
}

run_pre_tick_hooks() {
  local hooks spec rc out all=""
  hooks="${TASKPUMP_PRE_TICK_HOOKS:-$(default_pre_tick_hooks)}"
  while IFS= read -r spec; do
    [[ -z "${spec//[[:space:]]/}" ]] && continue
    # A hook entry is a command line; splitting on whitespace is the point.
    # shellcheck disable=SC2086
    set -- $spec
    if [[ ! -x "$1" ]]; then
      warn "pre-tick hook not executable, skipping: $1"
      continue
    fi
    rc=0
    out="$(TP_REPO_ROOT="$REPO_ROOT" "$@" "$REPO_ROOT" 2>&1)" || rc=$?
    (( rc != 0 )) && warn "pre-tick hook '$1' failed (rc=$rc)${out:+ — $out}"
    [[ -n "$out" ]] && { log "$out"; all+="$out"$'\n'; }
  done <<<"$hooks"

  all="${all%$'\n'}"
  if [[ -n "$all" ]]; then
    # Compare against the trimmed form the marker holds; $(cat) strips trailing
    # newlines, so an untrimmed comparison never matches and re-notifies forever.
    if [[ "$all" != "$(cat "$HOOK_MARK_FILE" 2>/dev/null)" ]]; then
      pump_notify "$all"
      printf '%s' "$all" >"$HOOK_MARK_FILE" 2>/dev/null || true
    fi
  else
    rm -f "$HOOK_MARK_FILE" 2>/dev/null || true   # quiet again → re-arm
  fi
  return 0
}

# ── Ledger-repo sync (issue #41) ───────────────────────────────────────────────
# Every tick refreshes the ledger checkout so a task file another machine pushed
# is planned this tick, and the drain / stall-exit paths push it back. A consumer
# with no SEPARATE ledger repo — the bring-your-own-repo shape, where OPS_DIR is
# a missing ops/ or a purely local checkout — has nothing to sync, and the old
# unconditional `|| warn` reported that absence as a failure every TICK seconds
# for the life of the run. Harmless per line, corrosive in aggregate: it teaches
# an operator to skim past pump stderr, which is the channel every loud failure
# in this file arrives on (found in the G4.4 walkthrough rehearsal, PR #39).
#
# So classify the shape ONCE, at startup, and say it once there. Only a sync
# that can never do anything is skipped; a real sync that really fails still
# warns every tick, now carrying the reason the old one-liner discarded.
# "OPS_DIR is the workspace" is deliberately NOT a skip condition even though
# the issue offers it: a ledger living inside a remote-backed code repo has a
# real pull to make, and skipping that would drop real ledger updates — the
# remoteless case below already covers every workspace-as-ledger shape that
# could have produced the noise.
OPS_SYNC=1               # 1 = there is a ledger repo to pull/push
OPS_SYNC_SKIP_REASON=""  # why not, for the one startup line

classify_ops_sync() {
  OPS_SYNC=1; OPS_SYNC_SKIP_REASON=""
  if ! git -C "$OPS_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    OPS_SYNC=0; OPS_SYNC_SKIP_REASON="$OPS_DIR is not a git checkout"
    return 0
  fi
  if [[ -z "$(git -C "$OPS_DIR" remote 2>/dev/null)" ]]; then
    OPS_SYNC=0; OPS_SYNC_SKIP_REASON="$OPS_DIR has no git remote"
    return 0
  fi
  return 0
}

# Which line of a failed git run is the REASON — deliberately NOT the first one.
# git's combined output opens with the FETCH banner ("From <url>", then the
# ref-update line), which describes the step that SUCCEEDED, and pads the middle
# with `hint:` advice. Quoting line 1 therefore named the wrong thing in the
# routine failing shape: a ledger branch DIVERGED from its remote — routine
# because tp-task commits task files locally on every tick while another machine
# pushes the same branch — warned "— From <url>" on the first tick and a
# dangling "hint: Diverging branches can't be fast-forwarded, you need to
# either:" on every tick after, while git's own "fatal: Not possible to
# fast-forward, aborting." was never shown at all. Pointing an operator at the
# remote URL for a divergence is precisely the confident-wrong-reason this
# warning exists to prevent, so: quote git's diagnosis when it made one, else
# the first line that is neither banner nor advice (a branch with no upstream
# states its cause as bare prose and then offers four lines of remedy, so the
# LAST line is the remedy, not the cause). Nothing quotable degrades to the bare
# warning rather than to a guess.
git_failure_reason() {  # git_failure_reason <combined git output>
  local why
  why=$(grep -m1 -E '^(fatal|error):' <<<"$1") \
    || why=$(grep -m1 -Ev '^([[:space:]]|From |remote:|hint:|$)' <<<"$1") \
    || why=""
  printf '%s' "$why"
}

# Refresh the ledger before planning. Never fatal — a stale ledger still plans —
# but a configured remote that fails is an operator-visible fact, so name it.
ops_pull() {
  [[ "$OPS_SYNC" -eq 1 ]] || return 0
  local out rc=0 why
  out=$(git -C "$OPS_DIR" pull --ff-only 2>&1) || rc=$?
  (( rc == 0 )) && return 0
  why=$(git_failure_reason "$out")
  warn "ops pull --ff-only failed (continuing)${why:+ — $why}"
  return 0
}

# Push the ledger back. Same skip, same reason: with no ledger repo, "final ops
# push failed" is a failure report for a push that was never attempted — and it
# lands on the drain line, the one line of a run every operator reads.
ops_push() {  # ops_push <warning>
  [[ "$OPS_SYNC" -eq 1 ]] || return 0
  git -C "$OPS_DIR" push >/dev/null 2>&1 || warn "$1"
  return 0
}

# ── One tick: scrub, plan, reclaim, gate, top up the pool to cap ───────────────
do_tick() {
  LIVENESS_DEGRADED_TICK=0   # the degraded-liveness warning is once per tick
  ops_pull
  # Capture rather than discard: a scrub that finds invisible task files (exit
  # 3) has the one detail worth acting on — the paths. Dropping them left the
  # operator a generic "scrub failed" every tick for days with nothing to go on,
  # and conflated a corrupt ledger with scrub itself crashing.
  local scrub_out scrub_line scrub_rc=0
  scrub_out=$("$TASK_BIN" scrub 2>&1) || scrub_rc=$?
  if (( scrub_rc == 3 )); then
    while IFS= read -r scrub_line; do
      [[ -n "$scrub_line" ]] && warn "ledger integrity: $scrub_line"
    done < <(grep -E 'UNPARSEABLE|NO-ID' <<<"$scrub_out" || true)
  elif (( scrub_rc != 0 )); then
    warn "scrub failed (continuing)"
  fi
  reclaim_orphaned_claims   # D3: free tasks parked by dead containers before planning
  run_pre_tick_hooks

  # Integrate finished phases into auto/trunk (A3). Runs after scrub and BEFORE
  # feed_gate: integration is local compute (no API tokens), so finished work
  # keeps propagating even while LAUNCHING is usage-paused. No-op when the
  # integration trunk is off (INTEGRATION=0).
  reconcile_trunk

  # Plan + reclaim run before the gate: classification is read-only and reclaim
  # frees disk for DONE phases even while feeding is paused (e.g. on the disk gate).
  compute_plan
  reclaim_done_targets

  if ! feed_gate; then
    log "PAUSED feeding — $GATE_REASON (running agents untouched)"
    write_state paused "$GATE_REASON"
    return 0
  fi

  local cap have launched=0 p
  cap="$(JOBS=$JOBS apl_read_cap)"
  have="$(apl_count_live_agents)"
  for p in "${PLAN_LAUNCH[@]:-}"; do
    [[ -z "$p" ]] && continue
    (( have >= cap )) && break
    if launch_unit "$p"; then
      have=$((have + 1)); launched=$((launched + 1)); sleep "$STAGGER"
    fi
  done
  # Starved phases go last: genuinely-eligible work is always preferred over
  # resuming a partially-done task. Same cap, same stagger, and — because this
  # sits below the feed gate's early return — the same usage/token/WiFi/disk
  # pause, so a resume never fires while the pump is throttled.
  for p in "${PLAN_RESUME[@]:-}"; do
    [[ -z "$p" ]] && continue
    (( have >= cap )) && break
    if resume_unit "$p"; then
      have=$((have + 1)); launched=$((launched + 1)); sleep "$STAGGER"
    fi
  done
  [[ "$launched" -gt 0 ]] && log "tick: launched $launched (live=$have/$cap)"

  # Deadlock detector. Nothing running, nothing launchable, nothing resumable ⇒
  # no later tick can change state by itself, so idling is pointless — this is
  # the 7-hour/563-tick silence the F79 stall produced. Counted over consecutive
  # ticks so a container dying mid-tick cannot trip it; gate-paused ticks return
  # before this point and never count.
  if (( have == 0 )) && [[ -z "${PLAN_LAUNCH[*]:-}" && -z "${PLAN_RESUME[*]:-}" ]]; then
    STALL_TICKS=$((STALL_TICKS + 1))
  else
    STALL_TICKS=0
  fi
  write_state running ""
  return 0
}

# No live agents, nothing launchable, nothing resumable, and open work left:
# hand the range to a human instead of spinning. Exits non-zero so the systemd
# unit reports `failed` rather than sitting green while making no progress.
stall_exit() {
  local attention
  attention=$("$TASK_BIN" list 2>/dev/null \
    | awk '$2=="blocked"||$2=="stuck"||$2=="needs-review"{n++} END{print n+0}')
  write_state stalled "no live agents, nothing launchable, nothing resumable"
  ops_push "ops push on stall exit failed"
  pump_notify "$PHASES STALLED after $STALL_TICKS idle ticks — $(open_count) open task(s) remain but none can launch, and no orphaned claim is resumable. $attention task(s) need human review (blocked/stuck/needs-review)."
  exit 3
}

# ── Drain check ────────────────────────────────────────────────────────────────
is_drained() {
  [[ "$(open_count)" -eq 0 && "$(apl_count_live_agents)" -eq 0 ]]
}

# ── Restart-safe state (E2) ────────────────────────────────────────────────────
# Persist enough that a restarted supervisor (or the monitor) can re-derive what
# is in flight. Restart safety itself falls out of D3: liveness comes from
# `docker ps` and the queue is recomputed each tick, so a fresh supervisor never
# disturbs running containers and never double-launches — the state file just
# makes the run observable (paused_reason) and lets a restart confirm it is
# resuming the same range.
# The file also carries the writer's pid + host (issue #22): status alone is a
# claim a dead pump cannot retract — the G3 drain left `status: running` behind
# with no supervisor process, and a reader trusting it gets the exact wrong
# answer to "is a pump live?". The pid lets every reader verify liveness with
# kill -0 instead of trusting the label; tp-monitor renders a running state
# with a dead pid as STALE. The last status/reason written are remembered so
# the exit trap below can tell an already-stamped terminal exit
# (drained/stalled/stopped) from an abandoned running/paused claim.
PUMP_LAST_STATUS=""
PUMP_LAST_REASON=""
write_state() {  # $1=status(running|paused|drained|stalled|stopped) $2=reason
  local status="${1:-running}" reason="${2:-}"
  PUMP_LAST_STATUS="$status"
  PUMP_LAST_REASON="$reason"
  jq -n \
    --arg phases "$PHASES" --argjson jobs "$JOBS" --argjson ceiling "$CEILING" \
    --arg grain "$GRAIN" --arg started "$PUMP_STARTED_AT" \
    --arg last_tick "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson live "$(apl_count_live_agents)" --argjson open "$(open_count)" \
    --arg status "$status" --arg reason "$reason" \
    --argjson pid "$$" --arg host "${HOSTNAME:-$(hostname 2>/dev/null || echo unknown)}" \
    '{phases:$phases, jobs:$jobs, ceiling:$ceiling, grain:$grain,
      started_at:$started, last_tick:$last_tick, live_agents:$live,
      open_tasks:$open, status:$status, paused_reason:$reason,
      pid:$pid, host:$host}' \
    >| "$STATE_FILE" 2>/dev/null || true
}

# ── Notify (E5) ────────────────────────────────────────────────────────────────
# Pluggable: ARACHNE_NOTIFY_CMD reads the message on stdin; defaults to
# `notify-send` (desktop) when present, else a no-op (just the log line).
pump_notify() {
  local msg="$1"
  log "$msg"
  if [[ -n "${TASKPUMP_NOTIFY_CMD:-}" ]]; then
    printf '%s\n' "$msg" | ${TASKPUMP_NOTIFY_CMD} >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "$PROG_NAME" "$msg" >/dev/null 2>&1 || true
  fi
}

# ── Detach (E3) ────────────────────────────────────────────────────────────────
# Re-exec the SAME command minus --detach, fully detached so a multi-day run
# survives terminal close / SSH drop. Prefers a transient systemd --user unit
# (clean `journalctl --user -u taskpump-pump`, Restart not set for transient —
# use systemd/taskpump-pump.service for restart-on-failure); falls back to
# setsid+nohup. The persistent unit template is systemd/taskpump-pump.service.
#
# The transient unit starts from the user manager — cwd $HOME, near-empty env —
# so everything THIS invocation resolved from its own context must cross the
# boundary explicitly (issue #31): the working directory (conf discovery walks
# up from $PWD), TASKPUMP_CONFIG (a consumer shim's export dies with the shim,
# because $0 is the resolved tp-pump, not the shim), and every override the
# operator just watched a dry-run of the same invocation honor. The setsid
# fallback inherits env and cwd natively; the forward below is what keeps the
# preferred path equivalent to it.

# The documented unprefixed spellings this tool reads alongside TASKPUMP_*
# (config block above and the runner hand-off), forwarded when the caller
# exported them.
DETACH_PASSTHROUGH_NAMES=(
  GITHUB_TOKEN MAX_TURNS AGENT_MODEL JOBS POOL_TICK POOL_STAGGER HEALTH_WINDOW
  DOCKER AGENT_MEMORY_MAX AGENT_MEMORY_SWAP
)

# build_detach_argv — construct the systemd-run re-exec into DETACH_ARGV (plus
# the shared pieces DETACH_UNIT / DETACH_FWD) rather than inline, so the
# boundary-crossing contract above is testable without a live user manager.
# Only EXPORTED names are forwarded: exactly the set the setsid fallback's
# child would inherit, never this process's internal computed state.
declare -a DETACH_ARGV DETACH_FWD
DETACH_UNIT=""
build_detach_argv() {
  DETACH_FWD=()
  local a name
  for a in "${ORIG_ARGS[@]}"; do [[ "$a" == "--detach" ]] || DETACH_FWD+=("$a"); done
  DETACH_UNIT="$PROG_NAME-$(printf '%s' "$PHASES" | tr -c 'A-Za-z0-9' '-')"
  DETACH_ARGV=(
    systemd-run --user --collect --unit="$DETACH_UNIT"
    --description="$PROG_NAME usage-governed pump ($PHASES)"
    -p WorkingDirectory="$PWD"
  )
  while IFS= read -r name; do
    case "$name" in TASKPUMP_*|ARACHNE_*) ;; *) continue ;; esac
    tp__is_set "$name" || continue
    DETACH_ARGV+=(--setenv="$name=${!name}")
  done < <(compgen -A export 2>/dev/null || true)
  for name in "${DETACH_PASSTHROUGH_NAMES[@]}"; do
    [[ "$(declare -p "$name" 2>/dev/null)" == "declare -x"* ]] || continue
    tp__is_set "$name" || continue
    DETACH_ARGV+=(--setenv="$name=${!name}")
  done
  DETACH_ARGV+=("$0" "${DETACH_FWD[@]}")
}

detach_and_exit() {
  build_detach_argv
  if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
    "${DETACH_ARGV[@]}"
    log "detached as systemd --user unit '$DETACH_UNIT'."
    log "  status: systemctl --user status $DETACH_UNIT   logs: journalctl --user -u $DETACH_UNIT -f"
    log "  stop:   systemctl --user stop $DETACH_UNIT"
  else
    setsid nohup "$0" "${DETACH_FWD[@]}" >>"$PUMP_LOG" 2>&1 </dev/null &
    local pid=$!
    disown "$pid" 2>/dev/null || true
    log "detached via setsid+nohup (pid=$pid, log=$PUMP_LOG)."
    log "  stop: kill $pid   (or: pkill -f '$PROG_NAME.*$PHASES')"
  fi
  exec_monitor
  exit 0
}

# Hand the launching terminal to the monitor. Only ever called after the
# supervisor is detached, so quitting the monitor (q) leaves the pump running —
# it is a viewer, not the run. Skipped when not interactive so cron/CI and the
# detached re-exec itself never block on a UI.
exec_monitor() {
  [[ "$MONITOR" -eq 1 ]] || return 0
  [[ -t 0 && -t 1 ]] || { log "not a tty — skipping the monitor (run: $MONITOR_BIN)"; return 0; }
  [[ -x "$MONITOR_BIN" ]] || { log "no monitor at $MONITOR_BIN — skipping"; return 0; }
  # The supervisor writes .taskpump-pump.state on its first tick; give it a beat
  # so the monitor's opening frame shows the run instead of "no pump".
  sleep 2
  log "opening the monitor (q to close it; the pump keeps running)"
  # No mode flag: the tty guard above means the monitor's own default watches.
  exec "$MONITOR_BIN"
}

# ── Modes ──────────────────────────────────────────────────────────────────────
# Refuse an unnameable or colliding unit before ANY mode runs, --dry-run
# included: a plan that shows two tasks launching onto one agent name is a
# wrong plan, and finding that out only at launch time is finding it out too
# late. No-op at phase grain, where the prefix probe above already answered.
validate_unit_names

case "$MODE" in
  render)
    # Print the brief rendered for $PHASES to stdout (debug / test). Goes
    # through render_brief_stream so {{DEPENDS_ON}} is expanded too (v1).
    #
    # At task grain the argument is a UNIT, and a unit is a task id. Handed a
    # phase token it used to render a task brief around it — "your job is one
    # task: G3", pointing the reader at tasks/G3.md, which does not exist. A
    # debug path that fabricates a plausible-looking brief for a task that was
    # never dispatched is the same silent wrong answer in miniature, so refuse
    # and say what to pass instead.
    if [[ "$GRAIN" == "task" && -z "${TSNAP_STATUS[$PHASES]:-}" ]]; then
      die "--render-brief takes a TASK ID at --grain task; '$PHASES' is not a task in range.
The task brief is rendered for one task and points its reader at
$(tasks_dir_rel)/$PHASES.md. Pass a task id (e.g. $PHASES.1), or drop
--grain task to render the phase-drain brief for phase $PHASES."
    fi
    [[ -f "$BRIEF_TEMPLATE" ]] || die "$(missing_brief_template_msg)"
    render_brief_stream "$PHASES"
    exit 0
    ;;
  resume-note)
    # Print the resume preamble a stalled phase WOULD get, to stdout (debug /
    # test). Same split as render_brief: the stream form is the testable one.
    detect_stalled_orphans
    id="${STALL_TASK[$PHASES]:-}"
    [[ -n "$id" ]] || die "no stalled orphan detected for phase $PHASES (nothing to resume)"
    render_resume_note_stream "$WORKTREES_DIR/$(unit_branch "$PHASES")" "$(unit_branch "$PHASES")" "$id"
    exit 0
    ;;
  dry)
    echo "[dry-run] no image build, no launches, no ops mutation"
    echo "gates: $(gate_chain_line)"
    print_plan
    exit 0
    ;;
  list)
    print_plan
    exit 0
    ;;
esac

# Real run (run / once): detach first if asked, then check prerequisites.
[[ "$DETACH" -eq 1 && "$MODE" == "run" ]] && detach_and_exit

# Restart detection (E2): a leftover state file for the SAME range means we are
# resuming; D3 makes that safe (re-derive from task files + docker ps).
if [[ -f "$STATE_FILE" ]]; then
  prev_phases="$(jq -r '.phases // empty' "$STATE_FILE" 2>/dev/null || true)"
  if [[ "$prev_phases" == "$PHASES" ]]; then
    log "resuming pump for $PHASES (re-deriving from task files + docker ps; running agents untouched)."
  elif [[ -n "$prev_phases" ]]; then
    warn "a pump state file exists for a different range ($prev_phases); overwriting with $PHASES."
  fi
fi

if [[ -z "${GITHUB_TOKEN:-}" ]] && command -v gh >/dev/null 2>&1; then
  GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"; export GITHUB_TOKEN
fi
[[ -f "$BRIEF_TEMPLATE" ]] || die "$(missing_brief_template_msg)"

# Seed the live cap file for discoverability / retuning.
[[ -f "$CAP_FILE" ]] || echo "$JOBS" >| "$CAP_FILE" 2>/dev/null || true

# Skip the (~9 GB) image build when we will not launch containers — keeps the
# NO_LAUNCH tick (tests / live read-only validation) side-effect-free.
if [[ "${TASKPUMP_PUMP_NO_LAUNCH:-0}" -ne 1 ]]; then
  # Launch prerequisites only: a NO_LAUNCH tick starts no containers, so it
  # must not require the operator's auth dir — CI runners have no ~/.claude.
  [[ -d "$CLAUDE_DIR" ]] || die "no ~/.claude; run 'claude' to authenticate first"
  # Before the build and before any runner call: launching needs an image, and
  # there is deliberately no default — a wrong silent image is strictly worse
  # than a loud missing one.
  [[ -n "$IMAGE" ]] || die "no container image configured: set TASKPUMP_IMAGE (--dry-run works without one)"
  [[ -x "$RUNNER" ]] || die "no agent runner at $RUNNER (set TASKPUMP_RUNNER)"
  # Probe the liveness source once, HERE, in the main shell: every tick reads
  # liveness from a subshell, where a cached answer would not survive. Placed
  # after the image check on purpose — the prerequisites must abort before this
  # process ever calls the runner.
  if apl_runner_list_supported "$RUNNER"; then
    log "liveness: asking the runner ($RUNNER list)"
  else
    log "liveness: runner has no list verb (contract v1); enumerating names matching $(apl_agent_prefix)*"
  fi
  if [[ -n "$IMAGE_BUILD_CMD" ]]; then
    log "Building the $IMAGE image ..."
    ( cd "$REPO_ROOT" && eval "$IMAGE_BUILD_CMD" ) >/dev/null || die "image build failed"
  fi
fi

# Materialise auto/trunk + its worktree once, before the loop (A3). Real run
# only — skipped under NO_LAUNCH (tests / read-only validation) and a no-op when
# --integration-trunk is off.
if [[ "${TASKPUMP_PUMP_NO_LAUNCH:-0}" -ne 1 ]]; then
  ensure_trunk
fi

# Decide once whether this pump has a ledger repo to sync at all (issue #41),
# and disclose the answer HERE — as one startup line — instead of as a pull
# failure every tick forever. Outside the NO_LAUNCH guard on purpose: a
# read-only tick refreshes the ledger like any other.
classify_ops_sync
[[ "$OPS_SYNC" -eq 1 ]] \
  || log "ledger: no separate ledger repo to sync ($OPS_SYNC_SKIP_REASON); skipping the per-tick pull and the closing push"

# Belt-and-suspenders disk discipline (A4): auto-start the disk watchdog like
# run-parallel.sh does, so disk pressure also drops the live pool cap (cap-file
# path) on top of the feed gate. --auto-exit retires it once no agents remain.
# Skipped for --once / NO_LAUNCH ticks and when the disk gate is disabled.
if [[ "$MODE" == "run" && "$DISK_GATE" -eq 1 && "${TASKPUMP_PUMP_NO_LAUNCH:-0}" -ne 1 ]]; then
  nohup "$DISK_WATCHDOG_BIN" --auto-exit \
    >>"$DISK_WATCHDOG_LOG" 2>&1 </dev/null &
  disown "$!" 2>/dev/null || true
  log "disk watchdog started (cap-file path; log: $DISK_WATCHDOG_LOG)"
fi

log "Pump: phases=$PHASES grain=$GRAIN cap=$JOBS (live via $CAP_FILE) ceiling=${CEILING}% tick=${TICK}s"
log "Singular supervisor; Ctrl-C stops feeding but leaves running agents. Monitor: $MONITOR_BIN"

# ── Exit honesty (issue #22) ───────────────────────────────────────────────────
# From here on, every exit path stamps a terminal status into the state file.
# The G3 incident: --once exited right after do_tick (whose last write is
# `running`), and a killed loop died wherever it was — either way the file kept
# claiming a live pump forever, and a reader trusting it burned a rescue
# session. The EXIT trap catches normal exits and crashes (set -e, die);
# INT/TERM/HUP get their own handlers because a fatal signal does not run the
# EXIT trap in a non-interactive shell — each stamps `stopped` with the signal
# as the reason, then re-raises so the exit status still reports the signal.
# Installed only now, after the prerequisites: a pump that never ticked never
# wrote state, and must not clobber a previous run's file on a startup abort.
# SIGKILL cannot be trapped — that path is what the pid field in the state file
# is for (the reader verifies liveness instead of trusting `status`).
pump_stamp_exit() {   # EXIT trap; $? is the pump's exit status
  local rc=$?
  case "$PUMP_LAST_STATUS" in drained|stalled|stopped) return 0 ;; esac
  local why="pump exited"
  (( rc != 0 )) && why="pump exited (rc=$rc)"
  write_state stopped "$why"
}
pump_signal_exit() {  # $1 = signal name (INT|TERM|HUP)
  trap - EXIT
  write_state stopped "received SIG$1"
  log "SIG$1 — stopping the supervisor (running agents are left alive; state stamped stopped)"
  # Reap the backgrounded tick sleep: the signal exit abandons the wait, and
  # an orphaned `sleep $TICK` would outlive the pump by up to a full tick.
  kill "${TICK_SLEEP_PID:-}" 2>/dev/null || true
  trap - "$1"
  kill -s "$1" $$
}
trap pump_stamp_exit EXIT
trap 'pump_signal_exit INT'  INT
trap 'pump_signal_exit TERM' TERM
trap 'pump_signal_exit HUP'  HUP

if [[ "$MODE" == "once" ]]; then
  do_tick
  # Writer honesty (issue #22): do_tick's last write is `running` (or `paused`
  # behind a tripped gate), and this process is about to not exist — leaving
  # either behind is the lie the incident is about. Stamp the terminal state
  # explicitly, carrying a gate pause forward so a gated single tick stays
  # diagnosable from the file alone.
  once_reason="single tick complete (--once)"
  [[ "$PUMP_LAST_STATUS" == "paused" && -n "$PUMP_LAST_REASON" ]] \
    && once_reason+="; feeding was paused — $PUMP_LAST_REASON"
  write_state stopped "$once_reason"
  log "single tick complete (--once)"
  exit 0
fi

# Multi-day drain loop.
while true; do
  do_tick
  if is_drained; then
    log "range $PHASES drained: no open tasks and no live agents remain."
    break
  fi
  if (( STALL_TICKS >= STALL_EXIT_TICKS )); then
    stall_exit
  fi
  # Interruptible sleep: bash defers trap handlers until the foreground command
  # returns, so a plain `sleep $TICK` would make `systemctl stop` wait out the
  # rest of the tick — and its SIGKILL after the stop timeout would skip the
  # stamp entirely. Backgrounding the sleep and waiting on it (a builtin, which
  # signals interrupt immediately) lets the TERM trap run the moment it lands.
  sleep "$TICK" & TICK_SLEEP_PID=$!
  wait "$TICK_SLEEP_PID" || true
done

# Graduate the integration trunk as one auto/trunk → main PR (A3, no-op when
# --integration-trunk is off), then push canonical ops/.
graduate_trunk
ops_push "final ops push failed"
write_state drained ""
# Tally non-done terminal states that need a human (blocked / stuck / needs-review).
attention=$("$TASK_BIN" list 2>/dev/null \
  | awk '$2=="blocked"||$2=="stuck"||$2=="needs-review"{n++} END{print n+0}')
pump_notify "$PHASES drained: 0 open should remain ($(open_count) open), $attention task(s) need human review (blocked/stuck/needs-review)."
exit 0
