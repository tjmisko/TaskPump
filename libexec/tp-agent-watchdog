#!/bin/bash
# arachne-agent-watchdog -- run arachne-cleanup --stuck on an interval, so
# log-stale agents get killed and their tasks released for the next pass.
#
# Background: an agent container can wedge silently — Claude waiting on a
# bash tool call that never returns (cargo lock held by a corpse process,
# disk-full ENOSPC, etc.). Without intervention the container sits forever,
# its task stays claimed, and no other agent can pick it up. This watchdog
# is the running-system counterpart to arachne-cleanup --stuck.
#
# Usage:
#   ./scripts/arachne-agent-watchdog                    # watch + auto-cleanup
#   ./scripts/arachne-agent-watchdog --dry-run          # detect + log, don't act
#   ./scripts/arachne-agent-watchdog --once             # one check, exit
#   ./scripts/arachne-agent-watchdog --auto-exit        # exit cleanly when no agents remain
#   STUCK_THRESHOLD_MIN=20 ./scripts/arachne-agent-watchdog
#
# Env (forwarded to arachne-cleanup):
#   POLL                  -- seconds between sweeps (default 120)
#   STUCK_THRESHOLD_MIN   -- log-stale cutoff in minutes (default 15)
#   STARTUP_GRACE_SEC     -- with --auto-exit, ignore zero-agent state this long after start (default 120)
#   EMPTY_GRACE_CHECKS    -- with --auto-exit, exit after this many consecutive empty checks (default 3)
#
# Heuristic note: long cargo builds are slow but they DO write to the log
# (each `cargo check` step emits a "tool_use" event in the JSON stream).
# Truly stuck = no log writes for STUCK_THRESHOLD_MIN minutes; a 14-minute
# cargo run is not flagged.
# HELP-END
set -uo pipefail

# ── TaskPump config core ──────────────────────────────────────────────────────
_tp_self_root="$(CDPATH= cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/config.sh
. "$_tp_self_root/lib/config.sh"
tp_load_config
# shellcheck source=../lib/pump-lib.sh
. "$TP_LIB_DIR/pump-lib.sh"

REPO_ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
POLL="${TASKPUMP_WATCHDOG_POLL:-${POLL:-120}}"
export STUCK_THRESHOLD_MIN="${TASKPUMP_STUCK_THRESHOLD_MIN:-${STUCK_THRESHOLD_MIN:-15}}"

DRY_RUN=0; ONCE=0; AUTO_EXIT=0
STARTUP_GRACE_SEC="${TASKPUMP_STARTUP_GRACE_SEC:-${STARTUP_GRACE_SEC:-120}}"
EMPTY_GRACE_CHECKS="${TASKPUMP_EMPTY_GRACE_CHECKS:-${EMPTY_GRACE_CHECKS:-3}}"
EXTRA_ARGS=()
for a in "$@"; do
    case "$a" in
        --dry-run)   DRY_RUN=1; EXTRA_ARGS+=(--dry-run) ;;
        --once)      ONCE=1 ;;
        --auto-exit) AUTO_EXIT=1 ;;
        -h|--help)   apl_help "$0"; exit 0 ;;
        *) echo "ERROR: unknown arg '$a'" >&2; exit 2 ;;
    esac
done

STARTED_AT=$(date +%s)
EMPTY_RUN=0

maybe_exit_when_idle() {
    [[ "$AUTO_EXIT" -eq 1 ]] || return 0
    local now elapsed; now=$(date +%s); elapsed=$((now - STARTED_AT))
    if (( elapsed < STARTUP_GRACE_SEC )); then return 0; fi
    local n; n="$(apl_count_live_agents)"
    if (( n > 0 )); then EMPTY_RUN=0; return 0; fi
    EMPTY_RUN=$((EMPTY_RUN + 1))
    if (( EMPTY_RUN >= EMPTY_GRACE_CHECKS )); then
        log "no agent containers for $EMPTY_RUN consecutive checks; exiting (--auto-exit)."
        exit 0
    fi
}

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

react() {
    "$TP_LIBEXEC_DIR/tp-cleanup" --stuck "${EXTRA_ARGS[@]}" 2>&1 | sed 's/^/  cleanup: /'
}

mode="watch"; [[ "$ONCE" -eq 1 ]] && mode="once"; [[ "$DRY_RUN" -eq 1 ]] && mode="$mode/dry-run"
log "arachne-agent-watchdog starting ($mode): poll=${POLL}s stuck_threshold=${STUCK_THRESHOLD_MIN}min"

if [[ "$ONCE" -eq 1 ]]; then
    react
    exit 0
fi

trap 'log "stopping."; exit 0' INT TERM
while true; do
    react
    maybe_exit_when_idle
    sleep "$POLL"
done
