#!/bin/bash
# tp-agent-watchdog -- run `tp cleanup --stuck` on an interval, so log-stale
# agents get killed and their tasks released for the next pass.
#
# Background: an agent container can wedge silently — waiting on a tool call
# that never returns (a build lock held by a corpse process, a disk-full
# ENOSPC). Without intervention the container sits forever, its task stays
# claimed, and no other agent can pick it up. This watchdog is the
# running-system counterpart to `tp cleanup --stuck`.
#
# Usage:
#   tp agent-watchdog                    # watch + auto-cleanup
#   tp agent-watchdog --dry-run          # detect + log, don't act
#   tp agent-watchdog --once             # one check, exit
#   tp agent-watchdog --auto-exit        # exit cleanly when no agents remain
#
# Configuration (taskpump.conf or the environment; legacy names still work):
#   TASKPUMP_WATCHDOG_POLL        seconds between sweeps (default 120)
#   TASKPUMP_STUCK_THRESHOLD_MIN  log-stale cutoff, minutes (default 15)
#   TASKPUMP_STARTUP_GRACE_SEC    with --auto-exit, ignore zero-agent state this
#                                 long after start (default 120)
#   TASKPUMP_EMPTY_GRACE_CHECKS   with --auto-exit, exit after this many
#                                 consecutive empty checks (default 3)
#
# Heuristic note: long builds are slow but they DO write to the log (each step
# emits an event in the agent's JSON stream). Truly stuck = no log writes for
# the threshold; a 14-minute build is not flagged.
# HELP-END
set -uo pipefail

# ── TaskPump config core ──────────────────────────────────────────────────────
_tp_self_root="$(CDPATH='' cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/config.sh
. "$_tp_self_root/lib/config.sh"
tp_load_config
# shellcheck source=../lib/pump-lib.sh
. "$TP_LIB_DIR/pump-lib.sh"

POLL="${TASKPUMP_WATCHDOG_POLL:-${POLL:-120}}"
export STUCK_THRESHOLD_MIN="${TASKPUMP_STUCK_THRESHOLD_MIN:-${STUCK_THRESHOLD_MIN:-15}}"

DRY_RUN=0; ONCE=0; AUTO_EXIT=0
STARTUP_GRACE_SEC="${TASKPUMP_STARTUP_GRACE_SEC:-${STARTUP_GRACE_SEC:-120}}"
EMPTY_GRACE_CHECKS="${TASKPUMP_EMPTY_GRACE_CHECKS:-${EMPTY_GRACE_CHECKS:-3}}"
EXTRA_ARGS=()
for a in "$@"; do
    case "$a" in
        --dry-run)   DRY_RUN=1; EXTRA_ARGS+=(--dry-run) ;;
        --once)      ONCE=1 ;;
        --auto-exit) AUTO_EXIT=1 ;;
        -h|--help)   apl_help "$0"; exit 0 ;;
        *) echo "ERROR: unknown arg '$a'" >&2; exit 2 ;;
    esac
done

STARTED_AT=$(date +%s)
EMPTY_RUN=0

maybe_exit_when_idle() {
    [[ "$AUTO_EXIT" -eq 1 ]] || return 0
    local now elapsed; now=$(date +%s); elapsed=$((now - STARTED_AT))
    if (( elapsed < STARTUP_GRACE_SEC )); then return 0; fi
    local n; n="$(apl_count_live_agents)"
    if (( n > 0 )); then EMPTY_RUN=0; return 0; fi
    EMPTY_RUN=$((EMPTY_RUN + 1))
    if (( EMPTY_RUN >= EMPTY_GRACE_CHECKS )); then
        log "no agent containers for $EMPTY_RUN consecutive checks; exiting (--auto-exit)."
        exit 0
    fi
}

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

react() {
    "$TP_LIBEXEC_DIR/tp-cleanup" --stuck "${EXTRA_ARGS[@]}" 2>&1 | sed 's/^/  cleanup: /'
}

mode="watch"; [[ "$ONCE" -eq 1 ]] && mode="once"; [[ "$DRY_RUN" -eq 1 ]] && mode="$mode/dry-run"
log "tp-agent-watchdog starting ($mode): poll=${POLL}s stuck_threshold=${STUCK_THRESHOLD_MIN}min"

if [[ "$ONCE" -eq 1 ]]; then
    react
    exit 0
fi

trap 'log "stopping."; exit 0' INT TERM
while true; do
    react
    maybe_exit_when_idle
    sleep "$POLL"
done
