#!/bin/bash
# tp-disk-watchdog -- pause new agent launches when free disk drops below a
# threshold, and when space gets critical buy it back by cleaning worktree and
# primary build dirs (`tp cleanup --targets --include-primary`, which skips any
# worktree with a live agent) and pruning the container runtime.
#
# Background: several parallel agents each maintain GB of build output plus the
# container build cache, image storage, and writable layers. A box with 50 GB
# free can become a box with 0 GB free in half an hour once rebuilds kick in.
# When that happens mid-run, writes start ENOSPC'ing and agents wedge inside
# half-finished tool calls. The pool cap file is the documented choke point on
# the launch loop; this watchdog drives it from disk pressure.
#
# Usage:
#   tp disk-watchdog                # watch + auto-throttle
#   tp disk-watchdog --dry-run      # detect + log only
#   tp disk-watchdog --once         # one check, exit
#   tp disk-watchdog --auto-exit    # exit cleanly when no agents remain
#   tp disk-watchdog --gate         # one-shot feed gate: exit 0=ok, 10=low disk
#
# Configuration (taskpump.conf or the environment; legacy names still work):
#   TASKPUMP_DISK_POLL          seconds between checks (default 30)
#   TASKPUMP_DISK_PAUSE_GB      free below this → pool cap 0, and the floor
#                               --gate answers against (default 10)
#   TASKPUMP_DISK_PANIC_GB      free below this → reclaim build dirs + prune
#                               (default 5)
#   TASKPUMP_DISK_RECOVER_GB    free above this → restore the original cap
#                               (default 20)
#   TASKPUMP_DISK_COOLDOWN      seconds to wait after a reclaim (default 180)
#   TASKPUMP_DISK_MOUNT         mount to measure (default /)
#   TASKPUMP_DISK_PROBE         command that reports free space
#   TASKPUMP_POOL_CAP_FILE      the live pool cap this drives
#   TASKPUMP_ORIGINAL_CAP       cap to restore (default: the cap file at start,
#                               unless that holds 0 — a pause is not a cap to
#                               restore to — in which case the shared fallback)
#   TASKPUMP_POOL_CAP_STALE_SEC how long a written 0 stays believable to the
#                               pump without a refresh (read by the shared cap
#                               reader). The watch loop re-stamps its pause every
#                               poll and hands it back on exit, so a 0 that
#                               reaches this window is one a SIGKILLed watchdog,
#                               a `--once` run or a hand edit left behind.
#   TASKPUMP_PANIC_RECLAIM      0 = prune only, never clean build dirs
#   TASKPUMP_STARTUP_GRACE_SEC / TASKPUMP_EMPTY_GRACE_CHECKS  as --auto-exit above
# HELP-END
set -uo pipefail

# ── TaskPump config core ──────────────────────────────────────────────────────
_tp_self_root="$(CDPATH='' cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/config.sh
. "$_tp_self_root/lib/config.sh"
tp_load_config
# shellcheck source=../lib/pump-lib.sh
. "$TP_LIB_DIR/pump-lib.sh"

# REPO_ROOT is the WORKSPACE this watchdog is guarding, resolved by the same
# rule the pump uses (tp_resolve_workspace) — because the cap file it writes is
# the file the pump reads, and the two have to name the same path or the
# mechanism is decorative.
#
# It used to default to the parent of this script's own directory. From a
# consumer repo with no TASKPUMP_STATE_DIR that is the INSTALLATION, so the
# watchdog wrote its cap into the TaskPump checkout while the pump read the
# workspace's — the watchdog logged "pool cap → 0" under disk pressure and the
# pump kept launching at full cap (B8). TASKPUMP_DISK_REPO_ROOT stays as the
# test seam, and TASKPUMP_WORKSPACE_ROOT pins the workspace explicitly exactly
# as it does for the pump.
tp_resolve_workspace
REPO_ROOT="${TASKPUMP_DISK_REPO_ROOT:-${TASKPUMP_WORKSPACE_ROOT:-$TP_WS_ROOT}}"
STATE_DIR="${TASKPUMP_STATE_DIR:-$REPO_ROOT}"
CAP_FILE="${TASKPUMP_POOL_CAP_FILE:-${CAP_FILE:-$STATE_DIR/.taskpump-pool-cap}}"
POLL="${TASKPUMP_DISK_POLL:-${POLL:-30}}"
PAUSE_THRESHOLD_GB="${TASKPUMP_DISK_PAUSE_GB:-${PAUSE_THRESHOLD_GB:-10}}"
PANIC_THRESHOLD_GB="${TASKPUMP_DISK_PANIC_GB:-${PANIC_THRESHOLD_GB:-5}}"
RECOVER_THRESHOLD_GB="${TASKPUMP_DISK_RECOVER_GB:-${RECOVER_THRESHOLD_GB:-20}}"
COOLDOWN="${TASKPUMP_DISK_COOLDOWN:-${COOLDOWN:-180}}"
MOUNT="${TASKPUMP_DISK_MOUNT:-${MOUNT:-/}}"

# Snapshot the cap at startup so we can restore it after pressure recovers.
# The final fallback is the shared TASKPUMP_JOBS_FALLBACK from pump-lib, not a
# third private 6.
ORIGINAL_CAP="${TASKPUMP_ORIGINAL_CAP:-${ORIGINAL_CAP:-}}"
ORIGINAL_CAP_NOTE="TASKPUMP_ORIGINAL_CAP"
if [[ -z "$ORIGINAL_CAP" && -f "$CAP_FILE" ]]; then
    ORIGINAL_CAP="$(tr -dc '0-9' < "$CAP_FILE" 2>/dev/null || true)"
    ORIGINAL_CAP_NOTE="$CAP_FILE"
fi
# A 0 is a PAUSE somebody was holding, never a cap to restore TO — whichever
# spelling supplied it. Snapshotting the cap file's 0 made a watchdog started
# against a stale one "recover" to 0, i.e. hold the very wedge it was launched to
# clear; and restoring to 0 on the way out would log a release that released
# nothing. The pause is not this process's to inherit: while nothing is
# throttling, the launch loop's own disk gate is what keeps the line.
if [[ "$ORIGINAL_CAP" == "0" ]]; then
    ORIGINAL_CAP_NOTE="$ORIGINAL_CAP_NOTE held 0, which is a pause and not a cap; fell back"
    ORIGINAL_CAP=""
fi
if [[ -z "$ORIGINAL_CAP" ]]; then
    [[ "$ORIGINAL_CAP_NOTE" == *"fell back" ]] || ORIGINAL_CAP_NOTE="TASKPUMP_JOBS_FALLBACK"
    ORIGINAL_CAP="$TASKPUMP_JOBS_FALLBACK"
fi

DRY_RUN=0; ONCE=0; AUTO_EXIT=0; GATE=0
STARTUP_GRACE_SEC="${TASKPUMP_STARTUP_GRACE_SEC:-${STARTUP_GRACE_SEC:-120}}"
EMPTY_GRACE_CHECKS="${TASKPUMP_EMPTY_GRACE_CHECKS:-${EMPTY_GRACE_CHECKS:-3}}"
for a in "$@"; do
    case "$a" in
        --dry-run)   DRY_RUN=1 ;;
        --once)      ONCE=1 ;;
        --auto-exit) AUTO_EXIT=1 ;;
        --gate)      GATE=1 ;;
        -h|--help)   apl_help "$0"; exit 0 ;;
        *) echo "ERROR: unknown arg '$a'" >&2; exit 2 ;;
    esac
done

# Track when we started so --auto-exit honours STARTUP_GRACE_SEC. Don't count
# zero-agent state against the exit budget during the grace window — the
# watchdog may have been launched before the first agent container was up.
STARTED_AT=$(date +%s)
EMPTY_RUN=0

# maybe_exit_when_idle -- when --auto-exit is set, count consecutive empty
# checks (after the startup grace) and exit cleanly after EMPTY_GRACE_CHECKS
# in a row. Idempotent: no-op when AUTO_EXIT is off.
maybe_exit_when_idle() {
    [[ "$AUTO_EXIT" -eq 1 ]] || return 0
    local now elapsed; now=$(date +%s); elapsed=$((now - STARTED_AT))
    if (( elapsed < STARTUP_GRACE_SEC )); then return 0; fi
    local n; n="$(apl_count_live_agents)"
    if (( n > 0 )); then EMPTY_RUN=0; return 0; fi
    EMPTY_RUN=$((EMPTY_RUN + 1))
    if (( EMPTY_RUN >= EMPTY_GRACE_CHECKS )); then
        log "no agent containers for $EMPTY_RUN consecutive checks; exiting (--auto-exit)."
        exit 0
    fi
}

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

# ── free_gb -- echo whole GB free on $MOUNT. FREE_GB_OVERRIDE forces a value
#    (test seam — lets the panic/reclaim path be exercised without real disk
#    pressure).
free_gb() {
    if [[ -n "${FREE_GB_OVERRIDE:-}" ]]; then echo "$FREE_GB_OVERRIDE"; return 0; fi
    eval "${TASKPUMP_DISK_PROBE:-df --output=avail -BG '$MOUNT'}" 2>/dev/null \
        | awk 'NR==2 {gsub("G",""); print $1}'
}

# CAP_LOWERED is 1 while THIS process is the one holding the pause — set when a
# `set_cap 0` lands, cleared when we put a real cap back. It is what the exit
# path checks: a watchdog that dies still holding the pause must not leave the 0
# behind, because the pump does not overwrite an existing cap file unless --jobs
# was passed, so that 0 would govern the next unattended run too.
CAP_LOWERED=0

# ── set_cap <n> -- write the live pool cap. Idempotent in VALUE, but a repeat of
#    a 0 still re-stamps the file's mtime: the shared cap reader treats a 0 that
#    nothing has refreshed as a pause whose holder died (apl_read_cap /
#    TASKPUMP_POOL_CAP_STALE_SEC), so this heartbeat is what tells "still paused"
#    apart from "abandoned". No log line for a heartbeat — it says nothing new.
set_cap() {
    local n="$1" cur=""
    [[ -f "$CAP_FILE" ]] && cur="$(tr -dc '0-9' < "$CAP_FILE" 2>/dev/null || true)"
    if [[ "$cur" == "$n" ]]; then
        if [[ "$n" == "0" ]]; then
            [[ "$DRY_RUN" -eq 0 ]] && touch "$CAP_FILE" 2>/dev/null
            CAP_LOWERED=1
        fi
        return 0
    fi
    if [[ "$DRY_RUN" -eq 1 ]]; then
        log "  (dry-run) would set pool cap $cur → $n via $CAP_FILE"
        return 0
    fi
    if ! printf '%s\n' "$n" > "$CAP_FILE" 2>/dev/null; then
        log "  WARNING: could not write cap file $CAP_FILE (permissions?)"
        return 1
    fi
    if [[ "$n" == "0" ]]; then CAP_LOWERED=1; else CAP_LOWERED=0; fi
    log "  pool cap $cur → $n ($CAP_FILE)"
}

# ── release_cap_on_exit -- put a real cap back if we are still holding the
#    pause. A killed watchdog used to leave its 0 in the cap file, and the next
#    unattended run read that 0 as a live pause, launched nothing, and reported
#    `status: running` with no page. A pause is only as good as the process
#    holding it, so the process hands it back on the way out.
#
#    Only the WATCH loop installs this. `--once` is a one-shot whose cap is meant
#    to outlive it (the reader's staleness window is what expires that one), and
#    `--gate` never writes a cap at all.
#
#    Guarded on the file still reading 0: if an operator or a pump has written a
#    real cap since, that is a newer decision than ours and it stands.
release_cap_on_exit() {
    [[ "$CAP_LOWERED" -eq 1 ]] || return 0
    local cur=""
    [[ -f "$CAP_FILE" ]] && cur="$(tr -dc '0-9' < "$CAP_FILE" 2>/dev/null || true)"
    [[ "$cur" == "0" ]] || return 0
    CAP_LOWERED=0
    log "releasing the pool-cap pause on exit: a 0 left in $CAP_FILE would pause the next run too. The launch loop's disk gate, not this file, holds the line while no watchdog is running."
    set_cap "$ORIGINAL_CAP"
}

# ── reclaim_targets -- reclaim worktree + primary build output to buy back
#    space, delegating to tp-cleanup --targets --include-primary (which skips
#    any worktree hosting a live agent container, so a running build is never
#    broken, and which itself touches nothing unless TASKPUMP_RECLAIM_CMD is
#    configured). Gated by PANIC_RECLAIM_TARGETS (default 1). Honours
#    --dry-run by forwarding it. Best-effort: a missing cleanup script is a
#    logged no-op, never an error.
reclaim_targets() {
    [[ "${TASKPUMP_PANIC_RECLAIM:-${PANIC_RECLAIM_TARGETS:-1}}" -eq 1 ]] || return 0
    local cleanup="$TP_LIBEXEC_DIR/tp-cleanup"
    if [[ ! -x "$cleanup" ]]; then
        log "  tp-cleanup not found/executable at $cleanup — skipping target reclaim"
        return 0
    fi
    local args=(--targets --include-primary)
    [[ "$DRY_RUN" -eq 1 ]] && args+=(--dry-run)
    log "  reclaiming build output (worktrees + primary) to buy space"
    # The workspace this watchdog guards is the workspace whose build output is
    # worth reclaiming. cleanup resolves its own root from its install dir, so
    # without this the panic sweep walks the TaskPump checkout's worktrees and
    # frees nothing (the same wrong-root family as the cap file above).
    # rc matters here. The sweep runs the consumer's own reclaim command, and an
    # arbitrary command fails routinely (`npm run clean` in a workspace with no
    # package.json, a cargo toolchain that is not installed) — which the old
    # hardcoded `rm -rf` essentially never did. pipefail carries tp-cleanup's
    # status through the sed, so a PANIC transcript never reads as though space
    # was bought when the reclaim itself failed.
    if ! TASKPUMP_CLEANUP_REPO_ROOT="$REPO_ROOT" \
           "$cleanup" "${args[@]}" 2>&1 | sed 's/^/    cleanup: /'; then
        log "  WARNING: the reclaim sweep reported failures (see the cleanup: lines above) — assume it bought no space"
    fi
}

# ── docker_panic -- run cleanup --docker to free space immediately.
docker_panic() {
    if [[ "$DRY_RUN" -eq 1 ]]; then
        log "  (dry-run) would run tp-cleanup --docker"
        return 0
    fi
    "$TP_LIBEXEC_DIR/tp-cleanup" --docker 2>&1 | sed 's/^/    cleanup: /'
}

# ── pressure state machine.
#    States:  HEALTHY (free > RECOVER), PAUSED (free < PAUSE), PANIC (free < PANIC)
#    Transitions are one-way until recovery to keep behavior deterministic.
LAST_STATE="HEALTHY"
react() {
    local g; g="$(free_gb || echo 0)"
    if [[ -z "$g" ]]; then
        log "WARNING: could not read free GB on $MOUNT (skipping check)"
        return 0
    fi

    if   (( g < PANIC_THRESHOLD_GB ));   then NEW="PANIC"
    elif (( g < PAUSE_THRESHOLD_GB ));   then NEW="PAUSED"
    elif (( g > RECOVER_THRESHOLD_GB )); then NEW="HEALTHY"
    else NEW="$LAST_STATE"  # in the hysteresis band
    fi

    if [[ "$NEW" != "$LAST_STATE" ]]; then
        log "$MOUNT free=${g}G — $LAST_STATE → $NEW"
        case "$NEW" in
            PANIC)
                set_cap 0
                reclaim_targets   # reclaim worktree+primary build output (skips live agents)
                docker_panic
                log "cooling down ${COOLDOWN}s before re-arming"
                [[ "$DRY_RUN" -eq 0 ]] && sleep "$COOLDOWN" ;;
            PAUSED)
                set_cap 0 ;;
            HEALTHY)
                set_cap "$ORIGINAL_CAP" ;;
        esac
        LAST_STATE="$NEW"
    elif [[ "$DRY_RUN" -eq 0 && ( "$NEW" == "PAUSED" || "$NEW" == "PANIC" ) ]]; then
        # Still holding the pause. set_cap re-stamps the cap file's mtime without
        # logging, which is the liveness signal the reader expires a 0 against;
        # if something raised the cap under us it also re-asserts the 0, and says
        # so, because that IS a change worth a line.
        set_cap 0
    fi
}

# ── --gate -- one-shot disk-pressure query for a feed gate (mirrors
#    `arachne-usage --gate`): exit 0 = feed OK (free ≥ PAUSE_THRESHOLD_GB),
#    exit 10 = pause (low disk) with a one-line reason on stderr. No loop, no
#    cap-file writes, no logging — a pure query for arachne-pump::feed_gate.
#    Fails open: if free space can't be read, exit 0 so a missing df never blocks.
if [[ "$GATE" -eq 1 ]]; then
    g="$(free_gb || echo "")"
    if [[ -z "$g" ]]; then
        echo "$MOUNT free=unknown — failing open (feed OK)" >&2
        exit 0
    fi
    if (( g < PAUSE_THRESHOLD_GB )); then
        echo "$MOUNT free=${g}GB < ${PAUSE_THRESHOLD_GB}GiB (disk gate)" >&2
        exit 10
    fi
    exit 0
fi

mode="watch"; [[ "$ONCE" -eq 1 ]] && mode="once"; [[ "$DRY_RUN" -eq 1 ]] && mode="$mode/dry-run"
log "tp-disk-watchdog starting ($mode): mount=$MOUNT poll=${POLL}s pause<${PAUSE_THRESHOLD_GB}G panic<${PANIC_THRESHOLD_GB}G recover>${RECOVER_THRESHOLD_GB}G original_cap=$ORIGINAL_CAP ($ORIGINAL_CAP_NOTE)"

# The heartbeat only works if it beats faster than the reader's patience. A poll
# at or above the staleness window means a pause this watchdog is genuinely
# holding can be expired out from under it between two re-stamps — the pump would
# resume launching under live disk pressure — so the misconfiguration is named
# rather than left to be discovered as a mystery.
_cap_stale_window="${TASKPUMP_POOL_CAP_STALE_SEC:-900}"
if [[ "$POLL" =~ ^[0-9]+$ && "$_cap_stale_window" =~ ^[0-9]+$ ]] \
   && (( _cap_stale_window > 0 && POLL >= _cap_stale_window )); then
    log "  WARNING: poll ${POLL}s >= TASKPUMP_POOL_CAP_STALE_SEC ${_cap_stale_window}s — a pause this watchdog is still holding can expire between re-stamps and let the pump launch under pressure. Lower the poll or raise the window."
fi

if [[ "$ONCE" -eq 1 ]]; then
    react
    exit 0
fi

# The pause this loop holds dies with the loop. EXIT covers a normal return and
# --auto-exit's own `exit 0`; INT/TERM get a handler that exits, which then runs
# the EXIT trap — release_cap_on_exit clears CAP_LOWERED, so running twice is a
# no-op rather than a double restore.
trap 'release_cap_on_exit' EXIT
trap 'log "stopping."; exit 0' INT TERM
while true; do
    react
    maybe_exit_when_idle
    sleep "$POLL"
done
