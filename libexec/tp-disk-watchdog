#!/bin/bash
# arachne-disk-watchdog -- pause new agent launches when free disk drops below
# a threshold, and when space gets critical buy it back by cargo-cleaning
# worktree + primary target/ dirs (arachne-cleanup --targets --include-primary,
# which skips worktrees with a live agent) and pruning docker.
#
# Background: 4-6 parallel agents each maintain ~3 GB of cargo target/ plus
# the docker build cache, image storage, container writable layers. A box
# with 50 GB free can become a box with 0 GB free in 30 minutes once cargo
# rebuilds kick in. When that happens mid-run, cargo writes start ENOSPC'ing
# and the agents wedge inside half-finished bash tool calls — observed
# 2026-05-28. The pool cap file (.arachne-pool-cap) is the documented choke
# point on run-parallel.sh's launch loop; this watchdog drives it from disk
# pressure.
#
# Usage:
#   ./scripts/arachne-disk-watchdog                # watch + auto-throttle
#   ./scripts/arachne-disk-watchdog --dry-run      # detect + log only
#   ./scripts/arachne-disk-watchdog --once         # one check, exit
#   ./scripts/arachne-disk-watchdog --auto-exit    # exit cleanly when no agents remain
#   ./scripts/arachne-disk-watchdog --gate         # one-shot feed gate: exit 0=ok, 10=low disk
#
# Env:
#   POLL                 -- seconds between checks (default 30)
#   PAUSE_THRESHOLD_GB   -- free below this GB → set pool cap to 0, and the
#                           free-space floor for --gate (default 10)
#   PANIC_THRESHOLD_GB   -- free below this GB → cargo clean target/ dirs + cleanup --docker (default 5)
#   RECOVER_THRESHOLD_GB -- free above this GB → restore original cap (default 20)
#   ORIGINAL_CAP         -- cap to restore when recovered (default: contents of CAP_FILE at start, else 6)
#   CAP_FILE             -- pool cap file (default <repo-root>/.arachne-pool-cap)
#   COOLDOWN             -- seconds to wait after cleanup before re-arming (default 180)
#   MOUNT                -- mount to check (default /; the partition that holds $HOME)
#   STARTUP_GRACE_SEC    -- with --auto-exit, ignore zero-agent state for this long after start (default 120)
#   EMPTY_GRACE_CHECKS   -- with --auto-exit, exit after this many consecutive empty checks (default 3)
#   PANIC_RECLAIM_TARGETS-- on PANIC, cargo clean worktree+primary target/ before docker prune (default 1)
set -uo pipefail

# ── TaskPump config core ──────────────────────────────────────────────────────
_tp_self_root="$(CDPATH= cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/config.sh
. "$_tp_self_root/lib/config.sh"
tp_load_config

# REPO_ROOT is the parent of this script's dir; overridable so the panic-reclaim
# path can be unit-tested against a fixture tree with a stub arachne-cleanup.
_default_repo_root="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
REPO_ROOT="${ARACHNE_DISK_REPO_ROOT:-$_default_repo_root}"
CAP_FILE="${CAP_FILE:-$REPO_ROOT/.arachne-pool-cap}"
POLL="${POLL:-30}"
PAUSE_THRESHOLD_GB="${PAUSE_THRESHOLD_GB:-10}"
PANIC_THRESHOLD_GB="${PANIC_THRESHOLD_GB:-5}"
RECOVER_THRESHOLD_GB="${RECOVER_THRESHOLD_GB:-20}"
COOLDOWN="${COOLDOWN:-180}"
MOUNT="${MOUNT:-/}"

# Snapshot the cap at startup so we can restore it after pressure recovers.
ORIGINAL_CAP="${ORIGINAL_CAP:-}"
if [[ -z "$ORIGINAL_CAP" && -f "$CAP_FILE" ]]; then
    ORIGINAL_CAP="$(tr -dc '0-9' < "$CAP_FILE" 2>/dev/null || true)"
fi
ORIGINAL_CAP="${ORIGINAL_CAP:-6}"

DRY_RUN=0; ONCE=0; AUTO_EXIT=0; GATE=0
STARTUP_GRACE_SEC="${STARTUP_GRACE_SEC:-120}"
EMPTY_GRACE_CHECKS="${EMPTY_GRACE_CHECKS:-3}"
for a in "$@"; do
    case "$a" in
        --dry-run)   DRY_RUN=1 ;;
        --once)      ONCE=1 ;;
        --auto-exit) AUTO_EXIT=1 ;;
        --gate)      GATE=1 ;;
        -h|--help)   sed -n '2,35p' "$0"; exit 0 ;;
        *) echo "ERROR: unknown arg '$a'" >&2; exit 2 ;;
    esac
done

# Track when we started so --auto-exit honours STARTUP_GRACE_SEC. Don't count
# zero-agent state against the exit budget during the grace window — the
# watchdog may have been launched before the first agent container was up.
STARTED_AT=$(date +%s)
EMPTY_RUN=0

# agent_count -- number of running arachne-agent-* containers.
agent_count() {
    docker ps --format '{{.Names}}' 2>/dev/null | grep -c '^arachne-agent-' || true
}

# maybe_exit_when_idle -- when --auto-exit is set, count consecutive empty
# checks (after the startup grace) and exit cleanly after EMPTY_GRACE_CHECKS
# in a row. Idempotent: no-op when AUTO_EXIT is off.
maybe_exit_when_idle() {
    [[ "$AUTO_EXIT" -eq 1 ]] || return 0
    local now elapsed; now=$(date +%s); elapsed=$((now - STARTED_AT))
    if (( elapsed < STARTUP_GRACE_SEC )); then return 0; fi
    local n; n="$(agent_count)"
    if (( n > 0 )); then EMPTY_RUN=0; return 0; fi
    EMPTY_RUN=$((EMPTY_RUN + 1))
    if (( EMPTY_RUN >= EMPTY_GRACE_CHECKS )); then
        log "no agent containers for $EMPTY_RUN consecutive checks; exiting (--auto-exit)."
        exit 0
    fi
}

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

# ── free_gb -- echo whole GB free on $MOUNT. FREE_GB_OVERRIDE forces a value
#    (test seam — lets the panic/reclaim path be exercised without real disk
#    pressure).
free_gb() {
    if [[ -n "${FREE_GB_OVERRIDE:-}" ]]; then echo "$FREE_GB_OVERRIDE"; return 0; fi
    df --output=avail -BG "$MOUNT" 2>/dev/null | awk 'NR==2 {gsub("G",""); print $1}'
}

# ── set_cap <n> -- write the live pool cap. Idempotent (no-op when unchanged).
set_cap() {
    local n="$1" cur=""
    [[ -f "$CAP_FILE" ]] && cur="$(tr -dc '0-9' < "$CAP_FILE" 2>/dev/null || true)"
    if [[ "$cur" == "$n" ]]; then return 0; fi
    if [[ "$DRY_RUN" -eq 1 ]]; then
        log "  (dry-run) would set pool cap $cur → $n via $CAP_FILE"
        return 0
    fi
    if ! printf '%s\n' "$n" > "$CAP_FILE" 2>/dev/null; then
        log "  WARNING: could not write cap file $CAP_FILE (permissions?)"
        return 1
    fi
    log "  pool cap $cur → $n ($CAP_FILE)"
}

# ── reclaim_targets -- cargo clean worktree + primary target/ dirs to buy back
#    space, delegating to arachne-cleanup --targets --include-primary (which
#    skips any worktree hosting a live agent container, so a running build is
#    never broken). Gated by PANIC_RECLAIM_TARGETS (default 1). Honours
#    --dry-run by forwarding it. Best-effort: a missing cleanup script is a
#    logged no-op, never an error.
reclaim_targets() {
    [[ "${PANIC_RECLAIM_TARGETS:-1}" -eq 1 ]] || return 0
    local cleanup="$TP_LIBEXEC_DIR/tp-cleanup"
    if [[ ! -x "$cleanup" ]]; then
        log "  arachne-cleanup not found/executable at $cleanup — skipping target reclaim"
        return 0
    fi
    local args=(--targets --include-primary)
    [[ "$DRY_RUN" -eq 1 ]] && args+=(--dry-run)
    log "  reclaiming cargo target/ dirs (worktrees + primary) to buy space"
    "$cleanup" "${args[@]}" 2>&1 | sed 's/^/    cleanup: /'
}

# ── docker_panic -- run cleanup --docker to free space immediately.
docker_panic() {
    if [[ "$DRY_RUN" -eq 1 ]]; then
        log "  (dry-run) would run arachne-cleanup --docker"
        return 0
    fi
    "$TP_LIBEXEC_DIR/tp-cleanup" --docker 2>&1 | sed 's/^/    cleanup: /'
}

# ── pressure state machine.
#    States:  HEALTHY (free > RECOVER), PAUSED (free < PAUSE), PANIC (free < PANIC)
#    Transitions are one-way until recovery to keep behavior deterministic.
LAST_STATE="HEALTHY"
react() {
    local g; g="$(free_gb || echo 0)"
    if [[ -z "$g" ]]; then
        log "WARNING: could not read free GB on $MOUNT (skipping check)"
        return 0
    fi

    if   (( g < PANIC_THRESHOLD_GB ));   then NEW="PANIC"
    elif (( g < PAUSE_THRESHOLD_GB ));   then NEW="PAUSED"
    elif (( g > RECOVER_THRESHOLD_GB )); then NEW="HEALTHY"
    else NEW="$LAST_STATE"  # in the hysteresis band
    fi

    if [[ "$NEW" != "$LAST_STATE" ]]; then
        log "$MOUNT free=${g}G — $LAST_STATE → $NEW"
        case "$NEW" in
            PANIC)
                set_cap 0
                reclaim_targets   # cargo clean worktree+primary target/ (skips live agents)
                docker_panic
                log "cooling down ${COOLDOWN}s before re-arming"
                [[ "$DRY_RUN" -eq 0 ]] && sleep "$COOLDOWN" ;;
            PAUSED)
                set_cap 0 ;;
            HEALTHY)
                set_cap "$ORIGINAL_CAP" ;;
        esac
        LAST_STATE="$NEW"
    fi
}

# ── --gate -- one-shot disk-pressure query for a feed gate (mirrors
#    `arachne-usage --gate`): exit 0 = feed OK (free ≥ PAUSE_THRESHOLD_GB),
#    exit 10 = pause (low disk) with a one-line reason on stderr. No loop, no
#    cap-file writes, no logging — a pure query for arachne-pump::feed_gate.
#    Fails open: if free space can't be read, exit 0 so a missing df never blocks.
if [[ "$GATE" -eq 1 ]]; then
    g="$(free_gb || echo "")"
    if [[ -z "$g" ]]; then
        echo "$MOUNT free=unknown — failing open (feed OK)" >&2
        exit 0
    fi
    if (( g < PAUSE_THRESHOLD_GB )); then
        echo "$MOUNT free=${g}GB < ${PAUSE_THRESHOLD_GB}GiB (disk gate)" >&2
        exit 10
    fi
    exit 0
fi

mode="watch"; [[ "$ONCE" -eq 1 ]] && mode="once"; [[ "$DRY_RUN" -eq 1 ]] && mode="$mode/dry-run"
log "arachne-disk-watchdog starting ($mode): mount=$MOUNT poll=${POLL}s pause<${PAUSE_THRESHOLD_GB}G panic<${PANIC_THRESHOLD_GB}G recover>${RECOVER_THRESHOLD_GB}G original_cap=$ORIGINAL_CAP"

if [[ "$ONCE" -eq 1 ]]; then
    react
    exit 0
fi

trap 'log "stopping."; exit 0' INT TERM
while true; do
    react
    maybe_exit_when_idle
    sleep "$POLL"
done
