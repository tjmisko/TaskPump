#!/usr/bin/env bash
# tp-task — TaskPump's ledger CLI: the sole reader/writer of a task DAG kept as
# one markdown file per task, state in YAML frontmatter.
#
# Nothing here is project-specific. Every literal that used to name Arachne — the
# ledger's location, the id grammar, the committer identity, the tripwire
# constants — is a TASKPUMP_* config key. The reference consumer pins its
# historical values in examples/arachne.conf (the v0.1.0 default flips retire the
# Arachne-shaped baked defaults), so under those pins behaviour is unchanged.
# See `tp-task --help` for the key list and lib/config.sh for how they resolve.
#
# ── The id grammar contract ──────────────────────────────────────────────────
#
# Two knobs describe a consumer's id scheme, and they do different jobs:
#
#   TASKPUMP_ID_PATTERN  VALIDATES. A regex `create` tests a new id against.
#   TASKPUMP_PHASE_SIGIL DERIVES. The alphabetic prefix on a phase token, which
#                        phase ranges strip and re-apply (`F55..F63` → F55…F63).
#
# What is NOT configurable is the shape: an id is `PHASE` or `PHASE.N`, and the
# phase is everything before the first `.`. Phase grouping, range expansion, and
# ordering are all built on that split, so a consumer choosing a different
# separator would silently lose all three. Pick a sigil and a pattern; keep the
# dot.

set -euo pipefail

# ── TaskPump config core ──────────────────────────────────────────────────────
# Loaded before any default below, so a taskpump.conf key reaches the `: "${X:=}"`
# defaults, and so a legacy ARACHNE_* export still arrives under its canonical
# TASKPUMP_* spelling.
_tp_self_root="$(CDPATH='' cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/config.sh
. "$_tp_self_root/lib/config.sh"
tp_load_config
# The naming contract (docs/RUNNERS.md §2) is shared with the supervisor, and a
# claim is where a branch enters the ledger — so the rule for what a branch name
# may be lives in one place and both tools read it, rather than each keeping its
# own opinion. A checkout without the lib is not a working install; nothing here
# guesses a fallback.
# shellcheck source=../lib/pump-lib.sh
. "${TP_LIB_DIR:-$_tp_self_root/lib}/pump-lib.sh"

# ── Workspace resolution ──────────────────────────────────────────────────────
# Resolve the workspace whose ledger we operate on. Env vars still override.
#
# The caller's workspace wins over the script's own location. Both the primary
# checkout and every worktree carry their own copy of this CLI and their own
# ledger checkout, so deriving the root from the script alone means
# `/primary/libexec/tp-task claim F78.8` run while standing in a worktree writes
# the claim into the *primary's* ledger — the worktree's own ledger never learns
# about it, and the primary's silently drifts. Preferring $PWD's worktree makes
# task state follow the workspace the work is happening in, which is what every
# caller means.
#
# TASKPUMP_LEDGER_PROBE is the ledger's path relative to a candidate workspace
# root. It answers "does this worktree carry a ledger of its own?" and, when no
# explicit tasks dir is given, it *is* the ledger's location — one key rather
# than two spellings of the same path that can drift apart.
: "${TASKPUMP_LEDGER_PROBE:=tasks}"

_tp_script_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
_tp_script_root="$(cd "$_tp_script_dir/.." && pwd)"

# Was the tasks dir handed to us outright (environment, or a conf value the
# config core already anchored)? Read BEFORE the default below fills it in,
# because "the caller said where the ledger is" is the one answer that needs no
# probing and no guard.
_tp_tasks_dir_explicit=0
[[ -n "${TASKPUMP_TASKS_DIR:-}" ]] && _tp_tasks_dir_explicit=1

# The shared workspace resolution (lib/config.sh): a DISCOVERED conf's
# directory when the probe answers there, else the caller's worktree, else the
# install root — which is a fallback, not an answer (see the guard below).
# tp-pump resolves through the same function, so the supervisor and the CLI
# cannot disagree about whose ledger an invocation touches.
tp_resolve_workspace
_tp_conf_root="$TP_WS_CONF_ROOT"
_tp_cwd_root="$TP_WS_CWD_ROOT"
_tp_repo_root="$TP_WS_ROOT"
_tp_resolved_via="$TP_WS_VIA"
# When the tasks dir was handed to us outright, the workspace rung did not
# decide it — the via diagnostic must name the rung that did, or it misleads
# in exactly the misconfiguration case it exists for.
if [[ "$_tp_tasks_dir_explicit" -eq 1 ]]; then
  if tp_conf_supplied TASKS_DIR; then
    _tp_resolved_via="conf-value"
  else
    _tp_resolved_via="env"
  fi
fi

# ── Config ────────────────────────────────────────────────────────────────────
: "${TASKPUMP_TASKS_DIR:=$_tp_repo_root/$TASKPUMP_LEDGER_PROBE}"
: "${TASKPUMP_TASK_OUT:=$(dirname "$TASKPUMP_TASKS_DIR")/.next-task}"
: "${TASKPUMP_CODE_REPO:=$_tp_repo_root}"
# TASKPUMP_PUSH is the design's name for the same switch; TASKPUMP_TASK_PUSH is
# where a legacy ARACHNE_TASK_PUSH lands, so it has to win to keep the promotion
# faithful.
: "${TASKPUMP_TASK_PUSH:=${TASKPUMP_PUSH:-0}}"
: "${TASKPUMP_TASK_NOCOMMIT:=0}"
: "${TASKPUMP_TASK_DEBUG:=0}"

# Ledger commit identity. Distinct from the operator's own git identity so a
# ledger's history separates bookkeeping from authored work.
: "${TASKPUMP_COMMITTER_NAME:=tp-task}"
: "${TASKPUMP_COMMITTER_EMAIL:=task@taskpump.local}"

# Id grammar. See the contract at the top of this file.
: "${TASKPUMP_ID_PATTERN:=^T[0-9]+(\.[0-9]+)?$}"
: "${TASKPUMP_PHASE_SIGIL:=T}"

# Tripwire + concurrency constants.
: "${TASKPUMP_TURN_BUDGET_DEFAULT:=50}"
: "${TASKPUMP_FAILURE_LIMIT:=3}"
: "${TASKPUMP_CLAIM_STALE_HOURS:=24}"
: "${TASKPUMP_LOCK_WAIT:=120}"
# The cross-agent state lockfile's NAME, created in the ledger's git root. Every
# concurrent agent must resolve the same name or they stop excluding each other,
# so change it only between runs, never under a live drain.
: "${TASKPUMP_LOCK_NAME:=.taskpump-task.lock}"
: "${TASKPUMP_PUSH_RETRIES:=6}"

# Name this tool answers to in its own diagnostics. The reference consumer pins
# the historical `arachne-task` in examples/arachne.conf; a consumer rebranding
# the install sets its own.
: "${TASKPUMP_PROG_NAME:=tp-task}"

dbg() {
  [[ "$TASKPUMP_TASK_DEBUG" == "1" ]] && printf '[%s] %s\n' "$TASKPUMP_PROG_NAME" "$*" >&2
  return 0
}

warn() {
  printf '%s: %s\n' "$TASKPUMP_PROG_NAME" "$*" >&2
  return 0
}

die() {
  printf '%s: %s\n' "$TASKPUMP_PROG_NAME" "$*" >&2
  exit 1
}

# ── Frontmatter helpers ───────────────────────────────────────────────────────

# Read a frontmatter field from a task file.
# Usage: fm_get <file> <yq-expr>
# Returns empty string if the field is null or absent.
fm_get() {
  local file=$1 expr=$2 val
  val=$(yq --front-matter=extract "$expr" "$file" 2>/dev/null || echo "")
  # yq returns "null" for missing keys; normalize to empty.
  [[ "$val" == "null" ]] && val=""
  printf '%s' "$val"
}

# Set (or unset) a frontmatter field in-place.
# Usage: fm_set <file> <yq-expr-with-assignment>
# Example: fm_set F17.10.md '.status = "in_progress"'
fm_set() {
  local file=$1 expr=$2
  yq -i --front-matter=process "$expr" "$file"
}

# Read <file>'s `.id` and `.status` in one pass, one per line, and fail if the
# frontmatter does not parse as YAML.
#
# The parse check has to be explicit because every other read path fails
# *silently*: `fm_get` swallows yq's error and returns "", so an unparseable
# file reads as a task with no id and no status. It then matches no status
# filter, never enters the `next`/`ready` frontier, and produces no diagnostic
# anywhere — the work is in the ledger, committed, and unreachable. F45.15 sat
# that way for nine weeks after being authored with an unquoted `goal:`
# containing a colon.
#
# Both fields come back from a single yq invocation because scrub runs this
# over every task file on every pump tick, and process spawns dominate its
# runtime. The integrity check rides along for free — yq fails before it
# evaluates the expression — so guarding costs nothing over the read scrub
# already had to do.
#
# Line-delimited, not @tsv: a tab is an IFS *whitespace* character, so `read`
# silently collapses a leading empty field and an id-less file would parse as
# id="<status>" — defeating the NO-ID check this feeds.
fm_id_status() {
  yq --front-matter=extract '.id // "", .status // ""' "$1" 2>/dev/null
}

# Path to a task file by id. Returns empty if not found.
task_file() {
  local id=$1 file
  file="$TASKPUMP_TASKS_DIR/$id.md"
  [[ -f "$file" ]] && printf '%s' "$file"
}

# Require a task file to exist; print its path.
task_file_required() {
  local id=$1 file
  file=$(task_file "$id")
  [[ -z "$file" ]] && die "no task file for id='$id' in $TASKPUMP_TASKS_DIR"
  printf '%s' "$file"
}

# ── Phase sigil ───────────────────────────────────────────────────────────────
# Drop a leading TASKPUMP_PHASE_SIGIL from a phase token, case-insensitively, so
# "F55", "f55" and "55" all reduce to "55". Any other input is returned as-is —
# callers distinguish "had a sigil" from "did not" by comparing to the input.
strip_phase_sigil() {
  local value=$1 sigil=$TASKPUMP_PHASE_SIGIL
  if [[ -n "$sigil" && "${value,,}" == "${sigil,,}"* ]]; then
    value=${value:${#sigil}}
  fi
  printf '%s' "$value"
}

# ── Sort key for phase-anchored ids ───────────────────────────────────────────
# "F17.10" → "17 10" so `sort -n -k1,1 -k2,2` orders F9 < F10 < F17.2 < F17.10.
# "F-MERGE.2" → "999999 2" (special phase sorted last within its bucket).
phase_sort_key() {
  local id=$1 phase_part num_part phase_num bare
  phase_part=${id%%.*}         # F17 from F17.10
  num_part=${id##*.}           # 10 from F17.10
  bare=$(strip_phase_sigil "$phase_part")
  # A numeric phase must carry the sigil to count as one: a bare "17" is not an
  # id in this grammar, and treating it as phase 17 would sort it alongside F17.
  if [[ ( -z "$TASKPUMP_PHASE_SIGIL" || "$bare" != "$phase_part" ) && "$bare" =~ ^[0-9]+$ ]]; then
    phase_num=$bare
  else
    # Non-numeric phase (e.g., F-MERGE). Sort after numeric phases.
    phase_num=999999
  fi
  printf '%s %s' "$phase_num" "$num_part"
}

# ── Phase-range expansion (for `ready --phases`) ───────────────────────────────
# Expand a phase spec into the canonical set of phase tokens, one per line.
# Accepts: a single phase ("F55", "f55", "55", or a full id "F55.2" → "F55");
# an inclusive numeric range ("F55..F63" → F55 F56 … F63); and comma lists of
# either ("F55,F58..F60"). Non-numeric phase tokens (e.g. "F-MERGE") pass through
# uppercased as single tokens; they cannot participate in a range.
expand_phases() {
  local spec=$1 comp a b lo hi i n sigil=$TASKPUMP_PHASE_SIGIL
  local IFS=','
  for comp in $spec; do
    comp="${comp//[[:space:]]/}"
    [[ -z "$comp" ]] && continue
    if [[ "$comp" == *..* ]]; then
      a="${comp%%..*}"; b="${comp##*..}"
      a=$(strip_phase_sigil "$a"); b=$(strip_phase_sigil "$b")
      [[ "$a" =~ ^[0-9]+$ && "$b" =~ ^[0-9]+$ ]] \
        || die "bad phase range '$comp' (expected ${sigil}N..${sigil}M)"
      if (( a <= b )); then lo=$a; hi=$b; else lo=$b; hi=$a; fi
      for (( i=lo; i<=hi; i++ )); do printf '%s%s\n' "$sigil" "$i"; done
    else
      comp="${comp%%.*}"            # tolerate a full id: F55.2 -> F55
      n=$(strip_phase_sigil "$comp")
      if [[ "$n" =~ ^[0-9]+$ ]]; then
        printf '%s%s\n' "$sigil" "$n"
      else
        printf '%s\n' "${comp^^}"   # non-numeric phase, e.g. F-MERGE
      fi
    fi
  done
}

# ── JSON helper (portable escaping via jq) ────────────────────────────────────
json_object() {
  # Usage: json_object key1 val1 key2 val2 ...
  # Emits a compact JSON object. Values are treated as strings unless numeric.
  local args=()
  while (( $# )); do
    args+=(--arg "k$#" "$1")
    shift
    args+=(--arg "v$#" "$1")
    shift
  done
  # Simpler: build via jq from positional.
  local out='{}'
  while read -r k v; do
    out=$(jq -c --arg k "$k" --arg v "$v" '. + {($k): $v}' <<<"$out")
  done < <(paste -d' ' <(printf '%s\n' "$@" | awk 'NR%2==1') <(printf '%s\n' "$@" | awk 'NR%2==0'))
  printf '%s' "$out"
}

# ── Git helpers ───────────────────────────────────────────────────────────────
# Set once a no-remote warning has been emitted, so a process that mutates more
# than once says it a single time.
_tp_warned_no_remote=0

git_commit_state() {
  # Commits the current state of TASKPUMP_TASKS_DIR with a given message.
  # Respects TASKPUMP_TASK_NOCOMMIT and TASKPUMP_TASK_PUSH.
  local msg=$1
  if [[ "$TASKPUMP_TASK_NOCOMMIT" == "1" ]]; then
    dbg "skipping commit (TASKPUMP_TASK_NOCOMMIT=1): $msg"
    return 0
  fi
  local tasks_git_root
  tasks_git_root=$(git -C "$TASKPUMP_TASKS_DIR" rev-parse --show-toplevel 2>/dev/null || true)
  if [[ -z "$tasks_git_root" ]]; then
    dbg "not a git repo at $TASKPUMP_TASKS_DIR; skipping commit"
    return 0
  fi
  git -C "$tasks_git_root" add -A -- "$TASKPUMP_TASKS_DIR"
  if git -C "$tasks_git_root" diff --cached --quiet; then
    dbg "no changes to commit for: $msg"
    return 0
  fi
  git -C "$tasks_git_root" \
    -c user.name="$TASKPUMP_COMMITTER_NAME" -c user.email="$TASKPUMP_COMMITTER_EMAIL" \
    commit -m "$msg" >/dev/null
  dbg "committed: $msg"
  [[ "$TASKPUMP_TASK_PUSH" == "1" ]] || return 0

  # A ledger with no remote is a legitimate configuration — a solo repo keeping
  # its task DAG in-tree has nowhere to push and never will. Treating that as a
  # failed push would spend six jittered retries and then `die`, failing the verb
  # *after* its commit already landed: the caller sees a non-zero exit for a
  # mutation that actually succeeded, and a supervisor reading that exit code
  # concludes the ledger write was lost. Warn once and succeed instead. A push
  # that fails against a remote which does exist is still worth retrying, so
  # that path is untouched.
  if [[ -z "$(git -C "$tasks_git_root" remote 2>/dev/null)" ]]; then
    if (( _tp_warned_no_remote == 0 )); then
      warn "ledger repo has no push remote; committed locally (set TASKPUMP_TASK_PUSH=0 to silence)"
      _tp_warned_no_remote=1
    fi
    return 0
  fi

  # Retry push with fetch-rebase + jittered backoff on non-fast-forward.
  # Under 10-12 concurrent agents, many small ledger pushes collide; jitter
  # spreads the retries so they don't thundering-herd the same remote ref.
  local try max=$TASKPUMP_PUSH_RETRIES branch
  branch=$(git -C "$tasks_git_root" rev-parse --abbrev-ref HEAD)
  for (( try=1; try<=max; try++ )); do
    if git -C "$tasks_git_root" push 2>/dev/null; then
      dbg "pushed (attempt $try)"
      return 0
    fi
    dbg "push rejected (attempt $try/$max); fetch + rebase onto origin/$branch"
    git -C "$tasks_git_root" fetch origin >/dev/null 2>&1 || true
    if ! git -C "$tasks_git_root" rebase "origin/$branch" >/dev/null 2>&1; then
      # Leave no half-finished rebase behind for the next invocation.
      git -C "$tasks_git_root" rebase --abort >/dev/null 2>&1 || true
      dbg "rebase failed (attempt $try); aborted, will retry push"
    fi
    # Backoff with jitter: 0.2s .. ~1.5s, seeded per-process so concurrent
    # agents desynchronize.
    sleep "$(awk "BEGIN{srand($$+$try); printf \"%.2f\", 0.2 + rand()*1.3}")"
  done
  die "push failed after $max retries"
}

# ── Cross-agent state lock ─────────────────────────────────────────────────────
# Serializes the read-modify-write + commit of every mutating subcommand across
# concurrent agents. All parallel containers bind-mount the same repo, so an
# flock on a lockfile in the ops git root is shared by inode across containers,
# closing the claim race and preventing index.lock contention. Held for the
# lifetime of the process via FD 9 (auto-released on exit). Degrades to a no-op
# where flock is unavailable (e.g. a stock macOS host).
acquire_state_lock() {
  [[ "$TASKPUMP_TASK_NOCOMMIT" == "1" ]] && return 0
  command -v flock >/dev/null 2>&1 || { dbg "flock unavailable; no state lock"; return 0; }
  local root lockfile
  root=$(git -C "$TASKPUMP_TASKS_DIR" rev-parse --show-toplevel 2>/dev/null || echo "")
  lockfile="${root:-/tmp}/$TASKPUMP_LOCK_NAME"
  # Open fd 9 to the lockfile for the lifetime of the process. The `2>/dev/null`
  # MUST be scoped to a brace group: `exec 9>… 2>/dev/null` with no command would
  # apply 2>/dev/null to the *current shell permanently*, silently swallowing all
  # subsequent stderr (every warning + `die` reason). The brace group restores
  # fd 2 after the open while leaving fd 9 (set by exec) in place.
  { exec 9>"$lockfile"; } 2>/dev/null || { dbg "cannot open lockfile $lockfile"; return 0; }
  if ! flock -w "$TASKPUMP_LOCK_WAIT" 9; then
    die "could not acquire state lock ($lockfile) within ${TASKPUMP_LOCK_WAIT}s"
  fi
  dbg "acquired state lock $lockfile"
}

# ── Subcommands ───────────────────────────────────────────────────────────────

# List task files as newline-separated paths. A nonexistent tasks dir never
# reaches here: main() refuses it up front (tp_require_tasks_dir) — "the ledger
# is not there" and "the ledger is there and empty" must not share an output.
list_all_files() {
  [[ -d "$TASKPUMP_TASKS_DIR" ]] || return 0
  find "$TASKPUMP_TASKS_DIR" -maxdepth 1 -name '*.md' -type f | sort
}

# True if all blockers of <file> are status: done.
blockers_satisfied() {
  local file=$1 blockers blocker bfile bstatus
  # Read blockers as newline-separated list.
  blockers=$(yq --front-matter=extract '.blockers[]?' "$file" 2>/dev/null || echo "")
  [[ -z "$blockers" ]] && return 0
  while IFS= read -r blocker; do
    [[ -z "$blocker" ]] && continue
    bfile=$(task_file "$blocker")
    if [[ -z "$bfile" ]]; then
      dbg "blocker '$blocker' has no task file; treating as unsatisfied"
      return 1
    fi
    bstatus=$(fm_get "$bfile" '.status')
    if [[ "$bstatus" != "done" ]]; then
      return 1
    fi
  done <<<"$blockers"
  return 0
}

cmd_next() {
  local branch="" phase="" include_reviews=0
  while (( $# )); do
    case $1 in
      --branch) branch=$2; shift 2;;
      --branch=*) branch=${1#--branch=}; shift;;
      --phase) phase=$2; shift 2;;
      --phase=*) phase=${1#--phase=}; shift;;
      --include-reviews) include_reviews=1; shift;;
      *) die "unknown arg to next: $1";;
    esac
  done
  # Normalise the phase filter to the bare phase token (e.g. F51): accept
  # "F51", "f51", "51", or a full task id like "F51.2" and keep only "F51".
  if [[ -n "$phase" ]]; then
    phase=${phase%%.*}                            # F51.2 -> F51
    phase=$(strip_phase_sigil "$phase")           # F51 / f51 -> 51
    phase="${TASKPUMP_PHASE_SIGIL}${phase}"       # 51 -> F51 (canonical)
  fi

  # Walk tasks, collect (sort_key, id, file) for eligible ones.
  local candidates=() file id status claimed_by sort_key
  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    id=$(fm_get "$file" '.id')
    [[ -z "$id" ]] && { dbg "skip $file: no id"; continue; }
    # Epic scoping: when --phase is given, only consider tasks in that phase.
    # The parallel substrate runs one epic per worktree, so an in-epic next
    # keeps pickups ordered within the epic instead of jumping to a stray
    # lower-numbered task from another phase.
    if [[ -n "$phase" && "${id%%.*}" != "$phase" ]]; then
      dbg "skip $id: phase ${id%%.*} != requested $phase"
      continue
    fi
    status=$(fm_get "$file" '.status')
    if [[ "$status" != "open" ]]; then
      dbg "skip $id: status=$status"
      continue
    fi
    # Review tasks are surfaced only on request. A phase-scoped agent loop
    # running `next --phase` after completing its own task would otherwise
    # claim the review of its own work in its own session — a self-review,
    # which looks like independent scrutiny and is not. Query scoping only:
    # the eligibility predicate (§6) is untouched, and `claim` still works
    # on a review task directly.
    if (( ! include_reviews )) && [[ -n "$(fm_get "$file" '.review_role')" ]]; then
      dbg "skip $id: review task (pass --include-reviews to surface review units)"
      continue
    fi
    claimed_by=$(fm_get "$file" '.claimed_by')
    if [[ -n "$claimed_by" && "$claimed_by" != "$branch" ]]; then
      dbg "skip $id: claimed by '$claimed_by' (current branch: '$branch')"
      continue
    fi
    if ! blockers_satisfied "$file"; then
      dbg "skip $id: blockers not satisfied"
      continue
    fi
    sort_key=$(phase_sort_key "$id")
    candidates+=("$sort_key|$id|$file")
  done < <(list_all_files)

  if (( ${#candidates[@]} == 0 )); then
    # No eligible task. Write an empty-ish JSON to the out file and exit 1.
    printf '%s\n' "null" >| "$TASKPUMP_TASK_OUT"
    echo "null"
    return 1
  fi

  # Sort by numeric phase then numeric within-phase. IFS hack since bash
  # arrays sort lexically by default.
  local sorted
  sorted=$(printf '%s\n' "${candidates[@]}" | sort -n -k1,1 -k2,2 -t'.' -s)
  # Take the first line.
  local top
  top=$(printf '%s\n' "$sorted" | head -n1)
  local top_id=${top#*|}
  top_id=${top_id%%|*}
  local top_file=${top#*|*|}

  # Emit JSON.
  local goal; goal=$(fm_get "$top_file" '.goal')
  [[ -z "$goal" ]] && echo "warning: task $top_id has no goal — set one with '$TASKPUMP_PROG_NAME goal $top_id --set \"...\"'" >&2
  local json
  json=$(jq -n \
    --arg id "$top_id" \
    --arg file "$top_file" \
    --arg branch "$branch" \
    --arg goal "$goal" \
    '{id: $id, file: $file, branch: $branch, goal: $goal, ready: true}')
  printf '%s\n' "$json" >| "$TASKPUMP_TASK_OUT"
  printf '%s\n' "$json"
  return 0
}

# cmd_ready — emit the WHOLE eligible frontier across a phase range, not just the
# single top task `next` returns. This is the keep-acquiring engine the pump
# polls each tick: as blockers complete, more tasks become eligible and surface
# here on the next call. Read-only (no lock, no commit), like next/list.
#
# Eligibility (default + --json) mirrors cmd_next's predicate exactly — status
# `open` ∧ blockers all `done` ∧ (unclaimed | claimed by --branch) — but emits
# ALL matches in phase order instead of head -n1. The candidate walk is kept
# parallel to (not factored out of) cmd_next so that hot path stays byte-for-byte
# unchanged (F64.1 acceptance: next regression-free).
#
# --count is deliberately BROADER: the number of `status: open` tasks in range
# regardless of blocker state — the pump's drain test ("no open work remains").
# --count-eligible is the NARROWER companion: the size of that eligible frontier
# (open ∧ blockers done ∧ unclaimed-or-own-branch) — "how many can launch now".
# The two diverge exactly when a cross-phase blocker or orphaned claim stalls the
# queue (open > 0 while eligible == 0); only then does the drain count mislead.
cmd_ready() {
  local branch="" phases="" json=0 count=0 count_eligible=0 include_reviews=0
  while (( $# )); do
    case $1 in
      --branch) branch=$2; shift 2;;
      --branch=*) branch=${1#--branch=}; shift;;
      --phases|--phase) phases=$2; shift 2;;
      --phases=*) phases=${1#--phases=}; shift;;
      --phase=*) phases=${1#--phase=}; shift;;
      --json) json=1; shift;;
      --count) count=1; shift;;
      --count-eligible) count_eligible=1; shift;;
      --include-reviews) include_reviews=1; shift;;
      *) die "unknown arg to ready: $1";;
    esac
  done

  # Build the wanted-phase set (empty = all phases).
  local -A want=()
  local have_filter=0
  if [[ -n "$phases" ]]; then
    have_filter=1
    local p
    while IFS= read -r p; do
      [[ -n "$p" ]] && want["$p"]=1
    done < <(expand_phases "$phases")
  fi

  # --count (DRAIN TEST): number of status:open tasks in range, blocker/claim
  # state ignored — answers "is there any open work left?", not "what can run?".
  if (( count )); then
    local n=0 file id status iphase
    while IFS= read -r file; do
      [[ -z "$file" ]] && continue
      id=$(fm_get "$file" '.id'); [[ -z "$id" ]] && continue
      iphase=${id%%.*}
      (( have_filter )) && [[ -z "${want[$iphase]:-}" ]] && continue
      status=$(fm_get "$file" '.status')
      [[ "$status" == "open" ]] && n=$((n + 1))
    done < <(list_all_files)
    printf '%s\n' "$n"
    return 0
  fi

  # Eligible FRONTIER: collect eligible (sort_key|id|file), same predicate as
  # cmd_next (open ∧ blockers done ∧ unclaimed-or-own-branch) — "what can launch".
  local candidates=() file id status claimed_by sort_key iphase
  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    id=$(fm_get "$file" '.id')
    [[ -z "$id" ]] && { dbg "skip $file: no id"; continue; }
    iphase=${id%%.*}
    if (( have_filter )) && [[ -z "${want[$iphase]:-}" ]]; then
      dbg "skip $id: phase $iphase not in requested set"
      continue
    fi
    status=$(fm_get "$file" '.status')
    [[ "$status" != "open" ]] && { dbg "skip $id: status=$status"; continue; }
    # Same review-task scoping as cmd_next: the eligible frontier hides review
    # units unless --include-reviews asks for them. Deliberately NOT applied to
    # --count above — a pending review is open work, and a drain test that
    # stopped counting it would let a supervisor exit "drained" over an
    # unrendered verdict.
    if (( ! include_reviews )) && [[ -n "$(fm_get "$file" '.review_role')" ]]; then
      dbg "skip $id: review task (pass --include-reviews to surface review units)"
      continue
    fi
    claimed_by=$(fm_get "$file" '.claimed_by')
    if [[ -n "$claimed_by" && "$claimed_by" != "$branch" ]]; then
      dbg "skip $id: claimed by '$claimed_by' (branch: '$branch')"
      continue
    fi
    if ! blockers_satisfied "$file"; then
      dbg "skip $id: blockers not satisfied"
      continue
    fi
    sort_key=$(phase_sort_key "$id")
    candidates+=("$sort_key|$id|$file")
  done < <(list_all_files)

  # --count-eligible: size of the frontier just collected. Reuses the exact same
  # candidate walk as --json / next, so the count can never drift from them. No
  # sort needed — the cardinality is order-independent. If both --count and
  # --count-eligible are passed, --count already returned above (drain test wins).
  if (( count_eligible )); then
    printf '%s\n' "${#candidates[@]}"
    return 0
  fi

  # Sort by numeric phase then within-phase number (same key as cmd_next).
  local sorted=""
  if (( ${#candidates[@]} > 0 )); then
    sorted=$(printf '%s\n' "${candidates[@]}" | sort -n -k1,1 -k2,2 -t'.' -s)
  fi

  if (( json )); then
    # Emit a JSON array of {id,file,phase,goal,blockers,files}. Build per-object
    # with jq -n then aggregate with jq -s so escaping is correct for
    # goals/blockers.
    #
    # `files` is the task's declared footprint (§3 Scheduling). It rides along
    # because a supervisor dispatching at TASK grain has to answer "may these two
    # eligible siblings run at once?", and the only honest input to that is what
    # each one says it will touch. Always an array — `[]` for a task that
    # declares nothing, never `null`, so a reader never has to distinguish
    # "empty" from "absent".
    local objs=() line oid ofile ophase ogoal oblockers ofiles
    if [[ -n "$sorted" ]]; then
      while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        oid=${line#*|}; oid=${oid%%|*}
        ofile=${line#*|*|}
        ophase=${oid%%.*}
        ogoal=$(fm_get "$ofile" '.goal')
        oblockers=$(yq --front-matter=extract -o=json -I=0 '.blockers' "$ofile" 2>/dev/null || echo "null")
        [[ -z "$oblockers" || "$oblockers" == "null" ]] && oblockers="[]"
        ofiles=$(yq --front-matter=extract -o=json -I=0 '.files' "$ofile" 2>/dev/null || echo "null")
        [[ -z "$ofiles" || "$ofiles" == "null" ]] && ofiles="[]"
        objs+=("$(jq -n \
          --arg id "$oid" --arg file "$ofile" --arg phase "$ophase" \
          --arg goal "$ogoal" --argjson blockers "$oblockers" \
          --argjson files "$ofiles" \
          '{id:$id, file:$file, phase:$phase, goal:$goal, blockers:$blockers, files:$files}')")
      done <<<"$sorted"
    fi
    if (( ${#objs[@]} == 0 )); then
      printf '[]\n'
    else
      printf '%s\n' "${objs[@]}" | jq -s '.'
    fi
    return 0
  fi

  # Default: human table.
  printf '%-10s %-8s %-12s %s\n' "ID" "PHASE" "STATUS" "BLOCKERS"
  if [[ -n "$sorted" ]]; then
    local line tid tfile tphase tblockers
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      tid=${line#*|}; tid=${tid%%|*}
      tfile=${line#*|*|}
      tphase=${tid%%.*}
      tblockers=$(yq --front-matter=extract '.blockers | join(",")' "$tfile" 2>/dev/null || echo "")
      [[ "$tblockers" == "null" ]] && tblockers=""
      printf '%-10s %-8s %-12s %s\n' "$tid" "$tphase" "open" "${tblockers:--}"
    done <<<"$sorted"
  fi
  return 0
}

cmd_list() {
  local filter_status="" json=0
  while (( $# )); do
    case $1 in
      --status) filter_status=$2; shift 2;;
      --status=*) filter_status=${1#--status=}; shift;;
      --json) json=1; shift;;
      *) die "unknown arg to list: $1";;
    esac
  done

  # --json: the same walk, machine-readable, with the two fields the human table
  # has no column for — `files` (the declared footprint) and `phase`. A
  # supervisor dispatching at task grain needs status, claimant, blockers AND
  # footprint for EVERY task, not just the eligible frontier: what a running
  # task is touching is exactly what a candidate must not collide with. Reading
  # that by parsing the human table would freeze the table's column layout into
  # a contract; reading it with yq behind the CLI's back would put a second
  # reader on the ledger. So it is a flag on the verb that already walks
  # everything.
  if (( json )); then
    local objs=() file id status claimed_by title blockers files phase
    while IFS= read -r file; do
      [[ -z "$file" ]] && continue
      id=$(fm_get "$file" '.id'); [[ -z "$id" ]] && continue
      status=$(fm_get "$file" '.status')
      [[ -n "$filter_status" && "$status" != "$filter_status" ]] && continue
      claimed_by=$(fm_get "$file" '.claimed_by')
      title=$(fm_get "$file" '.title')
      phase=${id%%.*}
      blockers=$(yq --front-matter=extract -o=json -I=0 '.blockers' "$file" 2>/dev/null || echo "null")
      [[ -z "$blockers" || "$blockers" == "null" ]] && blockers="[]"
      files=$(yq --front-matter=extract -o=json -I=0 '.files' "$file" 2>/dev/null || echo "null")
      [[ -z "$files" || "$files" == "null" ]] && files="[]"
      objs+=("$(jq -n \
        --arg id "$id" --arg file "$file" --arg phase "$phase" \
        --arg status "$status" --arg claimed_by "$claimed_by" --arg title "$title" \
        --argjson blockers "$blockers" --argjson files "$files" \
        '{id:$id, file:$file, phase:$phase, status:$status,
          claimed_by:(if $claimed_by == "" then null else $claimed_by end),
          title:$title, blockers:$blockers, files:$files}')")
    done < <(list_all_files)
    if (( ${#objs[@]} == 0 )); then
      printf '[]\n'
    else
      printf '%s\n' "${objs[@]}" | jq -s '.'
    fi
    return 0
  fi

  printf '%-10s %-14s %-24s %-20s %s\n' "ID" "STATUS" "CLAIMED_BY" "BLOCKERS" "TITLE"
  local file id status claimed_by title blockers goal
  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    id=$(fm_get "$file" '.id')
    status=$(fm_get "$file" '.status')
    if [[ -n "$filter_status" && "$status" != "$filter_status" ]]; then
      continue
    fi
    claimed_by=$(fm_get "$file" '.claimed_by')
    title=$(fm_get "$file" '.title')
    blockers=$(yq --front-matter=extract '.blockers | join(",")' "$file" 2>/dev/null || echo "")
    [[ "$blockers" == "null" ]] && blockers=""
    # Flag open/in_progress tasks that still lack a goal.
    goal=$(fm_get "$file" '.goal')
    if [[ -z "$goal" && ( "$status" == "open" || "$status" == "in_progress" ) ]]; then
      title="$title  ⚑ no goal"
    fi
    printf '%-10s %-14s %-24s %-20s %s\n' \
      "$id" "$status" "${claimed_by:--}" "${blockers:--}" "$title"
  done < <(list_all_files)
}

cmd_claim() {
  local id="" branch="" turns="$TASKPUMP_TURN_BUDGET_DEFAULT"
  while (( $# )); do
    case $1 in
      --branch) branch=$2; shift 2;;
      --branch=*) branch=${1#--branch=}; shift;;
      --turns) turns=$2; shift 2;;
      --turns=*) turns=${1#--turns=}; shift;;
      -*) die "unknown flag: $1";;
      *) [[ -z "$id" ]] && id=$1 || die "too many positional args"; shift;;
    esac
  done
  [[ -z "$id" ]] && die "usage: $TASKPUMP_PROG_NAME claim <id> --branch <b> [--turns <n>]"
  [[ -z "$branch" ]] && die "--branch is required"
  # The claim is where the branch enters the ledger, so it is where a branch that
  # cannot carry an agent name has to be stopped. Letting it through costs
  # nothing here and everything later: the agent launches under a name liveness
  # cannot map back, the pump reads the phase as dead, and it launches a second
  # agent on the same branch (docs/RUNNERS.md §2).
  local branch_problem
  if ! branch_problem="$(apl_branch_slug_reject_reason "$branch")"; then
    die "$branch_problem
the agent name is the branch with \"/\" replaced by \"-\", and that mapping has to
be reversible; use a branch name with at most one \"/\" (for example feat/g3)"
  fi
  local file; file=$(task_file_required "$id")

  local status; status=$(fm_get "$file" '.status')
  local claimed_by; claimed_by=$(fm_get "$file" '.claimed_by')
  # Idempotent re-claim by the same branch refreshes the turn budget.
  if [[ "$status" == "in_progress" && "$claimed_by" == "$branch" ]]; then
    dbg "refreshing claim on $id (already held by $branch)"
  elif [[ "$status" != "open" ]]; then
    die "cannot claim $id: status=$status (must be open or in_progress by same branch)"
  elif [[ -n "$claimed_by" && "$claimed_by" != "$branch" ]]; then
    die "cannot claim $id: already claimed by '$claimed_by'"
  fi

  local now; now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  fm_set "$file" "
    .status = \"in_progress\" |
    .claimed_by = \"$branch\" |
    .claimed_at = \"$now\" |
    .turn_budget_remaining = $turns |
    .consecutive_failed_iterations = 0 |
    .last_heartbeat_head_sha = null
  "
  git_commit_state "claim $id on $branch (turns=$turns)"
  echo "claimed $id for $branch (turn_budget=$turns)"
  local goal; goal=$(fm_get "$file" '.goal')
  [[ -n "$goal" ]] && echo "goal: $goal"
  # A successful claim must exit 0 regardless of whether the task has a goal —
  # without this, the trailing `[[ -n "$goal" ]] && …` leaks its exit status (1
  # when goal is empty), which a caller checking `claim … || handle` (the pump,
  # the drain brief) would mis-read as a failed claim.
  return 0
}

# Read the current git HEAD SHA of the *code repo* (not the tasks repo).
# Used by heartbeat to detect productive commits.
code_head_sha() {
  local code_repo_root
  code_repo_root=$(git -C "$TASKPUMP_CODE_REPO" rev-parse --show-toplevel 2>/dev/null || true)
  [[ -z "$code_repo_root" ]] && { printf ''; return; }
  git -C "$code_repo_root" rev-parse HEAD 2>/dev/null || printf ''
}

# List files touched by commits from <since_sha>..HEAD in the code repo.
code_files_touched_since() {
  local since_sha=$1 code_repo_root
  code_repo_root=$(git -C "$TASKPUMP_CODE_REPO" rev-parse --show-toplevel 2>/dev/null || true)
  [[ -z "$code_repo_root" ]] && return
  [[ -z "$since_sha" ]] && return
  git -C "$code_repo_root" diff --name-only "$since_sha"..HEAD 2>/dev/null || true
}

cmd_heartbeat() {
  local id="" mode="start"
  while (( $# )); do
    case $1 in
      --start) mode="start"; shift;;
      --end) mode="end"; shift;;
      -*) die "unknown flag: $1";;
      *) [[ -z "$id" ]] && id=$1 || die "too many positional args"; shift;;
    esac
  done
  [[ -z "$id" ]] && die "usage: $TASKPUMP_PROG_NAME heartbeat <id> [--start|--end]"
  local file; file=$(task_file_required "$id")

  local status; status=$(fm_get "$file" '.status')
  if [[ "$status" != "in_progress" ]]; then
    dbg "heartbeat skipped: $id status=$status"
    return 0
  fi

  local head_now; head_now=$(code_head_sha)
  # Wall-clock liveness stamp, distinct from last_heartbeat_head_sha (which is a
  # productivity marker, cleared to null each cycle). scrub's staleness tripwire
  # reads last_heartbeat_ts to reclaim claims that stopped beating.
  local now; now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  if [[ "$mode" == "start" ]]; then
    # Record the starting HEAD so --end can compare; stamp liveness.
    fm_set "$file" "
      .last_heartbeat_head_sha = \"$head_now\" |
      .last_heartbeat_ts = \"$now\"
    "
    git_commit_state "heartbeat start $id (head=$head_now)"
    echo "heartbeat start $id"
    return 0
  fi

  # mode=end: decrement budget, check for productive commits on task's files.
  local budget; budget=$(fm_get "$file" '.turn_budget_remaining')
  [[ -z "$budget" ]] && budget=0
  local new_budget=$((budget - 1))
  (( new_budget < 0 )) && new_budget=0

  # Review tasks: the commit-productivity meter measures nothing here — an
  # honest reviewer commits no code, its deliverable is the verdict in the
  # ledger — so the meter must not drive the failure-streak tripwire. Left
  # unmodified, three cycles of carefully reading a diff would scrub the
  # reviewer `stuck`, punishing exactly the agent doing its job. The counter
  # is left untouched (not incremented, not reset): the cycle is neither
  # productive nor failed, it is unmeasured. A wedged reviewer is still
  # bounded — the budget below decrements every cycle and scrub parks it at
  # 0, and heartbeat staleness catches one that stops beating entirely. See
  # docs/design/review-gates.md for why "a recorded verdict counts as the
  # productive act" was rejected as the mechanism: the verdict completes the
  # task, so --end never observes it.
  if [[ -n "$(fm_get "$file" '.review_role')" ]]; then
    fm_set "$file" "
      .turn_budget_remaining = $new_budget |
      .last_heartbeat_head_sha = null |
      .last_heartbeat_ts = \"$now\"
    "
    git_commit_state "heartbeat end $id (budget=$new_budget review task: productivity unmeasured)"
    echo "heartbeat end $id: budget=$new_budget (review task — commit productivity is not measured; the recorded verdict is the productive act)"
    return 0
  fi

  local start_sha; start_sha=$(fm_get "$file" '.last_heartbeat_head_sha')
  local productive=0
  local touched=""
  if [[ -n "$start_sha" && "$start_sha" != "$head_now" ]]; then
    # Check if any touched file overlaps files:[] — if listed; otherwise any commit counts.
    local task_files overlap
    task_files=$(yq --front-matter=extract '.files[]?' "$file" 2>/dev/null || echo "")
    touched=$(code_files_touched_since "$start_sha")
    if [[ -z "$task_files" ]]; then
      # No scoped file list — any code commit counts as productive.
      [[ -n "$touched" ]] && productive=1
    else
      # Any overlap?
      overlap=$(comm -12 <(printf '%s\n' "$task_files" | sort -u) <(printf '%s\n' "$touched" | sort -u) | head -1)
      [[ -n "$overlap" ]] && productive=1
    fi
  fi

  # Lenient + alarm: if we'd credit this task as productive, check whether
  # the same touched files match ANY OTHER in_progress task's files: list.
  # If so, the productivity attribution is ambiguous — refuse to credit
  # either, and warn loudly so a human can disambiguate. 2026-04-28 incident:
  # F21.5 was credited productive=1 because F21.10's routes.rs commit
  # overlapped its files: list while F21.10 was the actual task being worked.
  local conflicting_tasks=""
  if (( productive == 1 )) && [[ -n "$touched" ]]; then
    local touched_sorted other_file other_id other_status other_files other_overlap
    touched_sorted=$(printf '%s\n' "$touched" | sort -u)
    while IFS= read -r other_file; do
      [[ -z "$other_file" ]] && continue
      [[ "$other_file" == "$file" ]] && continue
      other_status=$(fm_get "$other_file" '.status')
      [[ "$other_status" != "in_progress" ]] && continue
      other_files=$(yq --front-matter=extract '.files[]?' "$other_file" 2>/dev/null || echo "")
      [[ -z "$other_files" ]] && continue
      other_overlap=$(comm -12 <(printf '%s\n' "$other_files" | sort -u) <(printf '%s\n' "$touched_sorted") | head -1)
      if [[ -n "$other_overlap" ]]; then
        other_id=$(fm_get "$other_file" '.id')
        conflicting_tasks="$conflicting_tasks $other_id"
      fi
    done < <(list_all_files)
    if [[ -n "$conflicting_tasks" ]]; then
      printf 'WARNING: heartbeat %s productivity ambiguous — touched files also match in_progress task(s):%s. Not crediting.\n' \
        "$id" "$conflicting_tasks" >&2
      productive=0
    fi
  fi

  local failures; failures=$(fm_get "$file" '.consecutive_failed_iterations')
  [[ -z "$failures" ]] && failures=0
  local new_failures
  if (( productive == 1 )); then
    new_failures=0
  else
    new_failures=$((failures + 1))
  fi

  fm_set "$file" "
    .turn_budget_remaining = $new_budget |
    .consecutive_failed_iterations = $new_failures |
    .last_heartbeat_head_sha = null |
    .last_heartbeat_ts = \"$now\"
  "
  git_commit_state "heartbeat end $id (budget=$new_budget failures=$new_failures productive=$productive)"
  echo "heartbeat end $id: budget=$new_budget failures=$new_failures productive=$productive"
}

cmd_complete() {
  local id="" commits="" defer_note=""
  while (( $# )); do
    case $1 in
      --commits) commits=$2; shift 2;;
      --commits=*) commits=${1#--commits=}; shift;;
      --defer-wiring) defer_note=$2; shift 2;;
      --defer-wiring=*) defer_note=${1#--defer-wiring=}; shift;;
      -*) die "unknown flag: $1";;
      *) [[ -z "$id" ]] && id=$1 || die "too many positional args"; shift;;
    esac
  done
  [[ -z "$id" ]] && die "usage: $TASKPUMP_PROG_NAME complete <id> [--commits <sha,sha>] [--defer-wiring \"note\"]"
  local file; file=$(task_file_required "$id")

  # A review task closes through `verdict`, never through `complete`. Both
  # write the same `done`, but every guard that makes the verdict mean
  # something lives in `verdict`: that the subject is still `done` (not
  # reopened under the reviewer's feet), that an adjudicator does not rule
  # before its panel reported, and that a change-request goes to the
  # implementation instead. `complete` on a gate task therefore hands
  # downstream a green light with the panel still open and no ruling recorded
  # anywhere — a review that never happened, indistinguishable in the ledger
  # from one that did.
  local review_role; review_role=$(fm_get "$file" '.review_role')
  [[ -n "$review_role" ]] \
    && die "cannot complete $id: it is a $review_role task, and a review closes by rendering its verdict — '$TASKPUMP_PROG_NAME verdict $id --approve [--findings -]' (complete would skip every guard: the panel, the subject's status, and the change-request path)"

  local now; now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  # Build JSON array of commits.
  local commits_json
  if [[ -n "$commits" ]]; then
    commits_json=$(printf '%s' "$commits" | jq -R 'split(",") | map(ltrimstr(" ") | rtrimstr(" "))')
  else
    commits_json='[]'
  fi

  fm_set "$file" "
    .status = \"done\" |
    .completed_at = \"$now\" |
    .completed_by_commits = $commits_json |
    .claimed_by = null |
    .turn_budget_remaining = null |
    .consecutive_failed_iterations = 0 |
    .last_heartbeat_head_sha = null
  "

  # Optionally mark that production wiring was deliberately deferred (foundation
  # shipped + tests green, but no real runtime caller yet). Surfaced by `deferred`.
  if [[ -n "$defer_note" ]]; then
    fm_set "$file" "
      .wiring_deferred = true |
      .wiring_deferred_note = \"$defer_note\"
    "
    printf '\n## Wiring deferred (%s)\n\n%s\n' "$now" "$defer_note" >> "$file"
  fi

  # Optionally append completion notes from stdin.
  if ! [ -t 0 ]; then
    local notes; notes=$(cat)
    if [[ -n "$notes" ]]; then
      printf '\n## Completion notes (%s)\n\n%s\n' "$now" "$notes" >> "$file"
    fi
  fi

  git_commit_state "complete $id"
  echo "completed $id${defer_note:+ (wiring deferred)}"
}

cmd_block() {
  local id="" reason=""
  while (( $# )); do
    case $1 in
      --reason) reason=$2; shift 2;;
      --reason=*) reason=${1#--reason=}; shift;;
      -*) die "unknown flag: $1";;
      *) [[ -z "$id" ]] && id=$1 || die "too many positional args"; shift;;
    esac
  done
  [[ -z "$id" ]] && die "usage: $TASKPUMP_PROG_NAME block <id> --reason \"...\""
  [[ -z "$reason" ]] && die "--reason is required"
  local file; file=$(task_file_required "$id")
  local now; now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  fm_set "$file" "
    .status = \"blocked\" |
    .claimed_by = null |
    .blocked_at = \"$now\" |
    .blocked_reason = \"$reason\"
  "
  printf '\n## Blocked (%s)\n\n%s\n' "$now" "$reason" >> "$file"
  git_commit_state "block $id: $reason"
  echo "blocked $id"
}

cmd_needs_review() {
  local id="" reason=""
  while (( $# )); do
    case $1 in
      --reason) reason=$2; shift 2;;
      --reason=*) reason=${1#--reason=}; shift;;
      -*) die "unknown flag: $1";;
      *) [[ -z "$id" ]] && id=$1 || die "too many positional args"; shift;;
    esac
  done
  [[ -z "$id" ]] && die "usage: $TASKPUMP_PROG_NAME needs-review <id> --reason \"...\""
  [[ -z "$reason" ]] && die "--reason is required"
  local file; file=$(task_file_required "$id")
  local now; now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  # Sanctioned setter for the needs-review status — the pump uses this to
  # quarantine a phase whose auto/trunk merge conflicted or went build-red, so it
  # never hand-edits frontmatter. The status value already exists (scrub sets it
  # on budget exhaustion / heartbeat staleness); reuse scrub_reason so monitors
  # surface it the same way.
  fm_set "$file" "
    .status = \"needs-review\" |
    .claimed_by = null |
    .scrub_reason = \"$reason\"
  "
  printf '\n## Needs review (%s)\n\n%s\n' "$now" "$reason" >> "$file"
  git_commit_state "needs-review $id: $reason"
  echo "needs-review $id"
}

cmd_release() {
  local id="" reason=""
  while (( $# )); do
    case $1 in
      --reason) reason=$2; shift 2;;
      --reason=*) reason=${1#--reason=}; shift;;
      -*) die "unknown flag: $1";;
      *) [[ -z "$id" ]] && id=$1 || die "too many positional args"; shift;;
    esac
  done
  [[ -z "$id" ]] && die "usage: $TASKPUMP_PROG_NAME release <id> --reason \"...\""
  [[ -z "$reason" ]] && die "--reason is required"
  local file; file=$(task_file_required "$id")

  local status; status=$(fm_get "$file" '.status')
  if [[ "$status" != "in_progress" ]]; then
    die "cannot release $id: status=$status (must be in_progress)"
  fi

  local now; now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  fm_set "$file" "
    .status = \"open\" |
    .claimed_by = null |
    .claimed_at = null |
    .turn_budget_remaining = null |
    .last_heartbeat_head_sha = null
  "
  printf '\n## Released (%s)\n\n%s\n' "$now" "$reason" >> "$file"
  git_commit_state "release $id: $reason"
  echo "released $id"
}

# Reopen a task back to status=open, from `blocked`, `done`, `needs-review`, or
# `stuck`.
#  - from blocked: a blocker was a transient/environment issue (e.g. an upstream
#    branch that has since merged) rather than a genuine remaining feature gap.
#  - from done: the task was falsely-done / partial — marked complete on green
#    unit tests but its production wiring was never landed (see `defer`). The
#    completion + wiring-deferred markers are dropped so it re-enters the queue
#    as fresh work; the prior completion commits are preserved in the body note.
#  - from needs-review / stuck: a human (or the pump's resume path) has looked at
#    a scrub-parked task and decided it is workable again. Without this, those two
#    statuses are dead ends: `release` requires in_progress, `claim` requires open
#    or a same-branch in_progress, and nothing else writes `open` — so a task
#    scrubbed to needs-review could only be revived by hand-editing frontmatter,
#    which the ledger's whole design forbids. The failure streak is cleared too,
#    so a task reopened from `stuck` does not trip its tripwire on the next turn.
# Distinct from release (which relinquishes a live in_progress claim).
cmd_reopen() {
  local id="" reason=""
  while (( $# )); do
    case $1 in
      --reason) reason=$2; shift 2;;
      --reason=*) reason=${1#--reason=}; shift;;
      -*) die "unknown flag: $1";;
      *) [[ -z "$id" ]] && id=$1 || die "too many positional args"; shift;;
    esac
  done
  [[ -z "$id" ]] && die "usage: $TASKPUMP_PROG_NAME reopen <id> --reason \"...\""
  [[ -z "$reason" ]] && die "--reason is required"
  local file; file=$(task_file_required "$id")

  local status; status=$(fm_get "$file" '.status')
  case "$status" in
    blocked|done|needs-review|stuck) : ;;
    *) die "cannot reopen $id: status=$status (must be blocked, done, needs-review or stuck)";;
  esac

  local now; now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  # A done task reopened as falsely-done/partial: shed its completion markers so
  # the pump treats it as open work again. Capture the prior commits for the note.
  local prior_commits=""
  if [[ "$status" == "done" ]]; then
    prior_commits=$(yq --front-matter=extract '.completed_by_commits | join(",")' "$file" 2>/dev/null || echo "")
    [[ "$prior_commits" == "null" ]] && prior_commits=""
    fm_set "$file" "
      .completed_at = null |
      .completed_by_commits = [] |
      .wiring_deferred = false |
      .wiring_deferred_note = null
    "
  fi
  # A scrub-parked task re-enters the queue with its tripwire counter cleared:
  # `stuck` means consecutive_failed_iterations hit 3, and reopening without
  # resetting would re-trip on the very next unproductive heartbeat.
  if [[ "$status" == "needs-review" || "$status" == "stuck" ]]; then
    fm_set "$file" ".consecutive_failed_iterations = 0"
  fi
  fm_set "$file" "
    .status = \"open\" |
    .blocked_at = null |
    .blocked_reason = null |
    .claimed_by = null |
    .claimed_at = null |
    .turn_budget_remaining = null |
    .last_heartbeat_head_sha = null |
    .scrub_reason = null
  "
  local note="$reason"
  [[ "$status" == "done" && -n "$prior_commits" ]] && note="$reason (prior completion commits: $prior_commits)"
  printf '\n## Reopened (%s, from %s)\n\n%s\n' "$now" "$status" "$note" >> "$file"

  # Reopening work that carries a review chain re-arms the chain, because the
  # work about to be redone has not been reviewed. Contract §5.12 names the
  # ordinary `reopen` as the human door out of a rounds-exhausted park, and
  # without this that door is a trapdoor: the exhaustion path completes the
  # gate, so a bare reopen leaves the gate `done` and the NEXT `complete` makes
  # downstream eligible with no review rendered and nothing warning. The same
  # hole opens after an ordinary approve-then-reopen. `verdict` cannot patch
  # it either — it refuses a second ruling on a done review ("a verdict is
  # already recorded"), and `review` refuses a second chain ("one subject, one
  # chain"), so there is no other sanctioned way back.
  #
  # The round counter resets to 1 with the chain: a human who reopens is
  # granting the work another look, and leaving the counter at its bound would
  # re-park the task on the first change-request of the new round.
  local rearmed=""
  if [[ -n "$(fm_get "$file" '.review_round')" ]]; then
    review_chain_scan "$id"
    if (( ${#REVIEW_CHAIN_IDS[@]} > 0 )); then
      local i cid cfile cstatus
      for i in "${!REVIEW_CHAIN_IDS[@]}"; do
        cid="${REVIEW_CHAIN_IDS[$i]}"
        cfile="${REVIEW_CHAIN_FILES[$i]}"
        cstatus=$(fm_get "$cfile" '.status')
        [[ "$cstatus" == "open" ]] && continue
        review_rearm_task "$cfile"
        printf '\n## Re-armed by reopen (%s)\n\n%s was reopened (was %s); this review re-runs against the redone work.\n' \
          "$now" "$id" "$status" >> "$cfile"
        rearmed="$rearmed $cid"
      done
      fm_set "$file" ".review_round = 1"
    fi
  fi

  git_commit_state "reopen $id: $reason"
  echo "reopened $id (was $status)"
  [[ -n "$rearmed" ]] && echo "review chain re-armed (round 1):$rearmed"
  return 0
}

# ── Review gates (issue #12) ──────────────────────────────────────────────────
# A review is an ordinary task the CLI synthesizes: reviewer tasks blocked by
# the implementation task, an adjudicator blocked by the reviewers when a panel
# exists, and every task downstream of the implementation gains the chain's
# GATE task (adjudicator, or the lone reviewer) as an additional blocker. The
# eligibility predicate then does the gating with zero new predicate logic, and
# the DAG renderer draws the chain because it is nodes with edges. See
# docs/design/review-gates.md for the shape and the rejected alternatives.

# Collect the review chain of <impl-id> into globals (dynamic scoping; results
# on stdout would die inside $(...) without killing the caller — the same trap
# normalize_blockers documents):
#   REVIEW_CHAIN_IDS / REVIEW_CHAIN_FILES  every task whose review_of == impl
#   REVIEW_REVIEWER_IDS                    the reviewer members
#   REVIEW_ADJ_ID                          the adjudicator, if any
#   REVIEW_GATE_ID                         adjudicator, else the lone reviewer,
#                                          else "" (a panel with no adjudicator
#                                          has no gate — hand-built only)
review_chain_scan() {
  local impl_id=$1 f rid role
  REVIEW_CHAIN_IDS=(); REVIEW_CHAIN_FILES=(); REVIEW_REVIEWER_IDS=()
  REVIEW_ADJ_ID=""; REVIEW_GATE_ID=""
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    [[ "$(fm_get "$f" '.review_of')" == "$impl_id" ]] || continue
    rid=$(fm_get "$f" '.id')
    [[ -z "$rid" ]] && continue
    role=$(fm_get "$f" '.review_role')
    REVIEW_CHAIN_IDS+=("$rid"); REVIEW_CHAIN_FILES+=("$f")
    if [[ "$role" == "adjudicator" ]]; then
      REVIEW_ADJ_ID="$rid"
    else
      REVIEW_REVIEWER_IDS+=("$rid")
    fi
  done < <(list_all_files)
  if [[ -n "$REVIEW_ADJ_ID" ]]; then
    REVIEW_GATE_ID="$REVIEW_ADJ_ID"
  elif (( ${#REVIEW_CHAIN_IDS[@]} == 1 )); then
    REVIEW_GATE_ID="${REVIEW_CHAIN_IDS[0]}"
  fi
  return 0
}

# Collect the review gates that must ride along with a set of blockers, into
# REVIEW_GATE_RIDERS (a global, because review_chain_scan's results are globals
# and a $(...) capture would lose them).
#
# `review` rewires downstream by snapshotting the tasks that name the
# implementation AT CHAIN-CREATION TIME, and never revisits. In a long-horizon
# drain, tasks are authored as work is discovered — so a task filed after the
# chain exists would block on the implementation alone and become eligible the
# moment it completes, with the verdict unrendered and nothing warning. The
# gate would look applied and not be, which is the feature's central promise
# leaking out the back. So the authoring verbs (`create --blockers`,
# `blockers --add/--set`) carry the gate along: naming an implementation under
# live review as your blocker means what it meant at chain-creation time.
#
# Three cases deliberately do NOT get a rider:
#   * a blocker that is itself a review task — the chain's own internal wiring;
#   * an owner that is a member of that blocker's chain — a reviewer blocks its
#     subject by design, and riding the gate onto it would build a cycle;
#   * a chain whose gate is already `done` — the review is rendered, so the
#     edge would be inert. (Reopening the subject re-arms the chain, §5.7, at
#     which point new blockers gate again.)
# Subtractive forms (`--remove`, `--clear`) are untouched: they are an operator
# explicitly rewiring, and re-adding what they just removed would make a bad
# edge unfixable. `fsck` is the net under that case.
# Usage: review_gate_riders <owner-id> <blocker-id>...
review_gate_riders() {
  local owner=$1; shift
  REVIEW_GATE_RIDERS=()
  local ownerfile b bfile gate gfile e seen
  ownerfile=$(task_file "$owner" || true)
  for b in "$@"; do
    [[ -z "$b" ]] && continue
    bfile=$(task_file "$b" || true)
    [[ -z "$bfile" ]] && continue
    [[ -n "$(fm_get "$bfile" '.review_role')" ]] && continue
    [[ -n "$(fm_get "$bfile" '.review_round')" ]] || continue
    review_chain_scan "$b"
    gate="$REVIEW_GATE_ID"
    [[ -z "$gate" || "$gate" == "$owner" ]] && continue
    [[ -n "$ownerfile" && "$(fm_get "$ownerfile" '.review_of')" == "$b" ]] && continue
    gfile=$(task_file "$gate" || true)
    [[ -z "$gfile" ]] && continue
    [[ "$(fm_get "$gfile" '.status')" == "done" ]] && continue
    seen=0
    for e in "$@"; do [[ "$e" == "$gate" ]] && seen=1; done
    for e in "${REVIEW_GATE_RIDERS[@]-}"; do [[ "$e" == "$gate" ]] && seen=1; done
    (( seen )) || REVIEW_GATE_RIDERS+=("$gate")
  done
  return 0
}

# Re-arm one review-chain member back to `open`, shedding every marker a
# completed (or parked) review left behind. Shared by the two paths that
# re-arm a chain — a change-request verdict and a `reopen` of the subject — so
# the two can never disagree about what a re-armed review looks like.
#
# blocked_at/blocked_reason are cleared with the rest because contract §3 ties
# them to the `blocked` status and §5.7 has `reopen` clear both: a task sitting
# `open` while still carrying the reason it was once blocked is a stale field
# every reader must learn to disbelieve.
# Usage: review_rearm_task <file>
review_rearm_task() {
  fm_set "$1" "
    .status = \"open\" |
    .claimed_by = null |
    .claimed_at = null |
    .turn_budget_remaining = null |
    .consecutive_failed_iterations = 0 |
    .last_heartbeat_head_sha = null |
    .completed_at = null |
    .completed_by_commits = [] |
    .blocked_at = null |
    .blocked_reason = null |
    .scrub_reason = null
  "
}

# Write one synthesized review task file. Emits the full machine-key set of
# LEDGER-CONTRACT §3 (a writer should emit the full set) plus the review
# fields, through yaml_scalar so no generated title can break the frontmatter.
# Usage: review_write_task <file> <id> <role> <is_gate> <impl-id> <impl-title> <prompt> <blocker...>
review_write_task() {
  local file=$1 id=$2 role=$3 is_gate=$4 impl_id=$5 impl_title=$6 prompt=$7
  shift 7
  local -a blist=("$@")
  local title goal b
  if [[ "$role" == "adjudicator" ]]; then
    title="Adjudicate the review of $impl_id: $impl_title"
    goal="The reviewer findings for $impl_id are adjudicated and the gate verdict is rendered."
  else
    title="Adversarial review of $impl_id: $impl_title"
    goal="The work of $impl_id is adversarially reviewed against its stated goal and a verdict is recorded."
  fi
  {
    printf -- '---\n'
    printf 'id: %s\n' "$(yaml_scalar "$id")"
    printf 'phase: %s\n' "$(yaml_scalar "${id%%.*}")"
    printf 'title: %s\n' "$(yaml_scalar "$title")"
    printf 'status: open\n'
    printf 'claimed_by: null\n'
    printf 'claimed_at: null\n'
    printf 'turn_budget_remaining: null\n'
    printf 'consecutive_failed_iterations: 0\n'
    printf 'blockers:\n'
    for b in "${blist[@]}"; do
      printf -- '  - %s\n' "$(yaml_scalar "$b")"
    done
    printf 'completed_by_commits: []\n'
    printf 'milestone: null\n'
    printf 'files: []\n'
    printf 'last_heartbeat_head_sha: null\n'
    printf 'completed_at: null\n'
    printf 'goal: %s\n' "$(yaml_scalar "$goal")"
    printf 'last_heartbeat_ts: null\n'
    printf 'blocked_at: null\n'
    printf 'blocked_reason: null\n'
    printf 'resume_attempts: 0\n'
    printf 'resume_head_sha: null\n'
    printf 'review_of: %s\n' "$(yaml_scalar "$impl_id")"
    printf 'review_role: %s\n' "$role"
    if [[ -n "$prompt" ]]; then
      printf 'review_prompt: %s\n' "$(yaml_scalar "$prompt")"
    else
      printf 'review_prompt: null\n'
    fi
    printf -- '---\n\n'
    printf '# %s — %s\n\n' "$id" "$title"
    printf '## Subject\n\n'
    if [[ "$role" == "adjudicator" ]]; then
      printf 'Adjudicate the review of %s ("%s"). Read every reviewer task'\''s findings\n' "$impl_id" "$impl_title"
      printf 'AND the delivered work — an adjudicator that cannot read the code cannot\n'
      printf 'break ties. The change-request path is yours alone; you may approve over a\n'
      printf 'lone objection.\n\n'
    else
      printf 'Adversarial review of %s ("%s"). Read its task file'\''s goal and\n' "$impl_id" "$impl_title"
      printf 'acceptance, read the work it delivered, run the tests. Your deliverable is\n'
      printf 'the verdict in the ledger, not code commits.\n\n'
    fi
    printf '## Verdict\n\n'
    if [[ "$is_gate" == "1" ]]; then
      printf '    %s verdict %s --approve [--findings -]\n' "$TASKPUMP_PROG_NAME" "$id"
      printf '    %s verdict %s --request-changes --findings -\n\n' "$TASKPUMP_PROG_NAME" "$id"
      printf 'This task is the gate: downstream work stays blocked until it completes, and\n'
      printf 'a change-request reopens %s with your findings.\n' "$impl_id"
    else
      printf '    %s verdict %s --approve --findings -\n\n' "$TASKPUMP_PROG_NAME" "$id"
      printf 'You are one voice on a panel: only the adjudicator renders the gate verdict,\n'
      printf 'and your findings must not be shaped by the other reviewers'\'' — independence\n'
      printf 'is what makes the panel adversarial rather than an echo.\n'
    fi
  } >"$file"
}

# Synthesize a review chain for an implementation task, atomically under the
# state lock: reviewers, adjudicator, and the downstream rewiring, in one
# ledger commit. Refuses a second chain for the same task — one subject, one
# chain — and warns (does not die) when the subject is already done, because
# reviewing landed work is legitimate and the chain is simply eligible at once.
cmd_review() {
  local impl_id="" panel=1 prompt="" max_rounds=3
  while (( $# )); do
    case $1 in
      --panel) panel=$2; shift 2;;
      --panel=*) panel=${1#--panel=}; shift;;
      --prompt) prompt=$2; shift 2;;
      --prompt=*) prompt=${1#--prompt=}; shift;;
      --max-rounds) max_rounds=$2; shift 2;;
      --max-rounds=*) max_rounds=${1#--max-rounds=}; shift;;
      -*) die "unknown flag to review: $1";;
      *) [[ -z "$impl_id" ]] && impl_id=$1 || die "too many positional args to review"; shift;;
    esac
  done
  [[ -z "$impl_id" ]] && die "usage: $TASKPUMP_PROG_NAME review <impl-id> [--panel N] [--prompt <file>] [--max-rounds N]"
  [[ "$panel" =~ ^[0-9]+$ ]] && (( panel >= 1 )) \
    || die "--panel must be a positive integer, got: $panel"
  [[ "$max_rounds" =~ ^[0-9]+$ ]] && (( max_rounds >= 1 )) \
    || die "--max-rounds must be a positive integer, got: $max_rounds"

  local impl_file; impl_file=$(task_file_required "$impl_id")
  [[ -n "$(fm_get "$impl_file" '.review_role')" ]] \
    && die "cannot review $impl_id: it is itself a review task (the adjudicator is the review of the reviews)"

  review_chain_scan "$impl_id"
  (( ${#REVIEW_CHAIN_IDS[@]} > 0 )) \
    && die "a review chain for $impl_id already exists (${REVIEW_CHAIN_IDS[*]}); one subject, one chain — reopen its tasks to re-review"

  # The prompt is validated now, at creation time, so a typo'd path fails here
  # and not in whatever dispatches the reviewer weeks later. Stored relative to
  # the code repo when it lies inside it, so the recorded path survives the
  # ledger being read from another checkout.
  if [[ -n "$prompt" ]]; then
    [[ -f "$prompt" ]] || die "review prompt file does not exist: $prompt"
    local prompt_abs code_root
    prompt_abs=$(readlink -f "$prompt")
    code_root=$(git -C "$TASKPUMP_CODE_REPO" rev-parse --show-toplevel 2>/dev/null || true)
    [[ -z "$code_root" ]] && code_root="$TASKPUMP_CODE_REPO"
    if [[ "$prompt_abs" == "$code_root"/* ]]; then
      prompt=${prompt_abs#"$code_root"/}
    else
      prompt="$prompt_abs"
    fi
  fi

  local impl_status impl_title
  impl_status=$(fm_get "$impl_file" '.status')
  [[ "$impl_status" == "done" ]] \
    && warn "reviewing already-done work: $impl_id is done, so the chain is eligible immediately"
  impl_title=$(fm_get "$impl_file" '.title')

  # Allocate the next free .N ids in the implementation's phase namespace —
  # the id grammar (§7) is contract-frozen, so review tasks live in the same
  # namespace as every other task. The bare-phase file, if any, counts as 0.
  local idphase=${impl_id%%.*} max_n=0 f stem n
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    stem=$(basename "$f" .md)
    [[ "$stem" == "$idphase".* ]] || continue
    n=${stem#"$idphase".}
    [[ "$n" =~ ^[0-9]+$ ]] || continue
    (( n > max_n )) && max_n=$n
  done < <(list_all_files)

  # Downstream snapshot BEFORE any new file exists, so the chain's own members
  # (whose blockers name the implementation) can never be rewired onto the
  # gate they are part of.
  local -a downstream_files=() downstream_ids=()
  local blk hit did
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    hit=0
    while IFS= read -r blk; do
      [[ "$blk" == "$impl_id" ]] && { hit=1; break; }
    done < <(yq --front-matter=extract '.blockers[]?' "$f" 2>/dev/null || true)
    (( hit )) || continue
    did=$(fm_get "$f" '.id')
    downstream_files+=("$f"); downstream_ids+=("$did")
  done < <(list_all_files)

  # Reserve the ids: reviewers first, then the adjudicator.
  local -a reviewer_ids=()
  local i new_id adj_id="" gate_id
  for (( i = 1; i <= panel; i++ )); do
    new_id="$idphase.$((max_n + i))"
    [[ "$new_id" =~ $TASKPUMP_ID_PATTERN ]] \
      || die "generated review id '$new_id' does not match TASKPUMP_ID_PATTERN $TASKPUMP_ID_PATTERN"
    reviewer_ids+=("$new_id")
  done
  if (( panel > 1 )); then
    adj_id="$idphase.$((max_n + panel + 1))"
    [[ "$adj_id" =~ $TASKPUMP_ID_PATTERN ]] \
      || die "generated adjudicator id '$adj_id' does not match TASKPUMP_ID_PATTERN $TASKPUMP_ID_PATTERN"
    gate_id="$adj_id"
  else
    gate_id="${reviewer_ids[0]}"
  fi

  # Write the chain. A lone reviewer is the gate; panel reviewers are not.
  local rid is_gate
  for rid in "${reviewer_ids[@]}"; do
    is_gate=0; [[ "$rid" == "$gate_id" ]] && is_gate=1
    review_write_task "$TASKPUMP_TASKS_DIR/$rid.md" "$rid" reviewer "$is_gate" \
      "$impl_id" "$impl_title" "$prompt" "$impl_id"
  done
  if [[ -n "$adj_id" ]]; then
    review_write_task "$TASKPUMP_TASKS_DIR/$adj_id.md" "$adj_id" adjudicator 1 \
      "$impl_id" "$impl_title" "" "${reviewer_ids[@]}"
  fi

  # Rewire downstream: the gate is ADDED to existing blockers, never a
  # replacement for the implementation edge — a later reopen of the
  # implementation must still hold downstream shut on its own.
  local df
  for df in "${downstream_files[@]}"; do
    local -a cur=()
    local seen=0 e
    while IFS= read -r blk; do
      [[ -z "$blk" ]] && continue
      cur+=("$blk")
      [[ "$blk" == "$gate_id" ]] && seen=1
    done < <(yq --front-matter=extract '.blockers[]?' "$df" 2>/dev/null || true)
    (( seen )) && continue
    cur+=("$gate_id")
    write_blockers "$df" "${cur[@]}"
  done

  # Round bookkeeping lives on the implementation task: one home for the
  # counter and its bound, whichever chain member renders the verdict.
  local now; now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  fm_set "$impl_file" ".review_round = 1 | .review_max_rounds = $max_rounds"
  {
    printf '\n## Review chain created (%s)\n\n' "$now"
    printf 'Reviewers: %s.' "${reviewer_ids[*]}"
    [[ -n "$adj_id" ]] && printf ' Adjudicator: %s.' "$adj_id"
    printf ' Gate: %s. Rounds: 1/%s.\n' "$gate_id" "$max_rounds"
  } >> "$impl_file"

  git_commit_state "review $impl_id: ${#reviewer_ids[@]} reviewer(s), gate=$gate_id (max_rounds=$max_rounds)"
  echo "review chain for $impl_id: reviewer(s) ${reviewer_ids[*]}${adj_id:+, adjudicator $adj_id} (gate: $gate_id)"
  if (( ${#downstream_ids[@]} > 0 )); then
    echo "downstream rewired onto the gate: ${downstream_ids[*]}"
  else
    echo "no downstream tasks listed $impl_id as a blocker; the gate blocks nothing yet"
  fi
  return 0
}

# Render a review verdict, through the state machine's existing doors only —
# no new status, no new transition. --approve is `complete` for a review task,
# findings in its body. --request-changes is the change loop, and it is the
# GATE task's call alone: findings land on the IMPLEMENTATION task's body (the
# implementer is who must act on them), the implementation reopens exactly as
# reopen-from-done would (completion markers shed, prior commits preserved in
# the note), the whole chain re-arms to open, and review_round advances. The
# reviews are then ineligible until the fix lands and `complete` runs again —
# the loop closes through the eligibility predicate, nothing else.
#
# A change-request that would need a round past review_max_rounds instead
# parks the implementation needs-review with the findings intact: the round
# bound measures futility, not duration, and past it a human renders the
# final call. Panel reviewers only ever report — their --request-changes is
# refused with a pointer to the adjudicator, because a panel where any
# member can reopen the work is a panel whose verdict nobody rendered.
cmd_verdict() {
  local rid="" approve=0 request=0 findings="" branch=""
  while (( $# )); do
    case $1 in
      --approve) approve=1; shift;;
      --request-changes) request=1; shift;;
      --findings) findings=$2; shift 2;;
      --findings=*) findings=${1#--findings=}; shift;;
      --branch) branch=$2; shift 2;;
      --branch=*) branch=${1#--branch=}; shift;;
      -*) die "unknown flag to verdict: $1";;
      *) [[ -z "$rid" ]] && rid=$1 || die "too many positional args to verdict"; shift;;
    esac
  done
  [[ -z "$rid" ]] && die "usage: $TASKPUMP_PROG_NAME verdict <review-id> [--branch <b>] --approve [--findings -|\"...\"]  |  --request-changes --findings -|\"...\""
  (( approve + request == 1 )) \
    || die "verdict requires exactly one of --approve or --request-changes"

  local rfile; rfile=$(task_file_required "$rid")
  local role; role=$(fm_get "$rfile" '.review_role')
  [[ -z "$role" ]] \
    && die "$rid is not a review task (no review_role); verdict applies only to reviewer/adjudicator tasks"
  local rstatus; rstatus=$(fm_get "$rfile" '.status')
  [[ "$rstatus" == "done" ]] \
    && die "a verdict is already recorded for $rid (status=done); reopen it to re-review"

  # Ownership. A claimed review belongs to its claimant: ruling over another
  # branch's live claim is a bystander overwriting a reviewer's work in
  # progress, and it is what makes the self-review exclusion (§6's frontier
  # skip) advisory — the implementer's own session could rule on the review of
  # its own work while a real reviewer holds the claim. Refused on the same
  # rule `claim` applies: same branch fine, different branch never.
  #
  # An UNCLAIMED review warns rather than refusing. Requiring in_progress (as
  # `release` does) would make `verdict` stricter than `complete`, its closest
  # sibling — and §5.12's door out of a rounds-exhausted park is explicitly a
  # human rendering the final call, which no dispatcher is around to claim for.
  local claimed_by; claimed_by=$(fm_get "$rfile" '.claimed_by')
  if [[ -n "$claimed_by" ]]; then
    [[ -z "$branch" ]] \
      && die "$rid is claimed by '$claimed_by'; pass --branch to say who is ruling (a verdict over another branch's live claim overwrites a reviewer mid-read)"
    [[ "$branch" != "$claimed_by" ]] \
      && die "cannot render a verdict on $rid from '$branch': it is claimed by '$claimed_by' (one claim, one ruling — release or reopen it first)"
  else
    warn "rendering a verdict on an unclaimed review ($rid, status=$rstatus): nothing records who ruled, and the self-review exclusion is only advisory without a claim"
  fi

  local impl_id; impl_id=$(fm_get "$rfile" '.review_of')
  [[ -z "$impl_id" ]] \
    && die "$rid carries review_role but no review_of; the chain is broken — repair it through the CLI"
  local impl_file; impl_file=$(task_file "$impl_id" || true)
  [[ -z "$impl_file" ]] \
    && die "review_of '$impl_id' names no task in this ledger; the verdict has no implementation to act on"
  # `claim` checks status, not blockers, so nothing upstream of this line
  # stops a verdict on work that is not finished — or was reopened while the
  # reviewer read it. A verdict on a moving target reviews nothing.
  local impl_status; impl_status=$(fm_get "$impl_file" '.status')
  [[ "$impl_status" != "done" ]] \
    && die "cannot render a verdict on $impl_id while it is $impl_status; the review is of completed work (wait for complete)"

  if [[ "$findings" == "-" ]]; then
    findings=$(cat)
  fi
  if (( request )) && [[ -z "$findings" ]]; then
    die "--request-changes requires --findings (the implementer needs something to act on)"
  fi

  review_chain_scan "$impl_id"
  local gate_id="$REVIEW_GATE_ID"
  local is_gate=0
  [[ -n "$gate_id" && "$rid" == "$gate_id" ]] && is_gate=1

  # An adjudicator's ruling before every reviewer has reported is a verdict
  # over findings that do not exist yet — and since `claim` does not check
  # blockers, nothing else refuses it.
  if [[ "$role" == "adjudicator" ]]; then
    local pending="" rev rev_file rev_status
    for rev in "${REVIEW_REVIEWER_IDS[@]-}"; do
      [[ -z "$rev" ]] && continue
      rev_file=$(task_file "$rev" || true)
      [[ -z "$rev_file" ]] && continue
      rev_status=$(fm_get "$rev_file" '.status')
      [[ "$rev_status" == "done" ]] || pending="$pending $rev"
    done
    [[ -n "$pending" ]] \
      && die "adjudicator verdict before the panel reported — still pending:$pending"
  fi

  local round max
  round=$(fm_get "$impl_file" '.review_round'); [[ "$round" =~ ^[0-9]+$ ]] || round=1
  max=$(fm_get "$impl_file" '.review_max_rounds'); [[ "$max" =~ ^[0-9]+$ ]] || max=3
  local now; now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  if (( approve )); then
    fm_set "$rfile" "
      .status = \"done\" |
      .completed_at = \"$now\" |
      .claimed_by = null |
      .turn_budget_remaining = null |
      .consecutive_failed_iterations = 0 |
      .last_heartbeat_head_sha = null
    "
    {
      printf '\n## Verdict: approve (round %s, %s)\n' "$round" "$now"
      [[ -n "$findings" ]] && printf '\n%s\n' "$findings"
    } >> "$rfile"
    git_commit_state "verdict $rid: approve (round $round)"
    if (( is_gate )); then
      echo "verdict $rid: approve (round $round) — the gate is done; downstream unblocks as its remaining blockers do"
    else
      echo "verdict $rid: approve (round $round) — report recorded; the gate verdict belongs to ${gate_id:-the adjudicator}"
    fi
    return 0
  fi

  # --request-changes from here on.
  if (( ! is_gate )); then
    if [[ -z "$gate_id" ]]; then
      die "this chain has no gate task (a panel with no adjudicator?); repair the chain before rendering a change-request"
    fi
    die "only the gate task ($gate_id) renders the change-request verdict; record your findings with --approve — independence is the point of the panel"
  fi

  local prior_commits
  prior_commits=$(yq --front-matter=extract '.completed_by_commits | join(",")' "$impl_file" 2>/dev/null || echo "")
  [[ "$prior_commits" == "null" ]] && prior_commits=""

  local new_round=$((round + 1))
  if (( new_round > max )); then
    # The round budget is spent. The gate's verdict is delivered (its task
    # completes; the report stands), and the implementation is parked for a
    # human — completion markers shed, because a needs-review task still
    # claiming completed_at would carry that lie through the next reopen.
    fm_set "$rfile" "
      .status = \"done\" |
      .completed_at = \"$now\" |
      .claimed_by = null |
      .turn_budget_remaining = null |
      .consecutive_failed_iterations = 0 |
      .last_heartbeat_head_sha = null
    "
    printf '\n## Verdict: request-changes (round %s, %s) — rounds exhausted\n\n%s\n' \
      "$round" "$now" "$findings" >> "$rfile"
    fm_set "$impl_file" "
      .status = \"needs-review\" |
      .scrub_reason = \"review rounds exhausted ($round/$max)\" |
      .claimed_by = null |
      .claimed_at = null |
      .turn_budget_remaining = null |
      .last_heartbeat_head_sha = null |
      .completed_at = null |
      .completed_by_commits = [] |
      .wiring_deferred = false |
      .wiring_deferred_note = null
    "
    {
      printf '\n## Review findings (round %s, %s)\n\n%s\n' "$round" "$now" "$findings"
      printf '\nReview rounds exhausted (%s/%s); parked needs-review for a human decision.' "$round" "$max"
      [[ -n "$prior_commits" ]] && printf ' Prior completion commits: %s.' "$prior_commits"
      printf '\n'
    } >> "$impl_file"
    git_commit_state "verdict $rid: request-changes — rounds exhausted ($round/$max), $impl_id parked needs-review"
    echo "verdict $rid: request-changes (round $round) — review rounds exhausted ($round/$max); $impl_id parked needs-review with the findings"
    return 0
  fi

  # Reopen the implementation exactly as reopen-from-done would, plus the
  # round advance; findings go to its body because the implementer acts there.
  fm_set "$impl_file" "
    .status = \"open\" |
    .completed_at = null |
    .completed_by_commits = [] |
    .wiring_deferred = false |
    .wiring_deferred_note = null |
    .claimed_by = null |
    .claimed_at = null |
    .turn_budget_remaining = null |
    .last_heartbeat_head_sha = null |
    .blocked_at = null |
    .blocked_reason = null |
    .scrub_reason = null |
    .review_round = $new_round
  "
  {
    printf '\n## Review findings (round %s, %s)\n\n%s\n' "$round" "$now" "$findings"
    printf '\nReopened for round %s.' "$new_round"
    [[ -n "$prior_commits" ]] && printf ' Prior completion commits: %s.' "$prior_commits"
    printf '\n'
  } >> "$impl_file"

  # Re-arm the whole chain — gate included — back to open. Blockers are
  # intact, so every member is ineligible until the fix lands and `complete`
  # runs again. The gate keeps its verdict note; siblings get a line saying
  # why their `done` was shed.
  printf '\n## Verdict: request-changes (round %s, %s)\n\n%s\n' \
    "$round" "$now" "$findings" >> "$rfile"
  local i cid cfile
  for i in "${!REVIEW_CHAIN_IDS[@]}"; do
    cid="${REVIEW_CHAIN_IDS[$i]}"
    cfile="${REVIEW_CHAIN_FILES[$i]}"
    review_rearm_task "$cfile"
    [[ "$cid" == "$rid" ]] && continue
    printf '\n## Re-armed for round %s (%s)\n\n%s was reopened by %s'\''s change-request verdict; blockers hold this review until the fix completes.\n' \
      "$new_round" "$now" "$impl_id" "$rid" >> "$cfile"
  done

  git_commit_state "verdict $rid: request-changes (round $round -> $new_round)"
  echo "verdict $rid: request-changes (round $round) — $impl_id reopened for round $new_round; chain re-armed"
  return 0
}

# Record that the pump is about to auto-resume a stalled task, and rule on
# whether it still may. Returns the verdict on stdout and in the exit code so the
# caller never has to read frontmatter itself — there is no generic read verb,
# and the ledger's one-writer rule means the counter's increment, its
# progress-reset, and the limit test have to be a single locked
# read-modify-write here rather than a race between the pump's read and write.
#
# Progress is "did the branch move since the last resume", measured by comparing
# --head against the stored sha. That deliberately does NOT depend on the
# container cooperating: a dead agent never fires `heartbeat --end`, so
# consecutive_failed_iterations stays 0 and cannot serve as the attempt budget.
# `claim` also zeroes that counter on every (re)claim, so the pump's own resume
# cycle would reset the very tripwire meant to stop it.
#
#   progress (head moved, or first ever resume) -> counter resets to 1
#   no progress                                 -> counter increments
#   would exceed --max                          -> clamp, verdict `escalate`, rc 10
#
# Clamping (rather than letting the counter run past --max) keeps repeated
# escalate calls idempotent: once exhausted the function writes nothing, so a
# pump ticking every 30s does not churn a ledger commit per tick.
cmd_resume_attempt() {
  local id="" head="" max="3"
  while (( $# )); do
    case $1 in
      --head) head=$2; shift 2;;
      --head=*) head=${1#--head=}; shift;;
      --max) max=$2; shift 2;;
      --max=*) max=${1#--max=}; shift;;
      -*) die "unknown flag: $1";;
      *) [[ -z "$id" ]] && id=$1 || die "too many positional args"; shift;;
    esac
  done
  [[ -z "$id" ]] && die "usage: $TASKPUMP_PROG_NAME resume-attempt <id> --head <sha> [--max N]"
  [[ -z "$head" ]] && die "--head is required (the branch head sha at this resume)"
  # Validated rather than escaped: the sha is interpolated into a yq expression,
  # and a hex-only shape is a cheaper guarantee than getting the quoting right.
  [[ "$head" =~ ^[0-9a-fA-F]{7,40}$ ]] || die "--head must be a git sha (7-40 hex chars), got: $head"
  [[ "$max" =~ ^[0-9]+$ ]] || die "--max must be a non-negative integer, got: $max"
  (( max >= 1 )) || die "--max must be at least 1"
  local file; file=$(task_file_required "$id")

  local cur; cur=$(fm_get "$file" '.resume_attempts')
  [[ "$cur" =~ ^[0-9]+$ ]] || cur=0
  local prev; prev=$(fm_get "$file" '.resume_head_sha')

  local next verdict rc
  if [[ -z "$prev" || "$prev" != "$head" ]]; then
    next=1                      # branch moved (or never resumed): real progress
  else
    next=$((cur + 1))
  fi
  if (( next > max )); then
    next=$max; verdict="escalate"; rc=10
  else
    verdict="resume"; rc=0
  fi

  if [[ "$next" != "$cur" || "$prev" != "$head" ]]; then
    fm_set "$file" ".resume_attempts = $next | .resume_head_sha = \"$head\""
    git_commit_state "resume-attempt $id: $verdict $next/$max (head=${head:0:12})"
  fi
  echo "$verdict $next/$max"
  return "$rc"
}

# Mark a task's production wiring as deliberately deferred: the foundation
# primitive shipped and its unit tests pass, but the first REAL (non-test)
# caller — the thing that makes the feature do its job at runtime — was left for
# a follow-up. Does NOT change status (the task can still go `done`). This is the
# sanctioned opt-out from the "wire to production before done" default; `deferred`
# collects these so they can be turned into new follow-up tasks. See also
# `complete --defer-wiring`, the inline form used at completion time.
cmd_defer() {
  local id="" reason=""
  while (( $# )); do
    case $1 in
      --reason) reason=$2; shift 2;;
      --reason=*) reason=${1#--reason=}; shift;;
      -*) die "unknown flag: $1";;
      *) [[ -z "$id" ]] && id=$1 || die "too many positional args"; shift;;
    esac
  done
  [[ -z "$id" ]] && die "usage: $TASKPUMP_PROG_NAME defer <id> --reason \"what wiring was deferred\""
  [[ -z "$reason" ]] && die "--reason is required"
  local file; file=$(task_file_required "$id")
  local now; now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  fm_set "$file" "
    .wiring_deferred = true |
    .wiring_deferred_note = \"$reason\"
  "
  printf '\n## Wiring deferred (%s)\n\n%s\n' "$now" "$reason" >> "$file"
  git_commit_state "defer $id: $reason"
  echo "deferred-wiring $id"
}

# Clear a task's deferred-wiring flag because the wiring HAS since landed —
# typically by a follow-up task that owned it (F70.3's wiring landed in F70.6,
# F73.5's in F73.9, …). The inverse of `defer`. Status is untouched; this only
# says "the first real caller now exists", so `deferred` stops collecting it as
# outstanding follow-up work.
#
# --caller is required and must name the non-test call site (file:line), so the
# ledger records the EVIDENCE for the claim rather than an unbacked assertion.
# If the wiring did not actually land, use `reopen` instead.
cmd_undefer() {
  local id="" caller=""
  while (( $# )); do
    case $1 in
      --caller) caller=$2; shift 2;;
      --caller=*) caller=${1#--caller=}; shift;;
      -*) die "unknown flag: $1";;
      *) [[ -z "$id" ]] && id=$1 || die "too many positional args"; shift;;
    esac
  done
  [[ -z "$id" ]] && die "usage: $TASKPUMP_PROG_NAME undefer <id> --caller \"<file:line> — what wired it\""
  [[ -z "$caller" ]] && die "--caller is required (name the non-test call site)"
  local file; file=$(task_file_required "$id")
  [[ "$(fm_get "$file" '.wiring_deferred')" == "true" ]] \
    || die "cannot undefer $id: wiring_deferred is not set"
  local now; now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  fm_set "$file" "
    .wiring_deferred = false |
    .wiring_deferred_note = null
  "
  printf '\n## Wiring landed (%s)\n\n%s\n' "$now" "$caller" >> "$file"
  git_commit_state "undefer $id: $caller"
  echo "wiring-landed $id"
}

# List tasks whose production wiring was marked deferred (via `defer` or
# `complete --defer-wiring`). The collection step: these are shipped-but-unwired
# foundations to fold back into the queue as new follow-up tasks.
cmd_deferred() {
  local as_json=0
  while (( $# )); do
    case $1 in
      --json) as_json=1; shift;;
      *) die "unknown arg to deferred: $1";;
    esac
  done
  local file id status note
  if (( as_json )); then
    local first=1
    printf '['
    while IFS= read -r file; do
      [[ -z "$file" ]] && continue
      [[ "$(fm_get "$file" '.wiring_deferred')" == "true" ]] || continue
      id=$(fm_get "$file" '.id'); status=$(fm_get "$file" '.status'); note=$(fm_get "$file" '.wiring_deferred_note')
      (( first )) || printf ','; first=0
      jq -cn --arg id "$id" --arg status "$status" --arg note "$note" '{id:$id,status:$status,note:$note}'
    done < <(list_all_files)
    printf ']\n'
    return
  fi
  printf '%-10s %-10s %s\n' "ID" "STATUS" "DEFERRED-WIRING NOTE"
  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    [[ "$(fm_get "$file" '.wiring_deferred')" == "true" ]] || continue
    id=$(fm_get "$file" '.id'); status=$(fm_get "$file" '.status'); note=$(fm_get "$file" '.wiring_deferred_note')
    printf '%-10s %-10s %s\n' "$id" "$status" "$note"
  done < <(list_all_files)
}

# Convert an ISO-8601 UTC timestamp (YYYY-MM-DDTHH:MM:SSZ) to epoch seconds.
# Portable across GNU coreutils date (-d), BSD/macOS date (-j -f), and a
# python3 fallback. Prints empty string if the timestamp can't be parsed.
iso_to_epoch() {
  local ts=$1 epoch
  [[ -z "$ts" ]] && { printf ''; return; }
  if epoch=$(date -u -d "$ts" +%s 2>/dev/null); then
    printf '%s' "$epoch"; return
  fi
  if epoch=$(date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$ts" +%s 2>/dev/null); then
    printf '%s' "$epoch"; return
  fi
  if command -v python3 >/dev/null 2>&1; then
    epoch=$(python3 -c 'import sys,datetime; print(int(datetime.datetime.strptime(sys.argv[1], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc).timestamp()))' "$ts" 2>/dev/null) \
      && { printf '%s' "$epoch"; return; }
  fi
  printf ''
}

cmd_scrub() {
  local scrubbed=0 broken=0
  local file id budget failures meta
  while IFS= read -r file; do
    [[ -z "$file" ]] && continue

    # Integrity check first: a file the frontier cannot see is invisible to
    # every other verb, so scrub is the only place that will ever notice it.
    # Neither case is repaired here — `fm_set` also goes through yq, so the CLI
    # cannot write to a file it cannot read — hence report, don't relabel.
    #
    # Two distinct ways a file goes invisible, both reported:
    #   UNPARSEABLE — the frontmatter is not valid YAML (F45.15's failure).
    #   NO-ID       — it parses, but carries no `id`, so it can never be named
    #                 by any verb. Caught separately because valid-but-idless
    #                 YAML is just as unreachable and yq is perfectly happy
    #                 with it (a file with no frontmatter at all parses fine).
    local status
    if ! meta=$(fm_id_status "$file"); then
      echo "scrub: UNPARSEABLE $file (invisible to next/ready — repair the frontmatter by hand)"
      broken=$((broken + 1))
      continue
    fi
    { IFS= read -r id; IFS= read -r status || true; } <<<"$meta"
    if [[ -z "$id" ]]; then
      echo "scrub: NO-ID $file (invisible to next/ready — add an 'id:' or move the file out of the tasks dir)"
      broken=$((broken + 1))
      continue
    fi

    [[ "$status" != "in_progress" ]] && continue
    budget=$(fm_get "$file" '.turn_budget_remaining')
    # Fallback for a null budget (pre-A5 claims, or tooling that skipped
    # --turns) is 3, not 9999: a small ceiling so an immune claim can still be
    # reclaimed, but not 0 — that would scrub a legitimate in-flight null-budget
    # claim on the very next pass.
    [[ -z "$budget" ]] && budget=3
    failures=$(fm_get "$file" '.consecutive_failed_iterations')
    [[ -z "$failures" ]] && failures=0

    # Heartbeat-staleness: reclaim a claim whose last beat (or claim time, if it
    # never beat) is older than TASKPUMP_CLAIM_STALE_HOURS (default 24h). This
    # catches an alive-but-hung container that never fires another heartbeat —
    # the residual gap A1's dead-container check cannot reach.
    local stale_hours stale=0 ts ts_epoch now_epoch
    stale_hours="$TASKPUMP_CLAIM_STALE_HOURS"
    [[ "$stale_hours" =~ ^[0-9]+$ ]] || stale_hours=24
    ts=$(fm_get "$file" '.last_heartbeat_ts')
    [[ -z "$ts" ]] && ts=$(fm_get "$file" '.claimed_at')
    if [[ -n "$ts" ]]; then
      ts_epoch=$(iso_to_epoch "$ts")
      now_epoch=$(date -u +%s)
      if [[ -n "$ts_epoch" ]] && (( now_epoch - ts_epoch > stale_hours * 3600 )); then
        stale=1
      fi
    fi

    if (( budget <= 0 )); then
      fm_set "$file" "
        .status = \"needs-review\" |
        .claimed_by = null |
        .scrub_reason = \"turn_budget exhausted\"
      "
      echo "scrub: $id → needs-review (budget=0)"
      scrubbed=$((scrubbed + 1))
    elif (( failures >= TASKPUMP_FAILURE_LIMIT )); then
      fm_set "$file" "
        .status = \"stuck\" |
        .claimed_by = null |
        .scrub_reason = \"consecutive_failed_iterations=$failures\"
      "
      echo "scrub: $id → stuck (failures=$failures)"
      scrubbed=$((scrubbed + 1))
    elif (( stale == 1 )); then
      fm_set "$file" "
        .status = \"needs-review\" |
        .claimed_by = null |
        .scrub_reason = \"heartbeat_staleness\"
      "
      echo "scrub: $id → needs-review (heartbeat_staleness, last=$ts, threshold=${stale_hours}h)"
      scrubbed=$((scrubbed + 1))
    fi
  done < <(list_all_files)
  if (( scrubbed > 0 )); then
    git_commit_state "scrub: $scrubbed task(s) relabeled"
  fi
  # Exit 3, not 1, so a supervisor can tell "the ledger has invisible files"
  # (actionable: go repair them) from "scrub itself failed" (a crash, a missing
  # yq, a bad tasks dir). The pump keys off this to name the offending paths
  # instead of logging a generic failure every tick.
  #
  # The per-file lines above already went to stdout; this summary is the only
  # thing on stderr, so `scrub 2>&1 | tee` does not double-report each path.
  if (( broken > 0 )); then
    printf '%s: %d task file(s) invisible to the frontier (see UNPARSEABLE/NO-ID above)\n' \
      "$TASKPUMP_PROG_NAME" "$broken" >&2
    return 3
  fi
  return 0
}

# ── fsck: whole-ledger conformance check (docs/LEDGER-CONTRACT.md §11.1) ──────
# The import path for a repository that already carries a directory of markdown
# task files: check every file against the ledger contract, one line per
# violation (`<file>: <what>`), exit 3 when any exist — the same actionable-vs-
# crash split scrub keeps (1 means fsck itself could not run). `--fix` stamps
# MISSING machine keys with their documented defaults and never rewrites a
# present-but-wrong value: guessing intent is how ledgers get corrupted.
#
# scrub reports the two invisibility classes it can see on its per-tick sweep
# (UNPARSEABLE, NO-ID); fsck is the full audit, including the one check no
# single-file tool can do — a blocker cycle, which silently removes every one
# of its members from the frontier forever.

# Parse <file>'s frontmatter to compact JSON on stdout. The return code
# classifies the ways a file can fail to even reach the schema checks:
#   0 mapping parsed    1 no opening ---     2 no closing ---
#   3 not valid YAML    4 parses, but is not a mapping
# The delimiter checks are load-bearing, not pedantry: yq's front-matter mode
# happily "parses" a file with no frontmatter at all (the whole body reads as a
# YAML scalar) and treats everything after an unclosed `---` as frontmatter, so
# without them a README.md in the tasks dir would type-check instead of being
# named for what it is.
fsck_read_frontmatter() {
  local file=$1 first="" fm_json
  IFS= read -r first < "$file" || true
  [[ "$first" == "---" ]] || return 1
  awk 'NR > 1 && $0 == "---" { found = 1; exit } END { exit (found ? 0 : 1) }' "$file" || return 2
  fm_json=$(yq --front-matter=extract -o=json -I=0 '.' "$file" 2>/dev/null) || return 3
  [[ "$(jq -r 'type' <<<"$fm_json")" == "object" ]] || return 4
  printf '%s' "$fm_json"
}

# The frontmatter schema of LEDGER-CONTRACT §3 as one jq program, so the check
# pass and the --fix pass read the same table and cannot drift. $mode selects:
#   check    emit one violation message per missing/mistyped key
#   missing  emit the names of absent keys whose class is "stamp" — the ones
#            --fix may repair (required keys have no default; verb-added keys
#            are legal to omit)
# Defined once per fsck run (inside cmd_fsck), reaching the helpers by bash's
# dynamic scoping, so no other verb pays for it.
fsck_schema_jq() {
  cat <<'JQ'
def is_int: type == "number" and (. == (. | floor));
def is_ts:  type == "string"
            and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$");
def kindok($kind):
  if   $kind == "string"  then type == "string"
  elif $kind == "string?" then . == null or type == "string"
  elif $kind == "int"     then is_int
  elif $kind == "int?"    then . == null or is_int
  elif $kind == "strlist" then type == "array" and all(.[]; type == "string")
  elif $kind == "ts?"     then . == null or is_ts
  elif $kind == "bool"    then type == "boolean"
  else false end;
. as $fm
| [
    ["id",                            "string",  "a string",                                                  "required"],
    ["title",                         "string",  "a string",                                                  "required"],
    ["phase",                         "string",  "a string",                                                  "stamp"],
    ["status",                        "string",  "a string",                                                  "stamp"],
    ["goal",                          "string?", "a string or null",                                          "stamp"],
    ["milestone",                     "string?", "a string or null",                                          "stamp"],
    ["blockers",                      "strlist", "a list of task-id strings",                                 "stamp"],
    ["files",                         "strlist", "a list of path strings",                                    "stamp"],
    ["claimed_by",                    "string?", "a string or null",                                          "stamp"],
    ["claimed_at",                    "ts?",     "an ISO-8601 UTC timestamp (YYYY-MM-DDTHH:MM:SSZ) or null",  "stamp"],
    ["turn_budget_remaining",         "int?",    "an integer or null",                                        "stamp"],
    ["consecutive_failed_iterations", "int",     "an integer",                                                "stamp"],
    ["last_heartbeat_head_sha",       "string?", "a sha string or null",                                      "stamp"],
    ["last_heartbeat_ts",             "ts?",     "an ISO-8601 UTC timestamp (YYYY-MM-DDTHH:MM:SSZ) or null",  "stamp"],
    ["completed_at",                  "ts?",     "an ISO-8601 UTC timestamp (YYYY-MM-DDTHH:MM:SSZ) or null",  "stamp"],
    ["completed_by_commits",          "strlist", "a list of sha strings",                                     "stamp"],
    ["blocked_at",                    "ts?",     "an ISO-8601 UTC timestamp (YYYY-MM-DDTHH:MM:SSZ) or null",  "stamp"],
    ["blocked_reason",                "string?", "a string or null",                                          "stamp"],
    ["resume_attempts",               "int",     "an integer",                                                "stamp"],
    ["resume_head_sha",               "string?", "a sha string or null",                                      "stamp"],
    ["wiring_deferred",               "bool",    "a boolean",                                                 "verb-added"],
    ["wiring_deferred_note",          "string?", "a string or null",                                          "verb-added"],
    ["scrub_reason",                  "string?", "a string or null",                                          "verb-added"],
    ["review_of",                     "string?", "a task-id string or null",                                  "verb-added"],
    ["review_role",                   "string?", "a string or null",                                          "verb-added"],
    ["review_prompt",                 "string?", "a path string or null",                                     "verb-added"],
    ["review_round",                  "int?",    "an integer or null",                                        "verb-added"],
    ["review_max_rounds",             "int?",    "an integer or null",                                        "verb-added"]
  ][]
| . as [$key, $kind, $label, $class]
| if $mode == "missing" then
    if $class == "stamp" and (($fm | has($key)) | not) then $key else empty end
  elif ($fm | has($key)) | not then
    if   $class == "required" then "missing required key '\($key)' (no defined default; --fix cannot invent one)"
    elif $class == "stamp"    then "missing machine key '\($key)' (--fix stamps its documented default)"
    else empty end
  elif ($fm[$key] | kindok($kind)) | not then
    "\($key): expected \($label), got \($fm[$key] | tojson)"
  elif $key == "status"
       and (["open", "in_progress", "done", "blocked", "needs-review", "stuck"]
            | index($fm[$key]) | not) then
    "status '\($fm[$key])' is not in the status vocabulary (open|in_progress|done|blocked|needs-review|stuck)"
  elif $key == "review_role"
       and ($fm[$key] != null)
       and (["reviewer", "adjudicator"] | index($fm[$key]) | not) then
    "review_role '\($fm[$key])' is not in the role vocabulary (reviewer|adjudicator)"
  else empty end
JQ
}

# Check one task file. Violations append to FSCK_VIOLATIONS; the blockers
# adjacency lands in FSCK_ADJ for the whole-ledger pass. Both are locals of
# cmd_fsck, reached by dynamic scoping — appending from inside a $(...) capture
# would mutate a subshell's copy and silently report nothing.
fsck_check_file() {
  local file=$1 stem fm_json parse_rc=0 line id blockers
  stem=$(basename "$file" .md)
  fm_json=$(fsck_read_frontmatter "$file") || parse_rc=$?
  case $parse_rc in
    1) FSCK_VIOLATIONS+=("$file: no YAML frontmatter (the first line must be exactly \"---\")"); return 0;;
    2) FSCK_VIOLATIONS+=("$file: frontmatter has no closing \"---\" delimiter"); return 0;;
    3) FSCK_VIOLATIONS+=("$file: frontmatter is not valid YAML between the --- delimiters"); return 0;;
    4) FSCK_VIOLATIONS+=("$file: frontmatter is not a YAML mapping of machine keys"); return 0;;
  esac

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    FSCK_VIOLATIONS+=("$file: $line")
  done < <(jq -r --arg mode check "$FSCK_SCHEMA_JQ" <<<"$fm_json")

  # Identity: the tools resolve a task to a path by name and read the id back
  # out of the frontmatter, so a file whose name and id disagree is reachable
  # by one and invisible to the other (contract §2).
  id=$(jq -r 'if (.id | type) == "string" then .id else "" end' <<<"$fm_json")
  if [[ -n "$id" ]]; then
    [[ "$id" == "$stem" ]] \
      || FSCK_VIOLATIONS+=("$file: id '$id' does not match the filename stem '$stem' (reachable by one name, invisible under the other)")
    [[ "$id" =~ $TASKPUMP_ID_PATTERN ]] \
      || FSCK_VIOLATIONS+=("$file: id '$id' does not match TASKPUMP_ID_PATTERN $TASKPUMP_ID_PATTERN")
  fi

  # Graph facts, keyed by stem: blockers resolve to <tasks-dir>/<id>.md by
  # name, so the stem is the node other tasks actually reach.
  blockers=$(jq -r 'if (.blockers | type) == "array" then .blockers[] | select(type == "string") else empty end' <<<"$fm_json")
  [[ -n "$blockers" ]] && FSCK_ADJ[$stem]=$blockers

  # Review-chain facts for the whole-ledger pass: `verdict` resolves the
  # implementation through review_of by name, so a dangling one is a chain
  # whose verdict can never land — and nothing per-file will ever say so.
  # Status and role ride along for the gate-coverage check below.
  local review_of review_role status
  review_of=$(jq -r 'if (.review_of | type) == "string" then .review_of else "" end' <<<"$fm_json")
  review_role=$(jq -r 'if (.review_role | type) == "string" then .review_role else "" end' <<<"$fm_json")
  status=$(jq -r 'if (.status | type) == "string" then .status else "" end' <<<"$fm_json")
  [[ -n "$review_of" ]] && FSCK_REVIEW_OF[$stem]=$review_of
  [[ -n "$review_role" ]] && FSCK_ROLE[$stem]=$review_role
  [[ -n "$status" ]] && FSCK_STATUS[$stem]=$status

  # review_role is what makes a task a review task (§5.12), and every verb that
  # acts on one resolves its subject through review_of. A role with no subject
  # is a task the frontier hides (§6) and `verdict` refuses outright — open
  # work that nothing can dispatch and nothing can close, with no diagnostic
  # until someone runs the verb by hand.
  [[ -n "$review_role" && -z "$review_of" ]] \
    && FSCK_VIOLATIONS+=("$file: review_role '$review_role' with no review_of (a review task with no subject: hidden from the frontier, and 'verdict' dies on it)")
  return 0
}

# The whole-ledger checks: dangling blockers, self-blocks, and blocker cycles.
# Each is a way a task leaves the frontier forever with no diagnostic from any
# per-file read — the eligibility predicate (§6) just keeps answering "not yet".
fsck_graph_check() {
  local stem b cyc e
  local -a stems_sorted=()
  if (( ${#FSCK_STEMS[@]} > 0 )); then
    while IFS= read -r stem; do stems_sorted+=("$stem"); done \
      < <(printf '%s\n' "${!FSCK_STEMS[@]}" | sort)
  fi

  for stem in "${stems_sorted[@]-}"; do
    [[ -n "${FSCK_ADJ[$stem]:-}" ]] || continue
    while IFS= read -r b; do
      [[ -z "$b" ]] && continue
      if [[ "$b" == "$stem" ]]; then
        FSCK_VIOLATIONS+=("$TASKPUMP_TASKS_DIR/$stem.md: task blocks itself ('$b' is in its own blockers)")
      elif [[ -z "${FSCK_STEMS[$b]:-}" ]]; then
        FSCK_VIOLATIONS+=("$TASKPUMP_TASKS_DIR/$stem.md: blocker '$b' names no task in this ledger (unsatisfied forever — the task can never enter the frontier)")
      fi
    done <<<"${FSCK_ADJ[$stem]}"
  done

  # Review chains: review_of must resolve, and never to the task itself. The
  # verb validates both on creation, but an imported ledger arrives with its
  # chains already drawn — same reasoning as the blocker checks above.
  for stem in "${stems_sorted[@]-}"; do
    [[ -n "${FSCK_REVIEW_OF[$stem]:-}" ]] || continue
    b="${FSCK_REVIEW_OF[$stem]}"
    if [[ "$b" == "$stem" ]]; then
      FSCK_VIOLATIONS+=("$TASKPUMP_TASKS_DIR/$stem.md: review_of names the task itself (a review cannot review its own verdict)")
    elif [[ -z "${FSCK_STEMS[$b]:-}" ]]; then
      FSCK_VIOLATIONS+=("$TASKPUMP_TASKS_DIR/$stem.md: review_of '$b' names no task in this ledger (the verdict verb has no implementation to act on)")
    fi
  done

  # Gate coverage: a task that blocks on an implementation under LIVE review
  # must also block on that chain's gate. `review` wires this for everything
  # downstream at chain-creation time and the authoring verbs carry the gate
  # along afterwards (review_gate_riders), so the CLI cannot produce this
  # shape — but an imported ledger, a hand edit, or a deliberate
  # `blockers --remove` of the gate can, and the result is the feature failing
  # OPEN: the task goes eligible the moment the implementation completes, with
  # the verdict unrendered and every other reader silent. A review that fails
  # open is not a review, so it is a violation, not a warning.
  local -A FSCK_GATE_OF=() FSCK_CHAIN_ADJ=() FSCK_CHAIN_N=() FSCK_CHAIN_ONE=()
  local impl
  for stem in "${stems_sorted[@]-}"; do
    impl="${FSCK_REVIEW_OF[$stem]:-}"
    [[ -z "$impl" ]] && continue
    FSCK_CHAIN_N[$impl]=$(( ${FSCK_CHAIN_N[$impl]:-0} + 1 ))
    FSCK_CHAIN_ONE[$impl]=$stem
    [[ "${FSCK_ROLE[$stem]:-}" == "adjudicator" ]] && FSCK_CHAIN_ADJ[$impl]=$stem
  done
  for impl in "${!FSCK_CHAIN_N[@]}"; do
    # The gate is the adjudicator, or the lone reviewer. A panel with no
    # adjudicator has no gate — hand-built, and nothing to check against.
    if [[ -n "${FSCK_CHAIN_ADJ[$impl]:-}" ]]; then
      FSCK_GATE_OF[$impl]="${FSCK_CHAIN_ADJ[$impl]}"
    elif (( ${FSCK_CHAIN_N[$impl]} == 1 )); then
      FSCK_GATE_OF[$impl]="${FSCK_CHAIN_ONE[$impl]}"
    fi
  done
  local gate has_gate
  for stem in "${stems_sorted[@]-}"; do
    [[ -n "${FSCK_ADJ[$stem]:-}" ]] || continue
    while IFS= read -r b; do
      [[ -z "$b" ]] && continue
      gate="${FSCK_GATE_OF[$b]:-}"
      [[ -z "$gate" || "$gate" == "$stem" ]] && continue
      # A chain member blocks on its own subject by design (§5.12).
      [[ "${FSCK_REVIEW_OF[$stem]:-}" == "$b" ]] && continue
      # A rendered verdict has already gated this edge; only a live chain can
      # still be bypassed. (Reopening the subject re-arms the chain, §5.7.)
      [[ "${FSCK_STATUS[$gate]:-}" == "done" ]] && continue
      has_gate=0
      while IFS= read -r e; do
        [[ "$e" == "$gate" ]] && { has_gate=1; break; }
      done <<<"${FSCK_ADJ[$stem]}"
      (( has_gate )) && continue
      FSCK_VIOLATIONS+=("$TASKPUMP_TASKS_DIR/$stem.md: blocks on '$b', which is under live review, but not on that chain's gate '$gate' (the review fails open: this task goes eligible the moment '$b' completes, verdict unrendered)")
    done <<<"${FSCK_ADJ[$stem]}"
  done

  # Cycle detection: depth-first walk over the blocker edges, sorted start
  # order for deterministic output. A back edge to a node still on the current
  # path closes a cycle; its members are the path suffix from that node.
  for stem in "${stems_sorted[@]-}"; do
    [[ -z "$stem" ]] && continue
    [[ -n "${FSCK_COLOR[$stem]:-}" ]] && continue
    fsck_cycle_dfs "$stem"
  done
  for cyc in "${FSCK_CYCLES[@]-}"; do
    [[ -z "$cyc" ]] && continue
    FSCK_VIOLATIONS+=("$TASKPUMP_TASKS_DIR/${cyc%%|*}.md: blocker cycle ${cyc#*|} (a cycle removes every one of its members from the frontier forever)")
  done
}

fsck_cycle_dfs() {
  local node=$1 b i
  FSCK_COLOR[$node]=gray
  FSCK_PATH+=("$node")
  while IFS= read -r b; do
    [[ -z "$b" || "$b" == "$node" ]] && continue    # self-block: reported above
    [[ -n "${FSCK_STEMS[$b]:-}" ]] || continue      # dangling: reported above
    case "${FSCK_COLOR[$b]:-white}" in
      gray)
        local start=0 members
        for (( i = 0; i < ${#FSCK_PATH[@]}; i++ )); do
          if [[ "${FSCK_PATH[$i]}" == "$b" ]]; then start=$i; break; fi
        done
        members="${FSCK_PATH[*]:$start}"
        FSCK_CYCLES+=("$b|${members// / -> } -> $b")
        ;;
      black) : ;;
      *) fsck_cycle_dfs "$b";;
    esac
  done <<<"${FSCK_ADJ[$node]:-}"
  FSCK_COLOR[$node]=black
  unset "FSCK_PATH[$(( ${#FSCK_PATH[@]} - 1 ))]"
}

# The documented default for each stampable machine key, as a yq assignment.
# phase is derived from id per contract §7.2 — mechanical, not a guess.
fsck_default_expr() {
  local key=$1 id=$2
  case $key in
    phase)                                          printf '.phase = %s' "$(yaml_scalar "${id%%.*}")";;
    status)                                         printf '.status = "open"';;
    consecutive_failed_iterations|resume_attempts)  printf '.%s = 0' "$key";;
    blockers|files|completed_by_commits)            printf '.%s = []' "$key";;
    *)                                              printf '.%s = null' "$key";;
  esac
}

# --fix: stamp MISSING machine keys with their documented defaults. Only files
# whose identity is sound are written — parseable mapping, id a string equal to
# the filename stem and matching the pattern; anything less is a file whose
# identity is in question, and writing to it would launder a broken file into a
# half-plausible one. Present-but-wrong values are never rewritten; the report
# pass that follows still names them. One ledger commit covers the repair.
fsck_apply_fixes() {
  local file stem id fm_json parse_rc key
  local stamped_keys=0 stamped_files=0
  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    parse_rc=0
    fm_json=$(fsck_read_frontmatter "$file") || parse_rc=$?
    (( parse_rc != 0 )) && continue
    stem=$(basename "$file" .md)
    id=$(jq -r 'if (.id | type) == "string" then .id else "" end' <<<"$fm_json")
    [[ -n "$id" && "$id" == "$stem" ]] || continue
    [[ "$id" =~ $TASKPUMP_ID_PATTERN ]] || continue

    local -a missing_keys=() exprs=()
    while IFS= read -r key; do
      [[ -z "$key" ]] && continue
      missing_keys+=("$key")
      exprs+=("$(fsck_default_expr "$key" "$id")")
    done < <(jq -r --arg mode missing "$FSCK_SCHEMA_JQ" <<<"$fm_json")
    (( ${#missing_keys[@]} == 0 )) && continue

    local joined names
    joined=$(printf '%s | ' "${exprs[@]}")
    fm_set "$file" "${joined% | }"
    names="${missing_keys[*]}"
    printf '%s: stamped missing machine key(s): %s\n' "$file" "${names// /, }"
    stamped_keys=$((stamped_keys + ${#missing_keys[@]}))
    stamped_files=$((stamped_files + 1))
  done < <(list_all_files)
  if (( stamped_files > 0 )); then
    git_commit_state "fsck --fix: stamped $stamped_keys missing machine key(s) in $stamped_files task file(s)"
  fi
}

cmd_fsck() {
  local fix=0
  while (( $# )); do
    case $1 in
      --fix) fix=1; shift;;
      *) die "unknown arg to fsck: $1 (usage: $TASKPUMP_PROG_NAME fsck [--fix])";;
    esac
  done

  # A missing tasks directory is an error, not an empty (and therefore clean)
  # ledger: exit 0 here would be a verdict about a ledger that does not exist.
  # die exits 1, not 3 — "fsck could not run" vs "violations found", the same
  # split scrub keeps.
  [[ -d "$TASKPUMP_TASKS_DIR" ]] \
    || die "no tasks directory at $TASKPUMP_TASKS_DIR — nothing to check ('$TASKPUMP_PROG_NAME resolve' prints how this path was chosen)"

  local FSCK_SCHEMA_JQ
  FSCK_SCHEMA_JQ=$(fsck_schema_jq)

  if (( fix )); then
    acquire_state_lock
    fsck_apply_fixes
  fi

  # Report pass. In --fix mode it runs after the stamping, so what prints (and
  # what the exit code answers for) is what REMAINS wrong.
  local -a FSCK_VIOLATIONS=() FSCK_PATH=() FSCK_CYCLES=()
  local -A FSCK_STEMS=() FSCK_ADJ=() FSCK_COLOR=() FSCK_REVIEW_OF=()
  local -A FSCK_ROLE=() FSCK_STATUS=()
  local file
  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    FSCK_STEMS[$(basename "$file" .md)]=1
  done < <(list_all_files)
  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    fsck_check_file "$file"
  done < <(list_all_files)
  fsck_graph_check

  if (( ${#FSCK_VIOLATIONS[@]} > 0 )); then
    printf '%s\n' "${FSCK_VIOLATIONS[@]}"
    printf '%s: %d contract violation(s) in %s (docs/LEDGER-CONTRACT.md is the contract)\n' \
      "$TASKPUMP_PROG_NAME" "${#FSCK_VIOLATIONS[@]}" "$TASKPUMP_TASKS_DIR" >&2
    return 3
  fi
  return 0
}

# ── goal: read / set / list-missing the one-line outcome goal ──────────────────
# The `goal` frontmatter field is a single crisp sentence stating what success
# looks like for the task. This CLI is its sole writer (per the no-hand-edit
# frontmatter invariant). `/goal` drives the authoring UX on top of this.
cmd_goal() {
  local id="" set_text="" do_set=0 missing=0
  while (( $# )); do
    case $1 in
      --set) set_text=$2; do_set=1; shift 2;;
      --set=*) set_text=${1#--set=}; do_set=1; shift;;
      --missing) missing=1; shift;;
      -*) die "unknown flag to goal: $1";;
      *) [[ -z "$id" ]] && id=$1 || die "too many positional args to goal"; shift;;
    esac
  done

  # --missing: ids of open/in_progress tasks with no goal (drives /goal sweep
  # and the prep-long-session gate). Read-only.
  if (( missing )); then
    local file status goal
    while IFS= read -r file; do
      [[ -z "$file" ]] && continue
      status=$(fm_get "$file" '.status')
      [[ "$status" == "open" || "$status" == "in_progress" ]] || continue
      goal=$(fm_get "$file" '.goal')
      [[ -z "$goal" ]] || continue
      fm_get "$file" '.id'; echo
    done < <(list_all_files)
    return 0
  fi

  [[ -z "$id" ]] && die "usage: $TASKPUMP_PROG_NAME goal <id> [--set \"text\"]  |  goal --missing"
  local file; file=$(task_file_required "$id")

  if (( do_set )); then
    [[ -z "$set_text" ]] && die "goal --set requires non-empty text"
    # Serialize the read-modify-write + commit like other mutators (read path
    # below stays lock-free, mirroring next/list).
    acquire_state_lock
    GOAL="$set_text" yq -i --front-matter=process '.goal = strenv(GOAL)' "$file"
    git_commit_state "goal: set $id"
    echo "goal set for $id: $set_text"
  else
    printf '%s\n' "$(fm_get "$file" '.goal')"
  fi
}

# Emit a value as a YAML-safe scalar. `jq -R .` produces a double-quoted JSON
# string, which is valid YAML for any input — so a value containing ": ", "#",
# a leading "*", etc. can never break the frontmatter.
#
# This is load-bearing, not defensive: a task file whose frontmatter yq cannot
# parse is read as empty by `fm_get` (which swallows yq errors), so the task
# vanishes from `next`/`ready` with no diagnostic anywhere. Exactly that
# happened to F45.15, which sat unparseable — and therefore unreachable — in
# the ledger for nine weeks.
yaml_scalar() {
  printf '%s' "$1" | jq -R .
}

# Trim, drop empties, reject self-blocking, require each id to resolve, and
# de-duplicate. Shared by `blockers` and `create` so the two verbs cannot
# disagree about what a valid blockers list is.
#
# Results land in the global NORMALIZED_BLOCKERS rather than on stdout, and the
# function must be called directly — NOT via `$(...)` or `< <(...)`. Inside a
# command/process substitution `die`'s `exit 1` terminates only the subshell,
# so a nonexistent or self-referential blocker would be silently dropped and
# the write would proceed as if it had validated.
# Usage: normalize_blockers <owning-id> [candidate...]
normalize_blockers() {
  local owner=$1; shift
  local b trimmed e seen
  NORMALIZED_BLOCKERS=()
  for b in "$@"; do
    trimmed=$(printf '%s' "$b" | tr -d '[:space:]')
    [[ -z "$trimmed" ]] && continue
    [[ "$trimmed" == "$owner" ]] && die "a task cannot block on itself: $owner"
    task_file_required "$trimmed" >/dev/null
    seen=0
    for e in "${NORMALIZED_BLOCKERS[@]-}"; do [[ "$e" == "$trimmed" ]] && seen=1; done
    (( seen )) || NORMALIZED_BLOCKERS+=("$trimmed")
  done
  return 0
}

# Write a task's `blockers:` list, in BLOCK sequence style.
#
# The style is not cosmetic. yq's default for a list built with `from_json` is
# FLOW style (`blockers: ["T1", "T1.1"]`), and lib/dag-layout.awk — the DAG
# renderer's parser, and the monitor's GRAPH tab through it — is line-oriented:
# it reads `blockers:` followed by `  - id` lines and special-cases only the
# empty `[]`. A flow-style list therefore parses as NO blockers at all, so the
# task loses every DAG edge and draws as a detached root with the *eligible*
# glyph while the eligibility predicate (which reads the same file through yq)
# correctly holds it shut. Two readers, two answers, no diagnostic — the exact
# silent-wrong-answer shape the ledger exists to prevent. Every writer of
# `blockers:` goes through here so the two can never disagree again.
# Empty arguments are dropped: `"${arr[@]-}"` on an empty array expands to one
# empty string, and a blockers list holding "" would be a blocker naming no
# task — unsatisfiable forever.
# Usage: write_blockers <file> [id...]
write_blockers() {
  local file=$1; shift
  local -a ids=() b
  for b in "$@"; do [[ -n "$b" ]] && ids+=("$b"); done
  if (( ${#ids[@]} == 0 )); then
    fm_set "$file" '.blockers = []'
    return 0
  fi
  local json; json=$(printf '%s\n' "${ids[@]}" | jq -R . | jq -s -c .)
  BLOCKERS="$json" yq -i --front-matter=process \
    '.blockers = (strenv(BLOCKERS) | from_json) | .blockers style="" | .blockers[] style=""' \
    "$file"
}

cmd_title() {
  local id="" set_text="" do_set=0
  while (( $# )); do
    case $1 in
      --set) set_text=$2; do_set=1; shift 2;;
      --set=*) set_text=${1#--set=}; do_set=1; shift;;
      -*) die "unknown flag to title: $1";;
      *) [[ -z "$id" ]] && id=$1 || die "too many positional args to title"; shift;;
    esac
  done

  [[ -z "$id" ]] && die "usage: $TASKPUMP_PROG_NAME title <id> [--set \"text\"]"
  local file; file=$(task_file_required "$id")

  if (( do_set )); then
    [[ -z "$set_text" ]] && die "title --set requires non-empty text"
    acquire_state_lock
    TITLE="$set_text" yq -i --front-matter=process '.title = strenv(TITLE)' "$file"
    git_commit_state "title: set $id"
    echo "title set for $id: $set_text"
  else
    printf '%s\n' "$(fm_get "$file" '.title')"
  fi
}

# Read or rewrite a task's `blockers:` list. Mutating forms validate that every
# referenced id resolves to a real task file — a typo'd blocker is worse than no
# blocker, because `next`/`ready` silently treat it as unsatisfied forever and
# the task drops out of the frontier with no diagnostic.
cmd_blockers() {
  local id="" mode="" arg=""
  while (( $# )); do
    case $1 in
      --set) mode='set'; arg=$2; shift 2;;
      --set=*) mode='set'; arg=${1#--set=}; shift;;
      --add) mode=add; arg=$2; shift 2;;
      --add=*) mode=add; arg=${1#--add=}; shift;;
      --remove) mode=remove; arg=$2; shift 2;;
      --remove=*) mode=remove; arg=${1#--remove=}; shift;;
      --clear) mode=clear; shift;;
      -*) die "unknown flag to blockers: $1";;
      *) [[ -z "$id" ]] && id=$1 || die "too many positional args to blockers"; shift;;
    esac
  done

  [[ -z "$id" ]] && die "usage: $TASKPUMP_PROG_NAME blockers <id> [--set A,B | --add X | --remove X | --clear]"
  local file; file=$(task_file_required "$id")

  # Read form.
  if [[ -z "$mode" ]]; then
    yq --front-matter=extract '.blockers[]?' "$file" 2>/dev/null || true
    return 0
  fi

  # Take the lock BEFORE reading the current list: --add/--remove are
  # read-modify-write, and reading outside the lock lets two concurrent agents
  # compute `next` from the same stale snapshot, so the second write silently
  # drops the first's blocker. Every other mutating verb holds the lock across
  # its whole RMW; this one must too.
  acquire_state_lock

  local -a next=()
  case $mode in
    clear) next=();;
    set)
      [[ -z "$arg" ]] && die "blockers --set requires ids (use --clear to empty)"
      IFS=',' read -r -a next <<<"$arg"
      ;;
    add|remove)
      [[ -z "$arg" ]] && die "blockers --$mode requires an id"
      local cur
      while IFS= read -r cur; do
        [[ -z "$cur" ]] && continue
        [[ "$mode" == "remove" && "$cur" == "$arg" ]] && continue
        next+=("$cur")
      done < <(yq --front-matter=extract '.blockers[]?' "$file" 2>/dev/null || true)
      if [[ "$mode" == "add" ]]; then
        local seen=0 e
        for e in "${next[@]-}"; do [[ "$e" == "$arg" ]] && seen=1; done
        (( seen )) || next+=("$arg")
      fi
      ;;
  esac

  normalize_blockers "$id" "${next[@]-}"
  local -a cleaned=("${NORMALIZED_BLOCKERS[@]-}")

  # The authoring forms carry live review gates along; the subtractive ones do
  # not (see review_gate_riders).
  local riders=""
  if [[ "$mode" == "add" || "$mode" == "set" ]]; then
    review_gate_riders "$id" "${cleaned[@]-}"
    if (( ${#REVIEW_GATE_RIDERS[@]} > 0 )); then
      cleaned+=("${REVIEW_GATE_RIDERS[@]}")
      riders="${REVIEW_GATE_RIDERS[*]}"
    fi
  fi

  write_blockers "$file" "${cleaned[@]-}"
  git_commit_state "blockers: $mode $id"
  echo "blockers for $id: ${cleaned[*]-(none)}"
  [[ -n "$riders" ]] \
    && echo "review gate(s) carried along (the named blocker is under live review): $riders"
  return 0
}

# Create a new task file. Exists so that filing work never requires hand-authoring
# frontmatter — the same reason every other field mutation is a verb.
cmd_create() {
  local id="" title="" phase="" goal="" files="" blockers="" milestone=""
  while (( $# )); do
    case $1 in
      --title) title=$2; shift 2;;
      --title=*) title=${1#--title=}; shift;;
      --phase) phase=$2; shift 2;;
      --phase=*) phase=${1#--phase=}; shift;;
      --goal) goal=$2; shift 2;;
      --goal=*) goal=${1#--goal=}; shift;;
      --files) files=$2; shift 2;;
      --files=*) files=${1#--files=}; shift;;
      --blockers) blockers=$2; shift 2;;
      --blockers=*) blockers=${1#--blockers=}; shift;;
      --milestone) milestone=$2; shift 2;;
      --milestone=*) milestone=${1#--milestone=}; shift;;
      -*) die "unknown flag to create: $1";;
      *) [[ -z "$id" ]] && id=$1 || die "too many positional args to create"; shift;;
    esac
  done

  [[ -z "$id" ]] && die "usage: $TASKPUMP_PROG_NAME create <id> --title \"...\" [--phase FN] [--goal \"...\"] [--files a,b] [--blockers X,Y] [--milestone m]"
  [[ -z "$title" ]] && die "create requires --title"
  # Phase-anchored ids only — an id that does not name its phase cannot be
  # grouped, ranged, or ordered, and a parallel flat "#N" scheme alongside the
  # phase scheme has been rejected. TASKPUMP_ID_PATTERN says what shape counts.
  [[ "$id" =~ $TASKPUMP_ID_PATTERN ]] \
    || die "id must be phase-anchored, matching $TASKPUMP_ID_PATTERN (e.g. ${TASKPUMP_PHASE_SIGIL}45.23), got: $id"
  [[ -z "$phase" ]] && phase=${id%%.*}

  # Lock BEFORE the exists-check: the check and the write are one
  # read-modify-write. Two agents filing the same id concurrently would both
  # pass an unlocked check and the second `>` would truncate the first's task.
  acquire_state_lock
  [[ -n "$(task_file "$id")" ]] && die "task already exists: $id"

  local -a blist=()
  local riders=""
  if [[ -n "$blockers" ]]; then
    local -a raw=()
    IFS=',' read -r -a raw <<<"$blockers"
    normalize_blockers "$id" "${raw[@]-}"
    blist=("${NORMALIZED_BLOCKERS[@]-}")
    # A task filed AFTER a review chain exists is invisible to that chain's
    # one-shot downstream snapshot, so the gate rides along here instead.
    review_gate_riders "$id" "${blist[@]-}"
    if (( ${#REVIEW_GATE_RIDERS[@]} > 0 )); then
      blist+=("${REVIEW_GATE_RIDERS[@]}")
      riders="${REVIEW_GATE_RIDERS[*]}"
    fi
  fi

  local b
  local file="$TASKPUMP_TASKS_DIR/$id.md"
  {
    printf -- '---\n'
    printf 'id: %s\n' "$(yaml_scalar "$id")"
    printf 'phase: %s\n' "$(yaml_scalar "$phase")"
    printf 'title: %s\n' "$(yaml_scalar "$title")"
    printf 'status: open\n'
    printf 'claimed_by: null\n'
    printf 'claimed_at: null\n'
    printf 'turn_budget_remaining: null\n'
    printf 'consecutive_failed_iterations: 0\n'
    if (( ${#blist[@]} )); then
      printf 'blockers:\n'
      for b in "${blist[@]}"; do
        printf -- '  - %s\n' "$(yaml_scalar "$b")"
      done
    else
      printf 'blockers: []\n'
    fi
    printf 'completed_by_commits: []\n'
    if [[ -n "$milestone" ]]; then
      printf 'milestone: %s\n' "$(yaml_scalar "$milestone")"
    else
      printf 'milestone: null\n'
    fi
    if [[ -n "$files" ]]; then
      printf 'files:\n'
      local f
      while IFS= read -r f; do
        f=$(printf '%s' "$f" | tr -d '[:space:]')
        [[ -z "$f" ]] && continue
        printf -- '  - %s\n' "$(yaml_scalar "$f")"
      done < <(printf '%s\n' "$files" | tr ',' '\n')
    else
      printf 'files: []\n'
    fi
    printf 'last_heartbeat_head_sha: null\n'
    printf 'completed_at: null\n'
    if [[ -n "$goal" ]]; then printf 'goal: %s\n' "$(yaml_scalar "$goal")"; else printf 'goal: null\n'; fi
    printf 'last_heartbeat_ts: null\n'
    printf 'blocked_at: null\n'
    printf 'blocked_reason: null\n'
    printf 'resume_attempts: 0\n'
    printf 'resume_head_sha: null\n'
    printf -- '---\n\n'
    printf '# %s — %s\n\n' "$id" "$title"
    printf '## Spec\n\n_TODO_\n\n## Scope\n\n_TODO_\n\n## Acceptance\n\n_TODO_\n'
  } >"$file"

  git_commit_state "create $id"
  echo "created $id at $file"
  [[ -n "$riders" ]] \
    && echo "review gate(s) carried along (the named blocker is under live review): $riders"
  return 0
}

cmd_resolve() {
  # Print where this invocation would read and write task state. Worth having
  # as a real verb rather than a test hook: with one checkout per worktree,
  # "which ledger am I about to touch?" is otherwise only answerable by
  # re-deriving the resolution rules by hand.
  local what=${1:---all}
  case $what in
    --tasks-dir) printf '%s\n' "$TASKPUMP_TASKS_DIR";;
    --code-repo) printf '%s\n' "$TASKPUMP_CODE_REPO";;
    --all)
      printf 'tasks_dir  %s\n' "$TASKPUMP_TASKS_DIR"
      printf 'task_out   %s\n' "$TASKPUMP_TASK_OUT"
      printf 'code_repo  %s\n' "$TASKPUMP_CODE_REPO"
      printf 'script     %s\n' "$_tp_script_root"
      printf 'cwd_root   %s\n' "${_tp_cwd_root:-<none>}"
      printf 'via        %s\n' "$_tp_resolved_via"
      printf 'conf       %s\n' "${TP_CONFIG_FILE:-<none>}"
      ;;
    *) die "usage: $TASKPUMP_PROG_NAME resolve [--tasks-dir|--code-repo|--all]";;
  esac
}

usage() {
  printf 'usage: %s <command> [args]\n\n' "$TASKPUMP_PROG_NAME"
  cat <<'EOF'
Commands:
  next [--branch <b>] [--phase <FN>] Emit next ready task as JSON (incl. goal).
                                     --phase scopes to one epic (e.g. F51).
                                     Review tasks are skipped unless
                                       --include-reviews: an in-context agent
                                       loop must never claim the review of its
                                       own work.
  ready [--phases A..B] [--branch <b>] [--json|--count|--count-eligible]
                                     --json/default: the WHOLE eligible frontier
                                       (open + blockers done + unclaimed or own
                                       branch) as JSON / a human table.
                                     --count: ALL open tasks in range, ignoring
                                       blocker and claim state — the pump's drain
                                       test ("is any open work left?").
                                     --count-eligible: size of the --json frontier
                                       — "how many tasks can launch now?". 0 while
                                       --count > 0 signals a stall (work, none
                                       ready). --count wins if both are given.
                                     --phases accepts TN, TN..TM, and comma lists.
                                     The eligible walks (--json/default/
                                       --count-eligible) skip review tasks
                                       unless --include-reviews; --count still
                                       counts them — a pending review is open
                                       work, and a range gated on one is
                                       stalled, not drained.
  list [--status <s>] [--json]       Human-readable listing (flags missing goals).
                                     --json adds phase, claimant, blockers and
                                       the declared `files:` footprint per task.
  goal <id> [--set "text"]           Read or set a task's one-line outcome goal.
  goal --missing                     List open/in_progress tasks with no goal.
  title <id> [--set "text"]          Read or set a task's title.
  blockers <id> [--set A,B | --add X | --remove X | --clear]
                                     Read or rewrite the blockers list. Mutating
                                       forms validate that each id exists and
                                       reject self-blocking — an unresolvable
                                       blocker silently removes a task from the
                                       frontier with no diagnostic.
  create <id> --title "..." [--phase TN] [--goal "..."] [--files a,b]
         [--blockers X,Y] [--milestone m]
                                     Author a new task file. Ids must be
                                       phase-anchored, matching
                                       TASKPUMP_ID_PATTERN. Refuses to
                                       overwrite an existing task.
  claim <id> --branch <b> [--turns N]  Atomically claim a task.
  heartbeat <id> [--start|--end]     Budget + failure tracking. On review tasks
                                       --end decrements the budget only: commit
                                       productivity is not measured for a task
                                       whose deliverable is a ledger verdict,
                                       so the failure streak never moves.
  complete <id> [--commits sha,sha] [--defer-wiring "note"]
                                     Mark done; stdin → completion notes.
                                     --defer-wiring flags that the runtime wiring
                                       (first real caller) was left for a follow-up.
                                     Refused on a review task — those close by
                                       rendering their verdict.
  block <id> --reason "..."          Mark blocked with reason.
  needs-review <id> --reason "..."   Flag for human review (pump quarantine setter).
  release <id> --reason "..."        Relinquish a claim back to status=open.
  reopen <id> --reason "..."         Reopen a blocked, done, needs-review or stuck
                                       task to status=open (done → sheds completion
                                       markers: falsely-done; needs-review/stuck →
                                       clears the failure streak + scrub_reason).
                                     A task carrying a review chain re-arms it:
                                       every member back to open, review_round
                                       reset to 1 — the redone work has not been
                                       reviewed, so the gate must live again.
  review <impl-id> [--panel N] [--prompt <file>] [--max-rounds N]
                                     Synthesize a review chain in the DAG: N
                                       reviewer tasks blocked by <impl-id> (default
                                       1), an adjudicator blocked by all reviewers
                                       when N > 1, and the gate task (adjudicator,
                                       or the lone reviewer) ADDED to the blockers
                                       of every task downstream of <impl-id>.
                                       Blockers do the gating; no new predicate.
                                       That rewiring is a snapshot, so `create
                                       --blockers` and `blockers --add/--set`
                                       carry the gate along afterwards.
                                       Refuses a second chain for the same task.
                                       --prompt records a review lens (validated
                                       now, read by whatever dispatches the
                                       reviewer); --max-rounds bounds the
                                       change-request loop (default 3).
  verdict <review-id> [--branch <b>] --approve [--findings -|"..."]
          | --request-changes --findings -|"..."
                                     Render a review's outcome through existing
                                       state-machine doors. --approve completes
                                       the review task (findings to its body);
                                       a panel reviewer's approve is its report.
                                     A claimed review needs --branch matching
                                       claimed_by; an unclaimed one rules with a
                                       warning (nothing records who ruled).
                                       --request-changes (gate task only,
                                       findings required, requires the reviewed
                                       task to be done) appends the findings to
                                       the IMPLEMENTATION task's body, reopens
                                       it (completion markers shed, prior
                                       commits preserved in the note), re-arms
                                       the chain to open, and advances
                                       review_round — or, past
                                       review_max_rounds, parks the
                                       implementation needs-review with the
                                       findings intact. --findings - reads
                                       stdin.
  resume-attempt <id> --head <sha> [--max N]
                                     Pump-only: record an auto-resume of a stalled
                                       task and rule on whether it may proceed.
                                       Counter resets when <sha> differs from the
                                       last resume (the branch moved = progress),
                                       else increments. Prints "resume n/max"
                                       (rc 0) or "escalate n/max" (rc 10) once the
                                       budget is spent. Default --max 3.
  defer <id> --reason "..."          Mark production wiring deferred (status unchanged).
  undefer <id> --caller "file:line"  Clear the deferred flag: the wiring HAS landed
                                       (usually via a follow-up task). --caller must
                                       name the non-test call site as evidence.
  deferred [--json]                  List tasks with deferred wiring (collect follow-ups).
  scrub                              Supervisor: relabel stale claims. Also
                                       reports task files invisible to the
                                       frontier — UNPARSEABLE frontmatter, or
                                       NO-ID — which have no other diagnostic.
                                       Exit 3 if any are found (1 = scrub
                                       itself failed).
  fsck [--fix]                       Whole-ledger conformance check against
                                       docs/LEDGER-CONTRACT.md — the import
                                       path for a pre-existing markdown task
                                       DAG. Checks: frontmatter parses between
                                       --- delimiters, id matches the filename
                                       and TASKPUMP_ID_PATTERN, status is in
                                       the vocabulary, machine keys have
                                       contract-legal types, every blocker
                                       resolves, no self-blocks, no blocker
                                       cycles, review_of resolves (never to
                                       the task itself), review_role is
                                       reviewer|adjudicator. One line per
                                       violation
                                       (<file>: <what>); exit 3 when any
                                       exist, 0 clean, 1 = fsck itself failed.
                                       --fix stamps MISSING machine keys with
                                       their documented defaults as one ledger
                                       commit; a present-but-wrong value is
                                       reported, never rewritten.
  resolve [--tasks-dir|--code-repo|--all]
                                     Print which workspace's ledger this
                                       invocation resolves to. Use it when a
                                       worktree's task state looks wrong.

Config (env or taskpump.conf; the legacy ARACHNE_* spelling of each still works):
  Locations
    TASKPUMP_LEDGER_PROBE   ledger path relative to a workspace root, and the
                              default tasks dir  (default: tasks)
    TASKPUMP_TASKS_DIR      tasks dir            (default: <root>/<probe>)
    TASKPUMP_TASK_OUT       next-task JSON path  (default: <parent>/.next-task)
    TASKPUMP_CODE_REPO      code repo root — what heartbeat measures commits in
                                                 (default: <root>)
  Git
    TASKPUMP_TASK_PUSH=1    push after each state-mutating commit. A ledger with
                              no remote warns once and succeeds; a push that
                              fails against a real remote is retried.
    TASKPUMP_PUSH_RETRIES   push attempts before giving up          (default: 6)
    TASKPUMP_COMMITTER_NAME / TASKPUMP_COMMITTER_EMAIL
                            identity on ledger commits (default: tp-task /
                              task@taskpump.local)
  Id grammar
    TASKPUMP_ID_PATTERN     regex `create` validates a new id against
                                            (default: ^T[0-9]+(\.[0-9]+)?$)
    TASKPUMP_PHASE_SIGIL    alphabetic prefix on a phase token; phase ranges
                              strip and re-apply it                 (default: T)
  Tripwires and concurrency
    TASKPUMP_TURN_BUDGET_DEFAULT  `claim` budget when --turns is omitted    (50)
    TASKPUMP_FAILURE_LIMIT  consecutive unproductive iterations before scrub
                              marks a task stuck                    (default: 3)
    TASKPUMP_CLAIM_STALE_HOURS   heartbeat staleness threshold     (default: 24)
    TASKPUMP_LOCK_WAIT      seconds to wait for the state lock    (default: 120)
    TASKPUMP_LOCK_NAME      the state lockfile's name, created in the ledger's
                              git root         (default: .taskpump-task.lock)
  Misc
    TASKPUMP_TASK_NOCOMMIT=1  skip commits and the state lock (fixture mode)
    TASKPUMP_TASK_DEBUG=1     print debug traces
    TASKPUMP_PROG_NAME        name used in this tool's own diagnostics

The id grammar contract: an id is PHASE or PHASE.N, and the phase is everything
before the first `.`. TASKPUMP_ID_PATTERN validates a new id; the phase split
plus TASKPUMP_PHASE_SIGIL derive the phase from it. Phase grouping (--phase),
range expansion (--phases T55..T63) and ordering are all built on that split, so
the dot is part of the contract even though the sigil and the pattern are yours.

The workspace is the directory of a DISCOVERED taskpump.conf when the ledger
probe resolves there, else $PWD's git worktree when that worktree carries a
ledger of its own (TASKPUMP_LEDGER_PROBE resolves there), otherwise the
directory above this script. Since each worktree carries both its own copy of
this CLI and its own ledger, preferring the caller's workspace keeps a claim
made inside a worktree out of the primary checkout's ledger. A vendored
TaskPump checkout inside a consumer never captures resolution: its own conf is
skipped by discovery, and from inside a vendored submodule the workspace is the
consumer's (docs/CONFIG.md, "Vendored TaskPump checkouts"). Relative paths in a
conf anchor to the conf's workspace, never to $PWD. The config above still
overrides; `resolve` prints what a given invocation picked.
EOF
}

# ── The install-root fallback is not an answer ────────────────────────────────
# When no explicit tasks dir, no discovered conf and no cwd git toplevel answers
# the ledger probe, resolution falls back to the INSTALLATION's own root. That
# fallback exists for the vendored layout, where each worktree carries both its
# own copy of this CLI and its own ledger — there the install root IS the
# workspace and the fallback is simply correct.
#
# Everywhere else it is a silent wrong answer, and it has already produced one:
# `tp task create` run in a fresh repository that had no tasks/ directory wrote
# the task into the TaskPump checkout's own ledger, with a git commit, and was
# caught only because that ledger happened to be under watch (2026-08-12). The
# repository the operator was standing in never learned about it and TaskPump's
# did — the worst shape a wrong answer can take, because both sides look fine.
#
# So: a command that MUTATES the ledger refuses when resolution reached the
# fallback AND the install root is outside the caller's worktree. Read-only
# commands keep working, deliberately — `resolve` is the diagnostic this error
# points at, and an error that disables the tool you need to diagnose it is a
# worse error.
tp_require_resolved_ledger() {
  [[ "$_tp_tasks_dir_explicit" -eq 1 ]] && return 0
  [[ "$_tp_resolved_via" != "install-root" ]] && return 0
  # The vendored layout: the install root is the caller's worktree, or sits
  # inside it. The fallback is the right answer there, and stays silent.
  if [[ -n "$_tp_cwd_root" ]]; then
    [[ "$_tp_script_root" == "$_tp_cwd_root" || "$_tp_script_root" == "$_tp_cwd_root"/* ]] && return 0
  fi
  die "refusing to touch a ledger this repository never asked for.

  probed for '$TASKPUMP_LEDGER_PROBE/' in:
    $(if [[ -n "$_tp_conf_root" ]]; then echo "$_tp_conf_root  (the taskpump.conf found above \$PWD)"; else echo "(no taskpump.conf discovered above \$PWD)"; fi)
    $(if [[ -n "$_tp_cwd_root" ]]; then echo "$_tp_cwd_root  (this repository)"; else echo "(\$PWD is not inside a git repository)"; fi)

  nothing answered, so resolution fell back to the TaskPump installation itself:
    $TASKPUMP_TASKS_DIR
  which is outside this repository. Writing there would put your task in
  TaskPump's own ledger, silently.

  fix it with either:
    mkdir $TASKPUMP_LEDGER_PROBE                   # give this repository a ledger
    TASKPUMP_TASKS_DIR=/path/to/tasks $TASKPUMP_PROG_NAME ...   # or point at an existing one

  \`$TASKPUMP_PROG_NAME resolve --tasks-dir\` keeps working and prints where resolution lands."
}

# ── A missing tasks directory is loud, never an empty frontier ────────────────
# "The ledger is not there" and "the ledger is there and has no eligible work"
# used to produce the same output: an empty listing, rc=0. The first one is how
# a misresolved path (a $PWD-relative conf value, issue #1) became a pump that
# reported a live range drained. A directory that does not exist is always
# misconfiguration or misresolution, so every ledger-reading verb refuses it
# with the diagnostic to run — except `resolve` itself, which is that
# diagnostic and must keep answering.
tp_require_tasks_dir() {
  [[ -d "$TASKPUMP_TASKS_DIR" ]] && return 0
  die "tasks directory does not exist: $TASKPUMP_TASKS_DIR
  (resolved via $_tp_resolved_via). An empty frontier from a missing ledger
  would be a silent wrong answer, so this is an error instead.
  \`$TASKPUMP_PROG_NAME resolve --all\` prints how this invocation resolved."
}

main() {
  local cmd=${1:-}
  [[ -z "$cmd" ]] && { usage; exit 1; }
  shift
  # Every command that writes to the ledger, which is a superset of the ones
  # that take the state lock below (create/goal/title/blockers mutate files
  # without needing cross-agent exclusion). fsck is here even though its report
  # mode only reads: its output is a verdict about a ledger, and a verdict
  # about the install-root fallback's ledger is a wrong answer about the
  # caller's — `resolve` stays available to diagnose.
  case $cmd in
    create|claim|heartbeat|complete|block|needs-review|release|reopen|review|verdict|defer|undefer|resume-attempt|scrub|goal|title|blockers|fsck)
      tp_require_resolved_ledger;;
  esac
  # Every verb that reads or writes the ledger needs the directory to exist;
  # `resolve` is the diagnostic the refusal points at and keeps working.
  case $cmd in
    next|ready|list|goal|title|blockers|create|claim|heartbeat|complete|block|needs-review|release|reopen|review|verdict|defer|undefer|deferred|resume-attempt|scrub)
      tp_require_tasks_dir;;
  esac
  # Mutating subcommands serialize on the cross-agent state lock for their
  # whole read-modify-write + commit. Read-only commands (next/list) skip it.
  case $cmd in
    claim|heartbeat|complete|block|needs-review|release|reopen|review|verdict|defer|undefer|resume-attempt|scrub) acquire_state_lock;;
  esac
  case $cmd in
    next) cmd_next "$@";;
    ready) cmd_ready "$@";;
    list) cmd_list "$@";;
    goal) cmd_goal "$@";;
    title) cmd_title "$@";;
    blockers) cmd_blockers "$@";;
    create) cmd_create "$@";;
    claim) cmd_claim "$@";;
    heartbeat) cmd_heartbeat "$@";;
    complete) cmd_complete "$@";;
    block) cmd_block "$@";;
    needs-review) cmd_needs_review "$@";;
    release) cmd_release "$@";;
    reopen) cmd_reopen "$@";;
    review) cmd_review "$@";;
    verdict) cmd_verdict "$@";;
    defer) cmd_defer "$@";;
    undefer) cmd_undefer "$@";;
    deferred) cmd_deferred "$@";;
    resume-attempt) cmd_resume_attempt "$@";;
    scrub) cmd_scrub "$@";;
    fsck) cmd_fsck "$@";;
    resolve) cmd_resolve "$@";;
    -h|--help|help) usage;;
    *) die "unknown command: $cmd";;
  esac
}

main "$@"
