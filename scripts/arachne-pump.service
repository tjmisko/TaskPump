# arachne-pump.service — systemd --user unit for a multi-day usage-governed run.
#
# This is the PERSISTENT-unit path for E3 (restart-on-failure). For a quick
# throwaway run, `arachne-pump --detach` uses a transient `systemd-run --user`
# unit instead and needs none of this.
#
# Install (edit the phases/flags first, and the repo path if it isn't
# ~/Projects/Arachne):
#
#   mkdir -p ~/.config/systemd/user
#   cp scripts/arachne-pump.service ~/.config/systemd/user/arachne-pump.service
#   $EDITOR ~/.config/systemd/user/arachne-pump.service   # set ARACHNE_PUMP_PHASES
#   systemctl --user daemon-reload
#   systemctl --user start arachne-pump          # (or: enable --now to survive logout w/ linger)
#   journalctl --user -u arachne-pump -f         # watch
#   systemctl --user stop arachne-pump           # stop FEEDING (running agents keep going)
#
# To survive a full logout, enable linger once: `loginctl enable-linger "$USER"`.

[Unit]
Description=Arachne usage-governed DAG pump
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ── Edit these ───────────────────────────────────────────────────────────────
Environment=ARACHNE_REPO=%h/Projects/Arachne
Environment=ARACHNE_PUMP_PHASES=F55..F63
Environment=ARACHNE_PUMP_JOBS=4
Environment=ARACHNE_PUMP_CEILING=95
# ─────────────────────────────────────────────────────────────────────────────
WorkingDirectory=%h/Projects/Arachne
ExecStart=/usr/bin/env bash -lc '"$ARACHNE_REPO/scripts/arachne-pump" --phases "$ARACHNE_PUMP_PHASES" --jobs "$ARACHNE_PUMP_JOBS" --usage-ceiling "$ARACHNE_PUMP_CEILING"'
# A drained pump exits 0 (success) and should NOT be restarted; only restart on
# an actual crash. The pump never kills running agents, so a restart re-derives
# in-flight work from task files + docker ps (design D3/E2) without disruption.
Restart=on-failure
RestartSec=30
# Stopping the unit stops FEEDING; detached agent containers keep running.
KillSignal=SIGINT

[Install]
WantedBy=default.target
