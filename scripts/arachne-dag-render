#!/bin/bash
# arachne-dag-render -- render the task DAG for a phase range as a layered ASCII
# graph, for the arachne-monitor GRAPH tab.
#
# Nodes are boxes, one row of boxes per dependency layer, edges routed through
# horizontal rail bands between layers. Reads task frontmatter directly (the
# whole graph in one gawk pass) rather than shelling out to yq per task, so it
# is cheap enough to sit behind the monitor's normal cache TTL.
#
# Layout passes (v2 -- see scripts/DESIGN-monitor-dag-v2.md):
#   layer()     longest-path layering over `blockers:`
#   dummies()   one trunk of dummy nodes per target with far blockers, so a
#               multi-layer edge is actually drawn instead of silently dropped
#   order()     median sweeps with a real crossing count, best permutation kept,
#               then adjacent-swap transposition
#   xassign()   priority-method x coordinates -- dummies outrank real nodes so
#               long edges stay straight columns; unrelated neighbours in a
#               layer get a wider gutter than siblings
#   channels()  greedy interval routing -- parents whose edge spans do not
#               overlap horizontally share one rail row, so a wide fan-out band
#               stays a few rows tall instead of one row per parent
#
# Usage:
#   ./scripts/arachne-dag-render                     # phases from .arachne-pump.state
#   ./scripts/arachne-dag-render --phases F79
#   ./scripts/arachne-dag-render --phases F55..F63
#   ./scripts/arachne-dag-render --running F79.4     # mark these as live (▶)
#   ./scripts/arachne-dag-render --cursor F79.5      # heavy border on one node
#   ./scripts/arachne-dag-render --index-file /tmp/i # TSV node table for the monitor
#   ./scripts/arachne-dag-render --cols 200          # clip output to a viewport
#   ./scripts/arachne-dag-render --no-color          # for tests
#   ./scripts/arachne-dag-render --claims            # no picture: one row per
#       branch holding an in_progress claim, naming the single task an agent is
#       actually on (branch/task/turns/goal, tab separated). Shares this file's
#       parser and election with the canvas, so the monitor's two tabs cannot
#       disagree about which claim is live.
set -euo pipefail

REPO_ROOT="${ARACHNE_DAG_REPO_ROOT:-$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)}"
TASKS_DIR="${ARACHNE_TASKS_DIR:-$REPO_ROOT/ops/task-loop/tasks}"
PUMP_STATE="${ARACHNE_PUMP_STATE_FILE:-$REPO_ROOT/.arachne-pump.state}"

PHASES=""; RUNNING=""; LIVEBRANCHES=""; COLOR=1; COMPACT=-1; PANX=0
CURSOR=""; INDEXFILE=""; COLS=0; MODE=""

print_help() { awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --phases)    PHASES="${2:-}"; shift ;;
        --phases=*)  PHASES="${1#--phases=}" ;;
        --running)   RUNNING="${2:-}"; shift ;;
        --running=*) RUNNING="${1#--running=}" ;;
        --live-branches)   LIVEBRANCHES="${2:-}"; shift ;;
        --live-branches=*) LIVEBRANCHES="${1#--live-branches=}" ;;
        --pan)       PANX="${2:-0}"; shift ;;
        --pan=*)     PANX="${1#--pan=}" ;;
        --cols)      COLS="${2:-0}"; shift ;;
        --cols=*)    COLS="${1#--cols=}" ;;
        --cursor)    CURSOR="${2:-}"; shift ;;
        --cursor=*)  CURSOR="${1#--cursor=}" ;;
        --index-file)   INDEXFILE="${2:-}"; shift ;;
        --index-file=*) INDEXFILE="${1#--index-file=}" ;;
        --claims)    MODE=claims ;;
        --no-color)  COLOR=0 ;;
        --compact)   COMPACT=1 ;;
        --full-ids)  COMPACT=0 ;;
        -h|--help)   print_help; exit 0 ;;
        *)           echo "ERROR: unknown arg '$1'" >&2; exit 1 ;;
    esac
    shift
done

# Phase range: explicit flag > the live pump's range > every phase present.
if [[ -z "$PHASES" && -f "$PUMP_STATE" ]]; then
    PHASES="$(jq -r '.phases // ""' "$PUMP_STATE" 2>/dev/null || echo '')"
fi

[[ -d "$TASKS_DIR" ]] || { echo "(no tasks dir: $TASKS_DIR)"; exit 0; }

shopt -s nullglob
files=("$TASKS_DIR"/*.md)
(( ${#files[@]} )) || { echo "(no tasks found)"; exit 0; }

gawk -v phases="$PHASES" -v running="$RUNNING" -v livebranches="$LIVEBRANCHES" \
     -v color="$COLOR" -v compact="$COMPACT" -v panx="$PANX" \
     -v cursor="$CURSOR" -v indexfile="$INDEXFILE" -v cols="$COLS" -v mode="$MODE" \
     -f "$(dirname "$0")/arachne-dag-layout.awk" "${files[@]}"
