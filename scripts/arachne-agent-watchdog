#!/bin/bash
# arachne-agent-watchdog -- run arachne-cleanup --stuck on an interval, so
# log-stale agents get killed and their tasks released for the next pass.
#
# Background: an agent container can wedge silently — Claude waiting on a
# bash tool call that never returns (cargo lock held by a corpse process,
# disk-full ENOSPC, etc.). Without intervention the container sits forever,
# its task stays claimed, and no other agent can pick it up. This watchdog
# is the running-system counterpart to arachne-cleanup --stuck.
#
# Usage:
#   ./scripts/arachne-agent-watchdog                    # watch + auto-cleanup
#   ./scripts/arachne-agent-watchdog --dry-run          # detect + log, don't act
#   ./scripts/arachne-agent-watchdog --once             # one check, exit
#   STUCK_THRESHOLD_MIN=20 ./scripts/arachne-agent-watchdog
#
# Env (forwarded to arachne-cleanup):
#   POLL                  -- seconds between sweeps (default 120)
#   STUCK_THRESHOLD_MIN   -- log-stale cutoff in minutes (default 15)
#
# Heuristic note: long cargo builds are slow but they DO write to the log
# (each `cargo check` step emits a "tool_use" event in the JSON stream).
# Truly stuck = no log writes for STUCK_THRESHOLD_MIN minutes; a 14-minute
# cargo run is not flagged.
set -uo pipefail

REPO_ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
POLL="${POLL:-120}"
export STUCK_THRESHOLD_MIN="${STUCK_THRESHOLD_MIN:-15}"

DRY_RUN=0; ONCE=0
EXTRA_ARGS=()
for a in "$@"; do
    case "$a" in
        --dry-run) DRY_RUN=1; EXTRA_ARGS+=(--dry-run) ;;
        --once)    ONCE=1 ;;
        -h|--help) sed -n '2,24p' "$0"; exit 0 ;;
        *) echo "ERROR: unknown arg '$a'" >&2; exit 2 ;;
    esac
done

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

react() {
    "$REPO_ROOT/scripts/arachne-cleanup" --stuck "${EXTRA_ARGS[@]}" 2>&1 | sed 's/^/  cleanup: /'
}

mode="watch"; [[ "$ONCE" -eq 1 ]] && mode="once"; [[ "$DRY_RUN" -eq 1 ]] && mode="$mode/dry-run"
log "arachne-agent-watchdog starting ($mode): poll=${POLL}s stuck_threshold=${STUCK_THRESHOLD_MIN}min"

if [[ "$ONCE" -eq 1 ]]; then
    react
    exit 0
fi

trap 'log "stopping."; exit 0' INT TERM
while true; do
    react
    sleep "$POLL"
done
