#!/bin/bash
# arachne-monitor -- at-a-glance status of parallel Arachne agents (btop-ish).
#
# Maps each running/recent arachne-agent container to its worktree, epic task
# status (from the canonical ops/ task files), uptime, and last log lines.
#
# Layout (top is FIXED, sessions SCROLL):
#   ┌ title + rule
#   │ pump summary (range · status · ready/open)            Notes (right column)
#   │ usage bars (5h/7d) · Disk bar — padded above/below    ─ stacks under if narrow
#   │ disk subinfo as a vertical list (worktrees / main / docker / updated)
#   ├ rule
#   │ ● session …   (scrollable viewport; 2 feed lines each)
#   └ status bar (scroll position only; keys are in --help)
#
# All expensive data (the eligible-task scan, the docker session table, disk
# sizing) is refreshed in BACKGROUND workers on their own TTLs and read from
# caches, so a paint is cheap (tens of ms) and the first frame is instant —
# cold caches show "…" placeholders that fill in within a couple seconds.
#
# In --watch the terminal autowrap is disabled (like btop/htop) so long lines
# clip at the edge instead of wrapping, and the frame is clipped to the terminal
# height, so the top never scrolls away.
#
# Notes: a free-text scratchpad scoped to the current pump run (keyed by the
# pump's phase-range + start time, so a new run starts fresh). Persisted in
# .arachne-monitor-notes/<run>.md (gitignored).
#
# Refresh cadence: --watch defaults to 1s. Set ARACHNE_MONITOR_INTERVAL to change
# it once in your shell/config; a positional --watch <N> still wins. Fractional
# seconds are accepted, e.g. --watch 0.5.
#
# Usage:
#   ./scripts/arachne-monitor             # one paint
#   ./scripts/arachne-monitor --watch     # refresh every 1s (cached, scrollable)
#   ./scripts/arachne-monitor --watch 5   # refresh every 5s
#   ARACHNE_MONITOR_INTERVAL=3 ./scripts/arachne-monitor --watch   # every 3s (env)
#   ./scripts/arachne-monitor --watch --log /tmp/mon.log   # log each redraw's timing
#   ./scripts/arachne-monitor --no-disk   # hide the disk gauge
#   ./scripts/arachne-monitor --demo      # synthetic sessions; no docker needed
#   ./scripts/arachne-monitor --tab graph --cursor F79.5 --moves jj   # scripted focus
#   ./scripts/arachne-monitor --decode-keys 5   # print the token each keypress
#                                               # decodes to (q stops early);
#                                               # run this when a key does
#                                               # nothing in a new terminal
#
# Both tabs navigate a SELECTION with vim motions; the viewport follows it.
#
# Watch-mode keys, SESSIONS tab (the cursor selects one agent session):
#                   k/j ↑ ↓ previous/next session
#                   gg/G · Home/End  first/last session
#                   Enter    open that session's current task file
#                   ← → switch tab · PgUp/PgDn (Ctrl-u/d) page the viewport
# Watch-mode keys, GRAPH tab (the cursor selects one task node):
#                   h/l ← → previous/next node in the layer
#                   k/j ↑ ↓ nearest node one layer up/down, preferring a
#                            connected one (a blocker, or a dependent)
#                   gg/G     first/last layer   (vertical: the DAG's depth)
#                   ^/_/0/Home · $/End  first/last node in the LAYER
#                            (horizontal: a layer is the graph's "line")
#                   .        recentre on the running task
#                   o / Enter open the selected task's file in a new editor
#                            window (wezterm + $EDITOR; falls back to taking
#                            over this terminal when there is no display)
#                   PgUp/PgDn page the viewport without moving the cursor
# Both tabs:        Tab / Shift-Tab switch tab · n add a note
#                   e / Ctrl-G edit notes in nvim · q quit
#
# Env: ARACHNE_MONITOR_OPEN_CMD  replace the `o` spawn entirely (path appended)
#      ARACHNE_MONITOR_TERM      GUI terminal to spawn (default wezterm)
#      ARACHNE_MONITOR_TASK_CLASS  window class for it (default arachne-task),
#                                  so a Hyprland windowrule can float/place it
set -euo pipefail

# REPO_ROOT is the checkout whose .worktrees/ hold the agent workspaces — i.e.
# the PRIMARY checkout. The override lets a worktree copy of this script report
# on the primary's sessions instead of looking for a nested .worktrees/.
REPO_ROOT="${ARACHNE_MONITOR_REPO_ROOT:-$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)}"
MANIFEST="${MANIFEST:-$REPO_ROOT/ops/task-loop/parallel-manifest.tsv}"
# Honours ARACHNE_TASKS_DIR for the same reason arachne-dag-render does: the two
# must read the SAME ledger, or the GRAPH tab draws one set of tasks while `o`
# opens files from another.
TASKS_DIR="${ARACHNE_TASKS_DIR:-$REPO_ROOT/ops/task-loop/tasks}"

print_help() {
    # Print the leading comment block (minus the shebang), stripping "# ".
    awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"
}

# Refresh interval precedence: positional --watch <N> (set in the arg loop below)
#   >  ARACHNE_MONITOR_INTERVAL  >  built-in default (1s). Fractional ok.
WATCH=0; INTERVAL="${ARACHNE_MONITOR_INTERVAL:-1}"; DEMO=0
MONITOR_LOG="${ARACHNE_MONITOR_LOG:-}"        # redraw-instrumentation log (off if empty)
SHOW_DISK="${ARACHNE_MONITOR_DISK:-1}"        # disk gauge on by default; --no-disk / =0 off
# Tabs: 0 = SESSIONS (gauges + live sessions), 1 = GRAPH (layered task DAG).
# On the GRAPH tab a cursor selects one task node; the viewport follows it.
TAB=0; PAN=0; CURSOR=""; MOVES=""; GRAPH_TOPH=7
DECODE_KEYS=""                                # --decode-keys N: key-decoder probe
# Resolved next to this script, NOT under REPO_ROOT: the two differ whenever
# ARACHNE_MONITOR_REPO_ROOT points a worktree copy at the primary checkout.
DAG_BIN="${ARACHNE_DAG_BIN:-$(CDPATH= cd -- "$(dirname "$0")" && pwd)/arachne-dag-render}"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --watch)        WATCH=1 ;;
        --demo)         DEMO=1 ;;          # render synthetic sessions; no docker needed
        --no-disk)      SHOW_DISK=0 ;;
        --tab)          case "${2:-}" in graph|dag) TAB=1 ;; sessions) TAB=0 ;;
                            *) echo "ERROR: --tab wants sessions|graph" >&2; exit 1 ;;
                        esac; shift ;;
        --cursor)       CURSOR="${2:-}"; shift ;;
        --cursor=*)     CURSOR="${1#--cursor=}" ;;
        --moves)        MOVES="${2:-}"; shift ;;
        --moves=*)      MOVES="${1#--moves=}" ;;
        --tab=*)        case "${1#--tab=}" in graph|dag) TAB=1 ;; sessions) TAB=0 ;;
                            *) echo "ERROR: --tab wants sessions|graph" >&2; exit 1 ;;
                        esac ;;
        --log)          MONITOR_LOG="${2:-}"; shift ;;
        --log=*)        MONITOR_LOG="${1#--log=}" ;;
        --decode-keys)  DECODE_KEYS="${2:-}"; shift ;;
        --decode-keys=*) DECODE_KEYS="${1#--decode-keys=}" ;;
        [0-9]*)         INTERVAL="$1" ;;
        -h|--help)      print_help; exit 0 ;;
        *)              echo "ERROR: unknown arg '$1'" >&2; exit 1 ;;
    esac
    shift
done
# Validated here rather than at use: the count drives an arithmetic for-loop, so
# garbage would surface as a bash arithmetic error instead of a usage message.
if [[ -n "$DECODE_KEYS" && ! "$DECODE_KEYS" =~ ^[0-9]+$ ]]; then
    echo "ERROR: --decode-keys wants a count" >&2; exit 1
fi

# branch-slug -> "name<TAB>epic_task" lookup from the manifest.
declare -A SLUG_NAME SLUG_TASK SLUG_BRANCH
if [[ -f "$MANIFEST" ]]; then
    while IFS=$'\t' read -r name branch brief task _rest; do
        [[ -z "${name// }" || "${name:0:1}" == "#" ]] && continue
        slug="${branch//\//-}"
        SLUG_NAME["$slug"]="$name"; SLUG_TASK["$slug"]="$task"; SLUG_BRANCH["$slug"]="$branch"
    done < "$MANIFEST"
fi

task_status() {  # $1 = task id -> status string or "-"
    local f="$TASKS_DIR/$1.md"
    [[ -f "$f" ]] || { echo "-"; return; }
    yq --front-matter=extract '.status' "$f" 2>/dev/null || echo "?"
}

# ── Colour system ────────────────────────────────────────────────────────────
# Four families, and no colour outside them. A new surface picks its family by
# asking what the colour is ABOUT. Full spec + contrast table:
# scripts/DESIGN-monitor-colour.md.
#
# Three rules hold the whole thing together:
#
#   R1  Every sequence re-opens with 0;. SGR attributes are STICKY — a bare
#       "\033[38;5;173m" sets only the foreground, so a 1 or 2 set earlier stays
#       on. This has produced two live bugs already: one dimmed `done` box
#       washing the whole DAG grey, and BAR_CAP's dim leaking into every gauge
#       fill on screen (both were invisible until someone read the raw bytes).
#   R2  State is never carried by colour alone — a glyph or word always carries
#       it too. Invariant I5 in DESIGN-monitor-dag-v2.md. This is what makes the
#       palette safe to retune and survivable on --no-color.
#   R3  No basic-ANSI colour numbers (30-37, 90-97) and no reverse video. They
#       resolve through the terminal's theme, so they cannot be reasoned about:
#       under Catppuccin Mocha `32m` is #a6e3a1, a bright pastel that could not
#       sit beside the graph's #5FAF5F, and that mismatch is exactly what this
#       system was written to delete. Enforced by a test.
#
# STATE — where a task or agent is in its life. The only family allowed green,
# amber or red. Green is the progress axis and has exactly TWO steps, settled
# and live; there is deliberately no third green anywhere in the monitor.
# Keep in sync with hue() in scripts/arachne-dag-layout.awk — one vocabulary in
# two languages, and changing either alone is a bug.
ST_DONE=$'\033[0;2;38;5;65m'      # ✓ done      — settled, behind you
ST_LIVE=$'\033[0;38;5;71m'        # ▶ running   — an agent is on it right now
ST_PARK=$'\033[0;38;5;179m'       # ⧗ parked    — attention, not yet a problem
ST_BLOCK=$'\033[0;38;5;131m'      # ⊘ blocked   — cannot proceed
ST_ALERT=$'\033[0;1;38;5;203m'    # ! review    — act now
ST_READY=$'\033[0;38;5;250m'      # ○ ready     — eligible, not started
ST_WAIT=$'\033[0;2;38;5;244m'     # ◌ waiting   — ineligible, not started
ST_RST=$'\033[0m'

# CHROME — structure and text carrying no state. Greys only, never a hue.
# STATE's two neutral tiers are greys too; the overlap is intended, since grey
# here means "no colour information". They are told apart by attachment — a
# state grey always sits on a glyph, a chrome grey never does.
C_STRONG=$'\033[0;1;38;5;252m'    # titles, selected row, input prompt
C_TEXT=$'\033[0;38;5;252m'        # the datum you actually read
C_MUTED=$'\033[0;38;5;245m'       # labels, units, hints, log tails — text floor
C_RULE=$'\033[0;38;5;242m'        # rules, gauge troughs, inactive tab
C_FAINT=$'\033[0;2;38;5;244m'     # empty states and placeholders only

colorize() {  # colorize a status word
    case "$1" in
        running|in_progress) printf '%s%s%s' "$ST_LIVE"  "$1" "$ST_RST" ;;
        done)                printf '%s%s%s' "$ST_DONE"  "$1" "$ST_RST" ;;
        blocked)             printf '%s%s%s' "$ST_BLOCK" "$1" "$ST_RST" ;;
        needs-review|stuck)  printf '%s%s%s' "$ST_ALERT" "$1" "$ST_RST" ;;
        open)                printf '%s%s%s' "$ST_READY" "$1" "$ST_RST" ;;
        exited)              printf '%s%s%s' "$ST_WAIT"  "$1" "$ST_RST" ;;
        *)                   printf '%s' "$1" ;;
    esac
}

# vis_len -- visible (printable) length of a string, ignoring CSI colour escapes.
# Pure bash (no subprocess) so it is cheap to call per row while composing.
vis_len() {  # $1 = string -> char count of the ANSI-stripped text
    local s="$1" out=""
    while [[ "$s" == *$'\033['* ]]; do
        out+="${s%%$'\033['*}"   # text before the escape
        s="${s#*$'\033['}"       # drop through "ESC["
        s="${s#*m}"              # drop the params up to and including the final 'm'
    done
    out+="$s"
    printf '%s' "${#out}"
}

# ── Bars ──────────────────────────────────────────────────────────────────────
# RESOURCE family: how much headroom is left. A gauge is not a task state, so it
# keeps its own resting hue — Claude terracotta, matching ~/.claude/claude-status
# — but its ESCALATION reuses STATE's amber and coral verbatim, so amber means
# "attention" and coral means "act now" everywhere on the screen, whether the
# subject is a task or a disk.
#
# All five re-opened with 0; on 2026-08-05 (R1). Before that BAR_CAP set dim and
# nothing cleared it, so every gauge fill and trough in the UI was rendering at
# half brightness — the terracotta measured ~2.9:1 against the background
# instead of ~5.9:1. Nothing looked obviously broken, which is how it survived.
BAR_CELLS=20
BAR_CAP=$'\033[0;38;5;242m'       # ▐ ▌ end-caps — chrome, not brand
BAR_FILL=$'\033[0;38;5;173m'      # Claude terracotta fill (#D7875F)
BAR_TROUGH=$'\033[0;38;5;242m'    # ░ unfilled cells — sit UNDER the fill
BAR_EMPTY="$C_MUTED"              # gauge labels + the surrounding metadata
BAR_WARN=$'\033[0;38;5;179m'      # warning band — STATE's ⧗ amber, deliberately
BAR_CRIT=$'\033[0;1;38;5;203m'    # critical band — STATE's ! coral, deliberately
BAR_RST=$'\033[0m'

# Gauge rows (5h / 7d / Disk) share one indent + a left-justified label column so
# the bars and trailing text line up. GAUGE_SUBINDENT lands under the bar.
GAUGE_INDENT='  '
GAUGE_LABEL_W=4                # widest label ("Disk"); 5h/7d are padded to match
printf -v GAUGE_SUBINDENT '%*s' "$(( ${#GAUGE_INDENT} + GAUGE_LABEL_W + 1 ))" ''

# bar_glyphs -- echo just the 20-cell ▐█░▌ bar for a percent. $2 overrides the
# fill colour; without it the fill is terracotta, turning red at/over 95%.
bar_glyphs() {
    local p="$1" fill="${2:-}"
    [[ "$p" =~ ^[0-9]+$ ]] || { printf '%s(n/a)%s' "$C_FAINT" "$ST_RST"; return 0; }
    (( p > 100 )) && p=100
    local filled=$(( p * BAR_CELLS / 100 )); (( filled > BAR_CELLS )) && filled=$BAR_CELLS
    local empty=$(( BAR_CELLS - filled )) i bar="" gap=""
    for (( i=0; i<filled; i++ )); do bar+="█"; done
    for (( i=0; i<empty;  i++ )); do gap+="░"; done
    [[ -z "$fill" ]] && { fill="$BAR_FILL"; (( p >= 95 )) && fill="$BAR_CRIT"; }
    printf '%s▐%s%s%s%s%s▌%s' "$BAR_CAP" "$fill" "$bar" "$BAR_TROUGH" "$gap" "$BAR_CAP" "$BAR_RST"
}

# render_bar -- one usage bar line. Args: label percent reset_at [date_fmt].
render_bar() {
    local label="$1" pct="$2" reset_at="${3:-}" date_fmt="${4:-+%H:%M}"
    if ! [[ "$pct" =~ ^[0-9]+$ ]]; then
        printf '%s%s%-*s%s %s(window unavailable)%s\n' \
            "$GAUGE_INDENT" "$C_MUTED" "$GAUGE_LABEL_W" "$label" "$ST_RST" "$C_FAINT" "$ST_RST"
        return 0
    fi
    local p="$pct"; (( p > 100 )) && p=100
    local reset_str=""
    if [[ -n "$reset_at" && "$reset_at" != "null" && "$reset_at" != "-" ]]; then
        reset_str="$(date -d "$reset_at" "$date_fmt" 2>/dev/null || true)"
    fi
    # Label is chrome, the percentage is the datum — the same split the Disk row
    # makes between free space and capacity.
    printf '%s%s%-*s%s %s %s%3d%%%s' "$GAUGE_INDENT" "$C_MUTED" "$GAUGE_LABEL_W" "$label" "$ST_RST" \
        "$(bar_glyphs "$p")" "$C_TEXT" "$p" "$ST_RST"
    [[ -n "$reset_str" ]] && printf '  %sresets %s%s' "$C_MUTED" "$reset_str" "$ST_RST"
    printf '\n'
    return 0
}

# usage_bars -- render both window bars from an arachne-usage --json blob. Pass
# the blob as $1 to reuse an already-fetched payload; omit to fetch fresh. Prints
# nothing when the meter is unreachable (no windows). Never errors the caller.
usage_bars() {
    [[ -x "$USAGE_BIN" ]] || return 0
    local usage_json="${1:-}"
    [[ -n "$usage_json" ]] || usage_json="$("$USAGE_BIN" --json 2>/dev/null || echo '{}')"
    local fivep fiver sevenp sevenr
    IFS=$'\t' read -r fivep fiver sevenp sevenr < <(jq -r '
        ([.windows[]? | select(.label=="5h")] | .[0]) as $a
      | ([.windows[]? | select(.label=="7d")] | .[0]) as $b
      | [ ($a.percent // "-"), ($a.reset_at // "-"),
          ($b.percent // "-"), ($b.reset_at // "-") ] | @tsv' \
        <<<"$usage_json" 2>/dev/null || true)
    [[ "${fivep:-}" == "-" || "${fivep:-}" == "null" ]] && fivep=""
    [[ "${sevenp:-}" == "-" || "${sevenp:-}" == "null" ]] && sevenp=""
    if [[ -n "${fivep:-}" || -n "${sevenp:-}" ]]; then
        render_bar "5h" "${fivep:-?}" "${fiver:-}" "+%H:%M"
        render_bar "7d" "${sevenp:-?}" "${sevenr:-}" "+%a %H:%M"
    fi
    return 0
}

# ── Size formatting ───────────────────────────────────────────────────────────
# human_bytes -- compact size for a byte count (e.g. 3.2G, 512M, 0B).
human_bytes() {
    awk -v b="${1:-0}" 'BEGIN{
        split("B K M G T P", u, " "); i=1;
        while (b >= 1024 && i < 6) { b /= 1024; i++ }
        if (i == 1) printf "%d%s", b, u[i]; else printf "%.1f%s", b, u[i] }'
}

# fmt_docker_size -- normalise docker's verbose size strings ("21.26GB", "0B",
# "4.396GB") to the compact human_bytes style ("21.3G", "0B", "4.4G").
fmt_docker_size() {  # $1 = docker size string
    local s="$1" num unit
    [[ "$s" =~ ^([0-9.]+)([A-Za-z]+)?$ ]] || { printf '%s' "$s"; return 0; }
    num="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]:-B}"
    case "$unit" in
        B|b)            printf '%d%s' "${num%.*}" B; return 0 ;;
        kB|KB|K|kiB|KiB) unit=K ;;
        MB|M|MiB)       unit=M ;;
        GB|G|GiB)       unit=G ;;
        TB|T|TiB)       unit=T ;;
        PB|P|PiB)       unit=P ;;
        *)              unit="${unit:0:1}" ;;
    esac
    printf '%.1f%s' "$num" "$unit"
}

# ── Generic background-refreshed cache ───────────────────────────────────────
# cache_refresh_if_stale -- non-blocking: if CACHE is older than TTL, kick a
# single background run of FN into the cache (atomic mkdir lock) and return at
# once. The current frame renders from whatever the cache already holds, so a
# slow collector (du, docker, the task scan) never blocks a paint.
cache_refresh_if_stale() {  # $1 cache  $2 ttl  $3 compute-fn
    local cache="$1" ttl="$2" fn="$3" age=999999
    [[ -f "$cache" ]] && age=$(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))
    (( age < ttl )) && return 0
    local lock="$cache.lock"
    if [[ -d "$lock" ]]; then   # clear a lock left by a refresh that died
        local lage; lage=$(( $(date +%s) - $(stat -c %Y "$lock" 2>/dev/null || echo 0) ))
        (( lage > 300 )) && rmdir "$lock" 2>/dev/null || true
    fi
    if mkdir "$lock" 2>/dev/null; then
        # Redirect the child's fds away from any inherited pipe so a frame built
        # via `$(...)` / mapfile never blocks on EOF until the worker exits.
        { "$fn" >| "$cache.tmp" 2>/dev/null && mv -f "$cache.tmp" "$cache"; \
            rmdir "$lock" 2>/dev/null; } </dev/null >/dev/null 2>&1 &
        disown 2>/dev/null || true
    fi
    return 0
}

cache_age() {  # $1 cache -> seconds since mtime, or empty if absent
    [[ -f "$1" ]] || { printf ''; return 0; }
    printf '%d' "$(( $(date +%s) - $(stat -c %Y "$1" 2>/dev/null || echo 0) ))"
}

USAGE_BIN="${ARACHNE_USAGE:-$REPO_ROOT/scripts/arachne-usage}"
TASK_BIN="${ARACHNE_TASK:-$REPO_ROOT/scripts/arachne-task}"

# MAIN_ROOT is the PRIMARY checkout (where .worktrees/ lives), resolved from git
# so caches/keys are correct even when the monitor runs from inside a worktree.
MAIN_ROOT="${ARACHNE_MONITOR_MAIN_ROOT:-}"
if [[ -z "$MAIN_ROOT" ]]; then
    MAIN_ROOT="$(git -C "$REPO_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    MAIN_ROOT="${MAIN_ROOT%/.git}"; MAIN_ROOT="${MAIN_ROOT%/.git/}"
    [[ -z "$MAIN_ROOT" || ! -d "$MAIN_ROOT" ]] && MAIN_ROOT="$REPO_ROOT"
fi

# The pump state + run notes live in the PRIMARY checkout (the pump always runs
# from main), so resolve against MAIN_ROOT — the monitor then shows the live
# pump even when run from a worktree. Override wins.
PUMP_STATE="${ARACHNE_PUMP_STATE_FILE:-$MAIN_ROOT/.arachne-pump.state}"
CACHE_KEY="$(printf '%s' "$MAIN_ROOT" | cksum | cut -d' ' -f1)"
CACHE_BASE="${TMPDIR:-/tmp}/arachne-monitor"

# Disk gauge config (free-space colour thresholds mirror arachne-disk-watchdog).
DISK_TTL="${ARACHNE_MONITOR_DISK_TTL:-60}"          # heavy-sizing cache freshness (s)
DISK_PANIC_GB="${ARACHNE_MONITOR_DISK_PANIC_GB:-5}"
DISK_PAUSE_GB="${ARACHNE_MONITOR_DISK_PAUSE_GB:-10}"
DISK_CACHE="${ARACHNE_MONITOR_DISK_CACHE:-$CACHE_BASE-disk.$CACHE_KEY.tsv}"

# Pump queue-count cache (the eligible-frontier scan is ~3s — far too slow to run
# every 1s paint, so it is backgrounded on its own TTL).
PUMP_TTL="${ARACHNE_MONITOR_PUMP_TTL:-8}"
PUMP_CACHE="${ARACHNE_MONITOR_PUMP_CACHE:-$CACHE_BASE-pump.$CACHE_KEY.tsv}"

# Docker session-table cache (docker ps + per-container log tails) — refreshed a
# bit faster than the queue/disk since log freshness matters more.
SESS_TTL="${ARACHNE_MONITOR_SESS_TTL:-2}"
SESS_CACHE="${ARACHNE_MONITOR_SESS_CACHE:-$CACHE_BASE-sess.$CACHE_KEY.tsv}"

TAIL_LINES="${ARACHNE_MONITOR_TAIL_LINES:-2}"   # feed lines per session (compact)

# ── Notes field ──────────────────────────────────────────────────────────────
# Scratchpad scoped to the current pump RUN (phases + started_at), so a new run
# starts fresh. ARACHNE_MONITOR_NOTES_FILE overrides the resolved path (tests).
NOTES_DIR="${ARACHNE_MONITOR_NOTES_DIR:-$MAIN_ROOT/.arachne-monitor-notes}"
NOTES_TAIL="${ARACHNE_MONITOR_NOTES_TAIL:-6}"    # note lines shown in the panel
NOTES_COLW="${ARACHNE_MONITOR_NOTES_COLW:-60}"   # max note width in the right column
EDITOR_BIN="${VISUAL:-${EDITOR:-nvim}}"          # Ctrl-G / e popout target

notes_run_key() {
    [[ -f "$PUMP_STATE" ]] || { printf 'session'; return 0; }
    local phases started slug ts
    phases="$(jq -r '.phases // ""' "$PUMP_STATE" 2>/dev/null || echo '')"
    started="$(jq -r '.started_at // ""' "$PUMP_STATE" 2>/dev/null || echo '')"
    [[ -n "$phases$started" ]] || { printf 'session'; return 0; }
    slug="$(printf '%s' "$phases" | tr -c 'A-Za-z0-9' '-')"; slug="${slug##-}"; slug="${slug%%-}"
    ts="$(printf '%s' "$started" | tr -dc '0-9')"
    printf '%s' "${slug:-run}${ts:+-$ts}"
}

notes_file() {
    [[ -n "${ARACHNE_MONITOR_NOTES_FILE:-}" ]] && { printf '%s' "$ARACHNE_MONITOR_NOTES_FILE"; return 0; }
    printf '%s/%s.md' "$NOTES_DIR" "$(notes_run_key)"
}

notes_label() {
    if [[ -f "$PUMP_STATE" ]]; then
        local phases; phases="$(jq -r '.phases // ""' "$PUMP_STATE" 2>/dev/null || echo '')"
        [[ -n "$phases" ]] && { printf '%s' "$phases"; return 0; }
    fi
    printf 'session'
}

append_note() {
    local text="$1" f; f="$(notes_file)"
    [[ -n "${text//[[:space:]]/}" ]] || return 0
    mkdir -p "$(dirname "$f")" 2>/dev/null || true
    printf -- '- %s  %s\n' "$(date '+%H:%M')" "$text" >> "$f" 2>/dev/null || true
}

# notes_panel_lines -- the RIGHT column: a header naming the run scope + the most
# recent NOTES_TAIL note lines (each truncated to NOTES_COLW), or an empty hint.
notes_panel_lines() {
    local f label; f="$(notes_file)"; label="$(notes_label)"
    printf 'Notes [%s]  %s(n · C-g)%s\n' "$label" "$BAR_EMPTY" "$BAR_RST"
    if [[ -s "$f" ]]; then
        local ln
        while IFS= read -r ln; do
            [[ -n "${ln//[[:space:]]/}" ]] || continue
            (( ${#ln} > NOTES_COLW )) && ln="${ln:0:$((NOTES_COLW - 1))}…"
            printf '%s\n' "$ln"
        done < <(tail -n "$NOTES_TAIL" "$f" 2>/dev/null)
    else
        printf '%s(no notes yet — press n)%s\n' "$C_FAINT" "$ST_RST"
    fi
}

# ── Pump summary (cached eligible count) ─────────────────────────────────────
# pump_compute -- BACKGROUND worker: the slow eligible-frontier scan + open count.
pump_compute() {
    [[ -f "$PUMP_STATE" ]] || { printf ''; return 0; }
    local phases; phases="$(jq -r '.phases // ""' "$PUMP_STATE" 2>/dev/null || echo '')"
    [[ -n "$phases" && -x "$TASK_BIN" ]] || { printf ''; return 0; }
    local elig open
    elig="$("$TASK_BIN" ready --phases "$phases" --count-eligible 2>/dev/null || true)"
    open="$("$TASK_BIN" ready --phases "$phases" --count 2>/dev/null || true)"
    printf 'ELIG\t%s\nOPEN\t%s\n' "${elig:-}" "${open:-}"
}

# pump_summary_line -- the pump status line (range · status · ready/open).
# Eligible comes from the cached scan (background-refreshed); open prefers the
# pump's own snapshot field, else the cache. Usage/reset are shown by the gauge
# bars below, not repeated here. $1 = usage json blob (unused; kept for caller).
pump_summary_line() {
    [[ -f "$PUMP_STATE" ]] || return 0
    local uj="${1:-{}}" phases status reason open_ct ceiling
    # Read one field per line via mapfile — NOT `read -r a b c` on a @tsv line.
    # Tab is IFS-whitespace, so an empty middle field (paused_reason when not
    # paused) would collapse and shift open_tasks/ceiling over by one. Newline-
    # delimited + mapfile preserves empty fields.
    local _pf; mapfile -t _pf < <(jq -r \
        '(.phases//"?"),(.status//"?"),(.paused_reason//""),((.open_tasks // "")|tostring),((.ceiling // "")|tostring)' \
        "$PUMP_STATE" 2>/dev/null || true)
    phases="${_pf[0]:-?}"; status="${_pf[1]:-?}"; reason="${_pf[2]:-}"
    open_ct="${_pf[3]:-}"; ceiling="${_pf[4]:-}"
    [[ -z "${phases:-}" ]] && phases="?"
    [[ -z "${status:-}" ]] && status="?"

    cache_refresh_if_stale "$PUMP_CACHE" "$PUMP_TTL" pump_compute
    local eligible="…" cached_open=""
    if [[ -f "$PUMP_CACHE" ]]; then
        eligible="$(awk -F'\t' '$1=="ELIG"{print $2; exit}' "$PUMP_CACHE" 2>/dev/null)"
        cached_open="$(awk -F'\t' '$1=="OPEN"{print $2; exit}' "$PUMP_CACHE" 2>/dev/null)"
        [[ -z "$eligible" ]] && eligible="?"
    fi
    [[ -z "${open_ct:-}" || "$open_ct" == "null" ]] && open_ct="$cached_open"
    [[ -z "${open_ct:-}" ]] && open_ct="?"

    # The pump's own state is a STATE, not a fourth vocabulary: running is the
    # same fact as "an agent is on it", paused is attention-not-yet-a-problem,
    # drained is settled. These were basic-ANSI green/yellow/cyan, which under
    # Catppuccin resolve to a pastel set that could not sit beside the graph.
    local color
    case "$status" in
        paused)  color="$ST_PARK" ;;
        drained) color="$ST_DONE" ;;
        running) color="$ST_LIVE" ;;
        *)       color="$C_MUTED" ;;   # an unknown state is not a state
    esac
    local rcolor="$C_FAINT"
    if [[ "$open_ct" =~ ^[0-9]+$ && "$open_ct" -eq 0 ]]; then
        rcolor="$ST_DONE"
    elif [[ "$eligible" =~ ^[0-9]+$ && "$open_ct" =~ ^[0-9]+$ && "$eligible" -eq 0 && "$open_ct" -gt 0 ]]; then
        rcolor="$ST_ALERT"  # STALL: work queued, nothing launchable
    elif [[ "$eligible" =~ ^[0-9]+$ && "$eligible" -gt 0 ]]; then
        rcolor="$ST_READY"  # this IS the ready state — wear the ○ grey
    fi

    local line
    line="$(printf '%spump[%s]:%s %s%s%s' "$C_MUTED" "$phases" "$ST_RST" "$color" "$status" "$ST_RST")"
    [[ "$status" == "paused" && -n "${reason:-}" ]] && line+=" — $reason"
    line+="$(printf '%s  |  %s%s ready%s%s · %s open%s' \
        "$C_MUTED" "$rcolor" "$eligible" "$ST_RST" "$C_MUTED" "$open_ct" "$ST_RST")"
    printf '%s\n' "$line"
    return 0
}

# ── Disk gauge ───────────────────────────────────────────────────────────────
# disk_compute -- BACKGROUND worker: primary footprint, per-worktree sizes, and
# docker's disk breakdown. One TSV record per line (MAIN/DKR/WT).
disk_compute() {
    local main_b
    main_b="$(du -sb --exclude="$MAIN_ROOT/.worktrees" "$MAIN_ROOT" 2>/dev/null | awk '{print $1}')"
    printf 'MAIN\t%s\n' "${main_b:-0}"
    if command -v docker >/dev/null 2>&1; then
        docker system df --format '{{.Type}}\t{{.Size}}\t{{.Reclaimable}}' 2>/dev/null \
            | while IFS=$'\t' read -r dt ds dr; do
                  [[ -n "$dt" ]] && printf 'DKR\t%s\t%s\t%s\n' "$dt" "$ds" "$dr"
              done
    fi
    git -C "$MAIN_ROOT" worktree list --porcelain 2>/dev/null \
        | awk '/^worktree /{print $2}' | tail -n +2 \
        | while IFS= read -r wt; do
              [[ -d "$wt" ]] || continue
              wb="$(du -sb "$wt" 2>/dev/null | awk '{print $1}')"
              printf 'WT\t%s\t%s\n' "${wt#"$MAIN_ROOT/.worktrees/"}" "${wb:-0}"
          done
}

# disk_bar_line -- the live free-space bar (df is instant, so always current).
disk_bar_line() {
    [[ "$SHOW_DISK" -eq 1 ]] || return 0
    local fields total_kb avail_kb
    fields="$(df -Pk "$MAIN_ROOT" 2>/dev/null | awk 'NR==2{print $2, $4}')"
    read -r total_kb avail_kb <<<"$fields"
    [[ -n "${total_kb:-}" && -n "${avail_kb:-}" && "$total_kb" -ne 0 ]] || return 0
    local used_pct=$(( (total_kb - avail_kb) * 100 / total_kb ))
    local free_gb=$(( avail_kb / 1024 / 1024 ))
    local fillcol="$BAR_FILL"
    (( free_gb < DISK_PAUSE_GB )) && fillcol="$BAR_WARN"
    (( free_gb < DISK_PANIC_GB )) && fillcol="$BAR_CRIT"
    # Free space is the datum — the one number that decides whether a multi-day
    # run survives — so it gets C_TEXT and the capacity beside it recedes. It
    # was the other way round.
    printf '%s%s%-*s%s %s  %s%s free%s %s/ %s  (%d%% used)%s\n' \
        "$GAUGE_INDENT" "$C_MUTED" "$GAUGE_LABEL_W" "Disk" "$ST_RST" \
        "$(bar_glyphs "$used_pct" "$fillcol")" \
        "$C_TEXT" "$(human_bytes $(( avail_kb * 1024 )))" "$ST_RST" \
        "$C_MUTED" "$(human_bytes $(( total_kb * 1024 )))" "$used_pct" "$ST_RST"
}

# disk_subinfo_line -- the cached footprint summary as a vertical list (worktrees
# total / main / docker breakdown / updated-age). Kicks the background sizing
# refresh when stale.
disk_subinfo_line() {
    [[ "$SHOW_DISK" -eq 1 ]] || return 0
    cache_refresh_if_stale "$DISK_CACHE" "$DISK_TTL" disk_compute
    if [[ ! -f "$DISK_CACHE" ]]; then
        printf '%s%ssizing worktrees…%s\n' "$GAUGE_SUBINDENT" "$C_FAINT" "$ST_RST"
        return 0
    fi
    local main_b wt_total=0 wt_count=0 wb
    main_b="$(awk -F'\t' '$1=="MAIN"{print $2; exit}' "$DISK_CACHE" 2>/dev/null)"
    while IFS=$'\t' read -r _ _ wb; do
        [[ "$wb" =~ ^[0-9]+$ ]] || continue
        wt_total=$(( wt_total + wb )); wt_count=$(( wt_count + 1 ))
    done < <(awk -F'\t' '$1=="WT"' "$DISK_CACHE" 2>/dev/null)
    local dline="" first=1 dtype dsize short
    while IFS=$'\t' read -r _ dtype dsize _; do
        [[ -n "$dtype" ]] || continue
        case "$dtype" in
            Images)          short=img ;;
            Containers)      short=cont ;;
            "Local Volumes") short=vol ;;
            "Build Cache")   short=cache ;;
            *)               short="$dtype" ;;
        esac
        (( first )) && first=0 || dline+=" · "
        dline+="$short $(fmt_docker_size "$dsize")"
    done < <(awk -F'\t' '$1=="DKR"' "$DISK_CACHE" 2>/dev/null)
    local age; age="$(cache_age "$DISK_CACHE")"
    # Vertical list — one footprint area per line, indented under the bars.
    printf '%s%sworktrees%s %s in %d\n' \
        "$GAUGE_SUBINDENT" "$BAR_EMPTY" "$BAR_RST" "$(human_bytes "$wt_total")" "$wt_count"
    printf '%s%smain%s %s\n' \
        "$GAUGE_SUBINDENT" "$BAR_EMPTY" "$BAR_RST" "$(human_bytes "${main_b:-0}")"
    [[ -n "$dline" ]] && printf '%s%sdocker%s %s\n' \
        "$GAUGE_SUBINDENT" "$BAR_EMPTY" "$BAR_RST" "$dline"
    [[ -n "$age" ]] && printf '%s%s(updated %ss ago)%s\n' \
        "$GAUGE_SUBINDENT" "$C_FAINT" "$age" "$ST_RST"
    return 0
}

# ── Session table (cached docker ps + log tails) ─────────────────────────────
# log_events -- up to $TAIL_LINES recent single-line meaningful events from a
# stream-json log. Best-effort; never errors the caller.
log_events() {  # $1 = log file
    local logf="$1" out
    out="$(tail -200 "$logf" 2>/dev/null \
        | jq -rR 'fromjson?
            | (if .type=="assistant" then (.message.content[]? | (.text // ("⚙ "+(.name//"tool"))))
               elif .type=="result"  then ("✓ "+(.subtype//"done"))
               else empty end)
            | gsub("\\s+";" ") | sub("^ ";"")' 2>/dev/null \
        | grep -v '^$' | tail -"$TAIL_LINES" || true)"
    [[ -z "$out" ]] && out="$(tail -"$TAIL_LINES" "$logf" 2>/dev/null || true)"
    # Terminate the last line. Callers consume this with `while IFS= read -r`,
    # and read returns non-zero on an unterminated final line — so with a bare
    # `printf '%s'` the loop body never runs for it and the most recent event is
    # silently dropped. That is why TAIL_LINES=2 only ever rendered one line.
    [[ -n "$out" ]] && printf '%s\n' "$out"
    return 0
}

# slug_branch -- container-name slug -> worktree branch. The slug is the branch
# with '/' replaced by '-', which is NOT reversible ("feat-f79-x" could be
# feat/f79-x or feat/f79/x), so match against the real worktree paths instead of
# guessing where the separator was. The manifest wins when it has the row.
slug_branch() {  # $1 = slug
    local slug="$1" cand d
    [[ -n "${SLUG_BRANCH[$slug]:-}" ]] && { printf '%s' "${SLUG_BRANCH[$slug]}"; return 0; }
    while IFS= read -r cand; do
        d="${cand#"$REPO_ROOT/.worktrees/"}"; d="${d%/}"
        [[ "${d//\//-}" == "$slug" ]] && { printf '%s' "$d"; return 0; }
    # Match on either marker: .git identifies a real worktree, and the agent log
    # identifies a workspace whose checkout is not visible from here (and is the
    # only marker the fixtures carry).
    done < <(find "$REPO_ROOT/.worktrees" -mindepth 1 -maxdepth 4 \
                  \( -name .git -o -name .arachne-agent.log \) -printf '%h\n' 2>/dev/null)
    printf ''
}

# ledger_claims -- branch -> the ONE task an agent is actually on, as
# "branch<TAB>task<TAB>turns<TAB>goal" rows. Delegated to the renderer's
# --claims mode ON PURPOSE: it shares the frontmatter parser AND the
# newest-heartbeat election with the canvas, so the two tabs cannot drift into
# disagreeing about which claim is live. Called only from the background
# sessions worker, never on the paint path.
ledger_claims() {
    [[ -x "$DAG_BIN" ]] || return 0
    ARACHNE_TASKS_DIR="$TASKS_DIR" "$DAG_BIN" --claims 2>/dev/null || true
}

# sessions_compute -- BACKGROUND worker: docker ps + per-container metadata + log
# tails, plus flagged epics. Emits records for sessions_lines to format cheaply:
#   S <name> <cstate> <tstat> <task> <up> <age> <stale> <branch> <turns> <goal>
#   L <logline>                      (belongs to the most recent S)
#   N 1                              (no containers)
#   F <task> <name> <status>         (blocked/stuck/needs-review epic)
sessions_compute() {
    local found=0 cname state status
    local flagged=""
    # Which task each branch is on, resolved once for the whole sweep.
    local -A CLAIM_TASK=() CLAIM_TURNS=() CLAIM_GOAL=()
    local cb ct cn cg
    while IFS=$'\t' read -r cb ct cn cg; do
        [[ -z "$cb" ]] && continue
        CLAIM_TASK[$cb]="$ct"; CLAIM_TURNS[$cb]="$cn"; CLAIM_GOAL[$cb]="$cg"
    done < <(ledger_claims)
    while IFS='|' read -r cname state status; do
        [[ -z "$cname" || "$cname" != arachne-agent* ]] && continue
        found=1
        local slug="${cname#arachne-agent-}"
        local name="${SLUG_NAME[$slug]:-$slug}"
        local branch; branch="$(slug_branch "$slug")"
        # The manifest's epic anchor is a launch-time constant and goes stale the
        # moment the agent moves on; the ledger's live claim is the truth. A
        # pump run has no manifest at all, which is why this column used to read
        # "—" for every session.
        local task="${CLAIM_TASK[$branch]:-${SLUG_TASK[$slug]:-—}}"
        local turns="${CLAIM_TURNS[$branch]:-null}" goal="${CLAIM_GOAL[$branch]:-}"
        local tstat="-"; [[ "$task" != "—" ]] && tstat="$(task_status "$task")"
        local cstate="running"; [[ "$state" != "running" ]] && cstate="exited"
        local up; up="$(printf '%s' "$status" | sed -E 's/^(Up|Exited[^ ]*) //; s/ ago$//' | cut -c1-11)"
        local logf=""
        [[ -n "$branch" ]] && logf="$REPO_ROOT/.worktrees/$branch/.arachne-agent.log"
        local age="-" stale=0
        if [[ -n "$logf" && -f "$logf" ]]; then
            local mtime; mtime="$(stat -c %Y "$logf" 2>/dev/null || echo 0)"
            if [[ "$mtime" -gt 0 ]]; then
                local secs=$(( $(date +%s) - mtime )); age="${secs}s"
                [[ "$cstate" == running && "$secs" -gt 120 ]] && stale=1
            fi
        fi
        printf 'S\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$name" "$cstate" "$tstat" "$task" "$up" "$age" "$stale" "$branch" "$turns" "$goal"
        local ln
        while IFS= read -r ln; do
            [[ -z "${ln// }" ]] && continue
            printf 'L\t%s\n' "$ln"
        done < <(log_events "$logf")
        # Flag a session for "Needs attention" only when it has a real container
        # in this sweep (docker ps -a includes recently-exited ones) and its task
        # is in a bad state. Keyed off live sessions, NOT the frozen launch
        # manifest — otherwise every long-blocked roster task nags forever.
        case "$tstat" in
            blocked|stuck|needs-review) flagged+=$'F\t'"$task"$'\t'"$name"$'\t'"$tstat"$'\n' ;;
        esac
    done < <(docker ps -a --filter 'name=arachne-agent' --format '{{.Names}}|{{.State}}|{{.Status}}' 2>/dev/null)
    [[ "$found" -eq 0 ]] && printf 'N\t1\n'
    printf '%s' "$flagged"
    return 0
}

session_header() {  # name cstate tstat task up age stale [index]
    local name="$1" cstate="$2" tstat="$3" task="$4" up="$5" age="$6" stale="$7"
    local idx="${8:--1}" dot age_c mark="  " nm="$name"
    # The dot restates the container state the bracketed word already gives, so
    # it must wear the SAME hue. It was cyan sitting immediately left of a green
    # `[running]` — two colours for one fact, and the loudest instance of the
    # second vocabulary this system deleted.
    case "$cstate" in running) dot="$ST_LIVE●$ST_RST" ;; *) dot="$C_FAINT●$ST_RST" ;; esac
    # A stale log on a running container is act-now: the same coral the graph
    # draws for ! rather than a theme-dependent basic red.
    if [[ "$stale" == "1" ]]; then age_c="$ST_ALERT$age$ST_RST"; else age_c="$C_MUTED$age$ST_RST"; fi
    # The selection is marked by a glyph AND weight, never colour alone — same
    # rule the GRAPH tab's heavy border follows.
    if [[ "$idx" == "$SESS_SEL" ]] && (( TAB == 0 )); then
        mark="$C_STRONG▸ $ST_RST"; nm="$C_STRONG$name$ST_RST"
        printf -v nm '%s%*s' "$nm" "$(( 10 - ${#name} > 0 ? 10 - ${#name} : 0 ))" ''
    else
        printf -v nm "$C_TEXT%-10s$ST_RST" "$name"
    fi
    printf '%s%b %s [%s] %s  %sup %s  log %s\n' \
        "$mark" "$dot" "$nm" "$(colorize "$cstate")" "${task}:$(colorize "$tstat")" \
        "$C_MUTED" "$up" "$age_c"
}

# ── Session cursor ───────────────────────────────────────────────────────────
# The GRAPH tab navigates a node cursor; SESSIONS navigates a session cursor,
# on the same principle — arrows move the SELECTION and the viewport follows,
# rather than arrows scrolling a wall of text past a fixed eye.
#
# The cache is the only source of order, so the cursor is an INDEX into the S
# records rather than a remembered name: sessions come and go between sweeps,
# and an index clamps cleanly where a stale name would silently select nothing.
SESS_SEL=0; SESS_N=0; SESS_SELLINE=-1; SESS_TOPH=8

# sessions_index -- one row per session, "name<TAB>line", where `line` is the
# 0-based output line its header occupies in sessions_lines' output. The cursor
# needs both: the count to clamp against, and the line to scroll to.
sessions_index() {
    [[ -f "$SESS_CACHE" ]] || return 0
    local rec rest ln=0
    while IFS=$'\t' read -r rec rest; do
        case "$rec" in
            S)   printf '%s\t%d\n' "${rest%%$'\t'*}" "$ln"; ln=$(( ln + 1 )) ;;
            L|N) ln=$(( ln + 1 )) ;;
            *)   : ;;
        esac
    done < "$SESS_CACHE"
}

sessions_cursor_sync() {
    local -a rows; mapfile -t rows < <(sessions_index)
    SESS_N=${#rows[@]}
    (( SESS_N == 0 )) && { SESS_SEL=0; SESS_SELLINE=-1; return 0; }
    (( SESS_SEL >= SESS_N )) && SESS_SEL=$(( SESS_N - 1 ))
    (( SESS_SEL < 0 )) && SESS_SEL=0
    local r="${rows[SESS_SEL]}"
    SESS_SELLINE="${r##*$'\t'}"
    return 0
}

# sessions_selected -- the selected session's S record fields, tab separated.
sessions_selected() {
    [[ -f "$SESS_CACHE" ]] || return 0
    local rec rest i=0
    while IFS=$'\t' read -r rec rest; do
        [[ "$rec" == S ]] || continue
        (( i == SESS_SEL )) && { printf '%s' "$rest"; return 0; }
        i=$(( i + 1 ))
    done < "$SESS_CACHE"
    return 0
}

# sessions_apply_moves -- replay a --moves string against the session cursor, the
# same trick graph_apply_moves plays for the node cursor: assertions without a
# pty. Navigation only — Enter (open) has no printable character to replay, and
# inventing an alias would mean testing a keymap the user never touches; the
# action itself is covered through the GRAPH tab's `o`.
sessions_apply_moves() {
    [[ -n "$MOVES" ]] || return 0
    local i c pend=0
    for (( i=0; i<${#MOVES}; i++ )); do
        c="${MOVES:i:1}"
        if (( pend )); then
            pend=0
            [[ "$c" == g ]] && { SESS_SEL=0; continue; }
        fi
        case "$c" in
            g) pend=1 ;;
            j) SESS_SEL=$(( SESS_SEL + 1 )) ;;
            k) SESS_SEL=$(( SESS_SEL - 1 )) ;;
            G) SESS_SEL=$(( SESS_N - 1 )) ;;
            *) : ;;
        esac
    done
    (( SESS_SEL < 0 )) && SESS_SEL=0
    (( SESS_N > 0 && SESS_SEL >= SESS_N )) && SESS_SEL=$(( SESS_N - 1 ))
    return 0
}

# sessions_follow -- keep the selected header, and its feed lines, on screen.
sessions_follow() {
    (( SESS_SELLINE < 0 )) && return 0
    local rows body last
    rows="$(term_height)"; body=$(( rows - 1 - SESS_TOPH )); (( body < 3 )) && body=3
    (( SESS_SELLINE < SCROLL )) && SCROLL=$SESS_SELLINE
    last=$(( SESS_SELLINE + TAIL_LINES ))
    (( last >= SCROLL + body )) && SCROLL=$(( last - body + 1 ))
    (( SCROLL < 0 )) && SCROLL=0
    return 0
}

# sessions_detail_lines -- the two-line top status bar for the selected session,
# mirroring graph_detail_lines: what is this agent on, and how much rope is left.
sessions_detail_lines() {
    local name cstate tstat task up age stale branch turns goal parts=""
    IFS=$'\t' read -r name cstate tstat task up age stale branch turns goal \
        < <(sessions_selected) || true
    if [[ -z "${name:-}" ]]; then
        printf '%s%s%s\n' "$C_FAINT" "  no sessions — nothing to select" "$ST_RST"
        printf '%s%s%s\n' "$C_MUTED" "  ↑↓ select · Enter open · Tab graph" "$ST_RST"
        return 0
    fi
    [[ -n "${branch:-}" ]] && parts+=" · $branch"
    [[ -n "${turns:-}" && "$turns" != "null" ]] && parts+=" · $turns turns"
    [[ -n "${up:-}" ]] && parts+=" · up $up"
    printf '%s%s%s  %s%s\n' "$C_STRONG" "${task:--}" "$ST_RST" "$(colorize "${tstat:--}")" "$parts"
    printf '%s  %s%s\n' "$BAR_EMPTY" "${goal:-}" "$BAR_RST"
    return 0
}

# sessions_lines -- the SCROLLABLE region, formatted cheaply from the cache.
sessions_lines() {  # $1 = width
    local width="${1:-100}"
    cache_refresh_if_stale "$SESS_CACHE" "$SESS_TTL" sessions_compute
    if [[ ! -f "$SESS_CACHE" ]]; then
        printf '%s(loading sessions…)%s\n' "$C_FAINT" "$ST_RST"
        return 0
    fi
    local flagged="" rec a b c d e f g h i j n=0
    while IFS=$'\t' read -r rec a b c d e f g h i j; do
        case "$rec" in
            S) session_header "$a" "$b" "$c" "$d" "$e" "$f" "$g" "$n"; n=$(( n + 1 )) ;;
            # The log tails are the largest block of text in the UI and were the
            # least legible thing in it: basic bright-black is ~2.5:1 nominal and
            # under 2:1 through a translucent terminal over a photo.
            L) printf '    %s%s%s\n' "$C_MUTED" "${a:0:$((width - 4))}" "$ST_RST" ;;
            N) printf '%s(no arachne-agent containers running or recently exited)%s\n' "$C_FAINT" "$ST_RST" ;;
            F) flagged+="  $C_MUTED$a ($b)$ST_RST: $(colorize "$c")"$'\n' ;;
        esac
    done < "$SESS_CACHE"
    if [[ -n "$flagged" ]]; then
        # This heading exists to raise an alarm, and it collects blocked / stuck /
        # needs-review rows — amber over coral rows understated them.
        printf '%sNeeds attention:%s\n' "$ST_ALERT" "$ST_RST"
        printf '%s' "$flagged"
    fi
    return 0
}

# ── Layout ───────────────────────────────────────────────────────────────────
# Geometry: ARACHNE_MONITOR_COLS / _LINES pin the width/height (tests, or forcing
# a layout); otherwise read the real terminal via tput, with sane fallbacks.
term_width()  {
    local w="${ARACHNE_MONITOR_COLS:-}"
    [[ -z "$w" ]] && w="$(tput cols 2>/dev/null || echo 100)"
    [[ "$w" =~ ^[0-9]+$ && "$w" -ge 40 ]] || w=100; echo "$w"
}
term_height() {
    local h="${ARACHNE_MONITOR_LINES:-}"
    [[ -z "$h" ]] && h="$(tput lines 2>/dev/null || echo 40)"
    [[ "$h" =~ ^[0-9]+$ && "$h" -ge 6 ]] || h=40; echo "$h"
}

# hbar -- a string of W box-drawing dashes. Uses bash parameter substitution
# (per-character, UTF-8 safe) instead of tr, which is byte-oriented and would
# mangle the 3-byte '─' into garbage.
hbar() { local w="$1" s; printf -v s '%*s' "$w" ''; printf '%s' "${s// /─}"; }

header() {  # $1 = optional suffix tag
    printf '%sArachne Task Pump%s %s— %s%s%s\n' \
        "$C_STRONG" "$ST_RST" "$C_MUTED" "$(date '+%Y-%m-%d %H:%M:%S')" "${1:-}" "$ST_RST"
    rule
}

# rule -- a full-width horizontal rule. C_RULE, a tier below the labels: two
# full-width lines at label brightness were the loudest chrome on the screen,
# and a rule is a line, not text.
rule() { local w; w="$(term_width)"; printf '%s%s%s\n' "$C_RULE" "$(hbar "$w")" "$ST_RST"; }

# compose_columns -- merge a LEFT line array and a RIGHT line array side by side,
# right-aligning the right block to the screen edge. Falls back to stacking
# (left lines, then right lines) when the terminal is too narrow.
# Args: width  left-array-name  right-array-name.
compose_columns() {
    local W="$1"; local -n _L="$2"; local -n _R="$3"
    local nL=${#_L[@]} nR=${#_R[@]} i vl
    if (( nR == 0 )); then
        for (( i=0; i<nL; i++ )); do printf '%s\n' "${_L[i]}"; done
        return 0
    fi
    local left_w=0 notes_w=0
    for (( i=0; i<nL; i++ )); do vl="$(vis_len "${_L[i]}")"; (( vl > left_w )) && left_w=$vl; done
    for (( i=0; i<nR; i++ )); do vl="$(vis_len "${_R[i]}")"; (( vl > notes_w )) && notes_w=$vl; done
    if (( left_w + 2 + notes_w <= W )); then
        local notes_col=$(( W - notes_w )); (( notes_col < left_w + 2 )) && notes_col=$(( left_w + 2 ))
        local rows=$(( nL > nR ? nL : nR )) lp rp lvl pad
        for (( i=0; i<rows; i++ )); do
            lp="${_L[i]:-}"; rp="${_R[i]:-}"
            if [[ -n "$rp" ]]; then
                lvl="$(vis_len "$lp")"; pad=$(( notes_col - lvl )); (( pad < 0 )) && pad=0
                printf '%s%*s%s\n' "$lp" "$pad" '' "$rp"
            else
                printf '%s\n' "$lp"
            fi
        done
    else
        for (( i=0; i<nL; i++ )); do printf '%s\n' "${_L[i]}"; done
        for (( i=0; i<nR; i++ )); do printf '%s\n' "${_R[i]}"; done
    fi
    return 0
}

# top_left_lines -- the left column: pump summary (if a pump is running) + usage
# bars + the live Disk bar. $1 = usage json blob.
top_left_lines() {
    local uj="${1:-{}}"
    [[ -f "$PUMP_STATE" ]] && pump_summary_line "$uj"
    printf '\n'              # padding above the gauge bars
    usage_bars "$uj"
    disk_bar_line
    printf '\n'              # padding below the gauge bars
}

# render_top -- the FIXED top region: title, two-column gauges/notes, disk
# subinfo, and a closing rule. Cheap: reads caches + one usage fetch.
render_top() {
    local W; W="$(term_width)"
    if (( DEMO )); then
        header "   [DEMO — synthetic data]"
        tab_bar
        local -a L R
        mapfile -t L < <(demo_left_lines)
        mapfile -t R < <(demo_notes_lines)
        compose_columns "$W" L R
        demo_disk_subinfo
        rule
        return 0
    fi
    header
    tab_bar
    local uj='{}'
    [[ -x "$USAGE_BIN" ]] && uj="$("$USAGE_BIN" --json 2>/dev/null || echo '{}')"
    local -a L R
    mapfile -t L < <(top_left_lines "$uj")
    mapfile -t R < <(notes_panel_lines)
    compose_columns "$W" L R
    disk_subinfo_line
    sessions_detail_lines
    rule
    return 0
}

# render_sessions -- the SCROLLABLE region.
render_sessions() {  # $1 = width
    local width="${1:-$(term_width)}"
    if (( DEMO )); then demo_sessions "$width"; return 0; fi
    sessions_lines "$width"
}

# ── Tabs ─────────────────────────────────────────────────────────────────────
# The active tab is marked by BOLD WEIGHT and colour together, never by colour
# alone: C_STRONG carries a `1` that C_RULE does not, so the mark still reads on
# --no-color and for a colour-blind reader (R2). That weight is the non-colour
# signal, which is why the tab bar no longer needs the `┤ ├` brackets.
#
# Each label sits in a fixed-width cell in BOTH states, so switching tabs never
# shifts a column: a label's start column is a property of the tab, not of which
# one happens to be selected. Changing one cell's padding means changing both.
tab_bar() {
    local cs cg
    # Inactive is C_RULE undimmed rather than dim+245: the same apparent weight
    # without a `2` that would leak into the affordance after it (R1).
    cs="$C_RULE"; cg="$C_RULE"
    if (( TAB == 0 )); then cs="$C_STRONG"; else cg="$C_STRONG"; fi
    # One affordance, not a keymap — the `?` / `:help` overlay owns the per-tab
    # key list, so the bar points at it instead of enumerating it.
    printf '%s  SESSIONS  %s%s  GRAPH  %s   %s:help%s\n' \
        "$cs" "$ST_RST" "$cg" "$ST_RST" "$C_MUTED" "$ST_RST"
}

# graph_live_branches -- worktree branches with a live agent container, as the
# renderer's liveness signal (it matches them against each task's claimed_by).
# Mirrors sessions_compute's slug -> worktree resolution: a slug is the branch
# with '/' replaced by '-', which is not reversible, so match against the real
# worktree paths rather than guessing.
graph_live_branches() {
    local out="" cname b
    while IFS= read -r cname; do
        [[ -z "$cname" ]] && continue
        b="$(slug_branch "${cname#arachne-agent-}")"
        [[ -n "$b" ]] && out+="$b,"
    done < <(docker ps --filter 'name=arachne-agent' --format '{{.Names}}' 2>/dev/null)
    printf '%s' "${out%,}"
}

# ── Graph cursor ─────────────────────────────────────────────────────────────
# The renderer emits a TSV node table alongside the picture; that table is the
# only thing the monitor navigates by, so cursor movement never has to re-derive
# the layout. Columns:
#   id lay pos cx y status branch turns resumes blockers live goal
# `live` is the renderer's own islive() verdict rather than a restatement of
# `status`, because a branch with several in_progress claims elects exactly one
# of them; the status bar has to name the same one the canvas drew.
declare -A GLAY GPOS GORD GCX GY GST GBY GTB GRA GBL GLIVE GGOAL GKIDS
GLAYERS=()
graph_index_file() { printf '%s' "$CACHE_BASE-dag.$CACHE_KEY.tsv"; }
# The monitor owns the pump-state path, so it resolves the range and passes it
# explicitly — the renderer must not have to re-find .arachne-pump.state.
graph_phases() {
    [[ -f "$PUMP_STATE" ]] || return 0
    jq -r '.phases // ""' "$PUMP_STATE" 2>/dev/null || true
}
# An empty subscript is an error on a bash associative array, so every lookup
# has to be gated on the cursor being set at all — not just on it being known.
graph_cur_ok() { [[ -n "$CURSOR" ]] && [[ -n "${GLAY[$CURSOR]:-}" ]]; }

graph_load_index() {
    local f; f="$(graph_index_file)"
    GLAY=(); GPOS=(); GORD=(); GCX=(); GY=(); GST=(); GBY=(); GTB=(); GRA=(); GBL=()
    GLIVE=(); GGOAL=(); GKIDS=()
    GLAYERS=()
    # The table lives in $TMPDIR and outlives the run that wrote it. With no
    # pump there is no graph, so a leftover table must not resurrect a cursor
    # for tasks the tab is telling the user it cannot show.
    [[ -n "$(graph_phases)" ]] || { CURSOR=""; rm -f "$f" 2>/dev/null || true; return 0; }
    [[ -s "$f" ]] || return 0
    local id lay pos cx y st by tb ra bl live goal b
    while IFS=$'\t' read -r id lay pos cx y st by tb ra bl live goal; do
        [[ -z "$id" ]] && continue
        GLAY[$id]=$lay; GPOS[$id]=$pos; GCX[$id]=$cx; GY[$id]=$y
        GST[$id]=$st;   GBY[$id]=$by;   GTB[$id]=$tb; GRA[$id]=$ra
        GBL[$id]=$bl;   GLIVE[$id]=$live; GGOAL[$id]=$goal
    done < "$f"
    # Reverse edges, and per-layer id lists ordered by position, both built once
    # per redraw so a keystroke is a lookup rather than a scan.
    local -A byslot=()
    for id in "${!GLAY[@]}"; do
        byslot["${GLAY[$id]}.$(printf '%04d' "${GPOS[$id]}")"]=$id
        [[ "${GBL[$id]}" == "-" ]] && continue
        for b in ${GBL[$id]//|/ }; do
            b="${b%%:*}"
            [[ -n "${GLAY[$b]:-}" ]] && GKIDS[$b]="${GKIDS[$b]:-} $id"
        done
    done
    local k lay
    while IFS= read -r k; do
        lay="${k%%.*}"
        GLAYERS[$lay]="${GLAYERS[$lay]:-} ${byslot[$k]}"
    done < <(printf '%s\n' "${!byslot[@]}" | sort -t. -k1,1n -k2,2n)
    # GPOS is the renderer's slot, which counts the dummy trunk columns the
    # index deliberately omits. Horizontal movement needs a dense ordinal over
    # the real nodes only, or h/l skip and stall on the gaps.
    local ord
    for lay in "${!GLAYERS[@]}"; do
        ord=0
        for k in ${GLAYERS[$lay]}; do GORD[$k]=$ord; ord=$(( ord + 1 )); done
    done
}

# graph_default_cursor -- what the cursor lands on with no prior selection: the
# live agent's task if there is one, else the shallowest ready task, else the root.
graph_default_cursor() {
    local id best="" bestkey="" key
    # The task actually being worked, not merely the first claim on the branch:
    # a phase that has left stale claims behind has several in_progress tasks
    # and only one of them is live.
    for id in "${!GLAY[@]}"; do
        [[ "${GLIVE[$id]:-0}" == "1" ]] || continue
        printf '%s' "$id"; return 0
    done
    for id in "${!GLAY[@]}"; do
        [[ "${GST[$id]}" == "in_progress" ]] || continue
        printf '%s' "$id"; return 0
    done
    for id in "${!GLAY[@]}"; do
        [[ "${GST[$id]}" == "open" ]] || continue
        key="$(printf '%03d%s' "${GLAY[$id]}" "$id")"
        [[ -z "$bestkey" || "$key" < "$bestkey" ]] && { bestkey="$key"; best="$id"; }
    done
    [[ -n "$best" ]] && { printf '%s' "$best"; return 0; }
    printf '%s' "${GLAYERS[0]:-}" | awk '{print $1}'
}

# graph_nearest -- the node in $1's layer list closest to column $2, preferring
# any id in the (space-separated) $3 set. That preference is what makes ↑ / ↓
# walk the dependency chain instead of drifting sideways to a stranger.
graph_nearest() {  # $1 layer-ids  $2 target-cx  $3 preferred-ids
    local ids="$1" want="$2" pref=" ${3:-} " id d best="" bestd=-1 pbest="" pbestd=-1
    for id in $ids; do
        d=$(( GCX[$id] - want )); (( d < 0 )) && d=$(( -d ))
        if (( bestd < 0 || d < bestd )); then bestd=$d; best="$id"; fi
        if [[ "$pref" == *" $id "* ]] && (( pbestd < 0 || d < pbestd )); then pbestd=$d; pbest="$id"; fi
    done
    printf '%s' "${pbest:-$best}"
}

graph_move() {  # $1 = h|l|k|j|g|G|^|$
    graph_cur_ok || { CURSOR="$(graph_default_cursor)"; return 0; }
    local lay="${GLAY[$CURSOR]}" pos="${GORD[$CURSOR]}" id want
    case "$1" in
        h|l)
            local -a arr=(${GLAYERS[$lay]})
            local t
            [[ "$1" == l ]] && t=$(( pos + 1 )) || t=$(( pos - 1 ))
            (( t >= 0 && t < ${#arr[@]} )) && CURSOR="${arr[t]}"
            ;;
        # vim's line-wise ends, read against the LAYER rather than a line: a
        # layer is the graph's horizontal axis, so ^ / $ mean its first and last
        # node. g/G stay vertical (first/last layer), matching the same split.
        '^')
            local -a arr=(${GLAYERS[$lay]})
            (( ${#arr[@]} )) && CURSOR="${arr[0]}"
            ;;
        '$')
            local -a arr=(${GLAYERS[$lay]})
            (( ${#arr[@]} )) && CURSOR="${arr[-1]}"
            ;;
        k)
            (( lay > 0 )) || return 0
            want="${GCX[$CURSOR]}"
            local blk="" b
            [[ "${GBL[$CURSOR]}" != "-" ]] && for b in ${GBL[$CURSOR]//|/ }; do blk+=" ${b%%:*}"; done
            id="$(graph_nearest "${GLAYERS[$(( lay - 1 ))]:-}" "$want" "$blk")"
            [[ -n "$id" ]] && CURSOR="$id"
            ;;
        j)
            want="${GCX[$CURSOR]}"
            id="$(graph_nearest "${GLAYERS[$(( lay + 1 ))]:-}" "$want" "${GKIDS[$CURSOR]:-}")"
            [[ -n "$id" ]] && CURSOR="$id"
            ;;
        g) CURSOR="$(graph_nearest "${GLAYERS[0]:-}" "${GCX[$CURSOR]}" "")" ;;
        G) local last=$(( ${#GLAYERS[@]} - 1 ))
           CURSOR="$(graph_nearest "${GLAYERS[$last]:-}" "${GCX[$CURSOR]}" "")" ;;
    esac
    return 0
}

# graph_apply_moves -- replay a --moves string against the cursor. This is what
# makes navigation testable headlessly, the same way --tab made the DAG itself
# testable: no pty, no key injection, just an assertion on the status bar.
graph_apply_moves() {
    [[ -n "$MOVES" ]] || return 0
    local i c pend=0
    for (( i=0; i<${#MOVES}; i++ )); do
        c="${MOVES:i:1}"
        # `g` is a prefix, exactly as in the live key loop: gg is first-layer,
        # a lone g is a no-op. Replaying them differently would make the
        # headless assertions test a keymap the user never touches.
        if (( pend )); then
            pend=0
            [[ "$c" == g ]] && { graph_move g; continue; }
        fi
        case "$c" in
            g)             pend=1 ;;
            h|l|k|j|G)     graph_move "$c" ;;
            '^'|'_'|0)     graph_move '^' ;;
            '$')           graph_move '$' ;;
            .)             CURSOR="$(graph_default_cursor)" ;;
            o)             open_task_file "$CURSOR" ;;
            *)             : ;;
        esac
    done
}

# graph_follow -- pan and scroll so the selection stays on screen. This is what
# makes a graph wider than the terminal usable, and why panning (rather than
# collapsing nodes) remains a viable overflow policy.
graph_follow() {
    graph_cur_ok || return 0
    local cols rows body cx y margin=12
    cols="$(term_width)"; rows="$(term_height)"
    body=$(( rows - 1 - GRAPH_TOPH )); (( body < 3 )) && body=3
    cx="${GCX[$CURSOR]}"; y="${GY[$CURSOR]}"
    (( cx - margin < PAN )) && PAN=$(( cx - margin ))
    (( cx + margin >= PAN + cols )) && PAN=$(( cx + margin - cols + 1 ))
    (( PAN < 0 )) && PAN=0
    # A node box is 3 rows; keep the whole box plus a row of its edges in view.
    (( y - 1 < SCROLL )) && SCROLL=$(( y - 1 ))
    (( y + 4 >= SCROLL + body )) && SCROLL=$(( y + 4 - body ))
    (( SCROLL < 0 )) && SCROLL=0
    return 0
}

# render_graph -- the SCROLLABLE region for the GRAPH tab. Rendered directly
# rather than through a cache: one gawk pass over the whole task corpus is
# ~50ms, comfortably inside the paint budget, and it keeps panning instant.
render_graph() {
    [[ -x "$DAG_BIN" ]] || { printf '(arachne-dag-render not found)\n'; return 0; }
    local phases; phases="$(graph_phases)"
    if [[ -z "$phases" ]]; then
        printf '%s(no pump running — nothing scoped to graph)%s\n' "$C_FAINT" "$ST_RST"
        printf '%s start a pump, or: scripts/arachne-dag-render --phases F79%s\n' "$C_FAINT" "$ST_RST"
        return 0
    fi
    # Hand the renderer the monitor's own TASKS_DIR rather than letting it
    # re-derive one: with ARACHNE_MONITOR_REPO_ROOT pointing a worktree copy at
    # the primary checkout the two resolve differently, and the graph would then
    # draw one ledger's tasks while `o` opened files from another.
    ARACHNE_TASKS_DIR="$TASKS_DIR" \
    "$DAG_BIN" --phases "$phases" --pan "$PAN" --cols "$(term_width)" \
               --cursor "$CURSOR" --index-file "$(graph_index_file)" \
               --live-branches "$(graph_live_branches)" 2>/dev/null \
        || printf '(dag render failed)\n'
}

# Each legend entry wears the colour it is describing, so the legend doubles as
# the palette key rather than being a grey list of glyphs.
GRAPH_LEGEND="${ST_DONE}✓ done${ST_RST}  ${ST_LIVE}▶ running${ST_RST}  ${ST_PARK}⧗ parked${ST_RST}  \
${ST_READY}○ ready${ST_RST}  ${ST_WAIT}◌ waiting${ST_RST}  ${ST_BLOCK}⊘ blocked${ST_RST}  ${ST_ALERT}! review${ST_RST}"

# graph_detail_lines -- the two-line top status bar describing the selection.
# Falls back to the legend when nothing is selected, so the region never jumps.
graph_detail_lines() {
    if ! graph_cur_ok; then
        printf '%s\n' "$GRAPH_LEGEND"
        printf '%s%s%s\n' "$BAR_EMPTY" "  ↑↓←→ move · o open · . running · gg/G layers · ^/\$ ends" "$BAR_RST"
        return 0
    fi
    local st="${GST[$CURSOR]}" word glyph hue parts="" b bid bst bg
    case "$st" in
        done)         glyph='✓'; word='done';         hue="$ST_DONE" ;;
        in_progress)  if [[ "${GLIVE[$CURSOR]:-0}" == "1" ]]
                      then glyph='▶'; word='in progress'; hue="$ST_LIVE"
                      # A claim with no agent behind it: either the container is
                      # gone, or the branch is draining a different task now.
                      else glyph='⧗'; word='claimed, idle'; hue="$ST_PARK"; fi ;;
        blocked)      glyph='⊘'; word='blocked';      hue="$ST_BLOCK" ;;
        needs-review) glyph='!'; word='needs review'; hue="$ST_ALERT" ;;
        stuck)        glyph='!'; word='stuck';        hue="$ST_ALERT" ;;
        open)         if [[ "${GBL[$CURSOR]}" == *':'* && "${GBL[$CURSOR]}" == *[!:]* ]] \
                          && [[ "${GBL[$CURSOR]}" =~ :(open|in_progress|blocked|needs-review|stuck) ]]
                      then glyph='◌'; word='waiting'; hue="$ST_WAIT"
                      else glyph='○'; word='ready';   hue="$ST_READY"; fi ;;
        *)            glyph='○'; word="$st";          hue="$ST_READY" ;;
    esac
    [[ "${GTB[$CURSOR]}" != "null" ]] && parts+=" · ${GTB[$CURSOR]} turns"
    [[ "${GRA[$CURSOR]}" != "null" && "${GRA[$CURSOR]}" != "0" ]] && parts+=" · resume ${GRA[$CURSOR]}"
    [[ "${GBY[$CURSOR]}" != "null" ]] && parts+=" · ${GBY[$CURSOR]}"
    if [[ "${GBL[$CURSOR]}" != "-" ]]; then
        parts+=" · blockers"
        for b in ${GBL[$CURSOR]//|/ }; do
            bid="${b%%:*}"; bst="${b##*:}"
            case "$bst" in done) bg='✓' ;; in_progress) bg='▶' ;; blocked) bg='⊘' ;;
                           needs-review|stuck) bg='!' ;; *) bg='○' ;; esac
            parts+=" $bid$bg"
        done
    fi
    printf '%s%s%s  %s%s %s%s%s\n' "$C_STRONG" "$CURSOR" "$ST_RST" "$hue" "$glyph" "$word" "$ST_RST" "$parts"
    printf '%s  %s%s\n' "$BAR_EMPTY" "${GGOAL[$CURSOR]:-}" "$BAR_RST"
}

render_graph_top() {
    header
    tab_bar
    local uj='{}'
    [[ -x "$USAGE_BIN" ]] && uj="$("$USAGE_BIN" --json 2>/dev/null || echo '{}')"
    [[ -f "$PUMP_STATE" ]] && pump_summary_line "$uj"
    graph_detail_lines
    rule
}

render_all() {  # one-shot / pipe: top then body, no viewport clipping
    if (( TAB == 1 )); then
        # One-shot has no prior frame, so prime the index with a throwaway render
        # before describing the selection. Costs one extra gawk pass, off the
        # interactive path entirely.
        [[ -n "$(graph_phases)" ]] && { render_graph >/dev/null 2>&1 || true; }
        graph_load_index
        graph_cur_ok || CURSOR="$(graph_default_cursor)"
        graph_apply_moves
        graph_follow
        render_graph_top
        render_graph
        return 0
    fi
    sessions_cursor_sync
    sessions_apply_moves
    render_top
    render_sessions "$(term_width)"
}

# ── Demo (synthetic preview; no docker, no caches) ───────────────────────────
demo_left_lines() {
    # The demo previews the real UI, so it must use the real tokens — a demo
    # that drifts from the system lies about the design it is previewing.
    printf '%spump[F43..F63]:%s %srunning%s%s  |  %s8 ready%s%s · 35 open%s\n' \
        "$C_MUTED" "$ST_RST" "$ST_LIVE" "$ST_RST" "$C_MUTED" \
        "$ST_READY" "$ST_RST" "$C_MUTED" "$ST_RST"
    printf '\n'
    render_bar "5h" 62 "" ""
    render_bar "7d" 65 "" ""
    printf '%s%-*s %s  %s60.5G free%s / 226.4G  (73%% used)\n' \
        "$GAUGE_INDENT" "$GAUGE_LABEL_W" "Disk" "$(bar_glyphs 73 "$BAR_FILL")" "$BAR_EMPTY" "$BAR_RST"
    printf '\n'
}
demo_notes_lines() {
    printf 'Notes [F43..F63]  %s(n · C-g)%s\n' "$BAR_EMPTY" "$BAR_RST"
    printf -- '- 15:10  watch f55 disk — cargo clean\n'
    printf -- '- 15:12  F00.0 example blocked on creds\n'
    printf -- '- 15:18  PR #150/#151 merged to main\n'
    printf -- '- 15:34  Issue: authentication and stale oauth tokens\n'
}
demo_disk_subinfo() {
    printf '%s%sworktrees%s 87.8G in 8\n' "$GAUGE_SUBINDENT" "$BAR_EMPTY" "$BAR_RST"
    printf '%s%smain%s 444.3M\n' "$GAUGE_SUBINDENT" "$BAR_EMPTY" "$BAR_RST"
    printf '%s%sdocker%s img 21.3G · cont 4.4G · vol 0B · cache 11.3G\n' "$GAUGE_SUBINDENT" "$BAR_EMPTY" "$BAR_RST"
    printf '%s%s(updated 8s ago)%s\n' "$GAUGE_SUBINDENT" "$BAR_EMPTY" "$BAR_RST"
}
demo_sessions() {  # $1 = width — several sessions so scrolling is exercised
    local width="$1" n l1 l2 cut=$(( width - 4 ))
    l1="⚙ Edit web/src/canvas/Node.tsx"
    l2="tsc is clean. Now run the full vitest suite to confirm no regressions."
    for n in 56 45 57 55 54 53; do
        session_header "feat-f$n" running in_progress "F$n.x" "$(( n - 30 )) minutes" "$(( n % 30 ))s" 0
        printf '    %s%s%s\n' "$C_MUTED" "${l1:0:$cut}" "$ST_RST"
        printf '    %s%s%s\n' "$C_MUTED" "${l2:0:$cut}" "$ST_RST"
    done
    printf '%sNeeds attention:%s\n' "$ST_ALERT" "$ST_RST"
    printf '  %sF00.0 (example)%s: %s\n' "$C_MUTED" "$ST_RST" "$(colorize blocked)"
    return 0
}

# ── Redraw instrumentation ───────────────────────────────────────────────────
_now_us() {
    if [[ -n "${EPOCHREALTIME:-}" ]]; then printf '%s' "${EPOCHREALTIME//[^0-9]/}"
    else date +%s%6N 2>/dev/null || echo 0; fi
}
log_redraw() {  # n compute_us paint_us frame
    [[ -n "$MONITOR_LOG" ]] || return 0
    local n="$1" cus="$2" pus="$3" frame="$4" lines bytes ts
    lines="$(printf '%s' "$frame" | wc -l | tr -d ' ')"; bytes="${#frame}"
    ts="$(date '+%Y-%m-%dT%H:%M:%S')"
    printf '%s redraw=%-5s mode=%-7s interval=%ss compute_ms=%-5s paint_ms=%-4s lines=%-3s bytes=%s\n' \
        "$ts" "$n" "batched" "$INTERVAL" "$((cus / 1000))" "$((pus / 1000))" "$lines" "$bytes" \
        >> "$MONITOR_LOG" 2>/dev/null || true
    return 0
}

# ── Scroll viewport paint ────────────────────────────────────────────────────
SCROLL=0
# paint_view -- repaint in place, clipped to the terminal: print the fixed top
# region, then a scrolled window of the session lines, then a status bar. Never
# prints more than $rows lines, so (with autowrap off) the terminal never
# scrolls and the top never disappears. Clamps the global SCROLL.
paint_view() {  # $1 top(text)  $2 sessions-array-name
    local top="$1"; local -n _S="$2"
    local rows cols; rows="$(term_height)"; cols="$(term_width)"
    local -a T; mapfile -t T <<< "$top"
    local top_h=${#T[@]} nS=${#_S[@]}
    local avail=$(( rows - 1 )); (( avail < 1 )) && avail=1
    local top_show=$(( top_h < avail ? top_h : avail ))
    local sess_view=$(( avail - top_show )); (( sess_view < 0 )) && sess_view=0
    local max_scroll=$(( nS - sess_view )); (( max_scroll < 0 )) && max_scroll=0
    (( SCROLL > max_scroll )) && SCROLL=$max_scroll
    (( SCROLL < 0 )) && SCROLL=0

    printf '\033[H'
    local i idx
    for (( i=0; i<top_show; i++ )); do printf '%s\033[K\n' "${T[i]}"; done
    for (( i=0; i<sess_view; i++ )); do
        idx=$(( SCROLL + i ))
        if (( idx < nS )); then printf '%s\033[K\n' "${_S[idx]}"; else printf '\033[K\n'; fi
    done
    # Status bar: keys + scroll position.
    local pos=""
    if (( nS > sess_view )); then
        local last=$(( SCROLL + sess_view )); (( last > nS )) && last=$nS
        pos="$(printf '  %d-%d/%d' $(( SCROLL + 1 )) "$last" "$nS")"
        (( SCROLL < max_scroll )) && pos+=" ↓"
        (( SCROLL > 0 )) && pos+=" ↑"
    fi
    # Keys are documented in --help; show only the scroll position (when there is
    # something to scroll), otherwise reclaim the line. Plain grey, not reverse
    # video: a reversed slab is the single loudest object on the screen, spent on
    # the least important fact in the frame — and its colours come from the
    # terminal's defaults, which R3 rules out.
    if [[ -n "$pos" ]]; then
        printf '%s%s%s\033[K' "$C_MUTED" "$pos" "$ST_RST"
    else
        printf '\033[K'
    fi
    printf '\033[J'
    return 0
}

# ── Interactive notes (watch mode) ───────────────────────────────────────────
edit_in_nvim() {  # file
    local f="$1"
    mkdir -p "$(dirname "$f")" 2>/dev/null || true
    [[ -e "$f" ]] || : >> "$f" 2>/dev/null || true
    printf '\033[?7h' 2>/dev/null || true    # restore autowrap for the editor
    tput rmcup 2>/dev/null || true
    tput cnorm 2>/dev/null || true
    "$EDITOR_BIN" "$f" </dev/tty >/dev/tty 2>&1 || true
    tput smcup 2>/dev/null || true
    tput civis 2>/dev/null || true
    printf '\033[?7l' 2>/dev/null || true    # autowrap off again
    printf '\033[2J' 2>/dev/null || true
}

# ── Open the selected task's file ────────────────────────────────────────────
# The GRAPH cursor names a task, so `o` / Enter opens that task's markdown —
# goal, spec, acceptance, blockers — without leaving the dashboard.
#
# On a graphical session that means a NEW terminal window, fully detached from
# the monitor: the dashboard keeps painting at its 1s cadence, and the editor
# outlives it if you quit. With no display (a plain tty, ssh) there is no window
# to open, so it falls back to handing THIS terminal to the editor, which the
# notes popout already knows how to do and undo.
TASK_TERM="${ARACHNE_MONITOR_TERM:-wezterm}"          # GUI terminal to spawn
TASK_WIN_CLASS="${ARACHNE_MONITOR_TASK_CLASS:-arachne-task}"   # for Hyprland windowrules
# ARACHNE_MONITOR_OPEN_CMD replaces the whole spawn; the file path is appended.

task_file() { printf '%s/%s.md' "$TASKS_DIR" "$1"; }

# spawn_detached -- run "$@" out of the monitor's session and controlling
# terminal, so it neither draws on the dashboard nor dies with it.
spawn_detached() {
    if command -v setsid >/dev/null 2>&1; then
        setsid -f "$@" </dev/null >/dev/null 2>&1 || return 1
        return 0
    fi
    { "$@" </dev/null >/dev/null 2>&1 & disown 2>/dev/null; } || return 1
    return 0
}

open_task_file() {  # $1 = task id
    local id="${1:-}" f
    [[ -n "$id" ]] || return 0
    f="$(task_file "$id")"
    [[ -f "$f" ]] || return 0
    if [[ -n "${ARACHNE_MONITOR_OPEN_CMD:-}" ]]; then
        local -a cmd; read -r -a cmd <<< "$ARACHNE_MONITOR_OPEN_CMD"
        (( ${#cmd[@]} )) && { spawn_detached "${cmd[@]}" "$f"; return 0; }
    fi
    if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && command -v "$TASK_TERM" >/dev/null 2>&1; then
        # --always-new-process so the window gets its own class: wezterm sets the
        # Wayland app_id per GUI process, and without it the window joins an
        # existing instance under the default class, where a windowrule can't
        # reach it.
        spawn_detached "$TASK_TERM" start --always-new-process --class "$TASK_WIN_CLASS" \
                       --cwd "$REPO_ROOT" -- "$EDITOR_BIN" "$f" && return 0
    fi
    edit_in_nvim "$f"
    return 0
}

# open_session_task -- Enter on the SESSIONS tab: open the task the selected
# session is actually on. Resolved from the ledger by sessions_compute, so it
# tracks the agent as it moves through a phase rather than pointing at whatever
# the manifest named at launch.
open_session_task() {
    local name cstate tstat task rest
    IFS=$'\t' read -r name cstate tstat task rest < <(sessions_selected) || true
    [[ -n "${task:-}" && "$task" != "—" && "$task" != "-" ]] || return 0
    open_task_file "$task"
}

notes_input_mode() {
    local buf="" ch rows seq
    rows="$(term_height)"
    printf '\033[?7h' 2>/dev/null || true     # allow the cursor to track long input
    tput cnorm 2>/dev/null || true
    while true; do
        printf '\033[%d;1H\033[K%snote>%s %s' "$rows" "$C_STRONG" "$ST_RST" "$buf"
        if ! IFS= read -rsn1 ch; then break; fi
        if [[ -z "$ch" ]]; then append_note "$buf"; break; fi      # Enter (delimiter → empty)
        case "$ch" in
            $'\r')            append_note "$buf"; break ;;
            $'\x7f'|$'\x08')  buf="${buf%?}" ;;
            $'\x07')          append_note "$buf"; edit_in_nvim "$(notes_file)"; break ;;   # Ctrl-G
            $'\x1b')          seq=""; IFS= read -rsn2 -t 0.002 seq || true
                              [[ -z "$seq" ]] && break ;;
            *)                buf+="$ch" ;;
        esac
    done
    tput civis 2>/dev/null || true
    printf '\033[?7l' 2>/dev/null || true
}

# Continuation bytes of one escape sequence arrive in the same burst as its
# introducer, so this only has to outlast scheduling jitter — not a human. It is
# also the delay before a bare ESC is reported, which nothing is bound to.
ESC_BYTE_TIMEOUT=0.05

# read_key -- read one key within the refresh interval, normalising escape
# sequences to tokens (UP/DOWN/LEFT/RIGHT/HOME/END/PGUP/PGDN/STAB/ESC). Empty on
# timeout. Honors set -e.
#
# Escapes are decoded by INTRODUCER + incremental read rather than by slurping a
# fixed two bytes, because one logical key has several encodings of DIFFERENT
# LENGTHS and a terminal picks between them at runtime:
#
#   Home →  \E[H   (CSI, cursor keys in normal mode)
#           \EOH   (SS3, cursor keys in APPLICATION mode — DECCKM set)
#           \E[1~ / \E[7~   (tilde family: linux console / rxvt lineage)
#           \E[1;5H etc.    (any of the above, plus a modifier parameter)
#
# This host's terminfo declares khome=\EOH / kend=\EOF / kcuu1=\EOA — the SS3
# forms — and nothing here sends smkx/rmkx, so whether the terminal is in
# application mode when the monitor starts depends on what ran before it. The
# old fixed 2-byte read matched ONLY the 3-byte CSI forms: \EOH yielded "OH",
# matched nothing, and the keypress vanished. Worse, \E[1~ yielded "[1", also
# unmatched, and left its trailing "~" in the input stream to be read as a
# phantom keypress on the next iteration.
#
# Reading a CSI up to and including its FINAL byte consumes exactly one
# sequence whatever its length, so nothing is ever stranded.
read_key() {
    local c intro seq="" ch final params
    IFS= read -rsn1 -t "$INTERVAL" c || { printf ''; return 0; }
    # Enter is read's own delimiter, so it arrives as an EMPTY successful read —
    # indistinguishable from a timeout unless it is named here.
    [[ -z "$c" ]] && { printf 'ENTER'; return 0; }
    [[ "$c" == $'\x1b' ]] || { printf '%s' "$c"; return 0; }

    IFS= read -rsn1 -t "$ESC_BYTE_TIMEOUT" intro || intro=""
    case "$intro" in
        # CSI: parameter bytes (0x30-0x3F) run until the final byte (0x40-0x7E),
        # which is kept as the last character of $seq.
        '[') while IFS= read -rsn1 -t "$ESC_BYTE_TIMEOUT" ch; do
                 [[ -n "$ch" ]] || break
                 seq+="$ch"
                 [[ '0123456789;:<=>?' == *"$ch"* ]] || break
             done ;;
        # SS3: exactly one byte follows the introducer.
        'O') IFS= read -rsn1 -t "$ESC_BYTE_TIMEOUT" seq || seq="" ;;
        '')  printf 'ESC'; return 0 ;;
        # ESC + printable is Alt-<key>. Consumed (never re-read as a bare key),
        # but nothing is bound to it.
        *)   printf ''; return 0 ;;
    esac
    [[ -n "$seq" ]] || { printf ''; return 0; }

    final="${seq: -1}"; params="${seq%?}"
    # The tilde family names the key in its FIRST parameter; every other form
    # names it in the final byte and uses parameters only for modifiers. So
    # \E[1~, \E[7~ and \E[1;5H all have to land on HOME.
    if [[ "$final" == '~' ]]; then
        case "${params%%;*}" in
            1|7) printf 'HOME' ;;
            4|8) printf 'END' ;;
            5)   printf 'PGUP' ;;
            6)   printf 'PGDN' ;;
            *)   printf '' ;;
        esac
        return 0
    fi
    case "$final" in
        A) printf 'UP' ;;    B) printf 'DOWN' ;;
        C) printf 'RIGHT' ;; D) printf 'LEFT' ;;
        H) printf 'HOME' ;;  F) printf 'END' ;;
        Z) printf 'STAB' ;;                        # Shift-Tab
        *) printf '' ;;
    esac
    return 0
}

# --decode-keys N -- read N keys and print the token read_key made of each, one
# per line, 'NONE' when nothing arrived within the interval. Two jobs: it is the
# decoder's test seam (the decoder is a pure function of the bytes on stdin, so
# the suite can feed it \EOH and assert HOME with no pty), and it is the
# diagnostic to reach for when a key "does nothing" in some new terminal — run
# it and press the key. Stops early on q so it can be used interactively.
if [[ -n "$DECODE_KEYS" ]]; then
    for (( __dk = 0; __dk < DECODE_KEYS; __dk++ )); do
        __tok="$(read_key)"
        printf '%s\n' "${__tok:-NONE}"
        if [[ "$__tok" == q ]]; then break; fi
    done
    exit 0
fi

if [[ "$WATCH" -eq 1 ]]; then
    restore() {
        printf '\033[?7h' 2>/dev/null || true   # autowrap back on
        tput cnorm 2>/dev/null || true
        tput rmcup 2>/dev/null || true
    }
    trap restore EXIT INT TERM
    tput smcup 2>/dev/null || true   # alternate screen
    tput civis 2>/dev/null || true   # hide cursor
    printf '\033[?7l' 2>/dev/null || true   # autowrap OFF → long lines clip, never wrap
    SCROLL=0; __redraw=0; __gpend=0
    while true; do
        __redraw=$((__redraw + 1))
        __t0="$(_now_us)"
        if (( TAB == 1 )); then
            # Index, then follow, then paint: the cursor's coordinates come from
            # the PREVIOUS frame's table, which is what lets one keystroke move
            # the selection and the viewport in the same redraw.
            graph_load_index
            graph_cur_ok || CURSOR="$(graph_default_cursor)"
            graph_follow
            __top="$(render_graph_top 2>/dev/null || true)"
            mapfile -t __T <<< "$__top"; GRAPH_TOPH=${#__T[@]}
            mapfile -t __SESS < <(render_graph 2>/dev/null || true)
        else
            # Same order, same reason: sync the cursor against the cache and
            # follow it before painting, using the previous frame's top height.
            sessions_cursor_sync
            sessions_follow
            __top="$(render_top 2>/dev/null || true)"
            mapfile -t __T <<< "$__top"; SESS_TOPH=${#__T[@]}
            mapfile -t __SESS < <(render_sessions "$(term_width)" 2>/dev/null || true)
        fi
        __compute_us=$(( $(_now_us) - __t0 ))
        __p0="$(_now_us)"
        paint_view "$__top" __SESS
        __paint_us=$(( $(_now_us) - __p0 ))
        log_redraw "$__redraw" "$__compute_us" "$__paint_us" "$__top"$'\n'"${__SESS[*]:-}"
        if [[ -t 0 ]]; then
            __key="$(read_key)"
            __page=$(( $(term_height) / 2 )); (( __page < 1 )) && __page=1
            # On the GRAPH tab the arrows and hjkl drive the CURSOR, not the
            # viewport — graph_follow pans and scrolls to keep it visible. Tab /
            # Shift-Tab are the only tab switch there; PgUp/PgDn still page the
            # viewport on its own, for reading without losing the selection.
            # `g` is a PREFIX (vim's gg), so it is resolved before the tab's own
            # keymap sees the key. Any other key cancels a pending g rather than
            # being swallowed by it — a half-typed motion must never eat a
            # command.
            if (( __gpend )); then
                __gpend=0
                if [[ "$__key" == g ]]; then
                    if (( TAB == 1 )); then graph_move g; else SESS_SEL=0; SCROLL=0; fi
                    __key=""
                fi
            elif [[ "$__key" == g ]]; then
                __gpend=1; __key=""
            fi
            if (( TAB == 1 )); then
                case "$__key" in
                    q|Q)                 break ;;
                    $'\t'|STAB)          TAB=0; SCROLL=0; PAN=0 ;;
                    h|H|LEFT)            graph_move h ;;
                    l|L|RIGHT)           graph_move l ;;
                    k|K|UP)              graph_move k ;;
                    j|J|DOWN)            graph_move j ;;
                    G)                   graph_move G ;;
                    # ^ / $ / Home / End work along the LAYER, the graph's
                    # horizontal axis, the way vim's work along a line.
                    '^'|_|0|HOME)        graph_move '^' ;;
                    '$'|END)             graph_move '$' ;;
                    .)                   CURSOR="$(graph_default_cursor)" ;;
                    o|O|ENTER)           open_task_file "$CURSOR" ;;
                    $'\x04'|PGDN|' ')    SCROLL=$(( SCROLL + __page )) ;;
                    $'\x15'|PGUP|b)      SCROLL=$(( SCROLL - __page )) ;;
                    n|N)                 notes_input_mode ;;
                    e|E|$'\x07')         edit_in_nvim "$(notes_file)" ;;
                    *)                   : ;;
                esac
            else
                case "$__key" in
                    q|Q)                 break ;;
                    # Tab switching resets the viewport: the two tabs have unrelated
                    # coordinate spaces, so carrying scroll/pan across is meaningless.
                    $'\t'|STAB|LEFT|RIGHT) TAB=1; SCROLL=0; PAN=0 ;;
                    .)                   SESS_SEL=0; SCROLL=0; PAN=0 ;;
                    n|N)                 notes_input_mode ;;
                    e|E|$'\x07')         edit_in_nvim "$(notes_file)" ;;
                    # Arrows move the SELECTION; the viewport follows it.
                    j|J|DOWN)            SESS_SEL=$(( SESS_SEL + 1 )) ;;
                    k|K|UP)              SESS_SEL=$(( SESS_SEL - 1 )) ;;
                    G|END)               SESS_SEL=999999 ;;
                    HOME)                SESS_SEL=0 ;;
                    ENTER)               open_session_task ;;
                    $'\x04'|PGDN|' ')    SCROLL=$(( SCROLL + __page )) ;;
                    $'\x15'|PGUP|b)      SCROLL=$(( SCROLL - __page )) ;;
                    *)                   : ;;
                esac
                (( SESS_SEL < 0 )) && SESS_SEL=0
            fi
            (( SCROLL < 0 )) && SCROLL=0
        else
            sleep "$INTERVAL"
        fi
    done
else
    if [[ -n "$MONITOR_LOG" ]]; then
        __t0="$(_now_us)"; __frame="$(render_all 2>/dev/null || true)"
        log_redraw 1 "$(( $(_now_us) - __t0 ))" 0 "$__frame"
        printf '%s\n' "$__frame"
    else
        render_all
    fi
fi
