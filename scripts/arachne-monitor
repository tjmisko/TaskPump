#!/bin/bash
# arachne-monitor -- at-a-glance status of parallel Arachne agents.
#
# Maps each running/recent arachne-agent container to its worktree, epic task
# status (from the canonical ops/ task files), uptime, and last log line, so
# you can see overall progress and spot anything stuck/blocked/parked.
#
# Each session renders as a header line (name, container state, epic task
# status, uptime, log freshness) followed by a fixed 5-line area showing the
# most recent meaningful log events. In --watch the whole view repaints on the
# interval.
#
# Usage:
#   ./scripts/arachne-monitor            # one paint
#   ./scripts/arachne-monitor --watch    # refresh every 10s
#   ./scripts/arachne-monitor --watch 5  # refresh every 5s
set -euo pipefail

REPO_ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
MANIFEST="${MANIFEST:-$REPO_ROOT/ops/task-loop/parallel-manifest.tsv}"
TASKS_DIR="$REPO_ROOT/ops/task-loop/tasks"

WATCH=0; INTERVAL=10; DEMO=0
for a in "$@"; do
    case "$a" in
        --watch)  WATCH=1 ;;
        --demo)   DEMO=1 ;;        # render synthetic sessions; no docker needed
        [0-9]*)   INTERVAL="$a" ;;
        *)        echo "ERROR: unknown arg '$a'" >&2; exit 1 ;;
    esac
done

# branch-slug -> "name<TAB>epic_task" lookup from the manifest.
declare -A SLUG_NAME SLUG_TASK SLUG_BRANCH
if [[ -f "$MANIFEST" ]]; then
    while IFS=$'\t' read -r name branch brief task _rest; do
        [[ -z "${name// }" || "${name:0:1}" == "#" ]] && continue
        slug="${branch//\//-}"
        SLUG_NAME["$slug"]="$name"; SLUG_TASK["$slug"]="$task"; SLUG_BRANCH["$slug"]="$branch"
    done < "$MANIFEST"
fi

task_status() {  # $1 = task id -> status string or "-"
    local f="$TASKS_DIR/$1.md"
    [[ -f "$f" ]] || { echo "-"; return; }
    yq --front-matter=extract '.status' "$f" 2>/dev/null || echo "?"
}

colorize() {  # colorize a status word
    case "$1" in
        running|in_progress) printf '\033[36m%s\033[0m' "$1" ;;   # cyan
        done)           printf '\033[32m%s\033[0m' "$1" ;;        # green
        blocked|stuck)  printf '\033[31m%s\033[0m' "$1" ;;        # red
        needs-review)   printf '\033[33m%s\033[0m' "$1" ;;        # yellow
        exited)         printf '\033[90m%s\033[0m' "$1" ;;        # grey
        *)              printf '%s' "$1" ;;
    esac
}

TAIL_LINES=4   # max log-tail lines per session (blanks are skipped, not padded)

# log_events -- up to $TAIL_LINES recent single-line meaningful events from a
# stream-json log. Best-effort; never errors the caller (used under pipefail).
log_events() {  # $1 = log file
    local logf="$1" out
    out="$(tail -200 "$logf" 2>/dev/null \
        | jq -rR 'fromjson?
            | (if .type=="assistant" then (.message.content[]? | (.text // ("⚙ "+(.name//"tool"))))
               elif .type=="result"  then ("✓ "+(.subtype//"done"))
               else empty end)
            | gsub("\\s+";" ") | sub("^ ";"")' 2>/dev/null \
        | grep -v '^$' | tail -"$TAIL_LINES" || true)"
    [[ -z "$out" ]] && out="$(tail -"$TAIL_LINES" "$logf" 2>/dev/null || true)"
    printf '%s' "$out"
}

# render_session -- one header line + a fixed TAIL_LINES tail area.
# Args: name cstate tstat task up age stale width ; stdin = log lines.
render_session() {
    local name="$1" cstate="$2" tstat="$3" task="$4" up="$5" age="$6" stale="$7" width="$8"
    local dot age_c
    case "$cstate" in
        running) dot=$'\033[36m●\033[0m' ;;   # cyan
        *)       dot=$'\033[90m●\033[0m' ;;    # grey
    esac
    if [[ "$stale" == "1" ]]; then age_c=$'\033[31m'"$age"$'\033[0m'; else age_c="$age"; fi
    printf '%b %-11s [%s] %s  up %s  log %s\n' \
        "$dot" "$name" "$(colorize "$cstate")" "${task}:$(colorize "$tstat")" "$up" "$age_c"
    local -a lines=(); local ln
    while IFS= read -r ln; do
        [[ -z "${ln// }" ]] && continue   # skip blank lines, don't pad
        lines+=("$ln")
    done
    # keep only the most recent TAIL_LINES
    if [[ "${#lines[@]}" -gt "$TAIL_LINES" ]]; then
        lines=("${lines[@]: -$TAIL_LINES}")
    fi
    if [[ "${#lines[@]}" -eq 0 ]]; then
        printf '    \033[90m(no log output yet)\033[0m\n'
    else
        for ln in "${lines[@]}"; do
            printf '    \033[90m%s\033[0m\n' "$(printf '%s' "$ln" | cut -c1-"$((width - 4))")"
        done
    fi
    echo   # one blank line between sessions
}

header() {  # $1 = optional suffix tag
    local w; w="$(tput cols 2>/dev/null || echo 100)"; [[ "$w" -lt 40 ]] && w=100
    echo "Arachne parallel agents — $(date '+%Y-%m-%d %H:%M:%S')${1:-}"
    printf '%*s\n' "$w" '' | tr ' ' '-'
}

USAGE_BIN="$REPO_ROOT/scripts/arachne-usage"
TASK_BIN="$REPO_ROOT/scripts/arachne-task"
PUMP_STATE="${ARACHNE_PUMP_STATE_FILE:-$REPO_ROOT/.arachne-pump.state}"

# pump_status_line -- when the usage-governed pump (scripts/arachne-pump) is
# running, show its range + status + (if paused) the reason, the queue depth
# (eligible frontier vs open-in-range), plus the live Max-plan utilization and
# the reset time. Silent when no pump state exists, so the monitor is unchanged
# for plain manifest runs. Best-effort (never errors the caller under the watch
# loop's set -e).
#
# Queue legibility (the A7 fix): "ready" must mean the ELIGIBLE FRONTIER — tasks
# that can launch right now (open ∧ blockers done ∧ unclaimed) — not open-in-range
# (the drain test). They diverge during a stall: work is queued but a cross-phase
# blocker or orphaned claim leaves nothing launchable. Showing both, and colouring
# "0 ready · N open" distinctly, makes that stall legible at a glance.
pump_status_line() {
    [[ -f "$PUMP_STATE" ]] || return 0
    local phases status reason pct reset
    phases="$(jq -r '.phases // "?"' "$PUMP_STATE" 2>/dev/null || echo '?')"
    status="$(jq -r '.status // "?"' "$PUMP_STATE" 2>/dev/null || echo '?')"
    reason="$(jq -r '.paused_reason // ""' "$PUMP_STATE" 2>/dev/null || echo '')"

    # Eligible frontier (ready) vs open-in-range. Prefer the pump's own snapshot
    # fields when present; otherwise query the canonical ledger live (the pump on
    # this branch persists open_tasks but not eligible_tasks, so eligible is
    # computed here — which is also a real-time count, not a post-tick snapshot).
    local eligible open_ct
    eligible="$(jq -r '.eligible_tasks // empty' "$PUMP_STATE" 2>/dev/null || true)"
    open_ct="$(jq -r '.open_tasks // empty' "$PUMP_STATE" 2>/dev/null || true)"
    if [[ -x "$TASK_BIN" && -n "$phases" && "$phases" != "?" ]]; then
        if [[ -z "$eligible" ]]; then
            eligible="$("$TASK_BIN" ready --phases "$phases" --count-eligible 2>/dev/null || true)"
        fi
        if [[ -z "$open_ct" ]]; then
            open_ct="$("$TASK_BIN" ready --phases "$phases" --count 2>/dev/null || true)"
        fi
    fi
    [[ -z "$eligible" ]] && eligible="?"
    [[ -z "$open_ct" ]] && open_ct="?"

    pct="?"; reset=""
    if [[ -x "$USAGE_BIN" ]]; then
        pct="$("$USAGE_BIN" --percent 2>/dev/null || echo '?')"
        reset="$("$USAGE_BIN" --json 2>/dev/null | jq -r '.reset_at // empty' 2>/dev/null \
                  | sed -E 's/.*T([0-9]{2}:[0-9]{2}).*/\1/' || true)"
    fi
    local color line
    case "$status" in
        paused)  color='\033[33m' ;;   # yellow
        drained) color='\033[32m' ;;   # green
        *)       color='\033[36m' ;;   # cyan
    esac

    # Colour the ready count by queue health: green when fully drained
    # (open == 0), red when stalled (0 eligible while open > 0), cyan when there
    # is an actionable frontier, grey when the count is unknown.
    local rcolor='\033[90m'
    if [[ "$open_ct" =~ ^[0-9]+$ && "$open_ct" -eq 0 ]]; then
        rcolor='\033[32m'   # drained: no open work left
    elif [[ "$eligible" =~ ^[0-9]+$ && "$open_ct" =~ ^[0-9]+$ && "$eligible" -eq 0 && "$open_ct" -gt 0 ]]; then
        rcolor='\033[31m'   # STALL: work queued, nothing launchable
    elif [[ "$eligible" =~ ^[0-9]+$ && "$eligible" -gt 0 ]]; then
        rcolor='\033[36m'   # actionable frontier
    fi

    line="$(printf 'pump[%s]: %b%s\033[0m' "$phases" "$color" "$status")"
    [[ "$status" == "paused" && -n "$reason" ]] && line+=" — $reason"
    line+="$(printf '  |  %b%s ready\033[0m · %s open' "$rcolor" "$eligible" "$open_ct")"
    line+="  |  usage ${pct}%"
    [[ -n "$reset" ]] && line+="  resets ${reset}"
    printf '%b\n\n' "$line"
    return 0
}

term_width() { local w; w="$(tput cols 2>/dev/null || echo 100)"; [[ "$w" -lt 40 ]] && w=100; echo "$w"; }

snapshot() {
    local width; width="$(term_width)"
    header
    pump_status_line
    local found=0
    while IFS='|' read -r cname state status; do
        [[ -z "$cname" ]] && continue
        [[ "$cname" == arachne-agent* ]] || continue
        found=1
        local slug="${cname#arachne-agent-}"
        local name="${SLUG_NAME[$slug]:-$slug}"
        local task="${SLUG_TASK[$slug]:-—}"
        local tstat="-"; [[ "$task" != "—" ]] && tstat="$(task_status "$task")"
        local cstate="running"; [[ "$state" != "running" ]] && cstate="exited"
        local up; up="$(echo "$status" | sed -E 's/^(Up|Exited[^ ]*) //; s/ ago$//' | cut -c1-11)"
        # Resolve the log path from the BRANCH (worktrees with '/' in the branch
        # are nested dirs). Fall back to a find for off-manifest slugs.
        local logf="" branch="${SLUG_BRANCH[$slug]:-}"
        if [[ -n "$branch" ]]; then
            logf="$REPO_ROOT/.worktrees/$branch/.arachne-agent.log"
        else
            local cand
            while IFS= read -r cand; do
                local d; d="$(dirname "$cand")"; d="${d#"$REPO_ROOT/.worktrees/"}"
                [[ "${d//\//-}" == "$slug" ]] && { logf="$cand"; break; }
            done < <(find "$REPO_ROOT/.worktrees" -name .arachne-agent.log 2>/dev/null)
        fi
        local age="-" stale=0
        if [[ -n "$logf" && -f "$logf" ]]; then
            local mtime; mtime="$(stat -c %Y "$logf" 2>/dev/null || echo 0)"
            if [[ "$mtime" -gt 0 ]]; then
                local secs=$(( $(date +%s) - mtime )); age="${secs}s"
                [[ "$cstate" == running && "$secs" -gt 120 ]] && stale=1
            fi
        fi
        log_events "$logf" \
            | render_session "$name" "$cstate" "$tstat" "$task" "$up" "$age" "$stale" "$width"
    done < <(docker ps -a --filter 'name=arachne-agent' --format '{{.Names}}|{{.State}}|{{.Status}}' 2>/dev/null)
    [[ "$found" -eq 0 ]] && echo "(no arachne-agent containers running or recently exited)"
    # Surface blocked/stuck/needs-review epics regardless of container state.
    local flagged=""
    for slug in "${!SLUG_TASK[@]}"; do
        local t="${SLUG_TASK[$slug]}"; local s; s="$(task_status "$t")"
        case "$s" in blocked|stuck|needs-review) flagged+="  $t (${SLUG_NAME[$slug]}): $s\n" ;; esac
    done
    [[ -n "$flagged" ]] && { echo "Needs attention:"; printf "$flagged"; }
    return 0   # never let a false trailing conditional abort the watch loop (set -e)
}

# demo -- synthetic sessions exercising every state, for iterating on the UI
# without launching containers. Pure rendering; touches no docker, no logs.
demo() {
    local width; width="$(term_width)"
    header "   [DEMO — synthetic data]"
    # The red "0 ready" against "42 open" is the stall signature A7 makes legible.
    printf 'pump[F55..F63]: \033[33mpaused\033[0m — bind_percent 95%% ≥ ceiling 95%%  |  \033[31m0 ready\033[0m · 42 open  |  usage 95%%  resets 21:00\n\n'
    printf '%s\n' \
        "Reading ops/planning/2026-04-13 - Integrations Roadmap.md" \
        "⚙ Read crates/arachne-connectors/src/email/mod.rs" \
        "Adding ImapSource block spec with an OAuth2 token field" \
        "⚙ Bash cargo test -p arachne-connectors email::" \
        "test imap::tests::parses_envelope ... ok" \
      | render_session email running in_progress F41.1 "12 minutes" "3s" 0 "$width"
    printf '%s\n' \
        "⚙ Edit web/src/canvas/Node.tsx" \
        "Wiring AgentConfidence.overall into the node confidence chip" \
      | render_session agentic running in_progress F42.2 "47 minutes" "8s" 0 "$width"
    printf '%s\n' \
        "⚙ Bash cargo clippy --workspace -- -D warnings" \
        "waiting on a long compile…" \
      | render_session calendar running in_progress F41.2 "9 minutes" "318s" 1 "$width"
    printf '%s\n' \
        "✓ success" \
        "Opened PR #214 against main" \
        "⚙ Bash gh pr create -d -r tjmisko" \
        "All tests green; web build green" \
        "Marked F41.5 complete with commit shas" \
      | render_session crm exited done F41.5 "2 minutes" "61s" 0 "$width"
    printf '' \
      | render_session messaging running in_progress F41.4 "20 seconds" "-" 0 "$width"
    echo "Needs attention:"
    printf '  %s\n' "F41.2 (calendar): running but log stale 318s"
    return 0
}

render_all() { if [[ "$DEMO" -eq 1 ]]; then demo; else snapshot; fi; }

if [[ "$WATCH" -eq 1 ]]; then
    # Full-screen repaint on the alternate buffer, like top/watch: take over the
    # terminal, hide the cursor, and restore both when the user quits (Ctrl-C) or
    # the loop dies for any reason. `|| true` keeps a transient render failure
    # (e.g. a docker hiccup) from ending the watch under `set -e`.
    restore() { tput cnorm 2>/dev/null || true; tput rmcup 2>/dev/null || true; }
    trap restore EXIT INT TERM
    tput smcup 2>/dev/null || true   # enter alternate screen
    tput civis 2>/dev/null || true   # hide cursor
    while true; do
        printf '\033[H\033[2J'       # home cursor + clear screen (flicker-free in alt buffer)
        render_all || true
        sleep "$INTERVAL"
    done
else
    render_all
fi
