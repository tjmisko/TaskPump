#!/usr/bin/env bash
# arachne-pump — usage-governed, DAG-aware, keep-acquiring task-loop supervisor.
#
# A singular HOST-level loop (so there is no cross-agent claim race — design D1)
# that points the parallel substrate at a RANGE of phases and drains it for days:
#
#   * Queue = the live eligible frontier, recomputed every tick from `blockers:`
#     via `arachne-task ready --phases A..B` (design D2). Newly-unblocked tasks
#     enter automatically — this is "keep acquiring".
#   * Dispatch grain = phase (D4): each phase FN with eligible work gets a
#     worktree that drains its own sub-tree serially via the in-context
#     `arachne-task next --phase FN` loop; phases fan out in parallel.
#   * Liveness from `docker ps`, never task status (D3): a parked epic
#     (in_progress, dead container) auto-resumes; a live one is never double-launched.
#   * Feed gate: pause LAUNCHING new work (running agents are never killed) when
#     `arachne-usage --gate` says we're at/over the ceiling, when free disk drops
#     below PAUSE_THRESHOLD_GB (`arachne-disk-watchdog --gate`), when a reset-backstop
#     window is open, or when the brcmfmac WiFi firmware looks wedged. Resume
#     automatically when the window slides / disk frees / journal goes quiet.
#   * Disk discipline (A4): a completed phase's worktree target/ is reclaimed
#     (`cargo clean`) each tick once its container has exited, so a multi-day
#     drain's disk footprint stays bounded (ARACHNE_DISK_RECLAIM=0 disables).
#   * Drains: exits only when no open task remains in range AND no live agent
#     container remains, then pushes ops/ and emits a summary.
#
# Design: ops/planning/2026-06-22 - Autonomous Task Loop v2 — Usage-Governed DAG Pump.md
# Generalizes run-parallel.sh's pool scheduler; shared helpers live in
# scripts/arachne-pump-lib.sh (sourced by both). run-parallel.sh stays the
# manifest path.
#
# Usage:
#   arachne-pump --phases F55..F63 --jobs 4 --usage-ceiling 95 --grain phase
#   arachne-pump --phases F55..F63 --dry-run     # print the plan, launch nothing
#   arachne-pump --phases F64 --list             # one planning pass, then exit
#   arachne-pump --phases F64 --once             # one REAL tick (scrub+gate+launch), exit
#
# Env overrides (mostly for testing / advanced use):
#   ARACHNE_TASK    path to arachne-task   (default: alongside this script)
#   ARACHNE_USAGE   path to arachne-usage  (default: alongside this script)
#   ARACHNE_DISK_WATCHDOG  path to arachne-disk-watchdog (default: alongside this script)
#   ARACHNE_DISK_RECLAIM   1/0 — cargo-clean a phase's target/ once done (default 1)
#   ARACHNE_TOKEN_GATE     1/0 — pause LAUNCHING when the HOST OAuth access token is
#                   stale (default 1). Containers are access-token-only (they cannot
#                   rotate the shared refresh token — that would log the host out;
#                   see entrypoint-parallel.sh), so they cannot self-refresh: the
#                   host must keep its token fresh (a live host `claude` session, or
#                   a manual refresh). Running agents are never killed.
#   ARACHNE_TOKEN_MARGIN_S  seconds before host-token expiry to start pausing (600)
#   ARACHNE_PUMP_WORKTREES_DIR  worktrees base (default: <repo>/.worktrees; tests)
#   DOCKER          docker binary          (default: docker)
#   ARACHNE_PHASE_BRIEF_TEMPLATE  phase-drain brief template (default:
#                   ops/task-loop/briefs/_phase-drain-template.md — built by F64.4)
#   MAX_TURNS, AGENT_MODEL, AGENT_MEMORY_MAX, AGENT_MEMORY_SWAP — forwarded to
#                   launched containers (same meaning as run-parallel.sh).
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=scripts/arachne-pump-lib.sh
source "$SCRIPT_DIR/arachne-pump-lib.sh"

CLAUDE_DIR="$HOME/.claude"
CLAUDE_JSON="$HOME/.claude.json"
OPS_DIR="${ARACHNE_PUMP_OPS_DIR:-$REPO_ROOT/ops}"
# Tasks dir — overridable (independent of OPS_DIR) so phase_dependencies / brief
# rendering can be unit-tested against a flat fixture dir.
TASKS_DIR="${ARACHNE_PUMP_TASKS_DIR:-$OPS_DIR/task-loop/tasks}"

ARACHNE_TASK="${ARACHNE_TASK:-$SCRIPT_DIR/arachne-task}"
ARACHNE_USAGE="${ARACHNE_USAGE:-$SCRIPT_DIR/arachne-usage}"
ARACHNE_DISK_WATCHDOG="${ARACHNE_DISK_WATCHDOG:-$SCRIPT_DIR/arachne-disk-watchdog}"
DOCKER="${DOCKER:-docker}"
ARACHNE_PHASE_BRIEF_TEMPLATE="${ARACHNE_PHASE_BRIEF_TEMPLATE:-$OPS_DIR/task-loop/briefs/_phase-drain-template.md}"
# Worktrees base — overridable so the reclaim sweep / launcher can be unit-tested
# against a fixture tree (single source for both launch_phase and reclaim).
WORKTREES_DIR="${ARACHNE_PUMP_WORKTREES_DIR:-$REPO_ROOT/.worktrees}"

# Defaults (flags override).
PHASES=""
JOBS="${JOBS:-4}"
CEILING="${ARACHNE_USAGE_CEILING:-95}"
GRAIN="phase"
TICK="${POOL_TICK:-30}"
STAGGER="${POOL_STAGGER:-3}"
HEALTH_WINDOW="${HEALTH_WINDOW:-120}"
HEALTH_GATE=1
USAGE_GATE=1
DISK_GATE=1
BRANCH_PREFIX="${ARACHNE_PUMP_BRANCH_PREFIX:-feat/}"
BASE_REF="${ARACHNE_PUMP_BASE:-main}"
BASE_GIVEN=0      # set when --base is passed explicitly (gates the trunk override)
# ── Autonomous integration trunk (A3 / F65.6) ────────────────────────────────
# Opt-in behind --integration-trunk (default OFF): when on, the run cuts every
# phase worktree from a continuously-integrated auto/trunk branch instead of a
# stale base, merges each quiescent phase into it behind a build gate, and
# graduates the whole drain as one auto/trunk → main PR. Flag off ⇒ byte-for-byte
# the prior pump.
INTEGRATION=0
INTEGRATION_TRUNK="${ARACHNE_PUMP_TRUNK:-auto/trunk}"
INTEGRATION_BASE="${ARACHNE_PUMP_INTEGRATION_BASE:-main}"
# Build gate run on each merge into the trunk (empty ⇒ default cargo check +
# smoke). Overridable for tests (ARACHNE_PUMP_BUILD_CMD='false' forces red).
BUILD_GATE_CMD="${ARACHNE_PUMP_BUILD_CMD:-}"
TRUNK_LOCK_FILE="${ARACHNE_PUMP_TRUNK_LOCK_FILE:-$REPO_ROOT/.auto-trunk.lock}"
QUARANTINE_FILE="${ARACHNE_PUMP_QUARANTINE_FILE:-$REPO_ROOT/.auto-trunk-quarantine}"
MAX_TURNS="${MAX_TURNS:-600}"
AGENT_MODEL="${AGENT_MODEL:-opus}"
CAP_FILE="${ARACHNE_POOL_CAP_FILE:-$REPO_ROOT/.arachne-pool-cap}"
RESET_FILE="${ARACHNE_USAGE_RESET_FILE:-$REPO_ROOT/.arachne-usage-reset}"
MODE="run"        # run | dry | list | once | render | help
DETACH=0
STATE_FILE="${ARACHNE_PUMP_STATE_FILE:-$REPO_ROOT/.arachne-pump.state}"
PUMP_LOG="${ARACHNE_PUMP_LOG:-$REPO_ROOT/.arachne-pump.log}"
PUMP_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

warn() { printf 'arachne-pump: %s\n' "$*" >&2; }
die()  { warn "$*"; exit 1; }
log()  { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }
# Quiet per-tick skip traces (e.g. "already integrated") — off unless
# ARACHNE_PUMP_DEBUG=1, so reconcile doesn't spam the log every TICK seconds.
dbg_log() { [[ "${ARACHNE_PUMP_DEBUG:-0}" -eq 1 ]] && log "$*"; return 0; }

# Keep the verbatim argv so --detach can re-exec the same command minus --detach.
ORIG_ARGS=("$@")

# ── Arg parsing ────────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --phases|--phase) PHASES="$2"; shift 2;;
    --phases=*) PHASES="${1#--phases=}"; shift;;
    --phase=*)  PHASES="${1#--phase=}"; shift;;
    --jobs|-j)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--jobs needs a non-negative integer"
      JOBS="$2"; shift 2;;
    --usage-ceiling)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--usage-ceiling needs an integer"
      CEILING="$2"; shift 2;;
    --usage-ceiling=*) CEILING="${1#--usage-ceiling=}"; shift;;
    --grain) GRAIN="$2"; shift 2;;
    --grain=*) GRAIN="${1#--grain=}"; shift;;
    --tick)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--tick needs an integer (seconds)"
      TICK="$2"; shift 2;;
    --branch-prefix) BRANCH_PREFIX="$2"; shift 2;;
    --base) BASE_REF="$2"; BASE_GIVEN=1; shift 2;;
    --integration-trunk) INTEGRATION=1; shift;;
    --integration-base) INTEGRATION_BASE="$2"; shift 2;;
    --integration-base=*) INTEGRATION_BASE="${1#--integration-base=}"; shift;;
    --no-health-gate) HEALTH_GATE=0; shift;;
    --no-usage-gate)  USAGE_GATE=0; shift;;
    --no-disk-gate)   DISK_GATE=0; shift;;
    --dry-run) MODE="dry"; shift;;
    --list)    MODE="list"; shift;;
    --once)    MODE="once"; shift;;
    --render-brief) MODE="render"; PHASES="$2"; shift 2;;   # print rendered brief, exit
    --render-brief=*) MODE="render"; PHASES="${1#--render-brief=}"; shift;;
    --detach)  DETACH=1; shift;;          # F64.5 wires the actual detach mechanism
    -h|--help) MODE="help"; shift;;
    --*) die "unknown flag $1 (try --help)";;
    *) die "unexpected argument: $1";;
  esac
done

usage() {
  sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
}
[[ "$MODE" == "help" ]] && { usage; exit 0; }

[[ -n "$PHASES" ]] || die "--phases is required (e.g. --phases F55..F63)"
case "$GRAIN" in
  phase) ;;
  task|chain) die "grain '$GRAIN' is not implemented yet; only --grain phase is supported (SPEC_GAP: D4 task/chain grains deferred)";;
  *) die "unknown grain '$GRAIN' (phase|task|chain)";;
esac

# When integration is on and the operator did not pin a base, cut worktrees from
# the continuously-integrated trunk rather than the (stale) base branch. An
# explicit --base always wins (e.g. a canary cutting from a throwaway base).
if [[ "$INTEGRATION" -eq 1 && "$BASE_GIVEN" -eq 0 ]]; then
  BASE_REF="$INTEGRATION_TRUNK"
fi

# ── Phase-range expansion (mirrors arachne-task's expand_phases for display) ───
# Numeric ranges + comma lists; non-numeric tokens pass through uppercased.
pump_expand_phases() {
  local spec=$1 comp a b lo hi i n
  local IFS=','
  for comp in $spec; do
    comp="${comp//[[:space:]]/}"; [[ -z "$comp" ]] && continue
    if [[ "$comp" == *..* ]]; then
      a="${comp%%..*}"; b="${comp##*..}"; a="${a#[Ff]}"; b="${b#[Ff]}"
      [[ "$a" =~ ^[0-9]+$ && "$b" =~ ^[0-9]+$ ]] || die "bad phase range '$comp'"
      if (( a <= b )); then lo=$a; hi=$b; else lo=$b; hi=$a; fi
      for (( i=lo; i<=hi; i++ )); do printf 'F%s\n' "$i"; done
    else
      comp="${comp%%.*}"; n="${comp#[Ff]}"
      if [[ "$n" =~ ^[0-9]+$ ]]; then printf 'F%s\n' "$n"; else printf '%s\n' "${comp^^}"; fi
    fi
  done
}

phase_branch()    { printf '%s%s' "$BRANCH_PREFIX" "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"; }
branch_slug()     { printf '%s' "${1//\//-}"; }
phase_container() { printf 'arachne-agent-%s' "$(branch_slug "$(phase_branch "$1")")"; }
# Host worktree the integration trunk is checked out into (A3): auto/trunk →
# <worktrees>/auto-trunk, sharing the configurable worktrees base with phases.
trunk_worktree()  { printf '%s/%s' "$WORKTREES_DIR" "$(branch_slug "$INTEGRATION_TRUNK")"; }
# pump_in_list <needle> <space-separated-haystack> — membership test for the
# dry-run integration stubs (STUB_INTEGRATE_*).
pump_in_list() {
  local needle="$1" item
  for item in ${2:-}; do [[ "$item" == "$needle" ]] && return 0; done
  return 1
}

# Distinct phases present in the live eligible frontier (have ≥1 launchable task).
frontier_phases() {
  "$ARACHNE_TASK" ready --phases "$PHASES" --json 2>/dev/null \
    | jq -r '.[].phase' 2>/dev/null | sort -u
}

# Open-task count across the range (the drain test). 0 ⇒ no open work remains.
open_count() {
  "$ARACHNE_TASK" ready --phases "$PHASES" --count 2>/dev/null || echo 0
}

# Open-task count within a single phase (regardless of blocker state).
phase_open_count() {
  "$ARACHNE_TASK" ready --phase "$1" --count 2>/dev/null || echo 0
}

# Is a phase's worktree branch currently owned by a LIVE container? (D3)
phase_live() {
  local want; want="$(phase_container "$1")"
  local slug
  while IFS= read -r slug; do
    [[ "arachne-agent-$slug" == "$want" ]] && return 0
  done < <(apl_live_agent_slugs)
  return 1
}

# Lowest eligible task id in a phase (the epic/safety-net task for the container).
phase_lead_task() {
  "$ARACHNE_TASK" ready --phase "$1" --json 2>/dev/null | jq -r '.[0].id // empty' 2>/dev/null
}

# ── Liveness-based reclaim (D3 applied to the eligibility path) ─────────────────
# A task left `in_progress` by a DEAD container (no live `arachne-agent` for its
# claimed branch) silently starves the frontier: `ready` excludes claimed tasks,
# so the phase's lead task — and everything blocked behind it — becomes ineligible
# and the pump can neither launch nor drain. (Root cause of the 2026-06-23 F43..F63
# stall: agents 401'd on an expired token and died; the entrypoint's safety-net
# `claim --turns 9999` meant scrub's turn-budget tripwire never reclaimed them.)
#
# D3 says liveness comes from `docker ps`, never task status. The launch path
# already honors this; this closes the gap on the *reclaim* path. Each tick, for
# every in_progress task claimed by a branch THIS pump owns (claimed_by ==
# phase_branch of the task's phase) whose container is dead:
#   * 0 commits ahead of base → `release` to `open` (clean, safe re-attempt).
#   * commits ahead          → leave parked, warn (a human/PR decision; the pump
#                              never auto-loops over committed work).
# The branch/worktree is never touched, so a released task resumes its prior work.
reclaim_orphaned_claims() {
  local -A live=()
  local s; while IFS= read -r s; do [[ -n "$s" ]] && live["$s"]=1; done < <(apl_live_agent_slugs)
  local reclaimed=0 parked=0 id status branch _rest
  while read -r id status branch _rest; do
    [[ "$id" == "ID" || "$status" != "in_progress" ]] && continue
    [[ -z "$branch" || "$branch" == "-" ]] && continue
    # Only touch claims on a branch this pump's naming scheme owns; skip human
    # branches and any other claimant.
    local phase="${id%%.*}"
    [[ "$branch" == "$(phase_branch "$phase")" ]] || continue
    # Live container for this branch ⇒ a legitimate, in-flight claim. Leave it.
    [[ -n "${live["$(branch_slug "$branch")"]:-}" ]] && continue
    # Orphaned claim. Preserve committed work; only auto-reopen clean orphans.
    local ahead; ahead="$(git -C "$REPO_ROOT" rev-list --count "$BASE_REF..$branch" 2>/dev/null || echo 0)"
    if [[ "$ahead" -gt 0 ]]; then
      warn "orphaned claim with committed work: $id ($branch, $ahead commit(s), container dead) — parked for review, not auto-reopened"
      parked=$((parked + 1))
      continue
    fi
    if "$ARACHNE_TASK" release "$id" \
        --reason "Auto-reclaimed by pump: container for $branch is dead and the branch has 0 commits (D3 liveness reclaim)." \
        >/dev/null 2>&1; then
      log "reclaimed orphaned claim $id ($branch — container dead, 0 commits) → open"
      reclaimed=$((reclaimed + 1))
    fi
  done < <("$ARACHNE_TASK" list --status in_progress 2>/dev/null)
  [[ "$reclaimed" -gt 0 ]] && log "liveness reclaim: $reclaimed task(s) released to open"
  [[ "$parked" -gt 0 ]] && warn "liveness reclaim: $parked orphaned claim(s) with committed work need review"
  return 0
}

# ── Feed gate ──────────────────────────────────────────────────────────────────
# Echoes a one-line reason and returns 10 to pause feeding, or returns 0 to feed.
GATE_REASON=""
feed_gate() {
  GATE_REASON=""
  if apl_network_unhealthy; then
    GATE_REASON="brcmfmac wedge signature in last ${HEALTH_WINDOW}s"
    return 10
  fi
  # Host OAuth token freshness (access-token-only container model): containers can
  # no longer self-refresh, so launching one with an already-expired host token
  # just 401s and dies. Pause launching until the host token is refreshed. Cheap
  # local check; self-contained (honors ARACHNE_TOKEN_GATE); fail-open.
  local treason trc
  treason="$(apl_host_token_stale "$CLAUDE_DIR/.credentials.json")"; trc=$?
  if [[ "$trc" -eq 10 ]]; then
    GATE_REASON="$treason"
    return 10
  fi
  if [[ "$USAGE_GATE" -eq 1 ]]; then
    local reason rc
    reason="$(ARACHNE_USAGE_RESET_FILE="$RESET_FILE" "$ARACHNE_USAGE" --gate --ceiling "$CEILING" 2>&1)"; rc=$?
    if [[ "$rc" -eq 10 ]]; then
      GATE_REASON="${reason#arachne-usage: }"
      return 10
    fi
  fi
  if [[ "$DISK_GATE" -eq 1 ]]; then
    local dreason drc
    dreason="$(apl_disk_low)"; drc=$?
    if [[ "$drc" -eq 10 ]]; then
      GATE_REASON="$dreason"
      return 10
    fi
  fi
  return 0
}

# ── Dependency-aware briefs (A3 v1 / F65.6) ────────────────────────────────────
# dep_pr_number <branch> — the open draft-PR number for a dependency branch, or
# empty. Fail-open: empty when gh is absent / disabled (ARACHNE_PUMP_NO_GH=1, for
# hermetic tests) / errors.
dep_pr_number() {
  local branch="$1"
  [[ "${ARACHNE_PUMP_NO_GH:-0}" -eq 1 ]] && return 0
  command -v gh >/dev/null 2>&1 || return 0
  gh pr list --head "$branch" --base main --json number -q '.[0].number // empty' 2>/dev/null || true
}

# phase_cross_blockers <FN> — the unique set of OTHER phases this phase's tasks
# are blocked on (in-phase blockers are the pump's own serial concern), one phase
# token per line. The single source of truth for both the dependency brief (v1)
# and the integration launch gate (v2).
phase_cross_blockers() {
  local phase="$1"
  local -A seen=()
  local f blk bphase
  shopt -s nullglob
  for f in "$TASKS_DIR/$phase."*.md; do
    while IFS= read -r blk; do
      [[ -z "$blk" ]] && continue
      bphase="${blk%%.*}"
      [[ "$bphase" == "$phase" ]] && continue       # in-phase dep — pump-internal
      [[ -n "${seen[$bphase]:-}" ]] && continue
      seen[$bphase]=1
      printf '%s\n' "$bphase"
    done < <(yq --front-matter=extract '.blockers[]?' "$f" 2>/dev/null || true)
  done
  shopt -u nullglob
}

# phase_deps_integrated <FN> — true (0) when EVERY cross-phase blocker's branch is
# already an ancestor of the integration trunk (its code is physically present on
# the base downstream is cut from). The v2 launch gate: a frontier phase whose
# blocker is `done` in the ledger but whose CODE is not yet on auto/trunk stays
# WAITING. Vacuously true with no cross-phase blockers. Test seam: when
# STUB_INTEGRATED is set, only its space-separated phases count as integrated.
phase_deps_integrated() {
  local phase="$1" dp dbranch
  while IFS= read -r dp; do
    [[ -z "$dp" ]] && continue
    dbranch="$(phase_branch "$dp")"
    if [[ -n "${STUB_INTEGRATED+x}" ]]; then
      pump_in_list "$dp" "$STUB_INTEGRATED" || return 1
    else
      apl_phase_integrated "$REPO_ROOT" "$dbranch" "$INTEGRATION_TRUNK" || return 1
    fi
  done < <(phase_cross_blockers "$phase")
  return 0
}

# phase_dependencies <FN> — emit a markdown "Depends on / builds upon" block
# naming this phase's CROSS-PHASE blockers, each resolved to branch / integration
# state / draft PR, so the launched agent learns its lineage instead of
# re-deriving upstream work. No cross-phase blockers ⇒ a single explanatory line.
# Pure-ish: the branch name is string-derived (always present); sha/PR are
# best-effort enrichment.
phase_dependencies() {
  local phase="$1"
  local deps=() dp
  while IFS= read -r dp; do [[ -n "$dp" ]] && deps+=("$dp"); done < <(phase_cross_blockers "$phase")

  if (( ${#deps[@]} == 0 )); then
    printf 'No cross-phase dependencies.\n'
    return 0
  fi

  printf 'This phase builds upon work from other phases. Their code is integrated\n'
  printf 'into the `%s` branch you are based on — do not re-derive it:\n\n' "$INTEGRATION_TRUNK"
  local dp dbranch dstate dpr
  for dp in "${deps[@]}"; do
    dbranch="$(phase_branch "$dp")"
    if apl_phase_integrated "$REPO_ROOT" "$dbranch" "$INTEGRATION_TRUNK"; then
      dstate="integrated @ $(git -C "$REPO_ROOT" rev-parse --short "$dbranch" 2>/dev/null || echo '?')"
    elif git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$dbranch" >/dev/null 2>&1; then
      dstate="not yet integrated"
    else
      dstate="not yet started"
    fi
    dpr="$(dep_pr_number "$dbranch")"
    if [[ -n "$dpr" ]]; then dpr="PR #$dpr"; else dpr="no PR yet"; fi
    printf -- '- **%s** (`%s`) — %s, %s\n' "$dp" "$dbranch" "$dstate" "$dpr"
  done
}

# ── Brief rendering (D6 / F64.4; deps A3 v1) ───────────────────────────────────
# render_brief_stream <phase> — render the parameterized phase-drain template to
# stdout: substitute {{PHASE}} (plain sed — no envsubst, no clash with the
# `$PHASE` / `$(…)` shell examples the brief contains; phase tokens FNN are
# sed-safe) and expand the {{DEPENDS_ON}} placeholder line with the dependency
# block (awk by literal `index()` — avoids multi-line inline sed and the awk
# brace-interval pitfall).
render_brief_stream() {
  local phase="$1"
  local depfile; depfile="$(mktemp)"
  phase_dependencies "$phase" >| "$depfile"
  sed "s/{{PHASE}}/$phase/g" "$ARACHNE_PHASE_BRIEF_TEMPLATE" \
    | awk -v df="$depfile" '
        index($0, "{{DEPENDS_ON}}") { while ((getline line < df) > 0) print line; close(df); next }
        { print }
      '
  rm -f "$depfile" 2>/dev/null || true
}

# render_brief <phase> — write the rendered brief to a transient per-phase file
# and echo its path (the launcher passes the path to the container).
render_brief() {
  local phase="$1"
  [[ -f "$ARACHNE_PHASE_BRIEF_TEMPLATE" ]] \
    || die "phase-drain brief template not found: $ARACHNE_PHASE_BRIEF_TEMPLATE (built by F64.4)"
  local out="$WORKTREES_DIR/$(phase_branch "$phase")/.arachne-phase-brief.md"
  mkdir -p "$(dirname "$out")" 2>/dev/null || true
  render_brief_stream "$phase" >| "$out"
  printf '%s' "$out"
}

# ── Launch one phase's worktree + container ────────────────────────────────────
launch_phase() {
  local phase="$1"
  # Test/maintenance hook: tick through the gate + plan + state logic without
  # materialising worktrees or containers.
  if [[ "${ARACHNE_PUMP_NO_LAUNCH:-0}" -eq 1 ]]; then
    log "would launch $phase -> $(phase_branch "$phase") (NO_LAUNCH)"
    return 0
  fi
  local branch; branch="$(phase_branch "$phase")"
  local wt="$WORKTREES_DIR/$branch"
  local cname; cname="$(phase_container "$phase")"
  local lead; lead="$(phase_lead_task "$phase")"

  # Materialise the worktree (idempotent). Create the branch from BASE_REF if new.
  if [[ ! -d "$wt" ]]; then
    if git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$branch" >/dev/null 2>&1; then
      git -C "$REPO_ROOT" worktree add "$wt" "$branch" >/dev/null
    else
      git -C "$REPO_ROOT" worktree add "$wt" -b "$branch" "$BASE_REF" >/dev/null
    fi
  fi
  [[ -f "$wt/ops/planning/STATUS.md" ]] || git -C "$wt" submodule update --init --recursive 2>&1 | tail -1 || true
  apl_repair_worktree_gitignore "$REPO_ROOT"
  if (cd "$REPO_ROOT" && git check-ignore -q "$wt" 2>/dev/null); then
    warn "worktree still gitignored: $wt — fix .gitignore; skipping $phase"; return 1
  fi

  # v2: refresh a reused/stale worktree with newly-integrated upstream deps. A
  # worktree cut from auto/trunk BEFORE a dependency integrated will not contain
  # it; merging the current trunk in makes a relaunch inherit upstream (a first
  # launch from BASE_REF=trunk is already up to date → no-op). Conflict → abort,
  # skip the launch, and quarantine (same gate as reconcile_trunk). Integration
  # off ⇒ untouched.
  if [[ "$INTEGRATION" -eq 1 ]] && git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$INTEGRATION_TRUNK" >/dev/null 2>&1; then
    if ! git -C "$wt" merge --no-ff --no-edit "$INTEGRATION_TRUNK" >/dev/null 2>&1; then
      git -C "$wt" merge --abort >/dev/null 2>&1 || true
      warn "worktree $wt conflicts with $INTEGRATION_TRUNK; skipping launch of $phase"
      quarantine_phase "$phase" "$(git -C "$wt" rev-parse HEAD 2>/dev/null)" "worktree merge conflict"
      return 1
    fi
  fi

  local brief; brief="$(render_brief "$phase")"

  "$DOCKER" rm -f "$cname" >/dev/null 2>&1 || true
  local cid
  cid=$("$DOCKER" run --rm -d \
    --name "$cname" \
    --cap-add NET_ADMIN \
    --memory "${AGENT_MEMORY_MAX:-3g}" \
    --memory-swap "${AGENT_MEMORY_SWAP:-5g}" \
    -e GITHUB_TOKEN="${GITHUB_TOKEN:-}" \
    -e WORKSPACE_PATH="$wt" \
    -e REPO_ROOT="$REPO_ROOT" \
    -e ARACHNE_BRIEF="$brief" \
    -e ARACHNE_TASK_ID="$lead" \
    -e ARACHNE_PHASE="$phase" \
    -e MAX_TURNS="$MAX_TURNS" \
    -e AGENT_MODEL="$AGENT_MODEL" \
    -v "$CLAUDE_DIR":/tmp/claude-home:ro \
    -v "$CLAUDE_JSON":/tmp/claude-home-json/.claude.json:ro \
    -v "$REPO_ROOT":"$REPO_ROOT":ro \
    -v "$REPO_ROOT/.git":"$REPO_ROOT/.git" \
    -v "$wt":"$wt" \
    -v "$REPO_ROOT/ops":"$REPO_ROOT/ops" \
    -w "$wt" \
    arachne /entrypoint-parallel.sh)
  log "launched $phase -> $cname ($(printf '%s' "$cid" | cut -c1-12))  lead=$lead  log: $wt/.arachne-agent.log"
  return 0
}

# ── Autonomous integration trunk (A3 / F65.6) ──────────────────────────────────
# ensure_trunk — startup, real-run only: create auto/trunk from INTEGRATION_BASE
# if absent and materialise its dedicated host worktree (idempotent). The host —
# not a container — owns the trunk worktree (decision 1): the merge/build runs on
# the host's fresh auth, never inside a dying container.
ensure_trunk() {
  [[ "$INTEGRATION" -eq 1 ]] || return 0
  if ! git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$INTEGRATION_TRUNK" >/dev/null 2>&1; then
    git -C "$REPO_ROOT" branch "$INTEGRATION_TRUNK" "$INTEGRATION_BASE" \
      || die "cannot create $INTEGRATION_TRUNK from $INTEGRATION_BASE"
    log "created integration trunk $INTEGRATION_TRUNK from $INTEGRATION_BASE"
  fi
  local twt; twt="$(trunk_worktree)"
  if [[ ! -d "$twt" ]]; then
    git -C "$REPO_ROOT" worktree add "$twt" "$INTEGRATION_TRUNK" >/dev/null \
      || die "cannot add trunk worktree $twt"
    log "integration trunk worktree at $twt"
  fi
  [[ -f "$twt/ops/planning/STATUS.md" ]] || git -C "$twt" submodule update --init --recursive 2>&1 | tail -1 || true
  apl_repair_worktree_gitignore "$REPO_ROOT"
}

# run_build_gate <worktree> — the gate every merge into the trunk must pass. A
# configured BUILD_GATE_CMD (tests / advanced) wholly replaces the default
# (cargo check --workspace, then smoke_test.sh if present). Returns the gate's
# exit status; 0 == green.
run_build_gate() {
  local wt="$1"
  if [[ -n "$BUILD_GATE_CMD" ]]; then
    ( cd "$wt" && WORKSPACE_PATH="$wt" eval "$BUILD_GATE_CMD" ) >/dev/null 2>&1
    return $?
  fi
  ( cd "$wt" && cargo check --workspace ) >/dev/null 2>&1 || return 1
  if [[ -x "$wt/smoke_test.sh" ]]; then
    ( cd "$wt" && WORKSPACE_PATH="$wt" ./smoke_test.sh ) >/dev/null 2>&1 || return 1
  fi
  return 0
}

# run_build_gate_dry — the dry-run build gate: run ONLY an explicitly-configured
# BUILD_GATE_CMD (so a test's `false` forces red) and never the real cargo. No
# command configured ⇒ assume green.
run_build_gate_dry() {
  [[ -n "$BUILD_GATE_CMD" ]] || return 0
  ( eval "$BUILD_GATE_CMD" ) >/dev/null 2>&1
}

# quarantine_phase <phase> <pre-sha> <reason> — a conflicting or build-red merge
# does NOT advance the trunk; the phase is flagged needs-review (real run) and a
# host quarantine marker is appended so a human can reconcile feat/fN later. The
# un-integrated branch simply stops propagating. Honors the dry-run seam.
quarantine_phase() {
  local phase="$1" sha="$2" reason="$3"
  local lead; lead="$(phase_lead_task "$phase")"
  [[ -z "$lead" ]] && lead="$phase.0"
  if [[ "${ARACHNE_PUMP_INTEGRATE_DRYRUN:-0}" -eq 1 ]]; then
    log "would quarantine $phase: $reason"
    log "would needs-review $lead: $reason"
  else
    log "quarantine $phase: $reason — not advancing $INTEGRATION_TRUNK; $lead → needs-review"
    "$ARACHNE_TASK" needs-review "$lead" --reason "auto/trunk integration $reason ($phase)" >/dev/null 2>&1 \
      || warn "needs-review $lead failed"
    pump_notify "auto/trunk: quarantined $phase ($reason); $lead flagged needs-review"
  fi
  printf '%s %s %s\n' "$phase" "${sha:-?}" "$reason" >> "$QUARANTINE_FILE" 2>/dev/null || true
}

# integrate_one_phase <phase> — merge a single quiescent phase branch into the
# trunk under the merge lock + build gate. Returns 0 always (fail-open).
integrate_one_phase() {
  local phase="$1" branch; branch="$(phase_branch "$phase")"
  # Never merge a tree an agent is mid-edit on (decision 3, quiescence proxy).
  if phase_live "$phase"; then
    dbg_log "skip integrate $phase: live container (not quiescent)"
    return 0
  fi
  if [[ "${ARACHNE_PUMP_INTEGRATE_DRYRUN:-0}" -eq 1 ]]; then
    integrate_one_phase_dryrun "$phase" "$branch"
  else
    integrate_one_phase_real "$phase" "$branch"
  fi
  return 0
}

# Dry-run integration: no git/cargo. STUB_INTEGRATE_NOBRANCH / _ANCESTOR /
# _CONFLICT (space-separated phase lists) drive branch-exists / already-integrated
# / merge-conflict; BUILD_GATE_CMD drives the gate. Logs would-integrate /
# would-quarantine lines for the harness to assert.
integrate_one_phase_dryrun() {
  local phase="$1"
  if pump_in_list "$phase" "${STUB_INTEGRATE_NOBRANCH:-}"; then
    dbg_log "skip integrate $phase: branch absent (stub)"; return 0
  fi
  if pump_in_list "$phase" "${STUB_INTEGRATE_ANCESTOR:-}"; then
    dbg_log "skip integrate $phase: already an ancestor of $INTEGRATION_TRUNK (stub)"; return 0
  fi
  if pump_in_list "$phase" "${STUB_INTEGRATE_CONFLICT:-}"; then
    quarantine_phase "$phase" "stub" "conflict"; return 0
  fi
  if ! run_build_gate_dry; then
    quarantine_phase "$phase" "stub" "build red"; return 0
  fi
  log "would integrate $phase"
}

# Real integration: under the trunk flock, merge feat/fN --no-ff into the trunk
# worktree; conflict → abort + quarantine; build-red → reset --hard + quarantine;
# green → keep, log, optionally push.
integrate_one_phase_real() {
  local phase="$1" branch="$2"
  git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$branch" >/dev/null 2>&1 \
    || { dbg_log "skip integrate $phase: no branch $branch"; return 0; }
  if apl_phase_integrated "$REPO_ROOT" "$branch" "$INTEGRATION_TRUNK"; then
    dbg_log "skip integrate $phase: $branch already an ancestor of $INTEGRATION_TRUNK"; return 0
  fi
  local twt; twt="$(trunk_worktree)"
  [[ -d "$twt" ]] || { warn "trunk worktree missing ($twt); skipping $phase"; return 0; }
  (
    apl_acquire_trunk_lock "$TRUNK_LOCK_FILE" || { warn "trunk lock busy; deferring $phase to next tick"; exit 0; }
    local pre; pre="$(git -C "$twt" rev-parse HEAD 2>/dev/null)"
    if ! git -C "$twt" merge --no-ff --no-edit "$branch" >/dev/null 2>&1; then
      git -C "$twt" merge --abort >/dev/null 2>&1 || true
      quarantine_phase "$phase" "$pre" "conflict"
      exit 0
    fi
    if ! run_build_gate "$twt"; then
      git -C "$twt" reset --hard "$pre" >/dev/null 2>&1 || true
      quarantine_phase "$phase" "$pre" "build red"
      exit 0
    fi
    local post; post="$(git -C "$twt" rev-parse HEAD 2>/dev/null)"
    log "integrated $phase @ $(printf '%s' "$post" | cut -c1-12)"
    [[ "${ARACHNE_PUMP_TRUNK_PUSH:-0}" -eq 1 ]] && git -C "$twt" push >/dev/null 2>&1 || true
    exit 0
  ) || true
}

# reconcile_trunk — the host integration step (decision 1): walk every phase in
# range and integrate each quiescent, not-yet-integrated branch. Wired into
# do_tick AFTER scrub and BEFORE feed_gate so finished work keeps propagating
# even while LAUNCHING is usage-paused (integration is local compute, no tokens).
# Guarded on INTEGRATION=1; returns 0 always (fail-open — a wedged merge delays
# integration, never the tick).
reconcile_trunk() {
  [[ "$INTEGRATION" -eq 1 ]] || return 0
  local p
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    integrate_one_phase "$p" || true
  done < <(pump_expand_phases "$PHASES")
  return 0
}

# graduate_trunk — drain tail (real run only): open exactly one auto/trunk → main
# PR (idempotent: refresh if it exists). main receives no direct commits — the
# separate trunk buffer keeps integration continuous while review stays batched.
graduate_trunk() {
  [[ "$INTEGRATION" -eq 1 ]] || return 0
  command -v gh >/dev/null 2>&1 || { warn "gh absent; cannot graduate $INTEGRATION_TRUNK → main"; return 0; }
  local twt; twt="$(trunk_worktree)"
  local existing
  existing="$(gh pr list --head "$INTEGRATION_TRUNK" --base main --json number -q '.[0].number // empty' 2>/dev/null || true)"
  if [[ -n "$existing" ]]; then
    log "graduation PR #$existing already open for $INTEGRATION_TRUNK; left as-is"
    return 0
  fi
  [[ -d "$twt" ]] && git -C "$twt" push -u origin "$INTEGRATION_TRUNK" >/dev/null 2>&1 \
    || warn "push $INTEGRATION_TRUNK failed (continuing to PR)"
  local quarantined=""
  [[ -f "$QUARANTINE_FILE" ]] && quarantined="$(cat "$QUARANTINE_FILE" 2>/dev/null || true)"
  local body
  body="$(printf 'Autonomous integration of phases %s via %s.\n' "$PHASES" "$INTEGRATION_TRUNK")"
  if [[ -n "$quarantined" ]]; then
    body="$(printf '%s\nQuarantined (needs human reconciliation):\n%s\n' "$body" "$quarantined")"
  fi
  if gh pr create --base main --head "$INTEGRATION_TRUNK" \
      --title "auto: integrate $PHASES" --body "$body" >/dev/null 2>&1; then
    log "opened graduation PR $INTEGRATION_TRUNK → main"
  else
    warn "gh pr create for $INTEGRATION_TRUNK → main failed"
  fi
}

# ── Planning pass: classify every phase in range ───────────────────────────────
# Sets arrays LAUNCH/RUNNING/WAITING/DONEP. Returns the plan via globals.
declare -a PLAN_LAUNCH PLAN_RUNNING PLAN_WAITING PLAN_DONE
declare -A PLAN_WAIT_REASON
compute_plan() {
  PLAN_LAUNCH=(); PLAN_RUNNING=(); PLAN_WAITING=(); PLAN_DONE=(); PLAN_WAIT_REASON=()
  local -A in_frontier=()
  local p
  while IFS= read -r p; do [[ -n "$p" ]] && in_frontier["$p"]=1; done < <(frontier_phases)
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    local oc; oc="$(phase_open_count "$p")"
    if [[ -n "${in_frontier[$p]:-}" ]]; then
      if phase_live "$p"; then
        PLAN_RUNNING+=("$p")
      elif [[ "$INTEGRATION" -eq 1 ]] && ! phase_deps_integrated "$p"; then
        # v2: ledger says ready, but a cross-phase dep's CODE is not yet on the
        # trunk this phase would be cut from. Hold until the merge lands so the
        # worktree physically contains its dependencies (RC-3 closure).
        PLAN_WAITING+=("$p")
        PLAN_WAIT_REASON["$p"]="deps done but not yet integrated into $INTEGRATION_TRUNK"
      else
        PLAN_LAUNCH+=("$p")
      fi
    elif [[ "$oc" -gt 0 ]]; then
      # Has open tasks but none eligible — gated on incomplete cross-phase deps,
      # unless a live container is already draining it.
      if phase_live "$p"; then
        PLAN_RUNNING+=("$p")
      else
        PLAN_WAITING+=("$p")
        PLAN_WAIT_REASON["$p"]="$oc open, none eligible — cross-phase blockers pending"
      fi
    else
      PLAN_DONE+=("$p")
    fi
  done < <(pump_expand_phases "$PHASES")
}

print_plan() {
  compute_plan
  local gate_line; if feed_gate; then gate_line="GATE: feed-ok"; else gate_line="GATE: PAUSED — $GATE_REASON"; fi
  echo "arachne-pump plan — phases $PHASES, grain $GRAIN, cap $(JOBS=$JOBS apl_read_cap), ceiling $CEILING%"
  echo "$gate_line"
  local p
  for p in "${PLAN_LAUNCH[@]:-}";  do [[ -n "$p" ]] && printf '  LAUNCH   %-6s -> %s\n' "$p" "$(phase_branch "$p")"; done
  for p in "${PLAN_RUNNING[@]:-}"; do [[ -n "$p" ]] && printf '  RUNNING  %-6s -> %s (live container)\n' "$p" "$(phase_branch "$p")"; done
  for p in "${PLAN_WAITING[@]:-}"; do [[ -n "$p" ]] && printf '  WAITING  %-6s (%s)\n' "$p" "${PLAN_WAIT_REASON[$p]:-cross-phase blockers pending}"; done
  for p in "${PLAN_DONE[@]:-}";    do [[ -n "$p" ]] && printf '  DONE     %-6s (no open tasks)\n' "$p"; done
  echo "frontier: ${#PLAN_LAUNCH[@]} launchable, ${#PLAN_RUNNING[@]} running, ${#PLAN_WAITING[@]} waiting | open tasks in range: $(open_count)"
}

# ── Reclaim build artifacts of completed phases (A4 / F65.3) ───────────────────
# After compute_plan, every phase with no open tasks is in PLAN_DONE — its agent
# container has exited (a resumable phase still has an open task and is never
# PLAN_DONE), so its worktree target/ is dead weight. Reclaim it to keep a
# multi-day drain's disk footprint bounded. Guards: never touch a phase with a
# live container (phase_live), and only remove build artifacts — source files and
# every commit are untouched. Runs every tick regardless of the feed gate, so a
# disk-pressure pause can self-heal as completed phases free their target/ dirs.
# Disabled with ARACHNE_DISK_RECLAIM=0.
reclaim_done_targets() {
  [[ "${ARACHNE_DISK_RECLAIM:-1}" -eq 1 ]] || return 0
  local p wt sz
  for p in "${PLAN_DONE[@]:-}"; do
    [[ -z "$p" ]] && continue
    wt="$WORKTREES_DIR/$(phase_branch "$p")"
    [[ -d "$wt/target" ]] || continue
    phase_live "$p" && continue
    sz="$(du -sh "$wt/target" 2>/dev/null | cut -f1)"
    if command -v cargo >/dev/null 2>&1; then
      if cargo clean --manifest-path "$wt/Cargo.toml" >/dev/null 2>&1; then
        log "reclaimed $p target/ (${sz:-?}) via cargo clean"
      else
        warn "cargo clean failed for $p ($wt); run scripts/arachne-cleanup --targets to reclaim"
      fi
    elif rm -rf "$wt/target"; then
      log "reclaimed $p target/ (${sz:-?}) via rm -rf (no cargo)"
    fi
  done
}

# ── One tick: scrub, plan, reclaim, gate, top up the pool to cap ───────────────
do_tick() {
  git -C "$OPS_DIR" pull --ff-only >/dev/null 2>&1 || warn "ops pull --ff-only failed (continuing)"
  "$ARACHNE_TASK" scrub >/dev/null 2>&1 || warn "scrub failed (continuing)"
  reclaim_orphaned_claims   # D3: free tasks parked by dead containers before planning

  # Strip any `.worktrees/` ignore line the `gh worktree` extension auto-appended
  # since the last tick BEFORE the FS-GUARD reads the tree. The repair is also
  # called inside launch_phase, but launches don't run while feeding is paused
  # (usage ceiling, disk, WiFi) — so without this every-tick call a stray append
  # would leave .gitignore dirty and the FS-GUARD would idle-loop on it (the
  # 2026-06-24 incident). Idempotent: a no-op unless the bad line is present.
  apl_repair_worktree_gitignore "$REPO_ROOT"

  # RC-4 contamination guard (A8 / F65.5): flag any primary-source dirtiness an
  # agent slipped past the read-only mount. Clean under normal operation. Always
  # log it, but desktop-notify only when the contamination CHANGES — otherwise a
  # persistent dirty tree spams a notification every tick (TICK seconds). The
  # fingerprint persists in a gitignored marker so dedup survives restarts.
  local fs_dirt fsg_mark="$REPO_ROOT/.arachne-fsguard.notified"
  fs_dirt="$(apl_fs_guard "$REPO_ROOT")"
  if [[ -n "$fs_dirt" ]]; then
    log "$fs_dirt"
    if [[ "$fs_dirt" != "$(cat "$fsg_mark" 2>/dev/null)" ]]; then
      pump_notify "$fs_dirt"
      printf '%s' "$fs_dirt" >"$fsg_mark" 2>/dev/null || true
    fi
  else
    rm -f "$fsg_mark" 2>/dev/null || true   # clean again → re-arm for next time
  fi

  # Integrate finished phases into auto/trunk (A3). Runs after scrub and BEFORE
  # feed_gate: integration is local compute (no API tokens), so finished work
  # keeps propagating even while LAUNCHING is usage-paused. No-op when the
  # integration trunk is off (INTEGRATION=0).
  reconcile_trunk

  # Plan + reclaim run before the gate: classification is read-only and reclaim
  # frees disk for DONE phases even while feeding is paused (e.g. on the disk gate).
  compute_plan
  reclaim_done_targets

  if ! feed_gate; then
    log "PAUSED feeding — $GATE_REASON (running agents untouched)"
    write_state paused "$GATE_REASON"
    return 0
  fi

  local cap have launched=0 p
  cap="$(JOBS=$JOBS apl_read_cap)"
  have="$(apl_count_live_agents)"
  for p in "${PLAN_LAUNCH[@]:-}"; do
    [[ -z "$p" ]] && continue
    (( have >= cap )) && break
    if launch_phase "$p"; then
      have=$((have + 1)); launched=$((launched + 1)); sleep "$STAGGER"
    fi
  done
  [[ "$launched" -gt 0 ]] && log "tick: launched $launched (live=$have/$cap)"
  write_state running ""
  return 0
}

# ── Drain check ────────────────────────────────────────────────────────────────
is_drained() {
  [[ "$(open_count)" -eq 0 && "$(apl_count_live_agents)" -eq 0 ]]
}

# ── Restart-safe state (E2) ────────────────────────────────────────────────────
# Persist enough that a restarted supervisor (or the monitor) can re-derive what
# is in flight. Restart safety itself falls out of D3: liveness comes from
# `docker ps` and the queue is recomputed each tick, so a fresh supervisor never
# disturbs running containers and never double-launches — the state file just
# makes the run observable (paused_reason) and lets a restart confirm it is
# resuming the same range.
write_state() {  # $1=status(running|paused|drained) $2=paused_reason
  local status="${1:-running}" reason="${2:-}"
  jq -n \
    --arg phases "$PHASES" --argjson jobs "$JOBS" --argjson ceiling "$CEILING" \
    --arg grain "$GRAIN" --arg started "$PUMP_STARTED_AT" \
    --arg last_tick "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson live "$(apl_count_live_agents)" --argjson open "$(open_count)" \
    --arg status "$status" --arg reason "$reason" \
    '{phases:$phases, jobs:$jobs, ceiling:$ceiling, grain:$grain,
      started_at:$started, last_tick:$last_tick, live_agents:$live,
      open_tasks:$open, status:$status, paused_reason:$reason}' \
    >| "$STATE_FILE" 2>/dev/null || true
}

# ── Notify (E5) ────────────────────────────────────────────────────────────────
# Pluggable: ARACHNE_NOTIFY_CMD reads the message on stdin; defaults to
# `notify-send` (desktop) when present, else a no-op (just the log line).
pump_notify() {
  local msg="$1"
  log "$msg"
  if [[ -n "${ARACHNE_NOTIFY_CMD:-}" ]]; then
    printf '%s\n' "$msg" | ${ARACHNE_NOTIFY_CMD} >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "arachne-pump" "$msg" >/dev/null 2>&1 || true
  fi
}

# ── Detach (E3) ────────────────────────────────────────────────────────────────
# Re-exec the SAME command minus --detach, fully detached so a multi-day run
# survives terminal close / SSH drop. Prefers a transient systemd --user unit
# (clean `journalctl --user -u arachne-pump`, Restart not set for transient —
# use scripts/arachne-pump.service for restart-on-failure); falls back to
# setsid+nohup. The persistent unit template is scripts/arachne-pump.service.
detach_and_exit() {
  local -a fwd=()
  local a
  for a in "${ORIG_ARGS[@]}"; do [[ "$a" == "--detach" ]] || fwd+=("$a"); done
  local unit="arachne-pump-$(printf '%s' "$PHASES" | tr -c 'A-Za-z0-9' '-')"
  if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
    systemd-run --user --collect --unit="$unit" \
      --description="Arachne usage-governed pump ($PHASES)" \
      --setenv=GITHUB_TOKEN="${GITHUB_TOKEN:-}" \
      "$0" "${fwd[@]}"
    log "detached as systemd --user unit '$unit'."
    log "  status: systemctl --user status $unit   logs: journalctl --user -u $unit -f"
    log "  stop:   systemctl --user stop $unit"
  else
    setsid nohup "$0" "${fwd[@]}" >>"$PUMP_LOG" 2>&1 </dev/null &
    local pid=$!
    disown "$pid" 2>/dev/null || true
    log "detached via setsid+nohup (pid=$pid, log=$PUMP_LOG)."
    log "  stop: kill $pid   (or: pkill -f 'arachne-pump.*$PHASES')"
  fi
  exit 0
}

# ── Modes ──────────────────────────────────────────────────────────────────────
case "$MODE" in
  render)
    # Print the phase-drain brief rendered for $PHASES to stdout (debug / test).
    # Goes through render_brief_stream so {{DEPENDS_ON}} is expanded too (v1).
    [[ -f "$ARACHNE_PHASE_BRIEF_TEMPLATE" ]] \
      || die "phase-drain brief template not found: $ARACHNE_PHASE_BRIEF_TEMPLATE (built by F64.4)"
    render_brief_stream "$PHASES"
    exit 0
    ;;
  dry)
    echo "[dry-run] no image build, no launches, no ops mutation"
    print_plan
    exit 0
    ;;
  list)
    print_plan
    exit 0
    ;;
esac

# Real run (run / once): detach first if asked, then check prerequisites.
[[ "$DETACH" -eq 1 && "$MODE" == "run" ]] && detach_and_exit

# Restart detection (E2): a leftover state file for the SAME range means we are
# resuming; D3 makes that safe (re-derive from task files + docker ps).
if [[ -f "$STATE_FILE" ]]; then
  prev_phases="$(jq -r '.phases // empty' "$STATE_FILE" 2>/dev/null || true)"
  if [[ "$prev_phases" == "$PHASES" ]]; then
    log "resuming pump for $PHASES (re-deriving from task files + docker ps; running agents untouched)."
  elif [[ -n "$prev_phases" ]]; then
    warn "a pump state file exists for a different range ($prev_phases); overwriting with $PHASES."
  fi
fi

[[ -d "$CLAUDE_DIR" ]] || die "no ~/.claude; run 'claude' to authenticate first"
if [[ -z "${GITHUB_TOKEN:-}" ]] && command -v gh >/dev/null 2>&1; then
  GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"; export GITHUB_TOKEN
fi
[[ -f "$ARACHNE_PHASE_BRIEF_TEMPLATE" ]] \
  || die "phase-drain brief template missing: $ARACHNE_PHASE_BRIEF_TEMPLATE (build F64.4 first)"

# Seed the live cap file for discoverability / retuning.
[[ -f "$CAP_FILE" ]] || echo "$JOBS" >| "$CAP_FILE" 2>/dev/null || true

# Skip the (~9 GB) image build when we will not launch containers — keeps the
# NO_LAUNCH tick (tests / live read-only validation) side-effect-free.
if [[ "${ARACHNE_PUMP_NO_LAUNCH:-0}" -ne 1 ]]; then
  log "Building arachne image ..."
  "$DOCKER" build -t arachne "$REPO_ROOT" >/dev/null || die "image build failed"
fi

# Materialise auto/trunk + its worktree once, before the loop (A3). Real run
# only — skipped under NO_LAUNCH (tests / read-only validation) and a no-op when
# --integration-trunk is off.
if [[ "${ARACHNE_PUMP_NO_LAUNCH:-0}" -ne 1 ]]; then
  ensure_trunk
fi

# Belt-and-suspenders disk discipline (A4): auto-start the disk watchdog like
# run-parallel.sh does, so disk pressure also drops the live pool cap (cap-file
# path) on top of the feed gate. --auto-exit retires it once no agents remain.
# Skipped for --once / NO_LAUNCH ticks and when the disk gate is disabled.
if [[ "$MODE" == "run" && "$DISK_GATE" -eq 1 && "${ARACHNE_PUMP_NO_LAUNCH:-0}" -ne 1 ]]; then
  nohup "$ARACHNE_DISK_WATCHDOG" --auto-exit \
    >>"$REPO_ROOT/.arachne-disk-watchdog.log" 2>&1 </dev/null &
  disown "$!" 2>/dev/null || true
  log "disk watchdog started (cap-file path; log: .arachne-disk-watchdog.log)"
fi

log "Pump: phases=$PHASES grain=$GRAIN cap=$JOBS (live via $CAP_FILE) ceiling=${CEILING}% tick=${TICK}s"
log "Singular supervisor; Ctrl-C stops feeding but leaves running agents. Monitor: scripts/arachne-monitor --watch"

if [[ "$MODE" == "once" ]]; then
  do_tick
  log "single tick complete (--once)"
  exit 0
fi

# Multi-day drain loop.
while true; do
  do_tick
  if is_drained; then
    log "range $PHASES drained: no open tasks and no live agents remain."
    break
  fi
  sleep "$TICK"
done

# Graduate the integration trunk as one auto/trunk → main PR (A3, no-op when
# --integration-trunk is off), then push canonical ops/.
graduate_trunk
git -C "$OPS_DIR" push >/dev/null 2>&1 || warn "final ops push failed"
write_state drained ""
# Tally non-done terminal states that need a human (blocked / stuck / needs-review).
attention=$("$ARACHNE_TASK" list 2>/dev/null \
  | awk '$2=="blocked"||$2=="stuck"||$2=="needs-review"{n++} END{print n+0}')
pump_notify "$PHASES drained: 0 open should remain ($(open_count) open), $attention task(s) need human review (blocked/stuck/needs-review)."
exit 0
