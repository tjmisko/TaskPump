#!/usr/bin/env bash
# arachne-usage — Max-plan usage-governor probe for the autonomous task-loop pump.
#
# Wraps the official OAuth usage endpoint (the same meter the user's
# ~/.claude/claude-status toolbar reads) into a single feed/pause decision the
# pump consumes each tick. See the design doc §C:
#   ops/planning/2026-06-22 - Autonomous Task Loop v2 — Usage-Governed DAG Pump.md
#
# Contract (confirmed 2026-06-22):
#   GET https://api.anthropic.com/api/oauth/usage
#     Authorization: Bearer <.claudeAiOauth.accessToken from ~/.claude/.credentials.json>
#     anthropic-beta: oauth-2025-04-20
#   → { five_hour:{utilization,resets_at}, seven_day:{...}, seven_day_opus:null|{...},
#       seven_day_sonnet:{...}, limits:[{kind,percent,severity,resets_at,...}] }
#
# bind_percent = max(five_hour.utilization, seven_day.utilization,
#                    seven_day_opus.utilization // 0). Range runs use Opus, so the
# Opus weekly cap is included; the Sonnet-scoped weekly cap is deliberately
# excluded (it never gates an Opus run). reset_at = the soonest resets_at among
# the window(s) currently at bind_percent (when headroom returns).
#
# Modes:
#   arachne-usage --percent            integer bind_percent, or "unknown"
#   arachne-usage --json               {bind_percent,reset_epoch,reset_at,
#                                        five_hour,seven_day,seven_day_opus,severity}
#   arachne-usage --gate --ceiling 95  exit 0 = feed OK, exit 10 = pause
#                                       (at/over ceiling, OR inside a reset-backstop
#                                       window); one-line reason on stderr
#   arachne-usage --scan-logs '<glob>' scan agent logs for a "limit reached / resets
#                                       at" signal and write the reset epoch to the
#                                       backstop file (belt-and-suspenders hard pause)
#
# Fail-open: when offline / token missing / curl|jq absent / no fresh cache, the
# bind_percent is reported "unknown" and --gate exits 0 (feed OK) with a warning
# on stderr — the pump must never wedge because the meter is briefly unreachable.
#
# No secret is ever printed; the token only ever appears in the Authorization
# header passed to curl via @- (stdin), never on argv or in output.
#
# Env overrides:
#   ARACHNE_CREDENTIALS       default ~/.claude/.credentials.json
#   ARACHNE_USAGE_CACHE       default /tmp/claude-plan-usage.json  (shared w/ toolbar)
#   ARACHNE_USAGE_TTL         cache freshness seconds, default 60
#   ARACHNE_USAGE_RESET_FILE  reset-backstop file, default <repo-root>/.arachne-usage-reset
#   ARACHNE_USAGE_ENDPOINT    default https://api.anthropic.com/api/oauth/usage
#   ARACHNE_USAGE_CEILING     default ceiling for --gate, default 95
#   ARACHNE_USAGE_DEBUG=1     stderr debug traces
set -euo pipefail

_script_dir="$(CDPATH= cd -- "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
_repo_root="$(CDPATH= cd -- "$_script_dir/.." && pwd)"

: "${ARACHNE_CREDENTIALS:=$HOME/.claude/.credentials.json}"
: "${ARACHNE_USAGE_CACHE:=/tmp/claude-plan-usage.json}"
: "${ARACHNE_USAGE_TTL:=60}"
: "${ARACHNE_USAGE_RESET_FILE:=$_repo_root/.arachne-usage-reset}"
: "${ARACHNE_USAGE_ENDPOINT:=https://api.anthropic.com/api/oauth/usage}"
: "${ARACHNE_USAGE_CEILING:=95}"
: "${ARACHNE_USAGE_DEBUG:=0}"

dbg() { [[ "$ARACHNE_USAGE_DEBUG" == "1" ]] && printf '[arachne-usage] %s\n' "$*" >&2; return 0; }
warn() { printf 'arachne-usage: %s\n' "$*" >&2; }
die() { warn "$*"; exit 1; }

# ── Probe: ensure the cache holds a fresh, valid usage payload ─────────────────
# Returns 0 if $ARACHNE_USAGE_CACHE holds a parseable usage JSON (fresh, or just
# refreshed); 1 if no usable payload could be obtained (offline / no token / no
# tools / stale cache that can't be refreshed).
cache_age() {
  [[ -f "$ARACHNE_USAGE_CACHE" ]] || { echo 999999; return; }
  local m; m="$(stat -c %Y "$ARACHNE_USAGE_CACHE" 2>/dev/null || echo 0)"
  echo $(( $(date +%s) - m ))
}

cache_valid() {
  [[ -f "$ARACHNE_USAGE_CACHE" ]] || return 1
  jq -e '.five_hour' "$ARACHNE_USAGE_CACHE" >/dev/null 2>&1
}

fetch_usage() {
  # Reuse a fresh cache (possibly warmed by the statusline) without hitting the API.
  if [[ "$(cache_age)" -lt "$ARACHNE_USAGE_TTL" ]] && cache_valid; then
    dbg "cache fresh ($(cache_age)s < ${ARACHNE_USAGE_TTL}s)"
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    dbg "curl/jq unavailable; cannot refresh"
    cache_valid && { dbg "falling back to stale-but-valid cache"; return 0; }
    return 1
  fi
  local token=""
  if [[ -f "$ARACHNE_CREDENTIALS" ]]; then
    token="$(jq -r '.claudeAiOauth.accessToken // empty' "$ARACHNE_CREDENTIALS" 2>/dev/null || true)"
  fi
  if [[ -z "$token" || "$token" == "null" ]]; then
    dbg "no OAuth token in $ARACHNE_CREDENTIALS"
    cache_valid && { dbg "falling back to stale-but-valid cache"; return 0; }
    return 1
  fi
  # Pass the bearer header on stdin (@-) so the token never lands on argv.
  local resp
  resp="$(printf 'Authorization: Bearer %s' "$token" \
    | curl -s --max-time "${ARACHNE_USAGE_HTTP_TIMEOUT:-8}" \
        -H @- \
        -H 'anthropic-beta: oauth-2025-04-20' \
        "$ARACHNE_USAGE_ENDPOINT" 2>/dev/null || true)"
  if [[ -n "$resp" ]] && jq -e '.five_hour' >/dev/null 2>&1 <<<"$resp"; then
    printf '%s' "$resp" >| "$ARACHNE_USAGE_CACHE" 2>/dev/null || true
    dbg "refreshed cache from API"
    return 0
  fi
  dbg "API fetch failed or returned unexpected shape"
  cache_valid && { dbg "falling back to stale-but-valid cache"; return 0; }
  return 1
}

# ── Parse: emit a compact JSON object from the cached payload ──────────────────
# {bind_percent,reset_at,five_hour,seven_day,seven_day_opus,severity}
PARSE_JQ='
  def n(x): if (x|type)=="number" then (x|floor) else null end;
  (n(.five_hour.utilization))      as $f
  | (n(.seven_day.utilization))    as $s
  | (n(.seven_day_opus.utilization)) as $o
  | ([ $f, $s, $o ] | map(select(. != null))) as $named
  | (if ($named|length) > 0 then ($named | max)
     else ([ .limits[]?
             | select(((.scope.model.display_name) // "") | ascii_downcase | . != "sonnet")
             | .percent ] | map(select(. != null)) | (if length > 0 then (max | floor) else null end))
     end) as $bind
  | ([ {u:$f, r:.five_hour.resets_at},
       {u:$s, r:.seven_day.resets_at},
       {u:$o, r:.seven_day_opus.resets_at} ]
      | map(select(.u != null and $bind != null and .u == $bind and .r != null))
      | map(.r) | sort | (.[0] // null)) as $reset
  | { bind_percent: $bind,
      reset_at: $reset,
      five_hour: $f, seven_day: $s, seven_day_opus: $o,
      severity: (if $bind == null then "unknown"
                 elif $bind >= 95 then "critical"
                 elif $bind >= 80 then "warning"
                 else "normal" end) }
'

iso_to_epoch() {  # $1 = ISO8601 → unix epoch, or empty on failure / empty input
  local iso=$1
  [[ -z "$iso" || "$iso" == "null" ]] && { printf ''; return; }
  date -d "$iso" +%s 2>/dev/null || printf ''
}

# Emit the full decision object on stdout: bind_percent (int or null),
# reset_epoch (int or null), reset_at, the three windows, severity.
# Sets global REPLY_BIND to the integer bind_percent or the string "unknown".
build_decision() {
  REPLY_BIND="unknown"
  if ! fetch_usage; then
    printf '{"bind_percent":null,"reset_epoch":null,"reset_at":null,"five_hour":null,"seven_day":null,"seven_day_opus":null,"severity":"unknown"}'
    return 0
  fi
  local parsed bind reset_at reset_epoch
  parsed="$(jq -c "$PARSE_JQ" "$ARACHNE_USAGE_CACHE" 2>/dev/null || echo '')"
  if [[ -z "$parsed" ]]; then
    printf '{"bind_percent":null,"reset_epoch":null,"reset_at":null,"five_hour":null,"seven_day":null,"seven_day_opus":null,"severity":"unknown"}'
    return 0
  fi
  bind="$(jq -r '.bind_percent // "null"' <<<"$parsed")"
  reset_at="$(jq -r '.reset_at // empty' <<<"$parsed")"
  reset_epoch="$(iso_to_epoch "$reset_at")"
  [[ "$bind" != "null" && -n "$bind" ]] && REPLY_BIND="$bind"
  jq -c --argjson re "${reset_epoch:-null}" '. + {reset_epoch: $re}' <<<"$parsed"
}

# ── Reset-backstop file ────────────────────────────────────────────────────────
reset_backstop_epoch() {  # echo the future epoch in the backstop file, else empty
  # Must `return 0`: a trailing `[[ … ]] && printf` would leak exit 1 when the
  # backstop is absent/expired, and the caller's `x="$(reset_backstop_epoch)"`
  # plain assignment would then trip `set -e`.
  [[ -f "$ARACHNE_USAGE_RESET_FILE" ]] || { printf ''; return 0; }
  local e; e="$(tr -dc '0-9' < "$ARACHNE_USAGE_RESET_FILE" 2>/dev/null || true)"
  if [[ -n "$e" && "$e" -gt "$(date +%s)" ]]; then printf '%s' "$e"; fi
  return 0
}

# ── Modes ──────────────────────────────────────────────────────────────────────
cmd_percent() {
  build_decision >/dev/null
  printf '%s\n' "$REPLY_BIND"
}

cmd_json() {
  build_decision
  printf '\n'
}

cmd_gate() {
  local ceiling="$ARACHNE_USAGE_CEILING"
  while (( $# )); do
    case $1 in
      --ceiling) ceiling=$2; shift 2;;
      --ceiling=*) ceiling=${1#--ceiling=}; shift;;
      *) die "unknown arg to --gate: $1";;
    esac
  done
  [[ "$ceiling" =~ ^[0-9]+$ ]] || die "--ceiling must be an integer (got '$ceiling')"

  # Reset backstop wins first: a known reset window is a hard pause regardless of
  # what the (possibly stale) percentage says.
  local backstop; backstop="$(reset_backstop_epoch)"
  if [[ -n "$backstop" ]]; then
    warn "pause: inside reset-backstop window (resets at $(date -d "@$backstop" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "@$backstop"))"
    return 10
  fi

  build_decision >/dev/null
  if [[ "$REPLY_BIND" == "unknown" ]]; then
    warn "feed OK (bind_percent unknown — meter unreachable; failing open)"
    return 0
  fi
  if (( REPLY_BIND >= ceiling )); then
    warn "pause: bind_percent ${REPLY_BIND}% ≥ ceiling ${ceiling}%"
    return 10
  fi
  dbg "feed OK: bind_percent ${REPLY_BIND}% < ceiling ${ceiling}%"
  return 0
}

# Scan agent / stream-json logs for a usage-limit reset signal and record the
# soonest future epoch to the backstop file. Best-effort: the proactive --gate
# poll is primary; this catches a limit hit between ticks. Recognises both the
# CLI's "usage limit reached|<epoch>" result string and a bare "resets at <ISO>".
cmd_scan_logs() {
  local glob="${1:-}"
  [[ -z "$glob" ]] && die "usage: arachne-usage --scan-logs '<glob>'"
  local now; now="$(date +%s)"
  local best="" f epoch iso
  # shellcheck disable=SC2086  # word-splitting the glob into matched paths is intended
  for f in $glob; do
    [[ -f "$f" ]] || continue
    # 1) pipe-epoch form: "...usage limit reached|1750000000..."
    while IFS= read -r epoch; do
      [[ "$epoch" =~ ^[0-9]{9,11}$ ]] || continue
      (( epoch > now )) || continue
      [[ -z "$best" || "$epoch" -lt "$best" ]] && best="$epoch"
    done < <(grep -oiE 'usage limit reached\|[0-9]{9,11}' "$f" 2>/dev/null | grep -oE '[0-9]{9,11}' || true)
    # 2) ISO form: "...resets at 2026-06-22T21:00:00+00:00..."
    while IFS= read -r iso; do
      epoch="$(iso_to_epoch "$iso")"
      [[ -n "$epoch" ]] || continue
      (( epoch > now )) || continue
      [[ -z "$best" || "$epoch" -lt "$best" ]] && best="$epoch"
    done < <(grep -oiE 'resets?[ _]?(at|_at)?[": ]+[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:+.-]+' "$f" 2>/dev/null \
              | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:+.-]+' || true)
  done
  if [[ -n "$best" ]]; then
    printf '%s\n' "$best" >| "$ARACHNE_USAGE_RESET_FILE"
    warn "reset backstop set: pause until $(date -d "@$best" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "@$best") (epoch $best)"
  else
    dbg "no reset signal found in: $glob"
  fi
  return 0
}

usage() {
  cat <<'EOF'
usage: arachne-usage <mode>

Modes:
  --percent                 Print integer bind_percent (Max-plan utilization of the
                            binding window), or "unknown" if the meter is unreachable.
  --json                    {bind_percent,reset_epoch,reset_at,five_hour,seven_day,
                            seven_day_opus,severity}.
  --gate [--ceiling N]      Exit 0 = feed OK; exit 10 = pause (bind_percent ≥ N, or
                            inside a reset-backstop window). One-line reason on stderr.
                            Fails open (exit 0) when the meter is unreachable.
  --scan-logs '<glob>'      Scan logs for a limit-reset signal; write the soonest
                            future epoch to the reset-backstop file.
  -h | --help               This help.

Env: ARACHNE_CREDENTIALS, ARACHNE_USAGE_CACHE, ARACHNE_USAGE_TTL,
     ARACHNE_USAGE_RESET_FILE, ARACHNE_USAGE_ENDPOINT, ARACHNE_USAGE_CEILING,
     ARACHNE_USAGE_DEBUG.
EOF
}

main() {
  local mode=${1:-}
  [[ -z "$mode" ]] && { usage; exit 1; }
  shift || true
  case $mode in
    --percent)   cmd_percent "$@";;
    --json)      cmd_json "$@";;
    --gate)      cmd_gate "$@";;
    --scan-logs) cmd_scan_logs "$@";;
    -h|--help|help) usage;;
    *) die "unknown mode: $mode (try --help)";;
  esac
}

main "$@"
