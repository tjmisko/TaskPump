# taskpump-pump.service — systemd --user unit for a multi-day drain.
#
# This is the PERSISTENT-unit path, the one that restarts on failure. For a
# throwaway run, `tp pump --detach` spins up a transient `systemd-run --user`
# unit instead and needs none of this.
#
# Install (edit the Environment= lines first):
#
#   mkdir -p ~/.config/systemd/user
#   cp systemd/taskpump-pump.service ~/.config/systemd/user/taskpump-pump.service
#   $EDITOR ~/.config/systemd/user/taskpump-pump.service
#   systemctl --user daemon-reload
#   systemctl --user start taskpump-pump    # (or: enable --now, with linger, to survive logout)
#   journalctl --user -u taskpump-pump -f   # watch
#   systemctl --user stop taskpump-pump     # stop FEEDING (running agents keep going)
#
# To survive a full logout, enable linger once: `loginctl enable-linger "$USER"`.

[Unit]
Description=TaskPump usage-governed DAG pump
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ── Edit these ───────────────────────────────────────────────────────────────
# TASKPUMP_REPO is the repo the pump drives; TASKPUMP_BIN is the TaskPump
# install. When TaskPump is vendored into the repo, they share a root.
Environment=TASKPUMP_REPO=%h/Projects/Arachne
Environment=TASKPUMP_BIN=%h/Projects/Arachne/libexec/tp-pump
Environment=TASKPUMP_PUMP_PHASES=F55..F63
Environment=TASKPUMP_PUMP_JOBS=4
Environment=TASKPUMP_PUMP_CEILING=95
# ─────────────────────────────────────────────────────────────────────────────
# The working directory decides which taskpump.conf and which ledger this run
# uses: config discovery walks up from the caller's directory, never from where
# the tools happen to be installed.
WorkingDirectory=%h/Projects/Arachne
ExecStart=/usr/bin/env bash -lc '"$TASKPUMP_BIN" --phases "$TASKPUMP_PUMP_PHASES" --jobs "$TASKPUMP_PUMP_JOBS" --usage-ceiling "$TASKPUMP_PUMP_CEILING"'
# A drained pump exits 0 and must NOT be restarted. A deadlocked one exits 3,
# which is a failure and should page you through the restart. The pump never
# kills running agents, so a restart re-derives in-flight work from the task
# files and the container runtime without disrupting anything.
Restart=on-failure
RestartSec=30
# Stopping the unit stops FEEDING; detached agent containers keep running.
KillSignal=SIGINT

[Install]
WantedBy=default.target
